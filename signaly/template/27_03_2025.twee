	var netPending = [];

	// Пришло с телефона или с пульта: переменные, итог голосования, коды, фразы и события ($sgNet.got).
	function netApply(o) {
		var b = o.body || {};
		var V = State.variables;

		function put(set) {
			Object.keys(set).forEach(function (k) {
				V[k.replace(/^\$/, '')] = set[k];
			});
		}
		if (o.kind === 'term' && (b.set || b.add)) {
			if (b.set) {
				put(b.set);
			}
			if (b.add) {
				put(window.SgTermNet.added(b.add, V));
			}
		} else if (o.kind === 'vote-close' && b.term) {
			put(window.SgTermNet.voteResult(b));
		} else if (o.kind === 'code' || o.kind === 'event') {
			var store = V.sgNet || (V.sgNet = {});
			var got = store.got || (store.got = {});
			var who = netNorm(b.num || (o.from && o.from.num) || '');
			var names = o.kind === 'event' ? [b.name] : [b.code, b.phrase, b.label];
			var seen = {};

			names.forEach(function (n) {
				n = netNorm(n);
				if (!n || seen[n]) {
					return;
				}
				seen[n] = 1;
				got[o.kind + '|' + n + '|'] = (got[o.kind + '|' + n + '|'] || 0) + 1;
				if (who) {
					got[o.kind + '|' + n + '|' + who] = (got[o.kind + '|' + n + '|' + who] || 0) + 1;
				}
			});
		} else {
			return false;
		}
		return true;
	}

	function netFlush() {
		if (!started || restoring || !State.passage || !netPending.length) {
			return;
		}

		var list = netPending;
		var changed = false;

		netPending = [];
		list.forEach(function (o) {
			try {
				changed = netApply(o) || changed;
			} catch (e) {
				console.error('СИГНАЛЫ: сеть', e);
			}
		});
		if (changed) {
			saveVars();
			setTimeout(checkEvents, 0);
		}
	}

	/* Сессия 35 (Т4-3): общие с телефонами переменные. Значение хранит центр («var:имя»): терминал
	   шлёт свои изменения, берёт чужие (телефоны, правила, пульт). $sgNet.shared — что уже отправлено
	   или взято: при новой связи своё изменение (без связи) уходит центру, иначе берётся значение центра. */
	var shareNames = {};
	var shareWelcome = false;
	var shareIn = [];

	setup.signaly.shared = shareNames;
	Macro.add('sg-shared', {
		handler: function () {
			this.args.forEach(function (n) {
				shareNames[String(n).replace(/^\$/, '')] = 1;
			});
		}
	});

	function shareJson(v) {
		return v === undefined ? undefined : JSON.stringify(v);
	}

	function shareSync() {
		var N = window.SgTermNet;
		var names = Object.keys(shareNames);

		if (!N || !names.length || !started || restoring || !State.passage) {
			return;
		}

		var V = State.variables;
		var store = V.sgNet || (V.sgNet = {});
		var sent = store.shared || (store.shared = {});
		var changed = false;
		var took = false;
		var welcome = shareWelcome && N.on;

		if (welcome) {
			shareWelcome = false;
		}
		shareIn.splice(0).forEach(function (o) {
			var n = o.key.slice(4);

			if (shareNames[n] && o.value !== null && o.value !== undefined) {
				V[n] = o.value;
				sent[n] = shareJson(o.value);
				changed = took = true;
			}
		});
		names.forEach(function (n) {
			var key = 'var:' + n;
			var local = shareJson(V[n]);

			if (local === undefined) {
				return;
			}
			if (welcome) {
				var has = Object.prototype.hasOwnProperty.call(N.state, key) && N.state[key] !== null;
				var center = has ? shareJson(N.state[key]) : undefined;

				if (sent[n] !== undefined && local !== sent[n]) {
					N.set(key, V[n]);
					sent[n] = local;
				} else if (has && center !== local) {
					V[n] = N.state[key];
					sent[n] = center;
					took = true;
				} else {
					if (!has) {
						N.set(key, V[n]);
					}
					sent[n] = local;
				}
				changed = true;
			} else if (N.on && local !== sent[n]) {
				N.set(key, V[n]);
				sent[n] = local;
				changed = true;
			}
		});
		if (changed) {
			saveVars();
		}
		if (took) {
			setTimeout(checkEvents, 0);
		}
	}

	if (window.SgTermNet) {
		window.SgTermNet.ownVars = true;
		window.SgTermNet.listen(function (type, o) {
			if (type === 'msg' && o && /^(term|vote-close|code|event)$/.test(o.kind)) {
				netPending.push(o);
				netFlush();
			} else if ((type === 'status' && o && o.t === 'welcome') || type === 'reset') {
				shareWelcome = true;
				shareSync();
			} else if (type === 'state' && o && /^var:/.test(o.key) && o.by !== window.SgTermNet.dev) {
				shareIn.push(o);
				shareSync();
			}
		});
		setInterval(function () {
			netFlush();
			shareSync();
		}, 500);
	}

	/* ----- Предзагрузка картинок (этап 6, ответ 6А) ----- */

	// Все картинки из текста экранов загружаются при запуске, пока горит
	// стартовый экран. Запуск их не ждёт. Берутся только файлы из media/ (решение 11),
	// поэтому пути с переменными не загружаются. Ссылки на картинки хранятся, иначе браузер их выбросит.
	var imageExt = 'jpe?g|png|gif|webp|bmp|svg|avif';
	var imageLoaded = {};

	function imageRes() {
		return [
			new RegExp('(["\'])((?:(?!\\1)[^\\n<>])+?\\.(?:' + imageExt + '))\\1', 'gi'),
			new RegExp('\\[img\\[(?:[^\\]|]*\\|)?()([^\\]|]+?\\.(?:' + imageExt + '))\\]', 'gi'),
			new RegExp('url\\(\\s*()([^"\')]+?\\.(?:' + imageExt + '))\\s*\\)', 'gi')
		];
	}

	function imagesPreload() {
		Story.filter(function () {
			return true;
		}).forEach(function (p) {
			imageRes().forEach(function (re) {
				var m;

				while ((m = re.exec(p.text))) {
					var src = m[2].trim();

					if (!imageLoaded[src] && src.indexOf('media/') === 0) {
						imageLoaded[src] = new Image();
						imageLoaded[src].src = src;
					}
				}
			});
		});
