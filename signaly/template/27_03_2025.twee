  function paint() {
    if (!D) return;
    if (dot) {
      dot.style.background = N.on ? '#3f3' : (stopped && !queue.length ? '#555' : '#f33');
      dot.title = N.on ? 'Сеть: ' + N.url : 'Сеть не подключена' + (queue.length ? ' · ждут отправки: ' + queue.length : '');
