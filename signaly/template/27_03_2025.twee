:: CAMERATEST {"position":"425,500","size":"100,100"}
<div class="center-text">\
<video id="webcam" autoplay playsinline muted width="1000" height="1000" style="border: 2px solid #00cc00;">\</video>\
</div>\

<<script>>
$(document).one(':passagedisplay', function () {
    var video = document.getElementById('webcam');
    if (setup.webcamStream) {
        video.srcObject = setup.webcamStream;
    } else {
        // fallback (если вдруг не успело)
        setup.initWebcam().then(function(stream) {
            video.srcObject = stream;
        });
    }
});
<</script>>


