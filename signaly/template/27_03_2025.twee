<div class="center-text">\
<video id="vid1" loop autoplay muted width="1000" height="1000">
    <source src="media/video/SHUTTERS.mp4" type="video/mp4">
</video>\
<video id="vid2" preload="auto" width="1000" height="1000" style="display:none;">
    <source src="media/video/SHUTTERS_DESSERT_OPEN_SOUND.mp4" type="video/mp4">
</video>\
<video id="vid3" loop preload="auto" width="1000" height="1000" style="display:none;">
    <source src="media/video/DESERT_RAIN.mp4" type="video/mp4">
</video>\
<video id="vid4" preload="auto" width="1000" height="1000" style="display:none;">
    <source src="media/video/SHUTTERS_DESSET_CLOSE_SOUND.mp4" type="video/mp4">
</video>
</div>

<<script>>
$(document).one(':passagedisplay', function () {

    var v1 = document.getElementById('vid1');
    var v2 = document.getElementById('vid2');
    var v3 = document.getElementById('vid3');
    var v4 = document.getElementById('vid4');

    v2.load();
    v3.load();
    v4.load();

    // Клик по первому (loop) → второе
    v1.addEventListener('click', function () {

        v1.pause();
        v1.style.display = "none";

        v2.style.display = "block";
        v2.play().catch(function(){});
    });

    // После второго → третье (loop дождя)
    v2.addEventListener('ended', function () {

        v2.style.display = "none";
        v3.style.display = "block";

        v3.play().catch(function(){});
    });

    // Клик по третьему → четвёртое
    v3.addEventListener('click', function () {

        v3.pause();
        v3.style.display = "none";

        v4.style.display = "block";
        v4.play().catch(function(){});
    });

    // После четвёртого → переход
    v4.addEventListener('ended', function () {
        Engine.play("Start");
    });

});
<</script>>


