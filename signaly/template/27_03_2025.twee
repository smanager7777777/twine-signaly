#000000","bg":"#cccc00","borderWidth":0,"borderColor":"#cccc00","glow":5,"glowColor":"#cccc00","underline":false},"active":null,"padV":3,"padH":6,"size":80,"transition":0.3},"buttonAsLink":false},{"cls":"amber","name":"Янтарный","link":{"normal":{"color":"#ffbf00","bg":"#000000","borderWidth":2,"borderColor":"#ffbf00","glow":5,"glowColor":"#ffbf00","underline":false},"hover":{"color":"#000000","bg":"#ffbf00","borderWidth":2,"borderColor":"#ffbf00","glow":5,"glowColor":"#ffbf00","underline":false},"active":null,"padV":4,"padH":9,"size":120,"transition":0.3},"button":{"normal":{"color":"#ffbf00","bg":"#000000","borderWidth":2,"borderColor":"#ffbf00","glow":5,"glowColor":"#ffbf00","underline":false},"hover":{"color":"#000000","bg":"#ffbf00","borderWidth":2,"borderColor":"#ffbf00","glow":5,"glowColor":"#ffbf00","underline":false},"active":null,"padV":4,"padH":9,"size":120,"transition":0.3},"buttonAsLink":false},{"cls":"purple","name":"Фиолетовый","link":{"normal":{"color":"#cc00cc","bg":"","borderWidth":0,"borderColor":"#cc00cc","glow":0,"glowColor":"#cc00cc","underline":false},"hover":{"color":"#ff00ff","bg":"","borderWidth":0,"borderColor":"#ff00ff","glow":0,"glowColor":"#ff00ff","underline":true},"active":null,"padV":0,"padH":0,"size":100,"transition":0.3},"button":{"normal":{"color":"#cc00cc","bg":"#000000","borderWidth":1,"borderColor":"#cc00cc","glow":5,"glowColor":"#cc00cc","underline":false},"hover":{"color":"#000000","bg":"#cc00cc","borderWidth":1,"borderColor":"#cc00cc","glow":5,"glowColor":"#cc00cc","underline":false},"active":null,"padV":5,"padH":10,"size":100,"transition":0.3},"buttonAsLink":false}],"places":[]} */
a {
	color: #00cc00;
	text-decoration: none;
	transition: all 0.2s;
}
a:hover {
	color: #00ff00;
	text-decoration: underline;
}
button {
	color: #00cc00;
	background-color: #000000;
	border: 1px solid #00cc00;
	box-shadow: 0 0 5px #00cc00;
	text-decoration: none;
	padding: 5px 10px;
	transition: all 0.3s;
}
button:hover {
	color: #000000;
	background-color: #00cc00;
	border: none;
}
.red-big a {
	color: #cc0000;
	background-color: transparent;
	border: none;
	box-shadow: none;
	text-decoration: none;
	padding: 0px 0px;
	font-size: 1.2em;
	transition: all 0.3s;
}
.red-big a:hover {
	color: #ff0000;
	text-decoration: underline;
}
.red-big button {
	color: #cc0000;
	background-color: #000000;
	border: 1px solid #cc0000;
	box-shadow: 0 0 5px #cc0000;
	text-decoration: none;
	padding: 10px 20px;
	font-size: 1.2em;
	transition: all 0.3s;
}
.red-big button:hover {
	color: #000000;
	background-color: #cc0000;
	border: none;
}
.yellow-small a {
	color: #cccc00;
	background-color: #000000;
	border: 1px solid #cccc00;
	box-shadow: 0 0 5px #cccc00;
	text-decoration: none;
	padding: 3px 6px;
	font-size: 0.8em;
	transition: all 0.3s;
}
.yellow-small a:hover {
	color: #000000;
	background-color: #cccc00;
	border: none;
	text-decoration: underline;
}
.yellow-small button {
	color: #cccc00;
	background-color: #000000;
	border: 1px solid #cccc00;
	box-shadow: 0 0 5px #cccc00;
	text-decoration: none;
	padding: 3px 6px;
	font-size: 0.8em;
	transition: all 0.3s;
}
.yellow-small button:hover {
	color: #000000;
	background-color: #cccc00;
	border: none;
}
.amber a {
	color: #ffbf00;
	background-color: #000000;
	border: 2px solid #ffbf00;
	box-shadow: 0 0 5px #ffbf00;
	text-decoration: none;
	padding: 4px 9px;
	font-size: 1.2em;
	transition: all 0.3s;
}
.amber a:hover {
	color: #000000;
	background-color: #ffbf00;
}
.amber button {
	color: #ffbf00;
	background-color: #000000;
	border: 2px solid #ffbf00;
	box-shadow: 0 0 5px #ffbf00;
	text-decoration: none;
	padding: 4px 9px;
	font-size: 1.2em;
	transition: all 0.3s;
}
.amber button:hover {
	color: #000000;
	background-color: #ffbf00;
}
.purple a {
	color: #cc00cc;
	background-color: transparent;
	border: none;
	box-shadow: none;
	text-decoration: none;
	padding: 0px 0px;
	font-size: 1em;
	transition: all 0.3s;
}
.purple a:hover {
	color: #ff00ff;
	text-decoration: underline;
}
.purple button {
	color: #cc00cc;
	background-color: #000000;
	border: 1px solid #cc00cc;
	box-shadow: 0 0 5px #cc00cc;
	text-decoration: none;
	padding: 5px 10px;
	font-size: 1em;
	transition: all 0.3s;
}
.purple button:hover {
	color: #000000;
	background-color: #cc00cc;
}
/* ===== СИГНАЛЫ: конец видов кнопок и ссылок ===== */


.ui-dialog {
    background-color: #000000;
    border: 2px solid #00cc00;
    box-shadow: 0 0 10px #00cc00, 0 0 20px #00cc00;
    color: #00cc00;
       font-size: 25px;
}

.ui-dialog-titlebar {
    background-color: #000000;
    color: #00cc00;
    border-bottom: 1px solid #00cc00;
     font-size: 25px;
}

.ui-dialog-body {
    color: #00cc00;
     font-size: 25px;
}

input, textarea {
    background-color: #000000;
    color: #00cc00;
    border: 1px solid #00cc00;
    box-shadow: 0 0 5px #00cc00;
    padding: 5px;
     font-size: 25px;
}

#ui-bar, #ui-bar-toggle {
    background-color: #000000;
    color: #00cc00;
    border: none;
     font-size: 25px;
}


/* Подключаем шрифт DSEG7 Classic для сегментного дизайна */
@font-face {
    font-family: 'DSEG7';
    src: url('media/fonts/DSEG7Classic-Regular.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
}

#timer-display {
    font-family: 'DSEG7', monospace;
    font-size: 125px; /* Размер шрифта для читаемости */
    color: #cc0000; /* Красный цвет */
    background-color: #000000;
    border: 2px solid #cc0000;
    box-shadow: 0 0 10px #cc0000, 0 0 20px #cc0000;
    padding: 10px 20px;
    width: fit-content; /* Ширина подстраивается под содержимое */
    display: inline-block; /* Делает контейнер компактным */
    margin: 20px auto; /* Центрирует элемент по горизонтали */
    text-align: center; /* Центрирует текст внутри элемента */
    display: flex; /* Используем flexbox для точного центрирования */
    justify-content: center; /* Центрирует содержимое по горизонтали */
    align-items: center; /* Центрирует содержимое по вертикали (если нужно) */
}

.center-text {
    text-align: center; /* По центру по горизонтали */
}

.side-text {
    text-align: right; /* Справа по горизонтали */
}



#blockscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #cc0000;
    color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 70px;
    z-index: 1002;
}

#blackscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 70px;
    z-index: 1002;
}




/* Стили для поля ввода пароля */
.password-input {
    background-color: #000000;
    color: #00cc00;
    border: 1px solid #00cc00;
    box-shadow: 0 0 5px #00cc00;
    padding: 5px;
    font-size: 20px;
    font-family: "Courier New", monospace;
    width: 200px; /* Ширина поля ввода */
    display: block; /* Делает поле блочным элементом */
    margin: 20px auto; /* Центрируем поле */
}






#terminalDisplay {
    width: 100%;
    height: 70%;
    overflow: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
      text-align: center;
    line-height: 1.5;
}

#likenessDisplay {
    width: 100%;
    height: 10%;
    overflow: auto;
    text-align: center;
    margin-top: 10px;
}

#attemptsLeft {
    width: 100%;
    height: 10%;
    margin-top: 10px;
    text-align: center;
}

.word {
    color: #00cc00; /* Зеленый текст */
    background-color: #000000; /* Черный фон */
}

.word:hover {
    color: #000000; /* Черный текст при наведении */
    background-color: #00cc00; /* Зеленый фон при наведении */
}




/* Глючный текст - старт */

/* "Clip" в ".glitch" не используется, поэтому технически вы должны использовать "clip-path", который находится в ".glitchy", однако Internet Explorer не поддерживает "clip-path", а большинство браузеров по-прежнему поддерживают "clip". */


.glitchy {
  color: #00cc00;
  position: relative;
}
.glitchy::before {
  content: attr(data-text);
  width: calc(100% + 0.5em);
  position: absolute;
  left: -9px;
  text-shadow: 1px 0 blue;
  top: -5px;
  color: #00cc00;
  background: #111;
  overflow: hidden;
  clip-path: polygon(0 0);
  animation: noise-animY-2 3s infinite linear alternate-reverse;
  -webkit-animation: noise-animY-2 3s infinite linear alternate-reverse;
}
.glitchy::after {
  content: attr(data-text);
  width: calc(100% + 0.5em);
  position: absolute;
  left: -5px;
  text-shadow: -1px 0 red;
  top: -5px;
  color: #00cc00;
  background: #111;
  overflow: hidden;
  clip-path: polygon(0 0);
  animation: noise-animY 2s infinite linear alternate-reverse;
  -webkit-animation: noise-animY 2s infinite linear alternate-reverse;
}
@keyframes noise-animY {
  0% {
    clip-path: polygon(0 80px, 100% 80px, 100% 16px, 0 16px);
  }
  5% {
    clip-path: polygon(0 94px, 100% 94px, 100% 17px, 0 17px);
  }
  10% {
    clip-path: polygon(0 9px, 100% 9px, 100% 92px, 0 92px);
  }
  15.0% {
    clip-path: polygon(0 37px, 100% 37px, 100% 4px, 0 4px);
  }
  20% {
    clip-path: polygon(0 53px, 100% 53px, 100% 47px, 0 47px);
  }
  25% {
    clip-path: polygon(0 99px, 100% 99px, 100% 69px, 0 69px);
  }
  30.0% {
    clip-path: polygon(0 15px, 100% 15px, 100% 49px, 0 49px);
  }
  35% {
    clip-path: polygon(0 83px, 100% 83px, 100% 81px, 0 81px);
  }
  40% {
    clip-path: polygon(0 55px, 100% 55px, 100% 43px, 0 43px);
  }
  45% {
    clip-path: polygon(0 28px, 100% 28px, 100% 27px, 0 27px);
  }
  50% {
    clip-path: polygon(0 64px, 100% 64px, 100% 28px, 0 28px);
  }
  55.0% {
    clip-path: polygon(0 76px, 100% 76px, 100% 91px, 0 91px);
  }
