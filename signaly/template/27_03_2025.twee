:: audiobuttons {"position":"200,0","size":"100,100"}
/* СИГНАЛЫ: каждая кнопка стоит на своём месте у окна терминала (<<sg-place>>) — место
   задаётся щелчком по команде в окне пассажа или перетаскиванием в предпросмотре */\
<<sg-place kind amber corner tr x 5 y 2.75>><<link "РАД">>
<<if $radioplaying is 1>>
<<set $radioplaying to 0>>
<<audio ":RADIO" pause>>
<<else>>
<<set $radioplaying to 1>>
<<set $ambientplaying to 0>>
<<audio ":AMBIENT" pause>>
<<audio ":paused:not(:AMBIENT)" play>>
<</if>>
<</link>><</sg-place>>\
<<sg-place kind amber corner tr x 5 y 55.25>><<link "АТМ">>
<<if $ambientplaying is 1>>
<<set $ambientplaying to 0>>
<<audio ":AMBIENT" pause>>
<<else>>
<<set $ambientplaying to 1>>
<<set $radioplaying to 0>>
<<audio ":RADIO" pause>>
<<audio ":paused:not(:RADIO)" play>>
