:: Хактест {"position":"700,125","size":"100,100"}
\<<set $attemptsLeft = 3>> /* Количество попыток */
\<<set $wordList = ["ЧЕХИЯ", "ХУЙНЯ", "ПАРИЯ", "СОННЯ", "КУХНЯ"]>> /* Список слов */
\<<set $correctPassword = "ПАРИЯ">> /* Правильный пароль */
\<<set $usedAttempts = []>> /* Использованные попытки */
\<<set $likenessDisplay = "">> /* Отображение совпадений */
\<<set $rows = 10>> /* Количество строк */
\<<set $charsPerRow = 60>> /* Символов в строке */
\
\<<script>>
// Генерация случайного фона как массива символов
function generateBackground(rows, cols, chars) {
    return Array(rows).fill().map(() => Array(cols).fill().map(() => chars[Math.floor(Math.random() * chars.length)]));
}

// Подсчёт совпадений
function getLikeness(guess, correct) {
    return `${[...guess].filter((c, i) => c === correct[i]).length}/${guess.length} ВЕРНО`;
}

// Инициализация терминала
$(document).one(':passagedisplay', function() {
    const $display = $("#terminalDisplay");
    const $attempts = $("#attemptsLeft");
    const $likeness = $("#likenessDisplay");
    const chars = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789";

    // Генерация фона
    const background = generateBackground(State.variables.rows, State.variables.charsPerRow, chars);
    const wordPositions = [];

    // Расстановка слов с проверкой пересечений
    State.variables.wordList.forEach(word => {
        let attempts = 0;
        while (attempts < 10) {
            const row = Math.floor(Math.random() * State.variables.rows);
            const col = Math.floor(Math.random() * (State.variables.charsPerRow - word.length + 1));
            if (!wordPositions.some(p => p.row === row && p.col <= col + word.length && p.col + p.word.length >= col)) {
                wordPositions.push({ row, col, word });
                // СИГНАЛЫ: слово занимает столько же клеток, сколько в нём букв, — строки остаются ровными
                background[row].splice(col, word.length, `<span class="word" data-word="${word}" style="cursor: pointer;">${word}</span>`, ...Array(word.length - 1).fill(""));
                break;
            }
            attempts++;
        }
    });

    // Формирование отображаемого текста
    $display.html(background.map(row => `<div>${row.join("")}</div>`).join(""));
    $attempts.text(`Осталось попыток: ${State.variables.attemptsLeft}`);
    $likeness.text(State.variables.likenessDisplay || "");

    // Обработка клика с точным выбором слова
    $display.on("click", ".word", function(e) {
        if (State.variables.attemptsLeft <= 0) return;

        const $wordSpan = $(e.target).closest(".word");
        const guess = $wordSpan.data("word");
        State.variables.usedAttempts.push(guess);
        State.variables.attemptsLeft--;

        if (guess === State.variables.correctPassword) {
            $display.text("Доступ разрешён!\nПароль: " + State.variables.correctPassword);
            $attempts.text("Взлом завершён успешно!");
            $likeness.text("");
            setTimeout(() => Engine.play("Start"), 1000);
        } else {
            State.variables.likenessDisplay = getLikeness(guess, State.variables.correctPassword);
            $attempts.text(`Осталось попыток: ${State.variables.attemptsLeft}`);
            $likeness.text(State.variables.likenessDisplay);

            if (State.variables.attemptsLeft <= 0) {
                $display.text("Доступ запрещён!\nТерминал заблокирован.");
                $likeness.text("");
                setTimeout(() => Engine.play("Blocktest"), 1000);
            }
        }
    });
});
<</script>>
\
\<div id="terminalWindow">
    \<div id="terminalDisplay"></div>
    \<div id="likenessDisplay"></div>
    \<div id="attemptsLeft"></div>
\</div>
\Текст под таймером


:: StoryScript [script]
/* ===== СИГНАЛЫ: звуки наведения и нажатия — не редактировать вручную ===== */
/* Наборы звуков — в окне «Звуки», звуки видов — в окне «Виды кнопок и ссылок». */
setup.signalySounds = {
	"sets": [
		{
			"name": "Наведение",
			"files": [
				"media/audio/hover1.wav",
				"media/audio/hover2.wav",
				"media/audio/hover3.wav",
				"media/audio/hover4.wav",
				"media/audio/hover5.wav",
				"media/audio/hover6.wav"
			],
			"volume": 5,
			"delay": 0
		},
		{
			"name": "Нажатие",
			"files": [
				"media/audio/click1.wav",
				"media/audio/click2.wav",
				"media/audio/click3.wav"
			],
			"volume": 5,
			"delay": 0
		}
	],
	"kinds": {
		"": {
			"hover": "Наведение",
			"click": "Нажатие"
		}
	}
};
/* ===== СИГНАЛЫ: конец звуков наведения и нажатия ===== */


/* ===== СИГНАЛЫ: движок терминала — не редактировать вручную ===== */
/* Версия движка: 7. Обновляется программой «Twine СИГНАЛЫ».
   Настройки — в окне «Оформление терминала» (они лежат в таблице стилей).
   Свой код пишите ниже конца этого блока. */
(function () {
	'use strict';

	// История в один шаг: «назад» в браузере не откатывает игру.
	Config.history.maxStates = 1;

	var rootStyle = getComputedStyle(document.documentElement);

	function opt(name, fallback) {
		var raw = rootStyle.getPropertyValue('--sg-' + name).trim();

		if (raw === '') {
			return fallback;
		}
		if (raw.charAt(0) === '"') {
			try {
				return JSON.parse(raw);
			} catch (e) {
				return fallback;
			}
		}

		var number = Number(raw);

		return isNaN(number) ? raw : number;
	}

	var settings = {
		startSound: opt('start-sound', ''),
		startVolume: opt('start-volume', 1),
		noContextMenu: opt('protect-menu', 0) === 1,
		noZoom: opt('protect-zoom', 0) === 1,
		hideCursorAfter: opt('hide-cursor', 0),
		lineScroll: opt('line-scroll', 0) === 1,
		// Печать текста (шаг 2.1): по умолчанию включено (ответ автора 6А).
		typeClick: opt('type-click', 1) === 1,
		typeSeen: opt('type-seen', 1) === 1
	};

	// Предпросмотр в программе: без стартового экрана, автокопии и защиты.
	var preview = window.SIGNALY_PREVIEW;

	setup.signaly = {engine: 7, preview: !!preview};

	function showStartScreen(onClick) {
		var screen = document.createElement('div');

		screen.id = 'sg-start';
		document.body.appendChild(screen);
		screen.addEventListener('click', function () {
			onClick(screen);
		});
		return screen;
	}

	/* ----- Прокрутка по одной строке ----- */

	function scrollTarget(element) {
		while (element && element !== document.documentElement) {
			var style = getComputedStyle(element);

			if (
				/(auto|scroll)/.test(style.overflowY) &&
				element.scrollHeight > element.clientHeight
			) {
				return element;
			}
			element = element.parentElement;
		}
		return null;
	}

	if (settings.lineScroll) {
		document.addEventListener(
			'wheel',
			function (ev) {
				if (ev.ctrlKey || ev.deltaY === 0) {
					return;
				}

				var target = scrollTarget(ev.target);

				if (!target) {
					return;
				}

				// Высота строки — меряем настоящую строку текста этого блока.
				var probe = document.createElement('div');

				probe.textContent = 'X';
				probe.style.cssText = 'position:absolute;visibility:hidden;left:0;top:0;';
				target.appendChild(probe);

				var line = probe.getBoundingClientRect().height;

				target.removeChild(probe);
				ev.preventDefault();
				target.scrollBy({top: ev.deltaY > 0 ? line : -line, behavior: 'instant'});
			},
			{passive: false}
		);
	}

	/* ----- Слой эффектов поверх терминала ----- */

	// Шум и затемнение углов — в слое #sg-fx точно по рамке #passages. Слой
	// живёт внутри #passages (мерцает вместе с ним, экран тревоги остаётся
	// сверху), но закреплён на экране и не прокручивается вместе с текстом.
	function placeEffects() {
		var passages = document.getElementById('passages');

		if (!passages) {
			return;
		}

		var fx = document.getElementById('sg-fx');

		if (!fx) {
			fx = document.createElement('div');
			fx.id = 'sg-fx';
			fx.setAttribute('aria-hidden', 'true');
		}
		if (fx.parentNode !== passages) {
			passages.appendChild(fx);
		}

		var rect = passages.getBoundingClientRect();

		fx.style.left = rect.left + 'px';
		fx.style.top = rect.top + 'px';
		fx.style.width = rect.width + 'px';
		fx.style.height = rect.height + 'px';
	}

	$(document).on(':passagedisplay', placeEffects);
	window.addEventListener('resize', placeEffects);
	document.addEventListener('fullscreenchange', placeEffects);
	setInterval(placeEffects, 1000);

	/* ----- Блоки экрана (шаг 1.4) ----- */

	// Команды: <<sg-image>>, <<sg-video>>, <<sg-alarm>>, <<sg-dialog>>,
	// <<sg-code>> (с <<sg-case>> и <<sg-wrong>>), окно KR2. Их вставляет панель
	// «Добавить блок»; в обычном Twine они работают так же.

	var engineStyle = document.createElement('style');

	engineStyle.id = 'sg-engine-style';
	engineStyle.textContent =
		'@keyframes sg-alarm-blink { 50% { filter: brightness(0.45); } }\n' +
		'html[data-sg-dialog="noclose"] #ui-dialog-close { display: none; }\n' +
		'.sg-dialog-ok { margin-top: 1em; text-align: center; }\n' +
		// Эффекты текста (шаг 2.1): мигание; глитч — с нулевой силой (:where),
		// его перекрывают и блок оформления, и стили автора.
		'@keyframes sg-text-blink { 50% { opacity: 0; } }\n' +
		'.sg-blink { animation: sg-text-blink 1s steps(1, end) infinite; }\n' +
		// Сессия 7: ссылка в печатающемся тексте ждёт конца своей надписи;
		// глитч и мигание до своего начала — обычный текст.
		'.sg-type-wait { pointer-events: none !important; }\n' +
		'.sg-blink.sg-off { animation: none; }\n' +
		'html .glitchy.sg-off { color: inherit; }\n' +
		'html .glitchy.sg-off::before, html .glitchy.sg-off::after { content: none; }\n' +
		":where(.glitchy) { color: #00cc00; position: relative; }\n:where(.glitchy)::before { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -9px; text-shadow: 1px 0 #0000ff; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-2 3s infinite linear alternate-reverse; }\n:where(.glitchy)::after { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -5px; text-shadow: -1px 0 #ff0000; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-1 2s infinite linear alternate-reverse; }\n@keyframes sg-glitch-1 { 0% { clip-path: polygon(0 80px, 100% 80px, 100% 16px, 0 16px); } 5% { clip-path: polygon(0 94px, 100% 94px, 100% 17px, 0 17px); } 10% { clip-path: polygon(0 9px, 100% 9px, 100% 92px, 0 92px); } 15.0% { clip-path: polygon(0 37px, 100% 37px, 100% 4px, 0 4px); } 20% { clip-path: polygon(0 53px, 100% 53px, 100% 47px, 0 47px); } 25% { clip-path: polygon(0 99px, 100% 99px, 100% 69px, 0 69px); } 30.0% { clip-path: polygon(0 15px, 100% 15px, 100% 49px, 0 49px); } 35% { clip-path: polygon(0 83px, 100% 83px, 100% 81px, 0 81px); } 40% { clip-path: polygon(0 55px, 100% 55px, 100% 43px, 0 43px); } 45% { clip-path: polygon(0 28px, 100% 28px, 100% 27px, 0 27px); } 50% { clip-path: polygon(0 64px, 100% 64px, 100% 28px, 0 28px); } 55.0% { clip-path: polygon(0 76px, 100% 76px, 100% 91px, 0 91px); } 60.0% { clip-path: polygon(0 29px, 100% 29px, 100% 72px, 0 72px); } 65% { clip-path: polygon(0 70px, 100% 70px, 100% 10px, 0 10px); } 70% { clip-path: polygon(0 5px, 100% 5px, 100% 84px, 0 84px); } 75% { clip-path: polygon(0 46px, 100% 46px, 100% 81px, 0 81px); } 80% { clip-path: polygon(0 7px, 100% 7px, 100% 85px, 0 85px); } 85.0% { clip-path: polygon(0 17px, 100% 17px, 100% 89px, 0 89px); } 90% { clip-path: polygon(0 41px, 100% 41px, 100% 59px, 0 59px); } 95% { clip-path: polygon(0 53px, 100% 53px, 100% 90px, 0 90px); } 100% { clip-path: polygon(0 10px, 100% 10px, 100% 30px, 0 30px); } }\n@keyframes sg-glitch-2 { 0% { clip-path: polygon(0 84px, 100% 84px, 100% 3px, 0 3px); } 5% { clip-path: polygon(0 31px, 100% 31px, 100% 69px, 0 69px); } 10% { clip-path: polygon(0 37px, 100% 37px, 100% 33px, 0 33px); } 15.0% { clip-path: polygon(0 18px, 100% 18px, 100% 6px, 0 6px); } 20% { clip-path: polygon(0 25px, 100% 25px, 100% 87px, 0 87px); } 25% { clip-path: polygon(0 100px, 100% 100px, 100% 8px, 0 8px); } 30.0% { clip-path: polygon(0 24px, 100% 24px, 100% 87px, 0 87px); } 35% { clip-path: polygon(0 39px, 100% 39px, 100% 16px, 0 16px); } 40% { clip-path: polygon(0 96px, 100% 96px, 100% 25px, 0 25px); } 45% { clip-path: polygon(0 16px, 100% 16px, 100% 100px, 0 100px); } 50% { clip-path: polygon(0 92px, 100% 92px, 100% 76px, 0 76px); } 55.0% { clip-path: polygon(0 29px, 100% 29px, 100% 40px, 0 40px); } 60.0% { clip-path: polygon(0 40px, 100% 40px, 100% 39px, 0 39px); } 65% { clip-path: polygon(0 94px, 100% 94px, 100% 44px, 0 44px); } 70% { clip-path: polygon(0 2px, 100% 2px, 100% 78px, 0 78px); } 75% { clip-path: polygon(0 86px, 100% 86px, 100% 50px, 0 50px); } 80% { clip-path: polygon(0 2px, 100% 2px, 100% 46px, 0 46px); } 85.0% { clip-path: polygon(0 41px, 100% 41px, 100% 71px, 0 71px); } 90% { clip-path: polygon(0 75px, 100% 75px, 100% 15px, 0 15px); } 95% { clip-path: polygon(0 41px, 100% 41px, 100% 8px, 0 8px); } 100% { clip-path: polygon(0 23px, 100% 23px, 100% 75px, 0 75px); } }";
	document.head.appendChild(engineStyle);

	// Слова команды: сначала значения по порядку, потом «имя значение» и галочки.
	function blockArgs(ctx, positional, keys, flags) {
		var args = ctx.args.slice();
		var result = {};

		positional.forEach(function (name) {
			if (args.length) {
				result[name] = args.shift();
			}
		});
		while (args.length) {
			var word = String(args.shift());

			if (flags.indexOf(word) !== -1) {
				result[word] = true;
			} else if (keys.indexOf(word) !== -1 && args.length) {
				result[word] = args.shift();
			}
		}
		return result;
	}

	var placeKeys = ['place', 'corner', 'x', 'y', 'border', 'color', 'glow'];

	// Внешний вид картинки или видео: рамка, свечение, место «на экране» —
	// от угла окна терминала, как кнопки на экране.
	function placeStyle(el, a) {
		var color = a.color || 'var(--sg-text, #00cc00)';
		var border = Number(a.border) || 0;
		var glow = Number(a.glow) || 0;

		if (border > 0) {
			el.style.border = border + 'px solid ' + color;
		}
		if (glow > 0) {
			el.style.boxShadow = '0 0 ' + glow + 'px ' + color + ', 0 0 ' + glow * 2 + 'px ' + color;
		}
		if (a.place === 'screen') {
			var corner = String(a.corner || 'tl');
			var right = corner === 'tr' || corner === 'br';
			var bottom = corner === 'bl' || corner === 'br';
			var halfW = 'var(--sg-win-width, 1050px) / 2';
			var halfH = 'var(--sg-win-height, 1050px) / 2';
			var offX = 'var(--sg-win-offset-x, 0px)';
			var offY = 'var(--sg-win-offset-y, 0px)';
			var x = (Number(a.x) || 0) + 'px';
			var y = (Number(a.y) || 0) + 'px';

			el.style.position = 'fixed';
			el.style[right ? 'right' : 'left'] = right
				? 'calc(50% - ' + halfW + ' - ' + offX + ' + ' + x + ')'
				: 'calc(50% - ' + halfW + ' + ' + offX + ' + ' + x + ')';
			el.style[bottom ? 'bottom' : 'top'] = bottom
				? 'calc(50% - ' + halfH + ' - ' + offY + ' + ' + y + ')'
				: 'calc(50% - ' + halfH + ' + ' + offY + ' + ' + y + ')';
		}
	}

	// Вывод блока: «по центру» — в отдельной строке по центру.
	function putPlaced(ctx, el, a, type) {
		if (preview) {
			// Для перетаскивания мышью в предпросмотре программы.
			el.setAttribute('data-sg-block', type);
			el.setAttribute('data-sg-src', ctx.source);
		}
		if (a.place === 'center') {
			var wrap = document.createElement('div');

			wrap.style.textAlign = 'center';
			wrap.appendChild(el);
			ctx.output.appendChild(wrap);
		} else {
			ctx.output.appendChild(el);
		}
	}

	// Кнопка или ссылка SugarCube с действием (та же разметка, что у <<button>>).
	function actionControl(output, label, asButton, action) {
		var name = asButton ? 'button' : 'link';
		var holder = document.createElement('span');

		$(holder).wiki('<<' + name + ' ' + JSON.stringify(String(label)) + '>><</' + name + '>>');

		// В режиме «Тестировать» SugarCube оборачивает кнопку в рамку отладки.
		var control = holder.querySelector(asButton ? 'button' : 'a');

		$(control).on('click', action);
		while (holder.firstChild) {
			output.appendChild(holder.firstChild);
		}
		return control;
	}

	function videoType(src) {
		var ext = String(src).split('.').pop().toLowerCase();

		return ext === 'webm' ? 'video/webm' : ext === 'ogv' || ext === 'ogg' ? 'video/ogg' : 'video/mp4';
	}

	Macro.add('sg-image', {
		handler: function () {
			var a = blockArgs(this, ['src'], ['width'].concat(placeKeys), []);
			var img = document.createElement('img');

			img.src = a.src || '';
			img.alt = '';
			if (Number(a.width) > 0) {
				img.style.width = Number(a.width) + 'px';
			}
			placeStyle(img, a);
			putPlaced(this, img, a, 'image');
		}
	});

	Macro.add('sg-video', {
		handler: function () {
			var a = blockArgs(
				this,
				['src'],
				['width', 'height'].concat(placeKeys),
				['autoplay', 'loop', 'muted', 'controls', 'buttons']
			);
			var video = document.createElement('video');
			var source = document.createElement('source');

			['controls', 'autoplay', 'loop', 'muted'].forEach(function (flag) {
				if (a[flag]) {
					video.setAttribute(flag, '');
					video[flag] = true;
				}
			});
			video.setAttribute('playsinline', '');
			if (Number(a.width) > 0) {
				video.setAttribute('width', Number(a.width));
			}
			if (Number(a.height) > 0) {
				video.setAttribute('height', Number(a.height));
			}
			source.src = a.src || '';
			source.type = videoType(a.src || '');
			video.appendChild(source);
			placeStyle(video, a);

			if (!a.buttons) {
				putPlaced(this, video, a, 'video');
				return;
			}

			// С кнопками «Воспроизвести» и «Остановить» — как в Videotest.
			var box = document.createDocumentFragment();

			box.appendChild(video);
			box.appendChild(document.createElement('br'));
			actionControl(box, 'Воспроизвести', true, function () {
				video.play().catch(function () {});
			});
			box.appendChild(document.createElement('br'));
			actionControl(box, 'Остановить', true, function () {
				video.pause();
			});
			if (preview) {
				video.setAttribute('data-sg-block', 'video');
				video.setAttribute('data-sg-src', this.source);
			}
			if (a.place === 'center') {
				var wrap = document.createElement('div');

				wrap.style.textAlign = 'center';
				wrap.appendChild(box);
				this.output.appendChild(wrap);
			} else {
				this.output.appendChild(box);
			}
		}
	});

	/* Кнопка на экране (сессия 6): содержимое стоит на месте от угла окна
	   терминала и не прокручивается с текстом; kind — вид кнопок и ссылок. */

	Macro.add('sg-place', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, [], ['kind', 'corner', 'x', 'y', 'hover', 'click'], []);
			var el = document.createElement('span');

			el.className = 'sg-place' + (a.kind ? ' ' + a.kind : '');
			// Шаг 2.2: свой звук наведения и нажатия (none — без звука).
			['hover', 'click'].forEach(function (which) {
				if (a[which] !== undefined) {
					el.setAttribute('data-sg-' + which, a[which] === 'none' ? '' : String(a[which]));
				}
			});
			placeStyle(el, {place: 'screen', corner: a.corner, x: a.x, y: a.y});
			if (preview) {
				el.setAttribute('data-sg-block', 'place');
				el.setAttribute('data-sg-src', this.source);
			}
			$(el).wiki(this.payload[0].contents);
			this.output.appendChild(el);
		}
	});

	/* ----- Таймеры (шаг 2.3) ----- */

	// Таймер именной и идёт в фоне: время окончания лежит в переменной
	// $sgTimers (попадает в автокопию), табло того же таймера можно поставить
	// на несколько экранов. По окончании — переход, окно-сообщение или звук.
	var timerDefaults = {"font":"media/fonts/DSEG7Classic-Regular.woff2","color":"#cc0000","bg":"#000000","size":125,"border":2,"glow":10};
	var timerFonts = {};
	var restoring = false;

	function timerStore() {
		var v = State.variables;

		if (!v.sgTimers || typeof v.sgTimers !== 'object') {
			v.sgTimers = {};
		}
		return v.sgTimers;
	}

	function timersChanged() {
		if (setup.signaly.saveTimers) {
			setup.signaly.saveTimers();
		}
	}

	function pad(n) {
		return n < 10 ? '0' + n : String(n);
	}

	function timerText(end, format) {
		var left = Math.max(0, Math.ceil((end - Date.now()) / 1000));

		if (format === 'hms') {
			return pad(Math.floor(left / 3600)) + ':' + pad(Math.floor(left / 60) % 60) + ':' + pad(left % 60);
		}
		return pad(Math.floor(left / 60)) + ':' + pad(left % 60);
	}

	// Шрифт табло — файл из папки игры (свой @font-face на каждый файл).
	function timerFont(file) {
		if (file === 'none') {
			return '';
		}
		if (!timerFonts[file]) {
			var family = 'sg-timer-font-' + (Object.keys(timerFonts).length + 1);
			var style = document.createElement('style');

			style.textContent =
				'@font-face { font-family: "' + family + '"; src: url(' + JSON.stringify(file) +
				'); font-weight: normal; font-style: normal; }';
			document.head.appendChild(style);
			timerFonts[file] = family;
		}
		return '"' + timerFonts[file] + '", monospace';
	}

	function timerEnded(name, t) {
		var store = timerStore();

		delete store[name];
		timersChanged();
		if (t.sound) {
			try {
				new Audio(t.sound).play().catch(function () {});
			} catch (e) {
				console.error('СИГНАЛЫ: звук таймера', e);
			}
		}
		if (t.passage || t.text || t.title) {
			setup.signaly.openDialog({title: t.title, passage: t.passage, text: t.text});
		}
		if (t.goto && Story.has(t.goto)) {
			Engine.play(t.goto);
		}
	}

	function tickTimers() {
		var store = State.variables && State.variables.sgTimers;

		if (!store || restoring || (Engine.isIdle && !Engine.isIdle())) {
			return;
		}
		$('.sg-timer[data-sg-timer]').each(function () {
			var t = store[this.getAttribute('data-sg-timer')];

			if (t) {
				this.firstChild.textContent = timerText(t.end, this.getAttribute('data-sg-format'));
			}
		});
		Object.keys(store).forEach(function (name) {
			var t = store[name];

			if (t && Date.now() >= t.end && State.variables.sgTimers === store && store[name] === t) {
				timerEnded(name, t);
			}
		});
	}

	setInterval(tickTimers, 250);

	Macro.add('sg-timer', {
		handler: function () {
			var a = blockArgs(
				this,
				['name'],
				['hours', 'minutes', 'seconds', 'start', 'goto', 'title', 'passage', 'text', 'sound',
					'font', 'color', 'bg', 'size', 'border', 'glow', 'format'],
				['hidden']
			);
			var name = String(a.name || State.passage);
			var store = timerStore();

			if (a.start !== 'running' && !(restoring && store[name])) {
				var total =
					(Number(a.hours) || 0) * 3600 + (Number(a.minutes) || 0) * 60 + (Number(a.seconds) || 0);
				var t = {end: Date.now() + total * 1000};

				['goto', 'title', 'passage', 'text', 'sound'].forEach(function (key) {
					if (a[key] !== undefined && a[key] !== '') {
						t[key] = String(a[key]);
					}
				});
				store[name] = t;
				timersChanged();
			}

			var running = store[name];

			// Табло не видно: скрытый таймер или таймер ещё не идёт.
			if (a.hidden || !running) {
				return;
			}

			var color = a.color || timerDefaults.color;
			var border = a.border === undefined ? timerDefaults.border : Number(a.border) || 0;
			var glow = a.glow === undefined ? timerDefaults.glow : Number(a.glow) || 0;
			var el = document.createElement('div');
			var text = document.createElement('span');
			var s = el.style;
			var font = timerFont(a.font === undefined ? timerDefaults.font : String(a.font));

			el.className = 'sg-timer';
			el.setAttribute('data-sg-timer', name);
			if (a.format === 'hms') {
				el.setAttribute('data-sg-format', 'hms');
			}
			if (font) {
				s.fontFamily = font;
			}
			s.fontSize = (a.size === undefined ? timerDefaults.size : Number(a.size) || 0) + 'px';
			s.color = color;
			s.backgroundColor = a.bg || timerDefaults.bg;
			if (border > 0) {
				s.border = border + 'px solid ' + color;
			}
			if (glow > 0) {
				s.boxShadow = '0 0 ' + glow + 'px ' + color + ', 0 0 ' + glow * 2 + 'px ' + color;
			}
			s.padding = '10px 20px';
			s.width = 'fit-content';
			s.margin = '20px auto';
			s.textAlign = 'center';
			s.display = 'flex';
			s.justifyContent = 'center';
			s.alignItems = 'center';
			text.textContent = timerText(running.end, a.format);
			el.appendChild(text);
			this.output.appendChild(el);
		}
	});

	// Действие ссылки или кнопки (шаг 3.2): остановить таймер по имени.
	// Запустить — тот же <<sg-timer … hidden>> внутри ссылки.
	Macro.add('sg-timer-stop', {
		handler: function () {
			var store = timerStore();
			var name = String(this.args.length ? this.args[0] : State.passage);

			if (store[name]) {
				delete store[name];
				timersChanged();
			}
		}
	});

	/* ----- Цепочка видео (шаг 2.3) ----- */

	// Шаги по порядку; следующий включает щелчок по видео, окончание видео или
	// N секунд. Все видео загружаются сразу — переход мгновенный (ответ 7А).
	Macro.add('sg-chain', {
		tags: ['sg-step'],
		handler: function () {
			var a = blockArgs(this, [], ['width', 'height', 'goto'].concat(placeKeys), []);
			var steps = this.payload.slice(1).map(function (part) {
				return blockArgs({args: part.args}, ['src'], ['next', 'seconds'], ['loop', 'muted']);
			});
			var box = document.createElement('span');
			var current = 0;
			var stepTimer = null;
			var done = false;
			var look = {border: a.border, glow: a.glow, color: a.color};

			box.className = 'sg-chain';

			var videos = steps.map(function (step, index) {
				var video = document.createElement('video');
				var source = document.createElement('source');

				['loop', 'muted'].forEach(function (flag) {
					if (step[flag]) {
						video.setAttribute(flag, '');
						video[flag] = true;
					}
				});
				if (index === 0) {
					video.setAttribute('autoplay', '');
					video.autoplay = true;
				} else {
					video.setAttribute('preload', 'auto');
					video.style.display = 'none';
				}
				if (Number(a.width) > 0) {
					video.setAttribute('width', Number(a.width));
				}
				if (Number(a.height) > 0) {
					video.setAttribute('height', Number(a.height));
				}
				source.src = step.src || '';
				source.type = videoType(step.src || '');
				video.appendChild(source);
				placeStyle(video, look);
				video.addEventListener('click', function () {
					if ((step.next || 'end') === 'click') {
						advance(index);
					}
				});
				video.addEventListener('ended', function () {
					if ((step.next || 'end') === 'end') {
						advance(index);
					}
				});
				box.appendChild(video);
				if (index > 0) {
					video.load();
				}
				return video;
			});

			function arm(index) {
				var step = steps[index];

				clearTimeout(stepTimer);
				if (step && step.next === 'time') {
					stepTimer = setTimeout(function () {
						advance(index);
					}, Math.max(0, Number(step.seconds) || 0) * 1000);
				}
			}

			function advance(index) {
				if (index !== current || done || !box.isConnected) {
					return;
				}
				clearTimeout(stepTimer);
				if (index + 1 < videos.length) {
					var old = videos[index];
					var next = videos[index + 1];

					old.pause();
					old.style.display = 'none';
					current = index + 1;
					next.style.display = '';
					next.currentTime = 0;
					next.play().catch(function () {});
					arm(current);
					return;
				}
				done = true;
				if (a.goto && Story.has(a.goto)) {
					Engine.play(a.goto);
				}
			}

			placeStyle(box, {place: a.place, corner: a.corner, x: a.x, y: a.y});
			putPlaced(this, box, a, 'chain');
			if (videos.length) {
				$(document).one(':passagedisplay', function () {
					arm(0);
				});
			}
		}
	});

	/* ----- Эффекты текста (шаг 2.1) ----- */

	// Экраны, которые уже показывали: при возврате <<type>> печатает сразу
	// весь текст (ответ 6А). Список попадает в автокопию.
	var seen = {};
	var seenNow = false;

	setup.signaly.seen = seen;
	$(document).on(':passagestart', function (ev) {
		seenNow = settings.typeSeen && !preview && seen[ev.passage.title] === true;
		skipAll = false;
	});
	$(document).on(':passagedisplay', function (ev) {
		seen[ev.passage.title] = true;
	});

	/* ----- Звуки наведения и нажатия (шаг 2.2) ----- */

	// Наборы — в блоке «СИГНАЛЫ: звуки наведения и нажатия» (setup.signalySounds).
	// У ссылки или кнопки звучит набор её вида (ближайший класс вида у неё или
	// вокруг неё), у вида без своего — набор вида «Обычный». Свой звук у элемента
	// — data-sg-hover / data-sg-click ("" — без звука). Из набора — случайный
	// файл; новый звук наведения прерывает предыдущий.
	var uiAudio = {};
	var hoverNow = null;
	var hoverTimer = null;

	function uiSoundOn() {
		return !preview || window.SIGNALY_UI_SOUND === true;
	}

	function uiAudioFor(file) {
		if (!uiAudio[file]) {
			var audio = new Audio(file);

			audio.preload = 'auto';
			audio.sgUi = true;
			uiAudio[file] = audio;
		}
		return uiAudio[file];
	}

	$(document).one(':passagestart', function () {
		var data = setup.signalySounds;

		if (data && data.sets) {
			data.sets.forEach(function (set) {
				(set.files || []).forEach(uiAudioFor);
			});
		}
	});

	function uiSet(el, which) {
		var data = setup.signalySounds;

		if (!data || !data.sets || !data.kinds) {
			return null;
		}

		var own = $(el).closest('[data-sg-' + which + ']');
		var name;

		if (own.length) {
			name = own.attr('data-sg-' + which);
		} else {
			for (var node = el; node && node.nodeType === 1 && name === undefined; node = node.parentNode) {
				for (var i = 0; i < node.classList.length; i++) {
					var kind = data.kinds[node.classList[i]];

					if (kind && kind[which] !== undefined) {
						name = kind[which];
						break;
					}
				}
			}
			if (name === undefined && data.kinds['']) {
				name = data.kinds[''][which];
			}
		}
		if (!name) {
			return null;
		}
		return (
			data.sets.filter(function (set) {
				return set.name === name;
			})[0] || null
		);
	}

	function playSet(set) {
		var files = set.files || [];
		var file = files[Math.floor(Math.random() * files.length)];

		if (!file) {
			return null;
		}

		var audio = uiAudioFor(file);

		audio.volume = Math.max(0, Math.min(1, (set.volume === undefined ? 100 : set.volume) / 100));
		audio.currentTime = 0;
		audio.play().catch(function () {});
		return audio;
	}

	function later(set, play) {
		if (set.delay > 0) {
			return setTimeout(play, set.delay);
		}
		play();
		return null;
	}

	$(document).on('mouseenter', 'a, button', function () {
		if (!uiSoundOn()) {
			return;
		}

		var set = uiSet(this, 'hover');

		clearTimeout(hoverTimer);
		if (hoverNow) {
			hoverNow.pause();
			hoverNow.currentTime = 0;
			hoverNow = null;
		}
		if (set) {
			hoverTimer = later(set, function () {
				hoverNow = playSet(set);
			});
		}
	});
	$(document).on('click', 'a, button', function () {
		var set = uiSoundOn() && uiSet(this, 'click');

		if (set) {
			later(set, function () {
				playSet(set);
			});
		}
	});

	/* ----- Порядок эффектов (сессия 7): «после эффектов выше» ----- */

	// Эффект со словом after (<<type 40ms after>>, <<timed 2s after>>) или span
	// с data-sg-after="1" ждёт, пока всё, что выше по тексту на этом экране,
	// допечатается, появится, сменится или включится, и только потом отсчитывает
	// свою задержку. waits — что ещё не закончилось, waiters — кто ждёт.
	var waits = [];
	var waiters = [];
	var checkTimer = null;

	$(document).on(':passageinit', function () {
		waits = [];
		waiters = [];
	});

	function takeWord(args, word) {
		var at = args.indexOf(word);

		if (at < 1) {
			return false;
		}
		args.splice(at, 1);
		return true;
	}

	function rootOf(node) {
		var el = node.nodeType === 1 ? node : node.parentNode;

		return el && el.closest ? el.closest('#ui-dialog-body, #passages') : null;
	}

	function busyBefore(node) {
		var root = rootOf(node);

		return waits.some(function (w) {
			if (w.node === node || !w.node.isConnected || rootOf(w.node) !== root || !w.pending()) {
				return false;
			}

			var pos = node.compareDocumentPosition(w.node);

			return (pos & Node.DOCUMENT_POSITION_PRECEDING) !== 0 && (pos & Node.DOCUMENT_POSITION_CONTAINS) === 0;
		});
	}

	function runWaiters() {
		checkTimer = null;
		waiters = waiters.filter(function (w) {
			return !w.started && w.node.isConnected;
		});
		waiters.sort(function (a, b) {
			return a.node.compareDocumentPosition(b.node) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
		});
		waiters.forEach(function (w) {
			if (!w.started && w.node.isConnected && !busyBefore(w.node)) {
				w.started = true;
				w.run();
			}
		});
	}

	function check() {
		if (waiters.length && checkTimer === null) {
			checkTimer = setTimeout(runWaiters, 0);
		}
	}

	$(document).on(':passageend :passagedisplay', check);
	setInterval(check, 500);

	function wait(node, run) {
		var waiter = {node: node, run: run, started: false};

		waiters.push(waiter);
		waits.push({
			node: node,
			pending: function () {
				return !waiter.started;
			}
		});
		check();
	}

	// Команда со словом after: на её месте — метка; когда подойдёт очередь,
	// команда выполняется в это место.
	function deferMacro(ctx, run, args) {
		var anchor = document.createComment('sg-after');

		ctx.output.appendChild(anchor);
		wait(anchor, function () {
			var holder = document.createElement('span');
			var parent = anchor.parentNode;

			parent.insertBefore(holder, anchor.nextSibling);
			run(
				Object.create(ctx, {
					_output: {value: holder},
					_debugView: {value: null, writable: true}
				}),
				args
			);
			while (holder.firstChild) {
				parent.insertBefore(holder.firstChild, holder);
			}
			parent.removeChild(holder);
		});
	}

	var typeMacro = Macro.get('type');

	if (typeMacro) {
		var typeHandler = typeMacro.handler;
		var runType = function (ctx, args) {
			var marker = document.createComment('sg-type');
			var was = ctx.self.typeId;

			ctx.output.appendChild(marker);

			var result = typeHandler.apply(ctx, args);
			var id = ctx.self.typeId;

			if (id !== was) {
				waits.push({
					node: marker,
					pending: function () {
						var queue = TempState.macroTypeQueue;

						return !!queue && queue.some(function (item) {
							return item.id === id;
						});
					}
				});
			} else if (marker.parentNode) {
				marker.parentNode.removeChild(marker);
			}
			return result;
		};

		typeMacro.handler = function () {
			var after = takeWord(this.args, 'after');

			if (seenNow && this.args.length) {
				this.args[0] = '0s';
			}
			return after ? deferMacro(this, runType, arguments) : runType(this, arguments);
		};
	}

	var timedMacro = Macro.get('timed');

	if (timedMacro) {
		var timedHandler = timedMacro.handler;
		var timedRegister = timedMacro.registerTimeout;
		var timedNow = null;

		// Появление закончилось — показан последний раздел (и прошла плавность).
		timedMacro.registerTimeout = function (callback, items) {
			var info = timedNow;
			var left = items.length;

			timedNow = null;
			if (!info) {
				return timedRegister.call(this, callback, items);
			}
			info.registered = true;
			return timedRegister.call(
				this,
				function () {
					var result = callback.apply(this, arguments);

					if (--left === 0) {
						setTimeout(function () {
							info.done = true;
							check();
						}, info.fade ? 450 : 0);
					}
					return result;
				},
				items
			);
		};

		var runTimed = function (ctx, args) {
			var info = {done: false, registered: false, fade: ctx.args.length > 1 && /^(?:transition|t8n)$/.test(ctx.args[1])};
			var out = ctx.output;
			var last = out.lastChild;
			var result;

			timedNow = info;
			try {
				result = timedHandler.apply(ctx, args);
			} finally {
				timedNow = null;
			}
			if (info.registered && out.lastChild && out.lastChild !== last) {
				waits.push({
					node: out.lastChild,
					pending: function () {
						return !info.done;
					}
				});
			}
			return result;
		};

		timedMacro.handler = function () {
			return takeWord(this.args, 'after') ? deferMacro(this, runTimed, arguments) : runTimed(this, arguments);
		};
	}

	// Глитч и мигание с началом: data-sg-start="2s" (через N с), data-sg-after="1"
	// (после эффектов выше). До начала — класс sg-off (обычный текст).
	function startSpans(root) {
		$(root)
			.find('[data-sg-start], [data-sg-after]')
			.addBack('[data-sg-start], [data-sg-after]')
			.each(function () {
				var el = this;

				if (el.sgOn !== undefined) {
					return;
				}
				el.sgOn = false;
				el.classList.add('sg-off');

				var go = function () {
					var delay = 0;

					try {
						delay = cssTimeToMS(el.getAttribute('data-sg-start') || '0s');
					} catch (e) {
						delay = 0;
					}
					setTimeout(function () {
						el.sgOn = true;
						el.classList.remove('sg-off');
						check();
					}, delay);
				};

				if (el.getAttribute('data-sg-after')) {
					wait(el, go);
				} else {
					go();
				}
				waits.push({
					node: el,
					pending: function () {
						return !el.sgOn;
					}
				});
			});
	}

	/* ----- Ссылки и глитч в печатающемся тексте (сессия 7) ----- */

	// Ссылка или кнопка внутри <<type>> нажимается, только когда допечатана
	// целиком (пока печатается — класс sg-type-wait). «Тени» глитча печатаются
	// вместе с текстом.
	var typingNow = [];

	function followed(el, wrap) {
		for (var node = el; node && node !== wrap; node = node.parentNode) {
			if (node.nextSibling) {
				return true;
			}
		}
		return false;
	}

	function typingAround(el) {
		return (
			typingNow.some(function (wrap) {
				return (wrap.contains(el) && !followed(el, wrap)) || el.contains(wrap);
			}) ||
			!!el.querySelector('.macro-type-target') ||
			$(el)
				.find('.macro-type:not(.macro-type-done)')
				.toArray()
				.some(function (wrap) {
					return wrap.textContent === '';
				})
		);
	}

	function syncTyping() {
		var waiting = [];

		typingNow.forEach(function (wrap) {
			$(wrap)
				.find('a, button')
				.each(function () {
					if (!followed(this, wrap)) {
						waiting.push(this);
					}
				});
		});
		$('.sg-type-wait').each(function () {
			if (waiting.indexOf(this) === -1) {
				this.classList.remove('sg-type-wait');
			}
		});
		waiting.forEach(function (el) {
			el.classList.add('sg-type-wait');
		});
		$('.glitchy').each(function () {
			var full = this.getAttribute('data-sg-text');

			if (typingAround(this)) {
				if (full === null) {
					full = this.getAttribute('data-text') || '';
					this.setAttribute('data-sg-text', full);
				}
				this.setAttribute('data-text', Array.from(full).slice(0, Array.from(this.textContent).length).join(''));
			} else if (full !== null) {
				this.setAttribute('data-text', full);
				this.removeAttribute('data-sg-text');
			}
		});
	}

	$(document).on(':typingstart', function (ev) {
		typingNow.push(ev.target);
		syncTyping();
	});
	$(document).on(':typingstop', function (ev) {
		setTimeout(function () {
			typingNow = typingNow.filter(function (wrap) {
				return wrap !== ev.target && wrap.isConnected;
			});
			syncTyping();
			check();
		}, 0);
	});
	$(document).on(':passageinit', function () {
		typingNow = [];
	});

	new MutationObserver(function (records) {
		records.forEach(function (record) {
			for (var i = 0; i < record.addedNodes.length; i++) {
				if (record.addedNodes[i].nodeType === 1) {
					startSpans(record.addedNodes[i]);
				}
			}
		});
		if (typingNow.length || document.querySelector('[data-sg-text], .glitchy .macro-type')) {
			syncTyping();
		}
	}).observe(document.body, {childList: true, subtree: true, characterData: true});

	// Щелчок мышью (не по ссылке, кнопке или полю) допечатывает текст сразу —
	// и всё, что на этом экране ещё будет печататься.
	var skipAll = false;

	function skipTyping() {
		setTimeout(function () {
			document.body.dispatchEvent(
				new KeyboardEvent('keydown', {key: Config.macros.typeSkipKey, bubbles: true})
			);
		}, 0);
	}

	$(document).on(':typingstart', function () {
		if (skipAll) {
			skipTyping();
		}
	});
	if (settings.typeClick) {
		document.addEventListener(
			'click',
			function (ev) {
				if (
					!document.querySelector('.macro-type:not(.macro-type-done):not(.macro-type-target)') ||
					$(ev.target).closest('a, button, input, textarea, select, label, #ui-dialog').length
				) {
					return;
				}
				skipAll = true;
				skipTyping();
			},
			true
		);
	}

	/* Экран тревоги: поверх всего экрана, закрывается щелчком, через N секунд
	   или только мастером (Shift+Z+X закрывает любой). */

	var alarmSounds = [];

	function stopAlarmSound(sound) {
		if (sound) {
			sound.pause();
			alarmSounds = alarmSounds.filter(function (s) {
				return s !== sound;
			});
		}
	}

	$(document).on(':passagestart', function () {
		alarmSounds.slice().forEach(stopAlarmSound);
	});

	function closeAlarm(el) {
		if (!el || !el.parentNode || el.getAttribute('data-sg-closed')) {
			return;
		}
		el.setAttribute('data-sg-closed', '1');
		stopAlarmSound(el.sgSound);
		el.parentNode.removeChild(el);

		var target = el.getAttribute('data-sg-goto');

		if (target && Story.has(target)) {
			Engine.play(target);
		}
	}

	setup.signaly.closeAlarm = function () {
		var all = document.querySelectorAll('.sg-alarm');

		closeAlarm(all[all.length - 1]);
	};

	Macro.add('sg-alarm', {
		tags: null,
		handler: function () {
			var a = blockArgs(
				this,
				[],
				['bg', 'color', 'size', 'blink', 'sound', 'volume', 'close', 'seconds', 'goto'],
				['loop']
			);
			var el = document.createElement('div');
			var s = el.style;

			el.className = 'sg-alarm';
			s.position = 'fixed';
			s.top = '0';
			s.left = '0';
			s.width = '100%';
			s.height = '100%';
			s.backgroundColor = a.bg || '#cc0000';
			s.color = a.color || '#000000';
			s.display = 'flex';
			s.justifyContent = 'center';
			s.alignItems = 'center';
			s.fontSize = (Number(a.size) || 70) + 'px';
			s.zIndex = '1002';
			if (Number(a.blink) > 0) {
				s.animation = 'sg-alarm-blink ' + Number(a.blink) + 's steps(1, end) infinite';
			}
			if (a.goto) {
				el.setAttribute('data-sg-goto', a.goto);
			}
			$(el).wiki(this.payload[0].contents);
			this.output.appendChild(el);

			if (a.sound) {
				try {
					var sound = new Audio(a.sound);

					sound.loop = !!a.loop;
					sound.volume = Math.max(0, Math.min(1, (a.volume === undefined ? 100 : Number(a.volume)) / 100));
					sound.play().catch(function () {});
					el.sgSound = sound;
					alarmSounds.push(sound);
				} catch (e) {
					console.error('СИГНАЛЫ: звук тревоги', e);
				}
			}
			if (a.close === 'click') {
				el.style.cursor = 'pointer';
				el.addEventListener('click', function () {
					closeAlarm(el);
				});
			} else if (a.close === 'time') {
				setTimeout(function () {
					closeAlarm(el);
				}, Math.max(0, Number(a.seconds) || 5) * 1000);
			}
		}
	});

	/* Окно-сообщение: заголовок, текст или пассаж; закрывается крестиком,
	   только кнопкой «Принято» или само через N секунд. */

	var dialogTurn = 0;

	document.addEventListener(
		'click',
		function (ev) {
			// Пока окно закрывается только кнопкой, щелчок мимо окна его не закрывает.
			if (
				document.documentElement.getAttribute('data-sg-dialog') === 'noclose' &&
				ev.target &&
				ev.target.id === 'ui-overlay'
			) {
				ev.stopPropagation();
				ev.preventDefault();
			}
		},
		true
	);

	function trimContent(text) {
		return String(text || '').replace(/^[ \t]*\n/, '').replace(/\n\s*$/, '');
	}

	setup.signaly.openDialog = function (o) {
		var turn = ++dialogTurn;
		var html = document.documentElement;

		Dialog.create(o.title || '');
		if (o.passage) {
			Dialog.wikiPassage(o.passage);
		} else {
			Dialog.wiki(o.text || '');
		}
		if (o.close === 'ok') {
			html.setAttribute('data-sg-dialog', 'noclose');
			var box = $('<div class="sg-dialog-ok"></div>').appendTo(Dialog.body());

			$('<button type="button" class="ui-close"></button>')
				.text(o.ok || 'Принято')
				.appendTo(box);
		}
		Dialog.open(null, function () {
			if (turn === dialogTurn) {
				html.removeAttribute('data-sg-dialog');
			}
		});
		if (o.close === 'time') {
			setTimeout(function () {
				if (turn === dialogTurn && Dialog.isOpen()) {
					Dialog.close();
				}
			}, Math.max(0, Number(o.seconds) || 5) * 1000);
		}
	};

	Macro.add('sg-dialog', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, ['label'], ['title', 'passage', 'close', 'seconds', 'ok'], ['button']);
			var text = trimContent(this.payload[0].contents);

			actionControl(this.output, a.label === undefined ? '' : a.label, !!a.button, function () {
				setup.signaly.openDialog({
					title: a.title,
					passage: a.passage,
					text: text,
					close: a.close,
					seconds: a.seconds,
					ok: a.ok
				});
			});
		}
	});

	// Действие ссылки или кнопки (шаг 3.2): открыть окно-сообщение —
	// <<sg-open "Заголовок" passage "Пассаж" close ok|time ok "Принято" seconds 5>>текст<</sg-open>>.
	Macro.add('sg-open', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, ['title'], ['passage', 'close', 'seconds', 'ok'], []);

			setup.signaly.openDialog({
				title: a.title,
				passage: a.passage,
				text: trimContent(this.payload[0].contents),
				close: a.close,
				seconds: a.seconds,
				ok: a.ok
			});
		}
	});

	/* Поле кода: таблица «код → действие» прямо в команде. */

	function codeAction(o, code) {
		State.temporary.code = code;
		if (o.sound) {
			try {
				new Audio(o.sound).play().catch(function () {});
			} catch (e) {
				console.error('СИГНАЛЫ: звук поля кода', e);
			}
		}
		if (o.passage || o.text || o.title) {
			setup.signaly.openDialog(o);
		}
		if (o.goto && Story.has(o.goto)) {
			Engine.play(o.goto);
		}
	}

	Macro.add('sg-code', {
		tags: ['sg-case', 'sg-wrong'],
		handler: function () {
			var a = blockArgs(this, [], ['var', 'button', 'gap'], ['password', 'focus', 'clear']);
			var cases = [];
			var wrong = null;

			this.payload.slice(1).forEach(function (part) {
				var isCase = part.name === 'sg-case';
				var o = blockArgs(
					{args: part.args},
					isCase ? ['code'] : [],
					['goto', 'title', 'passage', 'sound'],
					[]
				);

				o.text = trimContent(part.contents);
				if (isCase) {
					cases.push(o);
				} else {
					wrong = o;
				}
			});

			var input = document.createElement('input');
			var varName = a['var'] ? String(a['var']).replace(/^\$/, '') : '';

			input.type = a.password ? 'password' : 'text';
			input.className = 'sg-code';
			input.setAttribute('tabindex', '0');
			if (varName) {
				var start = State.variables[varName];

				input.value = start === undefined || start === null ? '' : String(start);
				input.addEventListener('input', function () {
					State.variables[varName] = input.value;
				});
			}

			function confirm() {
				var value = input.value;
				var found = null;

				cases.forEach(function (c) {
					if (!found && String(c.code) === value) {
						found = c;
					}
				});
				if (a.clear) {
					input.value = '';
					if (varName) {
						State.variables[varName] = '';
					}
				}
				if (found) {
					codeAction(found, value);
				} else if (wrong) {
					codeAction(wrong, value);
				}
			}

			input.addEventListener('keydown', function (ev) {
				if (ev.key === 'Enter') {
					ev.preventDefault();
					confirm();
				}
			});
			this.output.appendChild(input);

			if (a.button) {
				var gap = a.gap === undefined ? 1 : Math.max(0, Number(a.gap) || 0);

				if (gap === 0) {
					this.output.appendChild(document.createTextNode(' '));
				}
				for (var i = 0; i < gap; i++) {
					this.output.appendChild(document.createElement('br'));
				}
				actionControl(this.output, a.button, true, confirm);
			}
			if (a.focus) {
				$(document).one(':passagedisplay', function () {
					input.focus();
				});
			}
		}
	});

	/* Окно KR2 (экран с тегом kr2): текст и навигация, картинка, статусы.
	   Если в JavaScript истории остался свой код KR2 — движок его не трогает. */

	$(document).one(':passageinit', function () {
		if (Macro.has('kr2image') || Macro.has('kr2vars') || Macro.has('kr2main')) {
			return;
		}

		var kr2 = null;

		function reset() {
			kr2 = {image: '', vars: null, main: null, cols: null, rows: null};
		}

		function render(contents) {
			var tmp = $('<div style="display:none"></div>').appendTo(document.body);
			var frag = document.createDocumentFragment();

			tmp.wiki(contents);
			while (tmp[0].firstChild) {
				frag.appendChild(tmp[0].firstChild);
			}
			tmp.remove();
			return frag;
		}

		reset();

		Macro.add('kr2image', {
			handler: function () {
				kr2.image = this.args[0] || '';
			}
		});
		Macro.add('kr2layout', {
			handler: function () {
				kr2.cols = Number(this.args[0]) || null;
				kr2.rows = Number(this.args[1]) || null;
			}
		});
		Macro.add('kr2vars', {
			tags: null,
			handler: function () {
				kr2.vars = render(this.payload[0].contents);
			}
		});
		Macro.add('kr2main', {
			tags: null,
			handler: function () {
				kr2.main = render(this.payload[0].contents);
			}
		});

		$(document).on(':passagestart', function () {
			reset();
			$('#kr2-overlay').remove();
		});

		$(document).on(':passageend', function () {
			var passage = Story.get(State.passage);
			var $passages = $('#passages');

			if (!passage.tags.includes('kr2')) {
				$passages.removeClass('kr2-layout').css({gridTemplateColumns: '', gridTemplateRows: ''});
				return;
			}

			$passages.addClass('kr2-layout').css({
				gridTemplateColumns: kr2.cols ? kr2.cols + '% ' + (100 - kr2.cols) + '%' : '',
				gridTemplateRows: kr2.rows ? kr2.rows + '% ' + (100 - kr2.rows) + '%' : ''
			});

			var $passageEl = $passages.find('.passage');
			var $main = $('<div id="kr2-main"></div>');
			var $nav = $('<div id="kr2-nav"></div>');
			var $vars = $('<div id="kr2-vars"></div>');
			var $img = $('<div id="kr2-image"></div>');
			var image = kr2.image;

			if (kr2.vars) {
				$vars.append(kr2.vars);
			}
			$passageEl.find('a, button').each(function () {
				$nav.append(this);
			});
			if (kr2.main) {
				$main.append(kr2.main);
			} else {
				$passageEl.find('p').each(function () {
					if ($(this).text().trim() === '' && $(this).children().length === 0) {
						$(this).remove();
					}
				});
				$main.append($passageEl.contents());
			}
			if (image) {
				$('<img>').attr('src', image).attr('alt', '').appendTo($img);
			}

			// Щелчок по картинке — во весь терминал; ещё щелчок — обратно.
			$img.on('click', function () {
				if ($('#kr2-overlay').length) {
					$('#kr2-overlay').remove();
					return;
				}
				if (!image) {
					return;
				}

				var $overlay = $('<div id="kr2-overlay"></div>');

				$('<img>').attr('src', image).attr('alt', '').appendTo($overlay);
				$overlay.on('click', function () {
					$(this).remove();
				});
				$passages.append($overlay);
			});

			$passageEl.empty().append($main, $nav, $img, $vars);
		});
	});

	if (preview) {
		// Всегда с выбранного экрана, а не с того, что был в прошлый раз.
		State.reset();
		if (preview === 'start') {
			LoadScreen.lock();
			showStartScreen(function () {});
		}
		return;
	}

	/* ----- Полный экран и звук запуска ----- */

	function requestFullscreen() {
		var root = document.documentElement;

		if (document.fullscreenElement || !root.requestFullscreen) {
			return;
		}
		root.requestFullscreen().catch(function () {});
	}

	function playStartSound() {
		if (!settings.startSound) {
			return;
		}
		try {
			var sound = new Audio(settings.startSound);

			sound.volume = Math.max(0, Math.min(1, settings.startVolume));
			sound.play().catch(function () {});
		} catch (e) {
			console.error('СИГНАЛЫ: звук запуска', e);
		}
	}

	/* ----- Защита экрана ----- */

	if (settings.noContextMenu) {
		document.addEventListener('contextmenu', function (ev) {
			ev.preventDefault();
		});
	}

	if (settings.noZoom) {
		document.addEventListener(
			'wheel',
			function (ev) {
				if (ev.ctrlKey) {
					ev.preventDefault();
				}
			},
			{passive: false}
		);
	}

	if (settings.hideCursorAfter > 0) {
		var cursorTimer = null;
		var showCursor = function () {
			document.documentElement.classList.remove('sg-cursor-hidden');
			clearTimeout(cursorTimer);
			cursorTimer = setTimeout(function () {
				document.documentElement.classList.add('sg-cursor-hidden');
			}, settings.hideCursorAfter * 1000);
		};

		document.addEventListener('mousemove', showCursor);
		document.addEventListener('mousedown', showCursor);
		showCursor();
	}

	/* ----- Автокопия прогресса ----- */

	// В режиме «Тестировать» автокопии нет: проверка всегда начинается заново.
	var autocopyOn = Config.debug !== true;
	var fileName = decodeURIComponent(location.pathname.split('/').pop() || 'index.html');
	// У каждого файла игры своя автокопия.
	var storageKey = 'СИГНАЛЫ/автокопия/' + Story.ifId + '/' + fileName;
	var serial = typeof Serial !== 'undefined' ? Serial : JSON;
	var record = null;
	var stopped = false;
	var started = false;
	var navCount = 0;

	function readCopy() {
		try {
			var raw = localStorage.getItem(storageKey);

			return raw ? JSON.parse(raw) : null;
		} catch (e) {
			return null;
		}
	}

	function writeCopy() {
		if (!autocopyOn || stopped || !record) {
			return;
		}
		try {
			localStorage.setItem(storageKey, JSON.stringify(record));
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия не записана', e);
		}
	}

	function saveEntry() {
		// Состояние на входе в экран — как его запоминает сам SugarCube.
		record = {
			v: 1,
			passage: State.passage,
			vars: serial.stringify(State.variables),
			seen: Object.keys(seen).concat(State.passage),
			time: Date.now()
		};
		writeCopy();
	}

	function afterAction() {
		var turn = navCount;

		setTimeout(function () {
			// Если действие сменило экран, копию уже записал вход в экран.
			if (turn !== navCount || !record) {
				return;
			}
			record.vars = serial.stringify(State.variables);
			record.time = Date.now();
			writeCopy();
		}, 50);
	}

	function startAutocopy() {
		// Шаг 2.3: таймеры меняются не только при переходе — пишем их отдельно.
		setup.signaly.saveTimers = function () {
			if (!record) {
				return;
			}
			try {
				record.timers = JSON.parse(JSON.stringify(State.variables.sgTimers || {}));
			} catch (e) {
				record.timers = {};
			}
			writeCopy();
		};
		$(document).on(':passageinit', function () {
			navCount++;
		});
		$(document).on(':passagestart', saveEntry);
		document.addEventListener('click', afterAction, true);
		document.addEventListener('change', afterAction, true);
		document.addEventListener(
			'keyup',
			function (ev) {
				if (ev.key === 'Enter') {
					afterAction();
				}
			},
			true
		);
	}

	function prepareRestore(copy) {
		// Сеанс вкладки забываем — продолжаем по автокопии.
		State.reset();
		Config.passages.start = copy.passage;
		(copy.seen || []).forEach(function (title) {
			seen[title] = true;
		});
		$(document).one(':passageinit', function () {
			var variables = State.variables;

			Object.keys(variables).forEach(function (name) {
				delete variables[name];
			});
			try {
				Object.assign(variables, serial.parse(copy.vars));
			} catch (e) {
				console.error('СИГНАЛЫ: переменные не восстановлены', e);
			}
			// Таймеры — как были в момент сбоя: идущий таймер не начинается
			// заново, а продолжает по времени окончания.
			if (copy.timers) {
				variables.sgTimers = copy.timers;
			}
			restoring = true;
		});
		$(document).one(':passagedisplay', function () {
			restoring = false;
		});
	}

	/* ----- Новая игра: Shift+Z+N ----- */

	function newGame() {
		stopped = true;
		try {
			localStorage.removeItem(storageKey);
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия не стёрта', e);
		}
		Engine.restart();
	}

	function askNewGame() {
		if (!started) {
			return;
		}
		Dialog.create('Новая игра');

		var body = $(Dialog.body());

		$('<p></p>').text('Начать новую игру? Текущий прогресс будет стёрт.').appendTo(body);
		$('<button type="button" class="sg-new-game-yes"></button>')
			.text('Да')
			.on('click', newGame)
			.appendTo(body);
		body.append(' ');
		$('<button type="button" class="sg-new-game-no"></button>')
			.text('Нет')
			.on('click', function () {
				Dialog.close();
			})
			.appendTo(body);
		Dialog.open();
	}

	var zDown = false;

	document.addEventListener('keydown', function (ev) {
		if (ev.code === 'KeyZ') {
			zDown = true;
		}
		if (zDown && ev.shiftKey && ev.code === 'KeyN') {
			ev.preventDefault();
			askNewGame();
		}
		// Shift+Z+X — мастер закрывает экран тревоги.
		if (zDown && ev.shiftKey && ev.code === 'KeyX') {
			ev.preventDefault();
			setup.signaly.closeAlarm();
		}
	});
	document.addEventListener('keyup', function (ev) {
		if (ev.code === 'KeyZ') {
			zDown = false;
		}
	});
	window.addEventListener('blur', function () {
		zDown = false;
	});

	/* ----- Стартовый экран ----- */

	// SugarCube ждёт, пока экран загрузки не будет отпущен, — до клика игра не
	// запускается, и звуки первого экрана не теряются.
	var lockId = LoadScreen.lock();

	showStartScreen(function (screen) {
		if (started) {
			return;
		}
		started = true;
		requestFullscreen();
		playStartSound();
		screen.parentNode.removeChild(screen);

		try {
			var copy = autocopyOn ? readCopy() : null;

			if (copy && copy.passage && Story.has(copy.passage)) {
				prepareRestore(copy);
			}
			if (autocopyOn) {
				startAutocopy();
			}
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия', e);
		}

		LoadScreen.unlock(lockId);
	});
})();
/* ===== СИГНАЛЫ: конец движка терминала ===== */


/* ===== Горячие клавиши мастера ===== */
(function() {
    var zPressed = false;


      // Переменные для громкости звуков (диапазон от 0.0 до 1.0)
    var soundAVolume = 1.0; // Громкость для Shift + Z + A (100%)
    var soundBVolume = 1.0; // Громкость для Shift + Z + C (100%)

    // Предварительная загрузка звуков для комбинаций клавиш
    var soundA = new Audio("media/audio/msgsoundA.wav");
    soundA.preload = "auto";
    var soundB = new Audio("media/audio/click3.wav");
    soundB.preload = "auto";
      var soundC = new Audio("media/audio/radiovinyl.wav");
    soundC.preload = "auto";



      document.addEventListener('keydown', function(event) {
        if (event.key.toLowerCase() === 'z') {
            zPressed = true;
        }
        if (event.shiftKey && zPressed) {
            switch (event.key.toLowerCase()) {
                case 'a':
                    Dialog.create("Мастерское сообщение");
                    Dialog.wikiPassage("showPSGinfo");
                    Dialog.open();
                    // Воспроизведение звука для Shift + Z + A
soundA.volume = soundAVolume;
soundA.currentTime = 0;
soundA.play().catch(function(error) {
console.error("Ошибка", error);
                    });
                    break;


                case 'b':
                    Engine.play("gotoPSG");
// Воспроизведение звука для Shift + Z + B
soundB.volume = soundBVolume;
soundB.currentTime = 0;
soundB.play().catch(function(error) {
console.error("Ошибка", error);
});
                    break;

case 'c':
soundC.play().catch(function(error) {
console.error("Ошибка", error);
});
break;
            }
        }
    });

    document.addEventListener('keyup', function(event) {
        if (event.key.toLowerCase() === 'z') {
            zPressed = false;
        }
    });
})();


/* ===== Цвета кнопок и ссылок =====
   СИГНАЛЫ: цвет задаётся в самом пассаже, а не поиском по надписи:
   <span class="amber">…ссылки…</span> — янтарные,
   <span class="red-big">…</span> — красные большие,
   <span class="yellow-small">…</span> — жёлтые маленькие.
   Стили — в таблице стилей. */


/* СИГНАЛЫ: звуки наведения и нажатия перенесены в наборы (окно «Звуки», вид «Обычный», шаг 2.2). */


UIBar.destroy();

/* СИГНАЛЫ: таймер экрана Clocks перенесён в блок «Таймер» (шаг 2.3). */


/* hovertip v2.0 - Старт*/
window.UpdateHoverTipTxt = function (container) {
	if (Engine.isIdle()) {
		clearInterval(HTTIntervalID);
		if (container === undefined) {
			container = $(document);
		} else {
			container = $(container);
		}
		var i, id, top, left, parent, elementList, element, hoverPos, boxPos, zindex;
		elementList = container.find('span[id^="hoverTipTxt"]');
		for (i = 0; i < elementList.length; i++) {
			element = $(elementList[i]);
			id = elementList[i].id.substring(11);
			/* Найдите родительский элемент подсказки при наведении курсора мыши на страницу. */
			parent = $(container).find("#hoverTip" + (id));
			/* Расположите нижнюю часть hoverTipTxt чуть выше родительского элемента. */
			top = Math.round(-element.outerHeight() - 6);
			/* Центрируйте hoverTipTxt горизонтально над родительским текстом. */
			left = Math.round((parent.outerWidth() - element.outerWidth()) / 2);
			/* Посмотрите, содержится ли подсказка при наведении курсора мыши в чем-то с более высоким z-индексом. */
			zindex = element.css("z-index");
			if (zindex === "auto") {
				zindex = 0;
			} else {
				zindex = parseInt(zindex, 10);
			}
			while (parent.parent()[0] !== document) {
				if ((parent.parent().css("z-index") !== "auto") && (parseInt(parent.parent().css("z-index"), 10) > zindex)) {
					/* Получить прямоугольник контейнера. */
					boxPos = parent[0].getBoundingClientRect();
					break;
				}
				parent = parent.parent();
			}
			/* Обновить позицию. */
			element.css({ top: top, left: left });
			hoverPos = element[0].getBoundingClientRect();
			/* Убедитесь, что текст не выходит за пределы нижней части экрана. */
			if (hoverPos.top > window.innerHeight - hoverPos.height - 10) {
				top -= hoverPos.top - (window.innerHeight - hoverPos.height - 10);
			}
			/* Убедитесь, что текст не выходит за пределы верхней части экрана. */
			if (hoverPos.top < 4) {
				top -= hoverPos.top - 4;
			}
			/* Убедитесь, что текст находится не за пределами правой части экрана. */
			if (hoverPos.left > window.innerWidth - hoverPos.width - 26) {
				left -= hoverPos.left - (window.innerWidth - hoverPos.width - 26);
			}
			/* Убедитесь, что текст находится не за пределами левой части экрана. */
			if (hoverPos.left < 4) {
				left -= hoverPos.left - 4;
			}
			/* Обновить позицию. */
			element.css({ top: Math.round(top), left: Math.round(left) });
			hoverPos = element[0].getBoundingClientRect();
			if (boxPos) {  /* Вписывается в диалоговые окна и тому подобное. */
				/* Убедитесь, что текст не выходит за пределы нижней части поля. */
				if (hoverPos.top > boxPos.bottom - hoverPos.height - 10) {
					top -= hoverPos.top - (boxPos.bottom - hoverPos.height - 10);
				}
				/* Убедитесь, что текст не выходит за пределы верхней части поля. */
				if (hoverPos.top < boxPos.top + 4) {
					top -= hoverPos.top - (boxPos.top + 4);
				}
				/* Убедитесь, что текст не выходит за пределы правого поля. */
				if (hoverPos.left > boxPos.right - hoverPos.width - 26) {
					left -= hoverPos.left - (boxPos.right - hoverPos.width - 26);
				}
				/* Убедитесь, что текст не выходит за пределы левого поля. */
				if (hoverPos.left < boxPos.left + 4) {
					left -= hoverPos.left - boxPos.left - 4;
				}
				/* Обновить позицию. */
				element.css({ top: Math.round(top), left: Math.round(left) });
			}
		}
	} else {
		clearInterval(HTTIntervalID);
		HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
	}
};
/*  Ожидает, пока отрывок будет полностью отрисован, прежде чем что-либо делать.  */
var HTTIntervalID = 0;
$(document).on(":passageend", function (ev) {
	UpdateHoverTipTxt();
});
$(window).on("resize scroll", function (ev) {
	clearInterval(HTTIntervalID);
	HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
});
$("#ui-bar-toggle").on("click", function (ev) {
	clearInterval(HTTIntervalID);
	HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
});
/* <<hovertip>> макрос*/
Macro.add("hovertip", {
	tags	 : null,
	handler  : function () {
		if (this.args.length > 0) {
			var mw = "";
			if ((this.args.length > 1) && (!isNaN(parseInt(this.args[1], 10)))) {
				mw = ' style="max-width: ' + parseInt(this.args[1], 10) + 'px;"';
			}
			if (State.temporary.HoverTipCount == undefined) {
				State.temporary.HoverTipCount = 1;
			} else {
				State.temporary.HoverTipCount++;
			}
			while ($("#hoverTip" + State.temporary.HoverTipCount).length) {
				/* Найден существующий hoverTip. */
				State.temporary.HoverTipCount++;
			}
			var output = '<span id="hoverTip' + State.temporary.HoverTipCount +
					'" class="hoverTipTxt hoverTip" tabindex="0" ' +
					'onmouseenter="UpdateHoverTipTxt();">' +
					this.payload[0].contents + '<span id="hoverTipTxt' +
					State.temporary.HoverTipCount + '" class="hoverBox hoverTail"' +
					mw + '>' + this.args[0] + '</span></span>';
			$(this.output).wiki(output);
		} else {
			$(this.output).wiki(this.payload[0].contents);
		}
	}
});
/* hovertip v2.0 - Конец*/




/* ===== Камера и захват окна ===== */
setup.webcamStream = null;

setup.initWebcam = function () {
    if (setup.webcamStream) return Promise.resolve(setup.webcamStream);

    return navigator.mediaDevices.getUserMedia({ video: true, audio: false })
        .then(function(stream) {
            setup.webcamStream = stream;
            return stream;
        })
        .catch(function(err) {
            console.log("Ошибка доступа к камере:", err);
        });
};


setup.xiaomiStream = null;
setup.initXiaomi = function () {
    if (setup.xiaomiStream) return Promise.resolve(setup.xiaomiStream);
    return navigator.mediaDevices.getDisplayMedia({
        video: true,
        audio: false
    })
        .then(function(stream) {
            setup.xiaomiStream = stream;
            // Если захват остановлен — следующее нажатие кнопки запросит его заново
            stream.getVideoTracks().forEach(function (track) {
                track.addEventListener('ended', function () {
                    setup.xiaomiStream = null;
                });
            });
            return stream;
        })
        .catch(function(err) {
            console.log("Ошибка захвата экрана:", err);
        });
};






/* СИГНАЛЫ: код окна KR2 перенесён в движок терминала (шаг 1.4). */


:: StoryStylesheet [stylesheet]
/* ===== СИГНАЛЫ: оформление терминала — не редактировать вручную ===== */
/* Меняется в окне «Оформление терминала» программы «Twine СИГНАЛЫ».
   В своих стилях можно брать эти значения: var(--sg-text), var(--sg-font-size) и т. д. */
/* СИГНАЛЫ-настройки: {"v":1,"pageBg":"#000000","textColor":"#00cc00","font":"Courier New","fontFile":"","fontSize":25,"winWidth":1050,"winHeight":1050,"winPadding":20,"winOffsetX":0,"winOffsetY":0,"winBg":"#000000","borderWidth":2,"borderColor":"#00cc00","glowColor":"#00cc00","glowSize":10,"flicker":true,"flickerPeriod":0.1,"flickerDepth":5,"vignette":0,"noise":0,"noSelect":false,"noContextMenu":false,"noZoom":false,"hideCursor":0,"lineScroll":false,"startText":"Нажмите, чтобы запустить систему","startSound":"","startVolume":100,"savedColors":["#00cc00","#ffbf00","#cc0000","#cccc00","#cc00cc","#000000"],"dialogOn":true,"dialogBg":"#000000","dialogColor":"#00cc00","dialogSize":25,"dialogBorderColor":"#00cc00","dialogBorderWidth":2,"dialogGlow":10,"dialogTitleBg":"#000000","dialogTitleColor":"#00cc00","dialogTitleSize":25,"dialogTitleLine":1,"typeClick":true,"typeSeen":true,"glitchColor":"#00cc00","glitchBg":"#111111","glitchShadow1":"#0000ff","glitchShadow2":"#ff0000","glitchShift":5,"glitchSpeed":2} */
:root {
	--sg-page-bg: #000000;
	--sg-text: #00cc00;
	--sg-font: "Courier New", monospace;
	--sg-font-size: 25px;
	--sg-win-bg: #000000;
	--sg-win-width: 1050px;
	--sg-win-height: 1050px;
	--sg-win-padding: 20px;
	--sg-win-offset-x: 0px;
	--sg-win-offset-y: 0px;
	--sg-border-width: 2px;
	--sg-border-color: #00cc00;
	--sg-glow-color: #00cc00;
	--sg-glow-size: 10px;
	--sg-start-text: "Нажмите, чтобы запустить систему";
	--sg-start-sound: "";
	--sg-start-volume: 1;
	--sg-protect-menu: 0;
	--sg-protect-zoom: 0;
	--sg-hide-cursor: 0;
	--sg-line-scroll: 0;
	--sg-type-click: 1;
	--sg-type-seen: 1;
}
body {
	background-color: var(--sg-page-bg);
	color: var(--sg-text);
	font-family: var(--sg-font);
	font-size: var(--sg-font-size);
	margin: 0;
	height: 100vh;
	display: flex;
	justify-content: center;
	align-items: center;
	position: relative;
}
#passages {
	background-color: var(--sg-win-bg);
	border: var(--sg-border-width) solid var(--sg-border-color);
	box-shadow: 0 0 var(--sg-glow-size) var(--sg-glow-color), 0 0 calc(var(--sg-glow-size) * 2) var(--sg-glow-color);
	width: var(--sg-win-width);
	height: var(--sg-win-height);
	padding: var(--sg-win-padding);
	box-sizing: border-box;
	overflow: auto;
	animation: sg-flicker 0.1s infinite;
}
@keyframes sg-flicker {
	0% { opacity: 1; }
	50% { opacity: 0.95; }
	100% { opacity: 1; }
}
html.sg-cursor-hidden, html.sg-cursor-hidden * { cursor: none !important; }
#sg-fx {
	position: fixed;
	pointer-events: none;
	z-index: 1000;
	overflow: hidden;
}
#sg-start {
	position: fixed;
	inset: 0;
	z-index: 2147483647;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 1em;
	box-sizing: border-box;
	background-color: var(--sg-page-bg);
	color: var(--sg-text);
	font-family: var(--sg-font);
	font-size: var(--sg-font-size);
	text-align: center;
	cursor: pointer;
	user-select: none;
}
#sg-start::after {
	content: var(--sg-start-text);
	animation: sg-blink 1.2s steps(1, end) infinite;
}
@keyframes sg-blink {
	50% { opacity: 0; }
}
#ui-dialog {
	background-color: #000000;
	border: 2px solid #00cc00;
	box-shadow: 0 0 10px #00cc00, 0 0 20px #00cc00;
	color: #00cc00;
	font-size: 25px;
}
#ui-dialog-titlebar {
	background-color: #000000;
	color: #00cc00;
	border-bottom: 1px solid #00cc00;
	font-size: 25px;
}
#ui-dialog-close {
	color: #00cc00;
}
#ui-dialog-body {
	background-color: #000000;
	border: none;
	color: #00cc00;
	font-size: 25px;
}
html .glitchy { color: #00cc00; position: relative; }
html .glitchy::before { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -9px; text-shadow: 1px 0 #0000ff; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-2 3s infinite linear alternate-reverse; }
html .glitchy::after { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -5px; text-shadow: -1px 0 #ff0000; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-1 2s infinite linear alternate-reverse; }
@keyframes sg-glitch-1 { 0% { clip-path: polygon(0 80px, 100% 80px, 100% 16px, 0 16px); } 5% { clip-path: polygon(0 94px, 100% 94px, 100% 17px, 0 17px); } 10% { clip-path: polygon(0 9px, 100% 9px, 100% 92px, 0 92px); } 15.0% { clip-path: polygon(0 37px, 100% 37px, 100% 4px, 0 4px); } 20% { clip-path: polygon(0 53px, 100% 53px, 100% 47px, 0 47px); } 25% { clip-path: polygon(0 99px, 100% 99px, 100% 69px, 0 69px); } 30.0% { clip-path: polygon(0 15px, 100% 15px, 100% 49px, 0 49px); } 35% { clip-path: polygon(0 83px, 100% 83px, 100% 81px, 0 81px); } 40% { clip-path: polygon(0 55px, 100% 55px, 100% 43px, 0 43px); } 45% { clip-path: polygon(0 28px, 100% 28px, 100% 27px, 0 27px); } 50% { clip-path: polygon(0 64px, 100% 64px, 100% 28px, 0 28px); } 55.0% { clip-path: polygon(0 76px, 100% 76px, 100% 91px, 0 91px); } 60.0% { clip-path: polygon(0 29px, 100% 29px, 100% 72px, 0 72px); } 65% { clip-path: polygon(0 70px, 100% 70px, 100% 10px, 0 10px); } 70% { clip-path: polygon(0 5px, 100% 5px, 100% 84px, 0 84px); } 75% { clip-path: polygon(0 46px, 100% 46px, 100% 81px, 0 81px); } 80% { clip-path: polygon(0 7px, 100% 7px, 100% 85px, 0 85px); } 85.0% { clip-path: polygon(0 17px, 100% 17px, 100% 89px, 0 89px); } 90% { clip-path: polygon(0 41px, 100% 41px, 100% 59px, 0 59px); } 95% { clip-path: polygon(0 53px, 100% 53px, 100% 90px, 0 90px); } 100% { clip-path: polygon(0 10px, 100% 10px, 100% 30px, 0 30px); } }
@keyframes sg-glitch-2 { 0% { clip-path: polygon(0 84px, 100% 84px, 100% 3px, 0 3px); } 5% { clip-path: polygon(0 31px, 100% 31px, 100% 69px, 0 69px); } 10% { clip-path: polygon(0 37px, 100% 37px, 100% 33px, 0 33px); } 15.0% { clip-path: polygon(0 18px, 100% 18px, 100% 6px, 0 6px); } 20% { clip-path: polygon(0 25px, 100% 25px, 100% 87px, 0 87px); } 25% { clip-path: polygon(0 100px, 100% 100px, 100% 8px, 0 8px); } 30.0% { clip-path: polygon(0 24px, 100% 24px, 100% 87px, 0 87px); } 35% { clip-path: polygon(0 39px, 100% 39px, 100% 16px, 0 16px); } 40% { clip-path: polygon(0 96px, 100% 96px, 100% 25px, 0 25px); } 45% { clip-path: polygon(0 16px, 100% 16px, 100% 100px, 0 100px); } 50% { clip-path: polygon(0 92px, 100% 92px, 100% 76px, 0 76px); } 55.0% { clip-path: polygon(0 29px, 100% 29px, 100% 40px, 0 40px); } 60.0% { clip-path: polygon(0 40px, 100% 40px, 100% 39px, 0 39px); } 65% { clip-path: polygon(0 94px, 100% 94px, 100% 44px, 0 44px); } 70% { clip-path: polygon(0 2px, 100% 2px, 100% 78px, 0 78px); } 75% { clip-path: polygon(0 86px, 100% 86px, 100% 50px, 0 50px); } 80% { clip-path: polygon(0 2px, 100% 2px, 100% 46px, 0 46px); } 85.0% { clip-path: polygon(0 41px, 100% 41px, 100% 71px, 0 71px); } 90% { clip-path: polygon(0 75px, 100% 75px, 100% 15px, 0 15px); } 95% { clip-path: polygon(0 41px, 100% 41px, 100% 8px, 0 8px); } 100% { clip-path: polygon(0 23px, 100% 23px, 100% 75px, 0 75px); } }
/* ===== СИГНАЛЫ: конец оформления терминала ===== */

/* ===== СИГНАЛЫ: виды кнопок и ссылок — не редактировать вручную ===== */
