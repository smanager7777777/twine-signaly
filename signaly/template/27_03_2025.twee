/* hovertip v2.0 - Старт */
.hoverTip {
	display: inline-block;
	top: 4px;
	border-width: 0px;
    border-bottom: 2px dotted #00cc00;  /* Если вы хотите, чтобы под зависающим текстом были точки */
}
.hoverTipTxt {
	position: relative;
	vertical-align: text-bottom;
	line-height: initial;
}
.hoverTipTxt .hoverBox {
	position: absolute;
	visibility: hidden;
}
.hoverTipTxt:hover .hoverBox, .hoverTipTxt:focus .hoverBox {
	visibility: visible;
}
.hoverBox {
	padding: 3px 10px;
	width: intrinsic;  /* Safari/WebKit использует нестандартное имя */
	width: -webkit-max-content;  /* Chrome */
	width: -moz-max-content;  /* Firefox/Gecko */
	width: max-content;
	max-width: 333px;
	line-height: initial;
	text-align: left;
	color: #00cc00;
	background-color: black;
	border: #00cc00 solid 2px;
	-webkit-border-radius: 6px;
	   -moz-border-radius: 6px;
	        border-radius: 6px;
	-webkit-box-shadow: 0px 0px 12px 2px rgba(0, 0, 0, 0.75);
	   -moz-box-shadow: 0px 0px 12px 2px rgba(0, 0, 0, 0.75);
	        box-shadow: 0px 0px 12px 2px rgba(0, 0, 0, 0.75);
	z-index: 100;
}
.hoverTail::after {
	content: "";
	position: absolute;
	top: 100%;  /* В нижней части всплывающей подсказки */
	left: 50%;
	margin-left: -5px;
	border-width: 8px;
	border-style: solid;
	border-color: #00cc00 transparent transparent transparent;
	z-index: 100;
}
.hoverBox a {
	-webkit-transition-duration: unset;
	   -moz-transition-duration: unset;
	     -o-transition-duration: unset;
	        transition-duration: unset;
}
#ui-bar .hoverBox {
	max-width: 230px;
}
/* hovertip v2.0 - Конец*/






/* ===== KR2 INTERFACE ===== */

#passages.kr2-layout {
    display: grid;
    grid-template-columns: 65% 35%;
    grid-template-rows: 65% 35%;
    padding: 0;
    gap: 0;
    overflow: hidden;
    position: relative;
}

#passages.kr2-layout .passage {
    display: contents;
}

#kr2-main {
    grid-column: 1;
    grid-row: 1;
    overflow-y: auto;
    padding: 15px;
    border-right: 2px solid #00cc00;
    border-bottom: 2px solid #00cc00;
    box-sizing: border-box;
}

#kr2-nav {
    grid-column: 1;
    grid-row: 2;
    overflow-y: auto;
    padding: 15px;
    border-right: 2px solid #00cc00;
    box-sizing: border-box;
}

/* Каждая ссылка навигации — с новой строки */
#kr2-nav a,
#kr2-nav button {
    display: block;
    margin-bottom: 6px;
}

#kr2-image {
    grid-column: 2;
    grid-row: 1;
    overflow: hidden;
    position: relative;
    border-bottom: 2px solid #00cc00;
    box-sizing: border-box;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
}

/* Картинка в нормальном режиме */
#kr2-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
}

/* СИГНАЛЫ: правила #kr2-image.expanded удалены — картинка разворачивается через #kr2-overlay (ниже) */

#kr2-vars {
    grid-column: 2;
    grid-row: 2;
    overflow-y: auto;
    padding: 10px;
    box-sizing: border-box;
    font-size: 0.8em;
    color: #00aa00;
}

#kr2-main::-webkit-scrollbar,
#kr2-nav::-webkit-scrollbar,
#kr2-vars::-webkit-scrollbar {
    width: 6px;
}
#kr2-main::-webkit-scrollbar-track,
#kr2-nav::-webkit-scrollbar-track,
#kr2-vars::-webkit-scrollbar-track {
    background: #000;
}
#kr2-main::-webkit-scrollbar-thumb,
#kr2-nav::-webkit-scrollbar-thumb,
#kr2-vars::-webkit-scrollbar-thumb {
    background: #00cc00;
}

/* ===== END KR2 INTERFACE ===== */


#kr2-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-sizing: border-box;
}

#kr2-overlay img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}
