:: Хактест {"position":"700,125","size":"100,100"}
\<<set $attemptsLeft = 3>> /* Количество попыток */
\<<set $wordList = ["ЧЕХИЯ", "ХУЙНЯ", "ПАРИЯ", "СОННЯ", "КУХНЯ"]>> /* Список слов */
\<<set $correctPassword = "ПАРИЯ">> /* Правильный пароль */
\<<set $usedAttempts = []>> /* Использованные попытки */
\<<set $likenessDisplay = "">> /* Отображение совпадений */
\<<set $rows = 10>> /* Количество строк */
\<<set $charsPerRow = 60>> /* Символов в строке */
\
\<<script>>
// Генерация случайного фона как массива символов
function generateBackground(rows, cols, chars) {
    return Array(rows).fill().map(() => Array(cols).fill().map(() => chars[Math.floor(Math.random() * chars.length)]));
}

// Подсчёт совпадений
function getLikeness(guess, correct) {
    return `${[...guess].filter((c, i) => c === correct[i]).length}/${guess.length} ВЕРНО`;
}

// Инициализация терминала
$(document).one(':passagedisplay', function() {
    const $display = $("#terminalDisplay");
    const $attempts = $("#attemptsLeft");
    const $likeness = $("#likenessDisplay");
    const chars = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789";

    // Генерация фона
    const background = generateBackground(State.variables.rows, State.variables.charsPerRow, chars);
    const wordPositions = [];

    // Расстановка слов с проверкой пересечений
    State.variables.wordList.forEach(word => {
        let attempts = 0;
        while (attempts < 10) {
            const row = Math.floor(Math.random() * State.variables.rows);
            const col = Math.floor(Math.random() * (State.variables.charsPerRow - word.length + 1));
            if (!wordPositions.some(p => p.row === row && p.col <= col + word.length && p.col + p.word.length >= col)) {
                wordPositions.push({ row, col, word });
                // СИГНАЛЫ: слово занимает столько же клеток, сколько в нём букв, — строки остаются ровными
                background[row].splice(col, word.length, `<span class="word" data-word="${word}" style="cursor: pointer;">${word}</span>`, ...Array(word.length - 1).fill(""));
                break;
            }
            attempts++;
        }
    });

    // Формирование отображаемого текста
    $display.html(background.map(row => `<div>${row.join("")}</div>`).join(""));
    $attempts.text(`Осталось попыток: ${State.variables.attemptsLeft}`);
    $likeness.text(State.variables.likenessDisplay || "");

    // Обработка клика с точным выбором слова
    $display.on("click", ".word", function(e) {
        if (State.variables.attemptsLeft <= 0) return;

        const $wordSpan = $(e.target).closest(".word");
        const guess = $wordSpan.data("word");
        State.variables.usedAttempts.push(guess);
        State.variables.attemptsLeft--;

        if (guess === State.variables.correctPassword) {
            $display.text("Доступ разрешён!\nПароль: " + State.variables.correctPassword);
            $attempts.text("Взлом завершён успешно!");
            $likeness.text("");
            setTimeout(() => Engine.play("Start"), 1000);
        } else {
            State.variables.likenessDisplay = getLikeness(guess, State.variables.correctPassword);
            $attempts.text(`Осталось попыток: ${State.variables.attemptsLeft}`);
            $likeness.text(State.variables.likenessDisplay);

            if (State.variables.attemptsLeft <= 0) {
                $display.text("Доступ запрещён!\nТерминал заблокирован.");
                $likeness.text("");
                setTimeout(() => Engine.play("Blocktest"), 1000);
            }
        }
    });
});
<</script>>
\
\<div id="terminalWindow">
    \<div id="terminalDisplay"></div>
    \<div id="likenessDisplay"></div>
    \<div id="attemptsLeft"></div>
\</div>
\Текст под таймером


:: StoryScript [script]
/* ===== СИГНАЛЫ: движок терминала — не редактировать вручную ===== */
/* Версия движка: 1. Обновляется программой «Twine СИГНАЛЫ».
   Настройки — в окне «Оформление терминала» (они лежат в таблице стилей).
   Свой код пишите ниже конца этого блока. */
(function () {
	'use strict';

	// История в один шаг: «назад» в браузере не откатывает игру.
	Config.history.maxStates = 1;

	var rootStyle = getComputedStyle(document.documentElement);

	function opt(name, fallback) {
		var raw = rootStyle.getPropertyValue('--sg-' + name).trim();

		if (raw === '') {
			return fallback;
		}
		if (raw.charAt(0) === '"') {
			try {
				return JSON.parse(raw);
			} catch (e) {
				return fallback;
			}
		}

		var number = Number(raw);

		return isNaN(number) ? raw : number;
	}

	var settings = {
		startSound: opt('start-sound', ''),
		startVolume: opt('start-volume', 1),
		noContextMenu: opt('protect-menu', 0) === 1,
		noZoom: opt('protect-zoom', 0) === 1,
		hideCursorAfter: opt('hide-cursor', 0)
	};

	// Предпросмотр в программе: без стартового экрана, автокопии и защиты.
	var preview = window.SIGNALY_PREVIEW;

	setup.signaly = {engine: 1, preview: !!preview};

	function showStartScreen(onClick) {
		var screen = document.createElement('div');

		screen.id = 'sg-start';
		document.body.appendChild(screen);
		screen.addEventListener('click', function () {
			onClick(screen);
		});
		return screen;
	}

	if (preview) {
		if (preview === 'start') {
			LoadScreen.lock();
			showStartScreen(function () {});
		}
		return;
	}

	/* ----- Полный экран и звук запуска ----- */

	function requestFullscreen() {
		var root = document.documentElement;

		if (document.fullscreenElement || !root.requestFullscreen) {
			return;
		}
		root.requestFullscreen().catch(function () {});
	}

	function playStartSound() {
		if (!settings.startSound) {
			return;
		}
		try {
			var sound = new Audio(settings.startSound);

			sound.volume = Math.max(0, Math.min(1, settings.startVolume));
			sound.play().catch(function () {});
		} catch (e) {
			console.error('СИГНАЛЫ: звук запуска', e);
		}
	}

	/* ----- Защита экрана ----- */

	if (settings.noContextMenu) {
		document.addEventListener('contextmenu', function (ev) {
			ev.preventDefault();
		});
	}

	if (settings.noZoom) {
		window.addEventListener(
			'wheel',
			function (ev) {
				if (ev.ctrlKey) {
					ev.preventDefault();
				}
			},
			{passive: false}
		);
	}

	if (settings.hideCursorAfter > 0) {
		var cursorTimer = null;
		var showCursor = function () {
			document.documentElement.classList.remove('sg-cursor-hidden');
			clearTimeout(cursorTimer);
			cursorTimer = setTimeout(function () {
				document.documentElement.classList.add('sg-cursor-hidden');
			}, settings.hideCursorAfter * 1000);
		};

		document.addEventListener('mousemove', showCursor);
		document.addEventListener('mousedown', showCursor);
		showCursor();
	}

	/* ----- Автокопия прогресса ----- */

	// В режиме «Тестировать» автокопии нет: проверка всегда начинается заново.
	var autocopyOn = Config.debug !== true;
	var fileName = decodeURIComponent(location.pathname.split('/').pop() || 'index.html');
	// У каждого файла игры своя автокопия.
	var storageKey = 'СИГНАЛЫ/автокопия/' + Story.ifId + '/' + fileName;
	var serial = typeof Serial !== 'undefined' ? Serial : JSON;
	var record = null;
	var stopped = false;
	var started = false;
	var navCount = 0;

	function readCopy() {
		try {
			var raw = localStorage.getItem(storageKey);

			return raw ? JSON.parse(raw) : null;
		} catch (e) {
			return null;
		}
	}

	function writeCopy() {
		if (!autocopyOn || stopped || !record) {
			return;
		}
		try {
			localStorage.setItem(storageKey, JSON.stringify(record));
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия не записана', e);
		}
	}

	function saveEntry() {
		// Состояние на входе в экран — как его запоминает сам SugarCube.
		record = {
			v: 1,
			passage: State.passage,
			vars: serial.stringify(State.variables),
			time: Date.now()
		};
		writeCopy();
	}

	function afterAction() {
		var turn = navCount;

		setTimeout(function () {
			// Если действие сменило экран, копию уже записал вход в экран.
			if (turn !== navCount || !record) {
				return;
			}
			record.vars = serial.stringify(State.variables);
			record.time = Date.now();
			writeCopy();
		}, 50);
	}

	function startAutocopy() {
		$(document).on(':passageinit', function () {
			navCount++;
		});
		$(document).on(':passagestart', saveEntry);
		document.addEventListener('click', afterAction, true);
		document.addEventListener('change', afterAction, true);
		document.addEventListener(
			'keyup',
			function (ev) {
				if (ev.key === 'Enter') {
					afterAction();
				}
			},
			true
		);
	}

	function prepareRestore(copy) {
		// Сеанс вкладки забываем — продолжаем по автокопии.
		State.reset();
		Config.passages.start = copy.passage;
		$(document).one(':passageinit', function () {
			var variables = State.variables;

			Object.keys(variables).forEach(function (name) {
				delete variables[name];
			});
			try {
				Object.assign(variables, serial.parse(copy.vars));
			} catch (e) {
				console.error('СИГНАЛЫ: переменные не восстановлены', e);
			}
		});
	}

	/* ----- Новая игра: Shift+Z+N ----- */

	function newGame() {
		stopped = true;
		try {
			localStorage.removeItem(storageKey);
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия не стёрта', e);
		}
		Engine.restart();
	}

	function askNewGame() {
		if (!started) {
			return;
		}
		Dialog.create('Новая игра');

		var body = $(Dialog.body());

		$('<p></p>').text('Начать новую игру? Текущий прогресс будет стёрт.').appendTo(body);
		$('<button type="button" class="sg-new-game-yes"></button>')
			.text('Да')
			.on('click', newGame)
			.appendTo(body);
		body.append(' ');
		$('<button type="button" class="sg-new-game-no"></button>')
			.text('Нет')
			.on('click', function () {
				Dialog.close();
			})
			.appendTo(body);
		Dialog.open();
	}

	var zDown = false;

	document.addEventListener('keydown', function (ev) {
		if (ev.code === 'KeyZ') {
			zDown = true;
		}
		if (zDown && ev.shiftKey && ev.code === 'KeyN') {
			ev.preventDefault();
			askNewGame();
		}
	});
	document.addEventListener('keyup', function (ev) {
		if (ev.code === 'KeyZ') {
			zDown = false;
		}
	});
	window.addEventListener('blur', function () {
		zDown = false;
	});

	/* ----- Стартовый экран ----- */

	// SugarCube ждёт, пока экран загрузки не будет отпущен, — до клика игра не
	// запускается, и звуки первого экрана не теряются.
	var lockId = LoadScreen.lock();

	showStartScreen(function (screen) {
		if (started) {
			return;
		}
		started = true;
		requestFullscreen();
		playStartSound();
		screen.parentNode.removeChild(screen);

		try {
			var copy = autocopyOn ? readCopy() : null;

			if (copy && copy.passage && Story.has(copy.passage)) {
				prepareRestore(copy);
			}
			if (autocopyOn) {
				startAutocopy();
			}
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия', e);
		}

		LoadScreen.unlock(lockId);
	});
})();
/* ===== СИГНАЛЫ: конец движка терминала ===== */


/* ===== Горячие клавиши мастера ===== */
(function() {
    var zPressed = false;


      // Переменные для громкости звуков (диапазон от 0.0 до 1.0)
    var soundAVolume = 1.0; // Громкость для Shift + Z + A (100%)
    var soundBVolume = 1.0; // Громкость для Shift + Z + C (100%)

    // Предварительная загрузка звуков для комбинаций клавиш
    var soundA = new Audio("media/audio/msgsoundA.wav");
    soundA.preload = "auto";
    var soundB = new Audio("media/audio/click3.wav");
    soundB.preload = "auto";
      var soundC = new Audio("media/audio/radiovinyl.wav");
    soundC.preload = "auto";



      document.addEventListener('keydown', function(event) {
        if (event.key.toLowerCase() === 'z') {
            zPressed = true;
        }
        if (event.shiftKey && zPressed) {
            switch (event.key.toLowerCase()) {
                case 'a':
                    Dialog.create("Мастерское сообщение");
                    Dialog.wikiPassage("showPSGinfo");
                    Dialog.open();
                    // Воспроизведение звука для Shift + Z + A
soundA.volume = soundAVolume;
soundA.currentTime = 0;
soundA.play().catch(function(error) {
console.error("Ошибка", error);
                    });
                    break;


                case 'b':
                    Engine.play("gotoPSG");
// Воспроизведение звука для Shift + Z + B
soundB.volume = soundBVolume;
soundB.currentTime = 0;
soundB.play().catch(function(error) {
console.error("Ошибка", error);
});
                    break;

case 'c':
soundC.play().catch(function(error) {
console.error("Ошибка", error);
});
break;
            }
        }
    });

    document.addEventListener('keyup', function(event) {
        if (event.key.toLowerCase() === 'z') {
            zPressed = false;
        }
    });
})();


/* ===== Цвета кнопок и ссылок =====
   СИГНАЛЫ: цвет задаётся в самом пассаже, а не поиском по надписи:
   <span class="amber">…ссылки…</span> — янтарные,
   <span class="red-big">…</span> — красные большие,
   <span class="yellow-small">…</span> — жёлтые маленькие.
   Стили — в таблице стилей. */


/* ===== Звуки наведения и нажатия на ссылки и кнопки ===== */
(function () {
    var volume = 0.05;

    function preload(files) {
        return files.map(function (file) {
            var audio = new Audio("media/audio/" + file);
            audio.preload = "auto";
            return audio;
        });
    }

    // Массив звуков для наведения
    var hoverSounds = preload([
        "hover1.wav",
        "hover2.wav",
        "hover3.wav",
        "hover4.wav",
        "hover5.wav",
        "hover6.wav"
    ]);

    // Массив звуков для клика по ссылкам
    var clickSounds = preload([
        "click1.wav",
        "click2.wav",
        "click3.wav"
    ]);

    var currentHoverSound = null;

    function playRandom(sounds) {
        var audio = sounds[Math.floor(Math.random() * sounds.length)];
        audio.volume = volume;
        audio.currentTime = 0;
        audio.play().catch(function(error) {
            console.error("Ошибка", error);
        });
        return audio;
    }

    $(document).on('mouseenter', 'a, button', function() {
        // Новый звук наведения прерывает предыдущий
        if (currentHoverSound) {
            currentHoverSound.pause();
            currentHoverSound.currentTime = 0;
        }
        currentHoverSound = playRandom(hoverSounds);
    });

    $(document).on('click', 'a, button', function() {
        playRandom(clickSounds);
    });
})();


UIBar.destroy();


/* ===== Таймер (экран Clocks) =====
   СИГНАЛЫ: таймер идёт в фоне по времени окончания $timerEnd.
   Когда время вышло — переход на Start, где бы ни были игроки. */
setup.timerText = function () {
    var left = Math.max(0, Math.ceil(((State.variables.timerEnd || 0) - Date.now()) / 1000));
    return ('0' + Math.floor(left / 60)).slice(-2) + ':' + ('0' + (left % 60)).slice(-2);
};

setInterval(function () {
    var v = State.variables;
    if (v.timerstarted !== 1 || !v.timerEnd) {
        return;
    }
    $('#countdown').text(setup.timerText());
    if (Date.now() >= v.timerEnd) {
        v.timerstarted = 0;
        v.timerEnd = 0;
        Engine.play("Start");
    }
}, 250);


/* hovertip v2.0 - Старт*/
window.UpdateHoverTipTxt = function (container) {
	if (Engine.isIdle()) {
		clearInterval(HTTIntervalID);
		if (container === undefined) {
			container = $(document);
		} else {
			container = $(container);
		}
		var i, id, top, left, parent, elementList, element, hoverPos, boxPos, zindex;
		elementList = container.find('span[id^="hoverTipTxt"]');
		for (i = 0; i < elementList.length; i++) {
			element = $(elementList[i]);
			id = elementList[i].id.substring(11);
			/* Найдите родительский элемент подсказки при наведении курсора мыши на страницу. */
			parent = $(container).find("#hoverTip" + (id));
			/* Расположите нижнюю часть hoverTipTxt чуть выше родительского элемента. */
			top = Math.round(-element.outerHeight() - 6);
			/* Центрируйте hoverTipTxt горизонтально над родительским текстом. */
			left = Math.round((parent.outerWidth() - element.outerWidth()) / 2);
			/* Посмотрите, содержится ли подсказка при наведении курсора мыши в чем-то с более высоким z-индексом. */
			zindex = element.css("z-index");
			if (zindex === "auto") {
				zindex = 0;
			} else {
				zindex = parseInt(zindex, 10);
			}
			while (parent.parent()[0] !== document) {
				if ((parent.parent().css("z-index") !== "auto") && (parseInt(parent.parent().css("z-index"), 10) > zindex)) {
					/* Получить прямоугольник контейнера. */
					boxPos = parent[0].getBoundingClientRect();
					break;
				}
				parent = parent.parent();
			}
			/* Обновить позицию. */
			element.css({ top: top, left: left });
			hoverPos = element[0].getBoundingClientRect();
			/* Убедитесь, что текст не выходит за пределы нижней части экрана. */
			if (hoverPos.top > window.innerHeight - hoverPos.height - 10) {
				top -= hoverPos.top - (window.innerHeight - hoverPos.height - 10);
			}
			/* Убедитесь, что текст не выходит за пределы верхней части экрана. */
			if (hoverPos.top < 4) {
				top -= hoverPos.top - 4;
			}
			/* Убедитесь, что текст находится не за пределами правой части экрана. */
			if (hoverPos.left > window.innerWidth - hoverPos.width - 26) {
				left -= hoverPos.left - (window.innerWidth - hoverPos.width - 26);
			}
			/* Убедитесь, что текст находится не за пределами левой части экрана. */
			if (hoverPos.left < 4) {
				left -= hoverPos.left - 4;
			}
			/* Обновить позицию. */
			element.css({ top: Math.round(top), left: Math.round(left) });
			hoverPos = element[0].getBoundingClientRect();
			if (boxPos) {  /* Вписывается в диалоговые окна и тому подобное. */
				/* Убедитесь, что текст не выходит за пределы нижней части поля. */
				if (hoverPos.top > boxPos.bottom - hoverPos.height - 10) {
					top -= hoverPos.top - (boxPos.bottom - hoverPos.height - 10);
				}
				/* Убедитесь, что текст не выходит за пределы верхней части поля. */
				if (hoverPos.top < boxPos.top + 4) {
					top -= hoverPos.top - (boxPos.top + 4);
				}
				/* Убедитесь, что текст не выходит за пределы правого поля. */
				if (hoverPos.left > boxPos.right - hoverPos.width - 26) {
					left -= hoverPos.left - (boxPos.right - hoverPos.width - 26);
				}
				/* Убедитесь, что текст не выходит за пределы левого поля. */
				if (hoverPos.left < boxPos.left + 4) {
					left -= hoverPos.left - boxPos.left - 4;
				}
				/* Обновить позицию. */
				element.css({ top: Math.round(top), left: Math.round(left) });
			}
		}
	} else {
		clearInterval(HTTIntervalID);
		HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
	}
};
/*  Ожидает, пока отрывок будет полностью отрисован, прежде чем что-либо делать.  */
var HTTIntervalID = 0;
$(document).on(":passageend", function (ev) {
	UpdateHoverTipTxt();
});
$(window).on("resize scroll", function (ev) {
	clearInterval(HTTIntervalID);
	HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
});
$("#ui-bar-toggle").on("click", function (ev) {
	clearInterval(HTTIntervalID);
	HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
});
/* <<hovertip>> макрос*/
Macro.add("hovertip", {
	tags	 : null,
	handler  : function () {
		if (this.args.length > 0) {
			var mw = "";
			if ((this.args.length > 1) && (!isNaN(parseInt(this.args[1], 10)))) {
				mw = ' style="max-width: ' + parseInt(this.args[1], 10) + 'px;"';
			}
			if (State.temporary.HoverTipCount == undefined) {
				State.temporary.HoverTipCount = 1;
			} else {
				State.temporary.HoverTipCount++;
			}
			while ($("#hoverTip" + State.temporary.HoverTipCount).length) {
				/* Найден существующий hoverTip. */
				State.temporary.HoverTipCount++;
			}
			var output = '<span id="hoverTip' + State.temporary.HoverTipCount +
					'" class="hoverTipTxt hoverTip" tabindex="0" ' +
					'onmouseenter="UpdateHoverTipTxt();">' +
					this.payload[0].contents + '<span id="hoverTipTxt' +
					State.temporary.HoverTipCount + '" class="hoverBox hoverTail"' +
					mw + '>' + this.args[0] + '</span></span>';
			$(this.output).wiki(output);
		} else {
			$(this.output).wiki(this.payload[0].contents);
		}
	}
});
/* hovertip v2.0 - Конец*/




/* ===== Камера и захват окна ===== */
setup.webcamStream = null;

setup.initWebcam = function () {
    if (setup.webcamStream) return Promise.resolve(setup.webcamStream);

    return navigator.mediaDevices.getUserMedia({ video: true, audio: false })
        .then(function(stream) {
            setup.webcamStream = stream;
            return stream;
        })
        .catch(function(err) {
            console.log("Ошибка доступа к камере:", err);
        });
};


setup.xiaomiStream = null;
setup.initXiaomi = function () {
    if (setup.xiaomiStream) return Promise.resolve(setup.xiaomiStream);
    return navigator.mediaDevices.getDisplayMedia({
        video: true,
        audio: false
    })
        .then(function(stream) {
            setup.xiaomiStream = stream;
            // Если захват остановлен — следующее нажатие кнопки запросит его заново
            stream.getVideoTracks().forEach(function (track) {
                track.addEventListener('ended', function () {
                    setup.xiaomiStream = null;
                });
            });
            return stream;
        })
        .catch(function(err) {
            console.log("Ошибка захвата экрана:", err);
        });
};






/* ===== KR2 INTERFACE ===== */
(function() {

    var kr2Data = { imageUrl: '', varsHTML: '', mainHTML: null };

    Macro.add('kr2image', {
        handler: function() {
            kr2Data.imageUrl = this.args[0] || '';
        }
    });

    Macro.add('kr2vars', {
        tags: null,
        handler: function() {
            var $tmp = $('<div style="display:none">').appendTo(document.body);
            $tmp.wiki(this.payload[0].contents);
            kr2Data.varsHTML = $tmp.html();
            $tmp.remove();
        }
    });

    Macro.add('kr2main', {
        tags: null,
        handler: function() {
            var $tmp = $('<div style="display:none">').appendTo(document.body);
            $tmp.wiki(this.payload[0].contents);
            kr2Data.mainHTML = $tmp.html();
            $tmp.remove();
        }
    });

    $(document).on(':passagestart', function() {
        kr2Data = { imageUrl: '', varsHTML: '', mainHTML: null };
        // Убираем оверлей при переходе между пассажами
        $('#kr2-overlay').remove();
    });

    $(document).on(':passageend', function() {
        var passage = Story.get(State.passage);

        if (!passage.tags.includes('kr2')) {
            $('#passages').removeClass('kr2-layout');
            return;
        }

        var $passages = $('#passages');
        $passages.addClass('kr2-layout');
        var $passageEl = $passages.find('.passage');

        var $main = $('<div id="kr2-main">');
        var $nav  = $('<div id="kr2-nav">');
        var $vars = $('<div id="kr2-vars">').html(kr2Data.varsHTML || '');
        var $img  = $('<div id="kr2-image">');

        if (kr2Data.mainHTML !== null) {
            $main.html(kr2Data.mainHTML);
            $passageEl.find('a, button').each(function() {
                $nav.append($(this));
            });
        } else {
            $passageEl.find('a, button').each(function() {
                $nav.append($(this));
            });
            $passageEl.find('p').each(function() {
                if ($(this).text().trim() === '' && $(this).children().length === 0) {
                    $(this).remove();
                }
            });
            $passageEl.contents().each(function() {
                $main.append($(this).clone(true));
            });
        }

        if (kr2Data.imageUrl) {
            $('<img>').attr('src', kr2Data.imageUrl).attr('alt', '').appendTo($img);
        }

        // Клик на картинку — показываем оверлей поверх всего терминала
        $img.on('click', function() {
            if ($('#kr2-overlay').length) {
                $('#kr2-overlay').remove();
                return;
            }
            if (!kr2Data.imageUrl) return;

            var $overlay = $('<div id="kr2-overlay">');
            var $overlayImg = $('<img>').attr('src', kr2Data.imageUrl).attr('alt', '');
            $overlay.append($overlayImg);
            $overlay.on('click', function() {
                $(this).remove();
            });
            // Вставляем прямо в #passages, не в .passage
            $passages.append($overlay);
        });

        $passageEl.empty();
        $passageEl.append($main, $nav, $img, $vars);

        $nav.find('a[data-passage]').each(function() {
            var dest = $(this).attr('data-passage');
            if (dest) {
                $(this).off('click.kr2').on('click.kr2', function(e) {
                    e.preventDefault();
                    Engine.play(dest);
                });
            }
        });
    });

})();
/* ===== END KR2 INTERFACE ===== */


:: StoryStylesheet [stylesheet]
/* ===== СИГНАЛЫ: оформление терминала — не редактировать вручную ===== */
/* Меняется в окне «Оформление терминала» программы «Twine СИГНАЛЫ».
   В своих стилях можно брать эти значения: var(--sg-text), var(--sg-font-size) и т. д. */
/* СИГНАЛЫ-настройки: {"v":1,"pageBg":"#000000","textColor":"#00cc00","font":"Courier New","fontFile":"","fontSize":25,"winWidth":1050,"winHeight":1050,"winPadding":20,"winOffsetX":0,"winOffsetY":0,"winBg":"#000000","borderWidth":2,"borderColor":"#00cc00","glowColor":"#00cc00","glowSize":10,"flicker":true,"flickerPeriod":0.1,"flickerDepth":5,"scanlines":0,"scanlineGap":3,"vignette":0,"noise":0,"noSelect":false,"noContextMenu":false,"noZoom":false,"hideCursor":0,"startText":"Нажмите, чтобы запустить систему","startSound":"","startVolume":100,"savedColors":["#00cc00","#ffbf00","#cc0000","#cccc00","#cc00cc","#000000"]} */
:root {
	--sg-page-bg: #000000;
	--sg-text: #00cc00;
	--sg-font: "Courier New", monospace;
	--sg-font-size: 25px;
	--sg-win-bg: #000000;
	--sg-win-width: 1050px;
	--sg-win-height: 1050px;
	--sg-win-padding: 20px;
	--sg-border-width: 2px;
	--sg-border-color: #00cc00;
	--sg-glow-color: #00cc00;
	--sg-glow-size: 10px;
	--sg-start-text: "Нажмите, чтобы запустить систему";
	--sg-start-sound: "";
	--sg-start-volume: 1;
	--sg-protect-menu: 0;
	--sg-protect-zoom: 0;
	--sg-hide-cursor: 0;
}
body {
	background-color: var(--sg-page-bg);
	color: var(--sg-text);
	font-family: var(--sg-font);
	font-size: var(--sg-font-size);
	margin: 0;
	height: 100vh;
	display: flex;
	justify-content: center;
	align-items: center;
	position: relative;
	animation: sg-flicker 0.1s infinite;
}
#passages {
	background-color: var(--sg-win-bg);
	border: var(--sg-border-width) solid var(--sg-border-color);
	box-shadow: 0 0 var(--sg-glow-size) var(--sg-glow-color), 0 0 calc(var(--sg-glow-size) * 2) var(--sg-glow-color);
	width: var(--sg-win-width);
	height: var(--sg-win-height);
	padding: var(--sg-win-padding);
	box-sizing: border-box;
	overflow: auto;
}
@keyframes sg-flicker {
	0% { opacity: 1; }
	50% { opacity: 0.95; }
	100% { opacity: 1; }
}
html.sg-cursor-hidden, html.sg-cursor-hidden * { cursor: none !important; }
#sg-start {
	position: fixed;
	inset: 0;
	z-index: 2147483647;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 1em;
	box-sizing: border-box;
	background-color: var(--sg-page-bg);
	color: var(--sg-text);
	font-family: var(--sg-font);
	font-size: var(--sg-font-size);
	text-align: center;
	cursor: pointer;
	user-select: none;
}
#sg-start::after {
	content: var(--sg-start-text);
	animation: sg-blink 1.2s steps(1, end) infinite;
}
@keyframes sg-blink {
	50% { opacity: 0; }
}
/* ===== СИГНАЛЫ: конец оформления терминала ===== */


a {
    color: #00cc00;
    text-decoration: none
}

a:hover {
    color: #00ff00;
    text-decoration: underline;
}

/* Зелёная кнопка по дефолту */
button {
    background-color: #000000;
    color: #00cc00;
    border: 1px solid #00cc00;
    box-shadow: 0 0 5px #00cc00;
    padding: 5px 10px;
    transition: background-color 0.3s, color 0.3s;
}

button:hover {
    background-color: #00cc00;
    color: #000000;
        border: #00cc00;
}


.ui-dialog {
    background-color: #000000;
    border: 2px solid #00cc00;
    box-shadow: 0 0 10px #00cc00, 0 0 20px #00cc00;
    color: #00cc00;
       font-size: 25px;
}

.ui-dialog-titlebar {
    background-color: #000000;
    color: #00cc00;
    border-bottom: 1px solid #00cc00;
     font-size: 25px;
}

.ui-dialog-body {
    color: #00cc00;
     font-size: 25px;
}

input, textarea {
    background-color: #000000;
    color: #00cc00;
    border: 1px solid #00cc00;
    box-shadow: 0 0 5px #00cc00;
    padding: 5px;
     font-size: 25px;
}

#ui-bar, #ui-bar-toggle {
    background-color: #000000;
    color: #00cc00;
    border: none;
     font-size: 25px;
}



/* Красная большая кнопка
   СИГНАЛЫ: в пассаже — <span class="red-big">…кнопка…</span> */
.red-big-button,
.red-big button {
    background-color: #000000;
    color: #cc0000;
    border: 1px solid #cc0000;
    box-shadow: 0 0 5px #cc0000;
    padding: 10px 20px;
    font-size: 1.2em;
    transition: background-color 0.3s, color 0.3s;
}
.red-big-button:hover,
.red-big button:hover {
    background-color: #cc0000;
    color: #000000;
      border: #cc0000;
}

/* Жёлтая маленькая кнопка
   СИГНАЛЫ: в пассаже — <span class="yellow-small">…ссылка…</span> */
.yellow-small-button,
.yellow-small a,
.yellow-small button {
    background-color: #000000;
    color: #cccc00;
    border: 1px solid #cccc00;
    box-shadow: 0 0 5px #cccc00;
    padding: 3px 6px;
    font-size: 0.8em;
    transition: background-color 0.3s, color 0.3s;
}
.yellow-small-button:hover,
.yellow-small a:hover,
.yellow-small button:hover {
    background-color: #cccc00;
    color: #000000;
        border: #cccc00;
}



/* Янтарная кнопка
   СИГНАЛЫ: в пассаже — <span class="amber">…ссылки…</span> */
.amber-button,
.amber a,
.amber button {
    background-color: #000000;
    color: #FFBF00;
    border: 2px solid #FFBF00;
    box-shadow: 0 0 5px #FFBF00;
    padding: 4px 9px;
      font-size: 1.2em;
    transition: background-color 0.3s, color 0.3s;
}

.amber-button:hover,
.amber a:hover,
.amber button:hover {
    background-color: #FFBF00;
    color: #000000;
        border: 2px solid #FFBF00;
      text-decoration: none;
}

/* Существующие стили остаются без изменений */
/* Новые стили для ссылок */
.purple-link {
    color: #cc00cc !important; /* Убедимся, что цвет приоритетен */
    text-decoration: none;
    transition: color 0.3s;
}
.purple-link:hover {
    color: #ff00ff !important;
    text-decoration: underline;
}

.red-big-link {
    color: #cc0000 !important;
    text-decoration: none;
    font-size: 1.2em !important;
    transition: color 0.3s;
}
.red-big-link:hover {
    color: #ff0000 !important;
    text-decoration: underline;
}

.yellow-small-link {
    color: #cccc00 !important;
    text-decoration: none;
    font-size: 0.8em !important;
    transition: color 0.3s;
}
.yellow-small-link:hover {
    color: #ffff00 !important;
    text-decoration: underline;
}

/* Подключаем шрифт DSEG7 Classic для сегментного дизайна */
@font-face {
    font-family: 'DSEG7';
    src: url('media/fonts/DSEG7Classic-Regular.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
}

#timer-display {
    font-family: 'DSEG7', monospace;
    font-size: 125px; /* Размер шрифта для читаемости */
    color: #cc0000; /* Красный цвет */
    background-color: #000000;
    border: 2px solid #cc0000;
    box-shadow: 0 0 10px #cc0000, 0 0 20px #cc0000;
    padding: 10px 20px;
    width: fit-content; /* Ширина подстраивается под содержимое */
    display: inline-block; /* Делает контейнер компактным */
    margin: 20px auto; /* Центрирует элемент по горизонтали */
    text-align: center; /* Центрирует текст внутри элемента */
    display: flex; /* Используем flexbox для точного центрирования */
    justify-content: center; /* Центрирует содержимое по горизонтали */
    align-items: center; /* Центрирует содержимое по вертикали (если нужно) */
}

.center-text {
    text-align: center; /* По центру по горизонтали */
}

.side-text {
    text-align: right; /* Справа по горизонтали */
}



#blockscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #cc0000;
    color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 70px;
    z-index: 1002;
}

#blackscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 70px;
    z-index: 1002;
}



/* Новый стиль для текста в правом верхнем углу */
.top-right-audio-buttons {
    position: absolute;
    top: -26px; /* Отступ сверху */
    right: 440px; /* Отступ справа от края #passages */
}

/* Стили для поля ввода пароля */
.password-input {
    background-color: #000000;
    color: #00cc00;
    border: 1px solid #00cc00;
    box-shadow: 0 0 5px #00cc00;
    padding: 5px;
    font-size: 20px;
    font-family: "Courier New", monospace;
    width: 200px; /* Ширина поля ввода */
    display: block; /* Делает поле блочным элементом */
    margin: 20px auto; /* Центрируем поле */
}






#terminalDisplay {
    width: 100%;
    height: 70%;
    overflow: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
      text-align: center;
    line-height: 1.5;
}

#likenessDisplay {
    width: 100%;
    height: 10%;
    overflow: auto;
    text-align: center;
    margin-top: 10px;
}

#attemptsLeft {
    width: 100%;
    height: 10%;
    margin-top: 10px;
    text-align: center;
}

.word {
    color: #00cc00; /* Зеленый текст */
    background-color: #000000; /* Черный фон */
}

.word:hover {
    color: #000000; /* Черный текст при наведении */
    background-color: #00cc00; /* Зеленый фон при наведении */
}




/* Глючный текст - старт */

/* "Clip" в ".glitch" не используется, поэтому технически вы должны использовать "clip-path", который находится в ".glitchy", однако Internet Explorer не поддерживает "clip-path", а большинство браузеров по-прежнему поддерживают "clip". */


.glitchy {
  color: #00cc00;
  position: relative;
}
.glitchy::before {
  content: attr(data-text);
  width: calc(100% + 0.5em);
  position: absolute;
  left: -9px;
  text-shadow: 1px 0 blue;
  top: -5px;
  color: #00cc00;
  background: #111;
  overflow: hidden;
  clip-path: polygon(0 0);
  animation: noise-animY-2 3s infinite linear alternate-reverse;
  -webkit-animation: noise-animY-2 3s infinite linear alternate-reverse;
}
.glitchy::after {
  content: attr(data-text);
  width: calc(100% + 0.5em);
  position: absolute;
  left: -5px;
  text-shadow: -1px 0 red;
  top: -5px;
  color: #00cc00;
  background: #111;
  overflow: hidden;
  clip-path: polygon(0 0);
  animation: noise-animY 2s infinite linear alternate-reverse;
  -webkit-animation: noise-animY 2s infinite linear alternate-reverse;
}
@keyframes noise-animY {
  0% {
    clip-path: polygon(0 80px, 100% 80px, 100% 16px, 0 16px);
  }
  5% {
    clip-path: polygon(0 94px, 100% 94px, 100% 17px, 0 17px);
  }
  10% {
    clip-path: polygon(0 9px, 100% 9px, 100% 92px, 0 92px);
  }
  15.0% {
    clip-path: polygon(0 37px, 100% 37px, 100% 4px, 0 4px);
  }
  20% {
    clip-path: polygon(0 53px, 100% 53px, 100% 47px, 0 47px);
  }
  25% {
    clip-path: polygon(0 99px, 100% 99px, 100% 69px, 0 69px);
  }
  30.0% {
    clip-path: polygon(0 15px, 100% 15px, 100% 49px, 0 49px);
  }
  35% {
    clip-path: polygon(0 83px, 100% 83px, 100% 81px, 0 81px);
  }
  40% {
    clip-path: polygon(0 55px, 100% 55px, 100% 43px, 0 43px);
  }
  45% {
    clip-path: polygon(0 28px, 100% 28px, 100% 27px, 0 27px);
  }
  50% {
    clip-path: polygon(0 64px, 100% 64px, 100% 28px, 0 28px);
  }
  55.0% {
    clip-path: polygon(0 76px, 100% 76px, 100% 91px, 0 91px);
  }
  60.0% {
    clip-path: polygon(0 29px, 100% 29px, 100% 72px, 0 72px);
  }
  65% {
    clip-path: polygon(0 70px, 100% 70px, 100% 10px, 0 10px);
  }
  70% {
    clip-path: polygon(0 5px, 100% 5px, 100% 84px, 0 84px);
  }
  75% {
    clip-path: polygon(0 46px, 100% 46px, 100% 81px, 0 81px);
  }
  80% {
    clip-path: polygon(0 7px, 100% 7px, 100% 85px, 0 85px);
  }
  85.0% {
    clip-path: polygon(0 17px, 100% 17px, 100% 89px, 0 89px);
  }
  90% {
    clip-path: polygon(0 41px, 100% 41px, 100% 59px, 0 59px);
  }
  95% {
    clip-path: polygon(0 53px, 100% 53px, 100% 90px, 0 90px);
  }
  100% {
    clip-path: polygon(0 10px, 100% 10px, 100% 30px, 0 30px);
  }
}
@keyframes noise-animY-2 {
  0% {
    clip-path: polygon(0 84px, 100% 84px, 100% 3px, 0 3px);
  }
  5% {
    clip-path: polygon(0 31px, 100% 31px, 100% 69px, 0 69px);
  }
  10% {
    clip-path: polygon(0 37px, 100% 37px, 100% 33px, 0 33px);
  }
  15.0% {
    clip-path: polygon(0 18px, 100% 18px, 100% 6px, 0 6px);
  }
  20% {
    clip-path: polygon(0 25px, 100% 25px, 100% 87px, 0 87px);
  }
  25% {
    clip-path: polygon(0 100px, 100% 100px, 100% 8px, 0 8px);
  }
  30.0% {
    clip-path: polygon(0 24px, 100% 24px, 100% 87px, 0 87px);
  }
  35% {
    clip-path: polygon(0 39px, 100% 39px, 100% 16px, 0 16px);
  }
  40% {
    clip-path: polygon(0 96px, 100% 96px, 100% 25px, 0 25px);
  }
  45% {
    clip-path: polygon(0 16px, 100% 16px, 100% 100px, 0 100px);
  }
  50% {
    clip-path: polygon(0 92px, 100% 92px, 100% 76px, 0 76px);
  }
  55.0% {
    clip-path: polygon(0 29px, 100% 29px, 100% 40px, 0 40px);
  }
  60.0% {
    clip-path: polygon(0 40px, 100% 40px, 100% 39px, 0 39px);
  }
  65% {
    clip-path: polygon(0 94px, 100% 94px, 100% 44px, 0 44px);
  }
  70% {
    clip-path: polygon(0 2px, 100% 2px, 100% 78px, 0 78px);
  }
  75% {
    clip-path: polygon(0 86px, 100% 86px, 100% 50px, 0 50px);
  }
  80% {
    clip-path: polygon(0 2px, 100% 2px, 100% 46px, 0 46px);
  }
  85.0% {
    clip-path: polygon(0 41px, 100% 41px, 100% 71px, 0 71px);
  }
  90% {
    clip-path: polygon(0 75px, 100% 75px, 100% 15px, 0 15px);
  }
  95% {
    clip-path: polygon(0 41px, 100% 41px, 100% 8px, 0 8px);
  }
  100% {
    clip-path: polygon(0 23px, 100% 23px, 100% 75px, 0 75px);
  }
}
/* Глючный текст - Конец */








/* hovertip v2.0 - Старт */
.hoverTip {
	display: inline-block;
	top: 4px;
	border-width: 0px;
    border-bottom: 2px dotted #00cc00;  /* Если вы хотите, чтобы под зависающим текстом были точки */
}
.hoverTipTxt {
	position: relative;
	vertical-align: text-bottom;
	line-height: initial;
}
.hoverTipTxt .hoverBox {
	position: absolute;
	visibility: hidden;
}
.hoverTipTxt:hover .hoverBox, .hoverTipTxt:focus .hoverBox {
	visibility: visible;
}
.hoverBox {
	padding: 3px 10px;
	width: intrinsic;  /* Safari/WebKit использует нестандартное имя */
	width: -webkit-max-content;  /* Chrome */
	width: -moz-max-content;  /* Firefox/Gecko */
	width: max-content;
	max-width: 333px;
	line-height: initial;
	text-align: left;
	color: #00cc00;
	background-color: black;
	border: #00cc00 solid 2px;
	-webkit-border-radius: 6px;
	   -moz-border-radius: 6px;
	        border-radius: 6px;
	-webkit-box-shadow: 0px 0px 12px 2px rgba(0, 0, 0, 0.75);
	   -moz-box-shadow: 0px 0px 12px 2px rgba(0, 0, 0, 0.75);
	        box-shadow: 0px 0px 12px 2px rgba(0, 0, 0, 0.75);
	z-index: 100;
}
.hoverTail::after {
	content: "";
	position: absolute;
	top: 100%;  /* В нижней части всплывающей подсказки */
	left: 50%;
	margin-left: -5px;
	border-width: 8px;
	border-style: solid;
	border-color: #00cc00 transparent transparent transparent;
	z-index: 100;
}
.hoverBox a {
	-webkit-transition-duration: unset;
	   -moz-transition-duration: unset;
	     -o-transition-duration: unset;
	        transition-duration: unset;
}
#ui-bar .hoverBox {
	max-width: 230px;
}
/* hovertip v2.0 - Конец*/






/* ===== KR2 INTERFACE ===== */

#passages.kr2-layout {
    display: grid;
    grid-template-columns: 65% 35%;
    grid-template-rows: 65% 35%;
    padding: 0;
    gap: 0;
    overflow: hidden;
    position: relative;
}

#passages.kr2-layout .passage {
    display: contents;
}

#kr2-main {
    grid-column: 1;
    grid-row: 1;
    overflow-y: auto;
    padding: 15px;
    border-right: 2px solid #00cc00;
    border-bottom: 2px solid #00cc00;
    box-sizing: border-box;
}

#kr2-nav {
    grid-column: 1;
    grid-row: 2;
    overflow-y: auto;
    padding: 15px;
    border-right: 2px solid #00cc00;
    box-sizing: border-box;
}

/* Каждая ссылка навигации — с новой строки */
#kr2-nav a,
#kr2-nav button {
    display: block;
    margin-bottom: 6px;
}

#kr2-image {
    grid-column: 2;
    grid-row: 1;
    overflow: hidden;
    position: relative;
    border-bottom: 2px solid #00cc00;
    box-sizing: border-box;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
}

/* Картинка в нормальном режиме */
#kr2-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
}

/* СИГНАЛЫ: правила #kr2-image.expanded удалены — картинка разворачивается через #kr2-overlay (ниже) */

#kr2-vars {
    grid-column: 2;
    grid-row: 2;
    overflow-y: auto;
    padding: 10px;
    box-sizing: border-box;
    font-size: 0.8em;
    color: #00aa00;
}

#kr2-main::-webkit-scrollbar,
#kr2-nav::-webkit-scrollbar,
#kr2-vars::-webkit-scrollbar {
    width: 6px;
}
#kr2-main::-webkit-scrollbar-track,
#kr2-nav::-webkit-scrollbar-track,
#kr2-vars::-webkit-scrollbar-track {
    background: #000;
}
#kr2-main::-webkit-scrollbar-thumb,
#kr2-nav::-webkit-scrollbar-thumb,
#kr2-vars::-webkit-scrollbar-thumb {
    background: #00cc00;
}

/* ===== END KR2 INTERFACE ===== */


#kr2-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-sizing: border-box;
}

#kr2-overlay img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}
