	background-color: #000000;
	border: 1px solid #cc00cc;
	box-shadow: 0 0 5px #cc00cc;
	text-decoration: none;
	padding: 5px 10px;
	font-size: 1em;
	transition: all 0.3s;
}
.purple button:hover {
