:: StoryScript [script]
/* ===== СИГНАЛЫ: звуки наведения и нажатия — не редактировать вручную ===== */
/* Наборы звуков — в окне «Звуки», звуки видов — в окне «Виды кнопок и ссылок». */
setup.signalySounds = {
	"sets": [
		{
			"name": "Наведение",
			"files": [
				"media/audio/hover1.wav",
				"media/audio/hover2.wav",
				"media/audio/hover3.wav",
				"media/audio/hover4.wav",
				"media/audio/hover5.wav",
				"media/audio/hover6.wav"
			],
			"volume": 5,
			"delay": 0
		},
		{
			"name": "Нажатие",
			"files": [
				"media/audio/click1.wav",
				"media/audio/click2.wav",
				"media/audio/click3.wav"
			],
			"volume": 5,
			"delay": 0
		}
	],
	"kinds": {
		"": {
			"hover": "Наведение",
			"click": "Нажатие"
		}
	}
};
/* ===== СИГНАЛЫ: конец звуков наведения и нажатия ===== */


/* ===== СИГНАЛЫ: движок терминала — не редактировать вручную ===== */
/* Версия движка: 16. Обновляется программой «Twine СИГНАЛЫ».
   Настройки — в окне «Оформление терминала» (они лежат в таблице стилей).
   Свой код пишите ниже конца этого блока. */
(function () {
	'use strict';

	// История в один шаг: «назад» в браузере не откатывает игру.
	Config.history.maxStates = 1;

	var rootStyle = getComputedStyle(document.documentElement);

	function opt(name, fallback) {
		var raw = rootStyle.getPropertyValue('--sg-' + name).trim();

		if (raw === '') {
			return fallback;
		}
		if (raw.charAt(0) === '"') {
			try {
				return JSON.parse(raw);
			} catch (e) {
				return fallback;
			}
		}

		var number = Number(raw);

		return isNaN(number) ? raw : number;
	}

	var settings = {
		startSound: opt('start-sound', ''),
		startVolume: opt('start-volume', 1),
		noContextMenu: opt('protect-menu', 0) === 1,
		noZoom: opt('protect-zoom', 0) === 1,
		hideCursorAfter: opt('hide-cursor', 0),
		lineScroll: opt('line-scroll', 0) === 1,
		// Печать текста (шаг 2.1): по умолчанию включено (ответ автора 6А).
		typeClick: opt('type-click', 1) === 1,
		typeSeen: opt('type-seen', 1) === 1
	};

	// Предпросмотр в программе: без стартового экрана, автокопии и защиты.
	var preview = window.SIGNALY_PREVIEW;

	setup.signaly = {engine: 16, preview: !!preview};

	function showStartScreen(onClick) {
		var screen = document.createElement('div');

		screen.id = 'sg-start';
		document.body.appendChild(screen);
		screen.addEventListener('click', function () {
			onClick(screen);
		});
		return screen;
	}

	/* ----- Прокрутка по одной строке ----- */

	function scrollTarget(element) {
		while (element && element !== document.documentElement) {
			var style = getComputedStyle(element);

			if (
				/(auto|scroll)/.test(style.overflowY) &&
				element.scrollHeight > element.clientHeight
			) {
				return element;
			}
			element = element.parentElement;
		}
		return null;
	}

	if (settings.lineScroll) {
		document.addEventListener(
			'wheel',
			function (ev) {
				if (ev.ctrlKey || ev.deltaY === 0) {
					return;
				}

				var target = scrollTarget(ev.target);

				if (!target) {
					return;
				}

				// Высота строки — меряем настоящую строку текста этого блока.
				var probe = document.createElement('div');

				probe.textContent = 'X';
				probe.style.cssText = 'position:absolute;visibility:hidden;left:0;top:0;';
				target.appendChild(probe);

				var line = probe.getBoundingClientRect().height;

				target.removeChild(probe);
				ev.preventDefault();
				target.scrollBy({top: ev.deltaY > 0 ? line : -line, behavior: 'instant'});
			},
			{passive: false}
		);
	}

	/* ----- Слой эффектов поверх терминала ----- */

	// Шум и затемнение углов — в слое #sg-fx точно по рамке #passages. Слой
	// живёт внутри #passages (мерцает вместе с ним, экран тревоги остаётся
	// сверху), но закреплён на экране и не прокручивается вместе с текстом.
	function placeEffects() {
		var passages = document.getElementById('passages');

		if (!passages) {
			return;
		}

		var fx = document.getElementById('sg-fx');

		if (!fx) {
			fx = document.createElement('div');
			fx.id = 'sg-fx';
			fx.setAttribute('aria-hidden', 'true');
		}
		if (fx.parentNode !== passages) {
			passages.appendChild(fx);
		}

		var rect = passages.getBoundingClientRect();

		fx.style.left = rect.left + 'px';
		fx.style.top = rect.top + 'px';
		fx.style.width = rect.width + 'px';
		fx.style.height = rect.height + 'px';
	}

	$(document).on(':passagedisplay', placeEffects);
	window.addEventListener('resize', placeEffects);
	document.addEventListener('fullscreenchange', placeEffects);
	setInterval(placeEffects, 1000);

	/* ----- Блоки экрана (шаг 1.4) ----- */

	// Команды: <<sg-image>>, <<sg-video>>, <<sg-alarm>>, <<sg-dialog>>,
	// <<sg-code>> (с <<sg-case>> и <<sg-wrong>>), окно KR2. Их вставляет панель
	// «Добавить блок»; в обычном Twine они работают так же.

	var engineStyle = document.createElement('style');

	engineStyle.id = 'sg-engine-style';
	engineStyle.textContent =
		'@keyframes sg-alarm-blink { 50% { filter: brightness(0.45); } }\n' +
		'html[data-sg-dialog="noclose"] #ui-dialog-close { display: none; }\n' +
		'.sg-dialog-ok { margin-top: 1em; text-align: center; }\n' +
		// Эффекты текста (шаг 2.1): мигание; глитч — с нулевой силой (:where),
		// его перекрывают и блок оформления, и стили автора.
		'@keyframes sg-text-blink { 50% { opacity: 0; } }\n' +
		'.sg-blink { animation: sg-text-blink 1s steps(1, end) infinite; }\n' +
		// Сессия 7: ссылка в печатающемся тексте ждёт конца своей надписи;
		// глитч и мигание до своего начала — обычный текст.
		'.sg-type-wait { pointer-events: none !important; }\n' +
		// Шаг 4.3: ссылка на закрытый экран — скрыта или не нажимается.
		'.sg-acc-hide { display: none !important; }\n' +
		'.sg-acc-off { pointer-events: none !important; }\n' +
		// Шаг 4.4: список статей и ссылка «Назад».
		'.sg-art-section { margin-bottom: 1em; }\n' +
		'.sg-art-heading { font-weight: bold; margin-bottom: 0.4em; }\n' +
		'.sg-art-grid { display: grid; gap: 0.3em 2em; justify-items: start; }\n' +
		'.sg-art-back { margin-top: 1.5em; }\n' +
		// Шаг 5.1: список состояний и плитка.
		'.sg-list-grid { display: grid; gap: 0.4em 1.5em; justify-items: start; }\n' +
		'.sg-list-tiles { gap: 0.8em; justify-items: stretch; }\n' +
		'.sg-list-tiles .sg-list-item > span { display: block; }\n' +
		'.sg-tile { border: 2px solid currentColor; box-sizing: border-box; display: block; padding: 0.4em 0.7em; text-decoration: none; }\n' +
		'a.sg-tile:not(.sg-list-color):hover { filter: brightness(1.3); }\n' +
		// Свой цвет состояния: те же правила, что у видов, — при наведении цвета
		// меняются местами. Правило сильнее вида, инлайн-стиль убил бы наведение.
		'.sg-list-item .sg-list-color { border-color: var(--sg-state); color: var(--sg-state); }\n' +
		'.sg-list-item button.sg-list-color { box-shadow: 0 0 5px var(--sg-state); }\n' +
		'.sg-list-item a.sg-list-color:hover, .sg-list-item button.sg-list-color:hover { background-color: var(--sg-state); color: #000000; }\n' +
		'.sg-tile-name { display: block; font-weight: bold; }\n' +
		'.sg-tile-status { display: block; }\n' +
		'.sg-blink.sg-off { animation: none; }\n' +
		'html .glitchy.sg-off { color: inherit; }\n' +
		'html .glitchy.sg-off::before, html .glitchy.sg-off::after { content: none; }\n' +
		":where(.glitchy) { color: #00cc00; position: relative; }\n:where(.glitchy)::before { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -9px; text-shadow: 1px 0 #0000ff; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-2 3s infinite linear alternate-reverse; }\n:where(.glitchy)::after { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -5px; text-shadow: -1px 0 #ff0000; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-1 2s infinite linear alternate-reverse; }\n@keyframes sg-glitch-1 { 0% { clip-path: polygon(0 80px, 100% 80px, 100% 16px, 0 16px); } 5% { clip-path: polygon(0 94px, 100% 94px, 100% 17px, 0 17px); } 10% { clip-path: polygon(0 9px, 100% 9px, 100% 92px, 0 92px); } 15.0% { clip-path: polygon(0 37px, 100% 37px, 100% 4px, 0 4px); } 20% { clip-path: polygon(0 53px, 100% 53px, 100% 47px, 0 47px); } 25% { clip-path: polygon(0 99px, 100% 99px, 100% 69px, 0 69px); } 30.0% { clip-path: polygon(0 15px, 100% 15px, 100% 49px, 0 49px); } 35% { clip-path: polygon(0 83px, 100% 83px, 100% 81px, 0 81px); } 40% { clip-path: polygon(0 55px, 100% 55px, 100% 43px, 0 43px); } 45% { clip-path: polygon(0 28px, 100% 28px, 100% 27px, 0 27px); } 50% { clip-path: polygon(0 64px, 100% 64px, 100% 28px, 0 28px); } 55.0% { clip-path: polygon(0 76px, 100% 76px, 100% 91px, 0 91px); } 60.0% { clip-path: polygon(0 29px, 100% 29px, 100% 72px, 0 72px); } 65% { clip-path: polygon(0 70px, 100% 70px, 100% 10px, 0 10px); } 70% { clip-path: polygon(0 5px, 100% 5px, 100% 84px, 0 84px); } 75% { clip-path: polygon(0 46px, 100% 46px, 100% 81px, 0 81px); } 80% { clip-path: polygon(0 7px, 100% 7px, 100% 85px, 0 85px); } 85.0% { clip-path: polygon(0 17px, 100% 17px, 100% 89px, 0 89px); } 90% { clip-path: polygon(0 41px, 100% 41px, 100% 59px, 0 59px); } 95% { clip-path: polygon(0 53px, 100% 53px, 100% 90px, 0 90px); } 100% { clip-path: polygon(0 10px, 100% 10px, 100% 30px, 0 30px); } }\n@keyframes sg-glitch-2 { 0% { clip-path: polygon(0 84px, 100% 84px, 100% 3px, 0 3px); } 5% { clip-path: polygon(0 31px, 100% 31px, 100% 69px, 0 69px); } 10% { clip-path: polygon(0 37px, 100% 37px, 100% 33px, 0 33px); } 15.0% { clip-path: polygon(0 18px, 100% 18px, 100% 6px, 0 6px); } 20% { clip-path: polygon(0 25px, 100% 25px, 100% 87px, 0 87px); } 25% { clip-path: polygon(0 100px, 100% 100px, 100% 8px, 0 8px); } 30.0% { clip-path: polygon(0 24px, 100% 24px, 100% 87px, 0 87px); } 35% { clip-path: polygon(0 39px, 100% 39px, 100% 16px, 0 16px); } 40% { clip-path: polygon(0 96px, 100% 96px, 100% 25px, 0 25px); } 45% { clip-path: polygon(0 16px, 100% 16px, 100% 100px, 0 100px); } 50% { clip-path: polygon(0 92px, 100% 92px, 100% 76px, 0 76px); } 55.0% { clip-path: polygon(0 29px, 100% 29px, 100% 40px, 0 40px); } 60.0% { clip-path: polygon(0 40px, 100% 40px, 100% 39px, 0 39px); } 65% { clip-path: polygon(0 94px, 100% 94px, 100% 44px, 0 44px); } 70% { clip-path: polygon(0 2px, 100% 2px, 100% 78px, 0 78px); } 75% { clip-path: polygon(0 86px, 100% 86px, 100% 50px, 0 50px); } 80% { clip-path: polygon(0 2px, 100% 2px, 100% 46px, 0 46px); } 85.0% { clip-path: polygon(0 41px, 100% 41px, 100% 71px, 0 71px); } 90% { clip-path: polygon(0 75px, 100% 75px, 100% 15px, 0 15px); } 95% { clip-path: polygon(0 41px, 100% 41px, 100% 8px, 0 8px); } 100% { clip-path: polygon(0 23px, 100% 23px, 100% 75px, 0 75px); } }";
	document.head.appendChild(engineStyle);

	// Слова команды: сначала значения по порядку, потом «имя значение» и галочки.
	function blockArgs(ctx, positional, keys, flags) {
		var args = ctx.args.slice();
		var result = {};

		positional.forEach(function (name) {
			if (args.length) {
				result[name] = args.shift();
			}
		});
		while (args.length) {
			var word = String(args.shift());

			if (flags.indexOf(word) !== -1) {
				result[word] = true;
			} else if (keys.indexOf(word) !== -1 && args.length) {
				result[word] = args.shift();
			}
		}
		return result;
	}

	var placeKeys = ['place', 'corner', 'x', 'y', 'border', 'color', 'glow'];

	// Внешний вид картинки или видео: рамка, свечение, место «на экране» —
	// от угла окна терминала, как кнопки на экране.
	function placeStyle(el, a) {
		var color = a.color || 'var(--sg-text, #00cc00)';
		var border = Number(a.border) || 0;
		var glow = Number(a.glow) || 0;

		if (border > 0) {
			el.style.border = border + 'px solid ' + color;
		}
		if (glow > 0) {
			el.style.boxShadow = '0 0 ' + glow + 'px ' + color + ', 0 0 ' + glow * 2 + 'px ' + color;
		}
		if (a.place === 'screen') {
			var corner = String(a.corner || 'tl');
			var right = corner === 'tr' || corner === 'br';
			var bottom = corner === 'bl' || corner === 'br';
			var halfW = 'var(--sg-win-width, 1050px) / 2';
			var halfH = 'var(--sg-win-height, 1050px) / 2';
			var offX = 'var(--sg-win-offset-x, 0px)';
			var offY = 'var(--sg-win-offset-y, 0px)';
			var x = (Number(a.x) || 0) + 'px';
			var y = (Number(a.y) || 0) + 'px';

			el.style.position = 'fixed';
			el.style[right ? 'right' : 'left'] = right
				? 'calc(50% - ' + halfW + ' - ' + offX + ' + ' + x + ')'
				: 'calc(50% - ' + halfW + ' + ' + offX + ' + ' + x + ')';
			el.style[bottom ? 'bottom' : 'top'] = bottom
				? 'calc(50% - ' + halfH + ' - ' + offY + ' + ' + y + ')'
				: 'calc(50% - ' + halfH + ' + ' + offY + ' + ' + y + ' + var(--sg-place-shift, 0px))';
		}
	}

	// Вывод блока: «по центру» — в отдельной строке по центру.
	function putPlaced(ctx, el, a, type) {
		if (preview) {
			// Для перетаскивания мышью в предпросмотре программы.
			el.setAttribute('data-sg-block', type);
			el.setAttribute('data-sg-src', ctx.source);
		}
		if (a.place === 'center') {
			var wrap = document.createElement('div');

			wrap.style.textAlign = 'center';
			wrap.appendChild(el);
			ctx.output.appendChild(wrap);
		} else {
			ctx.output.appendChild(el);
		}
	}

	// Кнопка или ссылка SugarCube с действием (та же разметка, что у <<button>>).
	function actionControl(output, label, asButton, action) {
		var name = asButton ? 'button' : 'link';
		var holder = document.createElement('span');

		$(holder).wiki('<<' + name + ' ' + JSON.stringify(String(label)) + '>><</' + name + '>>');

		// В режиме «Тестировать» SugarCube оборачивает кнопку в рамку отладки.
		var control = holder.querySelector(asButton ? 'button' : 'a');

		$(control).on('click', action);
		while (holder.firstChild) {
			output.appendChild(holder.firstChild);
		}
		return control;
	}

	function videoType(src) {
		var ext = String(src).split('.').pop().toLowerCase();

		return ext === 'webm' ? 'video/webm' : ext === 'ogv' || ext === 'ogg' ? 'video/ogg' : 'video/mp4';
	}

	Macro.add('sg-image', {
		handler: function () {
			var a = blockArgs(this, ['src'], ['width'].concat(placeKeys), []);
			var img = document.createElement('img');

			img.src = a.src || '';
			img.alt = '';
			if (Number(a.width) > 0) {
				img.style.width = Number(a.width) + 'px';
			}
			placeStyle(img, a);
			putPlaced(this, img, a, 'image');
		}
	});

	Macro.add('sg-video', {
		handler: function () {
			var a = blockArgs(
				this,
				['src'],
				['width', 'height'].concat(placeKeys),
				['autoplay', 'loop', 'muted', 'controls', 'buttons']
			);
			var video = document.createElement('video');
			var source = document.createElement('source');

			['controls', 'autoplay', 'loop', 'muted'].forEach(function (flag) {
				if (a[flag]) {
					video.setAttribute(flag, '');
					video[flag] = true;
				}
			});
			video.setAttribute('playsinline', '');
			if (Number(a.width) > 0) {
				video.setAttribute('width', Number(a.width));
			}
			if (Number(a.height) > 0) {
				video.setAttribute('height', Number(a.height));
			}
			source.src = a.src || '';
			source.type = videoType(a.src || '');
			video.appendChild(source);
			placeStyle(video, a);

			if (!a.buttons) {
				putPlaced(this, video, a, 'video');
				return;
			}

			// С кнопками «Воспроизвести» и «Остановить» — как в Videotest.
			var box = document.createDocumentFragment();

			box.appendChild(video);
			box.appendChild(document.createElement('br'));
			actionControl(box, 'Воспроизвести', true, function () {
				video.play().catch(function () {});
			});
			box.appendChild(document.createElement('br'));
			actionControl(box, 'Остановить', true, function () {
				video.pause();
			});
			if (preview) {
				video.setAttribute('data-sg-block', 'video');
				video.setAttribute('data-sg-src', this.source);
			}
			if (a.place === 'center') {
				var wrap = document.createElement('div');

				wrap.style.textAlign = 'center';
				wrap.appendChild(box);
				this.output.appendChild(wrap);
			} else {
				this.output.appendChild(box);
			}
		}
	});

	/* Кнопка на экране (сессия 6): содержимое стоит на месте от угла окна
	   терминала и не прокручивается с текстом; kind — вид кнопок и ссылок. */

	Macro.add('sg-place', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, [], ['kind', 'corner', 'x', 'y', 'hover', 'click'], []);
			var el = document.createElement('span');

			el.className = 'sg-place' + (a.kind ? ' ' + a.kind : '');
			// Шаг 2.2: свой звук наведения и нажатия (none — без звука).
			['hover', 'click'].forEach(function (which) {
				if (a[which] !== undefined) {
					el.setAttribute('data-sg-' + which, a[which] === 'none' ? '' : String(a[which]));
				}
			});
			placeStyle(el, {place: 'screen', corner: a.corner, x: a.x, y: a.y});
			if (preview) {
				el.setAttribute('data-sg-block', 'place');
				el.setAttribute('data-sg-src', this.source);
			}
			$(el).wiki(this.payload[0].contents);
			this.output.appendChild(el);
		}
	});

	/* ----- Таймеры (шаг 2.3) ----- */

	// Таймер именной и идёт в фоне: время окончания лежит в переменной
	// $sgTimers (попадает в автокопию), табло того же таймера можно поставить
	// на несколько экранов. По окончании — переход, окно-сообщение или звук.
	var timerDefaults = {"font":"media/fonts/DSEG7Classic-Regular.woff2","color":"#cc0000","bg":"#000000","size":125,"border":2,"glow":10};
	var timerFonts = {};
	var restoring = false;

	function timerStore() {
		var v = State.variables;

		if (!v.sgTimers || typeof v.sgTimers !== 'object') {
			v.sgTimers = {};
		}
		return v.sgTimers;
	}

	function timersChanged() {
		if (setup.signaly.saveTimers) {
			setup.signaly.saveTimers();
		}
	}

	function pad(n) {
		return n < 10 ? '0' + n : String(n);
	}

	function timerText(end, format) {
		var left = Math.max(0, Math.ceil((end - Date.now()) / 1000));

		if (format === 'hms') {
			return pad(Math.floor(left / 3600)) + ':' + pad(Math.floor(left / 60) % 60) + ':' + pad(left % 60);
		}
		return pad(Math.floor(left / 60)) + ':' + pad(left % 60);
	}

	// Шрифт табло — файл из папки игры (свой @font-face на каждый файл).
	function timerFont(file) {
		if (file === 'none') {
			return '';
		}
		if (!timerFonts[file]) {
			var family = 'sg-timer-font-' + (Object.keys(timerFonts).length + 1);
			var style = document.createElement('style');

			style.textContent =
				'@font-face { font-family: "' + family + '"; src: url(' + JSON.stringify(file) +
				'); font-weight: normal; font-style: normal; }';
			document.head.appendChild(style);
			timerFonts[file] = family;
		}
		return '"' + timerFonts[file] + '", monospace';
	}

	function timerEnded(name, t) {
		var store = timerStore();

		delete store[name];
		timersChanged();
		if (t.sound) {
			try {
				new Audio(t.sound).play().catch(function () {});
			} catch (e) {
				console.error('СИГНАЛЫ: звук таймера', e);
			}
		}
		if (t.passage || t.text || t.title) {
			setup.signaly.openDialog({title: t.title, passage: t.passage, text: t.text});
		}
		if (t.goto && Story.has(t.goto)) {
			accessGo(t.goto, 'auto', 'timer:' + name);
		}
	}

	function tickTimers() {
		var store = State.variables && State.variables.sgTimers;

		if (!store || restoring || (Engine.isIdle && !Engine.isIdle())) {
			return;
		}
		$('.sg-timer[data-sg-timer]').each(function () {
			var t = store[this.getAttribute('data-sg-timer')];

			if (t) {
				this.firstChild.textContent = timerText(t.end, this.getAttribute('data-sg-format'));
			}
		});
		Object.keys(store).forEach(function (name) {
			var t = store[name];

			if (t && Date.now() >= t.end && State.variables.sgTimers === store && store[name] === t) {
				timerEnded(name, t);
			}
		});
	}

	setInterval(tickTimers, 250);

	Macro.add('sg-timer', {
		handler: function () {
			var a = blockArgs(
				this,
				['name'],
				['hours', 'minutes', 'seconds', 'start', 'goto', 'title', 'passage', 'text', 'sound',
					'font', 'color', 'bg', 'size', 'border', 'glow', 'format'],
				['hidden']
			);
			var name = String(a.name || State.passage);
			var store = timerStore();

			if (a.start !== 'running' && !(restoring && store[name])) {
				var total =
					(Number(a.hours) || 0) * 3600 + (Number(a.minutes) || 0) * 60 + (Number(a.seconds) || 0);
				var t = {end: Date.now() + total * 1000};

				['goto', 'title', 'passage', 'text', 'sound'].forEach(function (key) {
					if (a[key] !== undefined && a[key] !== '') {
						t[key] = String(a[key]);
					}
				});
				store[name] = t;
				timersChanged();
			}

			var running = store[name];

			// Табло не видно: скрытый таймер или таймер ещё не идёт.
			if (a.hidden || !running) {
				return;
			}

			var color = a.color || timerDefaults.color;
			var border = a.border === undefined ? timerDefaults.border : Number(a.border) || 0;
			var glow = a.glow === undefined ? timerDefaults.glow : Number(a.glow) || 0;
			var el = document.createElement('div');
			var text = document.createElement('span');
			var s = el.style;
			var font = timerFont(a.font === undefined ? timerDefaults.font : String(a.font));

			el.className = 'sg-timer';
			el.setAttribute('data-sg-timer', name);
			if (a.format === 'hms') {
				el.setAttribute('data-sg-format', 'hms');
			}
			if (font) {
				s.fontFamily = font;
			}
			s.fontSize = (a.size === undefined ? timerDefaults.size : Number(a.size) || 0) + 'px';
			s.color = color;
			s.backgroundColor = a.bg || timerDefaults.bg;
			if (border > 0) {
				s.border = border + 'px solid ' + color;
			}
			if (glow > 0) {
				s.boxShadow = '0 0 ' + glow + 'px ' + color + ', 0 0 ' + glow * 2 + 'px ' + color;
			}
			s.padding = '10px 20px';
			s.width = 'fit-content';
			s.margin = '20px auto';
			s.textAlign = 'center';
			s.display = 'flex';
			s.justifyContent = 'center';
			s.alignItems = 'center';
			text.textContent = timerText(running.end, a.format);
			el.appendChild(text);
			this.output.appendChild(el);
		}
	});

	// Действие ссылки или кнопки (шаг 3.2): остановить таймер по имени.
	// Запустить — тот же <<sg-timer … hidden>> внутри ссылки.
	Macro.add('sg-timer-stop', {
		handler: function () {
			var store = timerStore();
			var name = String(this.args.length ? this.args[0] : State.passage);

			if (store[name]) {
				delete store[name];
				timersChanged();
			}
		}
	});

	/* ----- Цепочка видео (шаг 2.3) ----- */

	// Шаги по порядку; следующий включает щелчок по видео, окончание видео или
	// N секунд. Все видео загружаются сразу — переход мгновенный (ответ 7А).
	Macro.add('sg-chain', {
		tags: ['sg-step'],
		handler: function () {
			var a = blockArgs(this, [], ['width', 'height', 'goto'].concat(placeKeys), []);
			var steps = this.payload.slice(1).map(function (part) {
				return blockArgs({args: part.args}, ['src'], ['next', 'seconds'], ['loop', 'muted']);
			});
			var box = document.createElement('span');
			var current = 0;
			var stepTimer = null;
			var done = false;
			var look = {border: a.border, glow: a.glow, color: a.color};

			box.className = 'sg-chain';

			var videos = steps.map(function (step, index) {
				var video = document.createElement('video');
				var source = document.createElement('source');

				['loop', 'muted'].forEach(function (flag) {
					if (step[flag]) {
						video.setAttribute(flag, '');
						video[flag] = true;
					}
				});
				if (index === 0) {
					video.setAttribute('autoplay', '');
					video.autoplay = true;
				} else {
					video.setAttribute('preload', 'auto');
					video.style.display = 'none';
				}
				if (Number(a.width) > 0) {
					video.setAttribute('width', Number(a.width));
				}
				if (Number(a.height) > 0) {
					video.setAttribute('height', Number(a.height));
				}
				source.src = step.src || '';
				source.type = videoType(step.src || '');
				video.appendChild(source);
				placeStyle(video, look);
				video.addEventListener('click', function () {
					if ((step.next || 'end') === 'click') {
						advance(index);
					}
				});
				video.addEventListener('ended', function () {
					if ((step.next || 'end') === 'end') {
						advance(index);
					}
				});
				box.appendChild(video);
				if (index > 0) {
					video.load();
				}
				return video;
			});

			function arm(index) {
				var step = steps[index];

				clearTimeout(stepTimer);
				if (step && step.next === 'time') {
					stepTimer = setTimeout(function () {
						advance(index);
					}, Math.max(0, Number(step.seconds) || 0) * 1000);
				}
			}

			function advance(index) {
				if (index !== current || done || !box.isConnected) {
					return;
				}
				clearTimeout(stepTimer);
				if (index + 1 < videos.length) {
					var old = videos[index];
					var next = videos[index + 1];

					old.pause();
					old.style.display = 'none';
					current = index + 1;
					next.style.display = '';
					next.currentTime = 0;
					next.play().catch(function () {});
					arm(current);
					return;
				}
				done = true;
				if (a.goto && Story.has(a.goto)) {
					accessGo(a.goto, 'auto', 'chain:' + State.passage);
				}
			}

			placeStyle(box, {place: a.place, corner: a.corner, x: a.x, y: a.y});
			putPlaced(this, box, a, 'chain');
			if (videos.length) {
				$(document).one(':passagedisplay', function () {
					arm(0);
				});
			}
		}
	});

	/* ----- Эффекты текста (шаг 2.1) ----- */

	// Экраны, которые уже показывали: при возврате <<type>> печатает сразу
	// весь текст (ответ 6А). Список попадает в автокопию.
	var seen = {};
	var seenNow = false;

	setup.signaly.seen = seen;
	$(document).on(':passagestart', function (ev) {
		seenNow = settings.typeSeen && !preview && seen[ev.passage.title] === true;
		skipAll = false;
	});
	$(document).on(':passagedisplay', function (ev) {
		seen[ev.passage.title] = true;
	});

	/* ----- Звуки наведения и нажатия (шаг 2.2) ----- */

	// Наборы — в блоке «СИГНАЛЫ: звуки наведения и нажатия» (setup.signalySounds).
	// У ссылки или кнопки звучит набор её вида (ближайший класс вида у неё или
	// вокруг неё), у вида без своего — набор вида «Обычный». Свой звук у элемента
	// — data-sg-hover / data-sg-click ("" — без звука). Из набора — случайный
	// файл; новый звук наведения прерывает предыдущий.
	var uiAudio = {};
	var hoverNow = null;
	var hoverTimer = null;

	function uiSoundOn() {
		return !preview || window.SIGNALY_UI_SOUND === true;
	}

	function uiAudioFor(file) {
		if (!uiAudio[file]) {
			var audio = new Audio(file);

			audio.preload = 'auto';
			audio.sgUi = true;
			uiAudio[file] = audio;
		}
		return uiAudio[file];
	}

	$(document).one(':passagestart', function () {
		var data = setup.signalySounds;

		if (data && data.sets) {
			data.sets.forEach(function (set) {
				(set.files || []).forEach(uiAudioFor);
			});
		}
	});

	function uiSet(el, which) {
		var data = setup.signalySounds;

		if (!data || !data.sets || !data.kinds) {
			return null;
		}

		var own = $(el).closest('[data-sg-' + which + ']');
		var name;

		if (own.length) {
			name = own.attr('data-sg-' + which);
		} else {
			for (var node = el; node && node.nodeType === 1 && name === undefined; node = node.parentNode) {
				for (var i = 0; i < node.classList.length; i++) {
					var kind = data.kinds[node.classList[i]];

					if (kind && kind[which] !== undefined) {
						name = kind[which];
						break;
					}
				}
			}
			if (name === undefined && data.kinds['']) {
				name = data.kinds[''][which];
			}
		}
		if (!name) {
			return null;
		}
		return (
			data.sets.filter(function (set) {
				return set.name === name;
			})[0] || null
		);
	}

	function playSet(set) {
		var files = set.files || [];
		var file = files[Math.floor(Math.random() * files.length)];

		if (!file) {
			return null;
		}

		var audio = uiAudioFor(file);

		audio.volume = Math.max(0, Math.min(1, (set.volume === undefined ? 100 : set.volume) / 100));
		audio.currentTime = 0;
		audio.play().catch(function () {});
		return audio;
	}

	function later(set, play) {
		if (set.delay > 0) {
			return setTimeout(play, set.delay);
		}
		play();
		return null;
	}

	$(document).on('mouseenter', 'a, button', function () {
		if (!uiSoundOn()) {
			return;
		}

		var set = uiSet(this, 'hover');

		clearTimeout(hoverTimer);
		if (hoverNow) {
			hoverNow.pause();
			hoverNow.currentTime = 0;
			hoverNow = null;
		}
		if (set) {
			hoverTimer = later(set, function () {
				hoverNow = playSet(set);
			});
		}
	});
	$(document).on('click', 'a, button', function () {
		var set = uiSoundOn() && uiSet(this, 'click');

		if (set) {
			later(set, function () {
				playSet(set);
			});
		}
	});

	/* ----- Порядок эффектов (сессия 7): «после эффектов выше» ----- */

	// Эффект со словом after (<<type 40ms after>>, <<timed 2s after>>) или span
	// с data-sg-after="1" ждёт, пока всё, что выше по тексту на этом экране,
	// допечатается, появится, сменится или включится, и только потом отсчитывает
	// свою задержку. waits — что ещё не закончилось, waiters — кто ждёт.
	var waits = [];
	var waiters = [];
	var checkTimer = null;

	$(document).on(':passageinit', function () {
		waits = [];
		waiters = [];
	});

	function takeWord(args, word) {
		var at = args.indexOf(word);

		if (at < 1) {
			return false;
		}
		args.splice(at, 1);
		return true;
	}

	function rootOf(node) {
		var el = node.nodeType === 1 ? node : node.parentNode;

		return el && el.closest ? el.closest('#ui-dialog-body, #passages') : null;
	}

	function busyBefore(node) {
		var root = rootOf(node);

		return waits.some(function (w) {
			if (w.node === node || !w.node.isConnected || rootOf(w.node) !== root || !w.pending()) {
				return false;
			}

			var pos = node.compareDocumentPosition(w.node);

			return (pos & Node.DOCUMENT_POSITION_PRECEDING) !== 0 && (pos & Node.DOCUMENT_POSITION_CONTAINS) === 0;
		});
	}

	function runWaiters() {
		checkTimer = null;
		waiters = waiters.filter(function (w) {
			return !w.started && w.node.isConnected;
		});
		waiters.sort(function (a, b) {
			return a.node.compareDocumentPosition(b.node) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
		});
		waiters.forEach(function (w) {
			if (!w.started && w.node.isConnected && !busyBefore(w.node)) {
				w.started = true;
				w.run();
			}
		});
	}

	function check() {
		if (waiters.length && checkTimer === null) {
			checkTimer = setTimeout(runWaiters, 0);
		}
	}

	$(document).on(':passageend :passagedisplay', check);
	setInterval(check, 500);

	function wait(node, run) {
		var waiter = {node: node, run: run, started: false};

		waiters.push(waiter);
		waits.push({
			node: node,
			pending: function () {
				return !waiter.started;
			}
		});
		check();
	}

	// Команда со словом after: на её месте — метка; когда подойдёт очередь,
	// команда выполняется в это место.
	function deferMacro(ctx, run, args) {
		var anchor = document.createComment('sg-after');

		ctx.output.appendChild(anchor);
		wait(anchor, function () {
			var holder = document.createElement('span');
			var parent = anchor.parentNode;

			parent.insertBefore(holder, anchor.nextSibling);
			run(
				Object.create(ctx, {
					_output: {value: holder},
					_debugView: {value: null, writable: true}
				}),
				args
			);
			while (holder.firstChild) {
				parent.insertBefore(holder.firstChild, holder);
			}
			parent.removeChild(holder);
		});
	}

	var typeMacro = Macro.get('type');

	if (typeMacro) {
		var typeHandler = typeMacro.handler;
		var runType = function (ctx, args) {
			var marker = document.createComment('sg-type');
			var was = ctx.self.typeId;

			ctx.output.appendChild(marker);

			var result = typeHandler.apply(ctx, args);
			var id = ctx.self.typeId;

			if (id !== was) {
				waits.push({
					node: marker,
					pending: function () {
						var queue = TempState.macroTypeQueue;

						return !!queue && queue.some(function (item) {
							return item.id === id;
						});
					}
				});
			} else if (marker.parentNode) {
				marker.parentNode.removeChild(marker);
			}
			return result;
		};

		typeMacro.handler = function () {
			var after = takeWord(this.args, 'after');

			if (seenNow && this.args.length) {
				this.args[0] = '0s';
			}
			return after ? deferMacro(this, runType, arguments) : runType(this, arguments);
		};
	}

	var timedMacro = Macro.get('timed');

	if (timedMacro) {
		var timedHandler = timedMacro.handler;
		var timedRegister = timedMacro.registerTimeout;
		var timedNow = null;

		// Появление закончилось — показан последний раздел (и прошла плавность).
		timedMacro.registerTimeout = function (callback, items) {
			var info = timedNow;
			var left = items.length;

			timedNow = null;
			if (!info) {
				return timedRegister.call(this, callback, items);
			}
			info.registered = true;
			return timedRegister.call(
				this,
				function () {
					var result = callback.apply(this, arguments);

					if (--left === 0) {
						setTimeout(function () {
							info.done = true;
							check();
						}, info.fade ? 450 : 0);
					}
					return result;
				},
				items
			);
		};

		var runTimed = function (ctx, args) {
			var info = {done: false, registered: false, fade: ctx.args.length > 1 && /^(?:transition|t8n)$/.test(ctx.args[1])};
			var out = ctx.output;
			var last = out.lastChild;
			var result;

			timedNow = info;
			try {
				result = timedHandler.apply(ctx, args);
			} finally {
				timedNow = null;
			}
			if (info.registered && out.lastChild && out.lastChild !== last) {
				waits.push({
					node: out.lastChild,
					pending: function () {
						return !info.done;
					}
				});
			}
			return result;
		};

		timedMacro.handler = function () {
			return takeWord(this.args, 'after') ? deferMacro(this, runTimed, arguments) : runTimed(this, arguments);
		};
	}

	// Глитч и мигание с началом: data-sg-start="2s" (через N с), data-sg-after="1"
	// (после эффектов выше). До начала — класс sg-off (обычный текст).
	function startSpans(root) {
		$(root)
			.find('[data-sg-start], [data-sg-after]')
			.addBack('[data-sg-start], [data-sg-after]')
			.each(function () {
				var el = this;

				if (el.sgOn !== undefined) {
					return;
				}
				el.sgOn = false;
				el.classList.add('sg-off');

				var go = function () {
					var delay = 0;

					try {
						delay = cssTimeToMS(el.getAttribute('data-sg-start') || '0s');
					} catch (e) {
						delay = 0;
					}
					setTimeout(function () {
						el.sgOn = true;
						el.classList.remove('sg-off');
						check();
					}, delay);
				};

				if (el.getAttribute('data-sg-after')) {
					wait(el, go);
				} else {
					go();
				}
				waits.push({
					node: el,
					pending: function () {
						return !el.sgOn;
					}
				});
			});
	}

	/* ----- Ссылки и глитч в печатающемся тексте (сессия 7) ----- */

	// Ссылка или кнопка внутри <<type>> нажимается, только когда допечатана
	// целиком (пока печатается — класс sg-type-wait). «Тени» глитча печатаются
	// вместе с текстом.
	var typingNow = [];

	function followed(el, wrap) {
		for (var node = el; node && node !== wrap; node = node.parentNode) {
			if (node.nextSibling) {
				return true;
			}
		}
		return false;
	}

	function typingAround(el) {
		return (
			typingNow.some(function (wrap) {
				return (wrap.contains(el) && !followed(el, wrap)) || el.contains(wrap);
			}) ||
			!!el.querySelector('.macro-type-target') ||
			$(el)
				.find('.macro-type:not(.macro-type-done)')
				.toArray()
				.some(function (wrap) {
					return wrap.textContent === '';
				})
		);
	}

	function syncTyping() {
		var waiting = [];

		typingNow.forEach(function (wrap) {
			$(wrap)
				.find('a, button')
				.each(function () {
					if (!followed(this, wrap)) {
						waiting.push(this);
					}
				});
		});
		$('.sg-type-wait').each(function () {
			if (waiting.indexOf(this) === -1) {
				this.classList.remove('sg-type-wait');
			}
		});
		waiting.forEach(function (el) {
			el.classList.add('sg-type-wait');
		});
		$('.glitchy').each(function () {
			var full = this.getAttribute('data-sg-text');

			if (typingAround(this)) {
				if (full === null) {
					full = this.getAttribute('data-text') || '';
					this.setAttribute('data-sg-text', full);
				}
				this.setAttribute('data-text', Array.from(full).slice(0, Array.from(this.textContent).length).join(''));
			} else if (full !== null) {
				this.setAttribute('data-text', full);
				this.removeAttribute('data-sg-text');
			}
		});
	}

	$(document).on(':typingstart', function (ev) {
		typingNow.push(ev.target);
		syncTyping();
	});
	$(document).on(':typingstop', function (ev) {
		setTimeout(function () {
			typingNow = typingNow.filter(function (wrap) {
				return wrap !== ev.target && wrap.isConnected;
			});
			syncTyping();
			check();
		}, 0);
	});
	$(document).on(':passageinit', function () {
		typingNow = [];
	});

	new MutationObserver(function (records) {
		records.forEach(function (record) {
			for (var i = 0; i < record.addedNodes.length; i++) {
				if (record.addedNodes[i].nodeType === 1) {
					startSpans(record.addedNodes[i]);
				}
			}
		});
		if (typingNow.length || document.querySelector('[data-sg-text], .glitchy .macro-type')) {
			syncTyping();
		}
	}).observe(document.body, {childList: true, subtree: true, characterData: true});

	// Щелчок мышью (не по ссылке, кнопке или полю) допечатывает текст сразу —
	// и всё, что на этом экране ещё будет печататься.
	var skipAll = false;

	function skipTyping() {
		setTimeout(function () {
			document.body.dispatchEvent(
				new KeyboardEvent('keydown', {key: Config.macros.typeSkipKey, bubbles: true})
			);
		}, 0);
	}

	$(document).on(':typingstart', function () {
		if (skipAll) {
			skipTyping();
		}
	});
	if (settings.typeClick) {
		document.addEventListener(
			'click',
			function (ev) {
				if (
					!document.querySelector('.macro-type:not(.macro-type-done):not(.macro-type-target)') ||
					$(ev.target).closest('a, button, input, textarea, select, label, #ui-dialog').length
				) {
					return;
				}
				skipAll = true;
				skipTyping();
			},
			true
		);
	}

	/* Экран тревоги: поверх всего экрана, закрывается щелчком, через N секунд
	   или только мастером (Shift+Z+X закрывает любой). */

	var alarmSounds = [];

	function stopAlarmSound(sound) {
		if (sound) {
			sound.pause();
			alarmSounds = alarmSounds.filter(function (s) {
				return s !== sound;
			});
		}
	}

	$(document).on(':passagestart', function () {
		alarmSounds.slice().forEach(stopAlarmSound);
	});

	function closeAlarm(el) {
		if (!el || !el.parentNode || el.getAttribute('data-sg-closed')) {
			return;
		}
		el.setAttribute('data-sg-closed', '1');
		stopAlarmSound(el.sgSound);
		el.parentNode.removeChild(el);

		var target = el.getAttribute('data-sg-goto');

		if (target && Story.has(target)) {
			accessGo(target, 'auto', 'alarm:' + State.passage);
		}
	}

	setup.signaly.closeAlarm = function () {
		var all = document.querySelectorAll('.sg-alarm');

		closeAlarm(all[all.length - 1]);
	};

	Macro.add('sg-alarm', {
		tags: null,
		handler: function () {
			var a = blockArgs(
				this,
				[],
				['bg', 'color', 'size', 'blink', 'sound', 'volume', 'close', 'seconds', 'goto'],
				['loop']
			);
			var el = document.createElement('div');
			var s = el.style;

			el.className = 'sg-alarm';
			s.position = 'fixed';
			s.top = '0';
			s.left = '0';
			s.width = '100%';
			s.height = '100%';
			s.backgroundColor = a.bg || '#cc0000';
			s.color = a.color || '#000000';
			s.display = 'flex';
			s.justifyContent = 'center';
			s.alignItems = 'center';
			s.fontSize = (Number(a.size) || 70) + 'px';
			s.zIndex = '1002';
			if (Number(a.blink) > 0) {
				s.animation = 'sg-alarm-blink ' + Number(a.blink) + 's steps(1, end) infinite';
			}
			if (a.goto) {
				el.setAttribute('data-sg-goto', a.goto);
			}
			$(el).wiki(this.payload[0].contents);
			this.output.appendChild(el);

			if (a.sound) {
				try {
					var sound = new Audio(a.sound);

					sound.loop = !!a.loop;
					sound.volume = Math.max(0, Math.min(1, (a.volume === undefined ? 100 : Number(a.volume)) / 100));
					sound.play().catch(function () {});
					el.sgSound = sound;
					alarmSounds.push(sound);
				} catch (e) {
					console.error('СИГНАЛЫ: звук тревоги', e);
				}
			}
			if (a.close === 'click') {
				el.style.cursor = 'pointer';
				el.addEventListener('click', function () {
					closeAlarm(el);
				});
			} else if (a.close === 'time') {
				setTimeout(function () {
					closeAlarm(el);
				}, Math.max(0, Number(a.seconds) || 5) * 1000);
			}
		}
	});

	/* Окно-сообщение: заголовок, текст или пассаж; закрывается крестиком,
	   только кнопкой «Принято» или само через N секунд. */

	var dialogTurn = 0;

	document.addEventListener(
		'click',
		function (ev) {
			// Пока окно закрывается только кнопкой, щелчок мимо окна его не закрывает.
			if (
				document.documentElement.getAttribute('data-sg-dialog') === 'noclose' &&
				ev.target &&
				ev.target.id === 'ui-overlay'
			) {
				ev.stopPropagation();
				ev.preventDefault();
			}
		},
		true
	);

	function trimContent(text) {
		return String(text || '').replace(/^[ \t]*\n/, '').replace(/\n\s*$/, '');
	}

	setup.signaly.openDialog = function (o) {
		var turn = ++dialogTurn;
		var html = document.documentElement;

		Dialog.create(o.title || '');
		if (o.passage) {
			Dialog.wikiPassage(o.passage);
		} else {
			Dialog.wiki(o.text || '');
		}
		if (o.close === 'ok') {
			html.setAttribute('data-sg-dialog', 'noclose');
			var box = $('<div class="sg-dialog-ok"></div>').appendTo(Dialog.body());

			$('<button type="button" class="ui-close"></button>')
				.text(o.ok || 'Принято')
				.appendTo(box);
		}
		Dialog.open(null, function () {
			if (turn === dialogTurn) {
				html.removeAttribute('data-sg-dialog');
			}
		});
		if (o.close === 'time') {
			setTimeout(function () {
				if (turn === dialogTurn && Dialog.isOpen()) {
					Dialog.close();
				}
			}, Math.max(0, Number(o.seconds) || 5) * 1000);
		}
	};

	Macro.add('sg-dialog', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, ['label'], ['title', 'passage', 'close', 'seconds', 'ok'], ['button']);
			var text = trimContent(this.payload[0].contents);

			actionControl(this.output, a.label === undefined ? '' : a.label, !!a.button, function () {
				setup.signaly.openDialog({
					title: a.title,
					passage: a.passage,
					text: text,
					close: a.close,
					seconds: a.seconds,
					ok: a.ok
				});
			});
		}
	});

	// Действие ссылки или кнопки (шаг 3.2): открыть окно-сообщение —
	// <<sg-open "Заголовок" passage "Пассаж" close ok|time ok "Принято" seconds 5>>текст<</sg-open>>.
	Macro.add('sg-open', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, ['title'], ['passage', 'close', 'seconds', 'ok'], []);

			setup.signaly.openDialog({
				title: a.title,
				passage: a.passage,
				text: trimContent(this.payload[0].contents),
				close: a.close,
				seconds: a.seconds,
				ok: a.ok
			});
		}
	});

	/* Поле кода: таблица «код → действие» прямо в команде. */

	function codeAction(o, code) {
		State.temporary.code = code;
		if (o.sound) {
			try {
				new Audio(o.sound).play().catch(function () {});
			} catch (e) {
				console.error('СИГНАЛЫ: звук поля кода', e);
			}
		}
		if (o.passage || o.text || o.title) {
			setup.signaly.openDialog(o);
		}
		if (o.goto && Story.has(o.goto)) {
			accessGo(o.goto, 'code', String(code));
		}
	}

	/* ----- Общая таблица кодов (шаг 3.4) -----
	   Пассаж с тегом sg-codes («Коды»):
	     <<sg-replies title "Ошибка" wrong "…" denied "…" badpin "…" used "…" ask "…">>
	     <<sg-person "3" pin "417" var "$progress3">>
	     <<sg-entry "205" "Подпись" who "3, 5" once all|each title "…" goto "…" denied "…" used "…">>
	     действия<<sg-answer>>ответ<</sg-entry>>
	   Поле кода со словом table проверяет сначала свои коды, потом таблицу.
	   Если коду важно, кто вводит (who, once each, <<sg-progress>>, _who), —
	   под полем появляется второе поле для личного кода. Отметки одноразовых
	   кодов — в $sgUsed (попадают в автокопию, «Новая игра» их стирает). */

	var codeTable = null;
	var codeCollect = null;
	var codePerson = null;

	Macro.add('sg-person', {
		handler: function () {
			if (!codeCollect) {
				return;
			}

			var a = blockArgs(this, ['id'], ['pin', 'var'], []);

			codeCollect.people.push({
				id: a.id === undefined ? '' : String(a.id),
				pin: a.pin === undefined ? '' : String(a.pin).trim(),
				variable: a['var'] === undefined ? '' : String(a['var']).replace(/^\$/, '')
			});
		}
	});

	Macro.add('sg-replies', {
		handler: function () {
			if (!codeCollect) {
				return;
			}

			var a = blockArgs(this, [], ['title', 'wrong', 'denied', 'badpin', 'used', 'ask'], []);

			Object.keys(a).forEach(function (key) {
				codeCollect.texts[key] = String(a[key]);
			});
		}
	});

	Macro.add('sg-entry', {
		tags: ['sg-answer', 'sg-when'],
		handler: function () {
			if (!codeCollect) {
				return;
			}

			var a = blockArgs(this, ['code', 'label'], ['who', 'once', 'title', 'goto', 'denied', 'used', 'lock'], []);
			var actions = this.payload[0].contents;
			var answer = '';
			var when = '';

			this.payload.slice(1).forEach(function (part) {
				if (part.name === 'sg-answer') {
					answer = trimContent(part.contents);
				} else {
					when = part.contents.trim();
				}
			});

			var who = a.who === undefined ? [] : String(a.who).split(',').map(function (s) {
				return s.trim();
			}).filter(Boolean);

			codeCollect.codes.push({
				code: a.code === undefined ? '' : String(a.code).trim(),
				who: who,
				once: a.once === 'all' || a.once === 'each' ? a.once : '',
				title: a.title === undefined ? '' : String(a.title),
				goto: a.goto === undefined ? '' : String(a.goto),
				denied: a.denied === undefined ? '' : String(a.denied),
				used: a.used === undefined ? '' : String(a.used),
				lock: a.lock === undefined ? '' : String(a.lock),
				when: when,
				run: actions,
				answer: answer,
				pin:
					who.length > 0 ||
					a.once === 'each' ||
					/<<sg-progress[\s>]|\b_who\b/.test(actions + answer + (a.title === undefined ? '' : a.title))
			});
		}
	});

	// Действие «Прогресс вводящего +N»: переменная прогресса того, кто ввёл код.
	Macro.add('sg-progress', {
		handler: function () {
			var n = this.args.length ? Number(this.args[0]) : 1;

			if (!codePerson || !codePerson.variable) {
				return;
			}
			State.variables[codePerson.variable] =
				(Number(State.variables[codePerson.variable]) || 0) + (isFinite(n) ? n : 0);
		}
	});

	function codes() {
		if (codeTable) {
			return codeTable;
		}
		codeTable = {
			people: [],
			codes: [],
			texts: {
				title: 'Ошибка',
				wrong: 'Неверный код',
				denied: 'Нет доступа',
				badpin: 'Неверный личный код',
				used: 'Пусто',
				ask: 'Введите личный код'
			}
		};
		codeCollect = codeTable;
		Story.filter(function (p) {
			return p.tags.indexOf('sg-codes') !== -1;
		}).forEach(function (p) {
			try {
				new Wikifier(document.createDocumentFragment(), p.text);
			} catch (e) {
				console.error('СИГНАЛЫ: таблица кодов', e);
			}
		});
		codeCollect = null;

		// Шаг 3.5: код упомянут в условии «сотрудник ввёл код» — терминал
		// спросит личный код, чтобы знать, кто ввёл.
		var referenced = {};
		var refRe = /setup\.entered\(\s*("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')\s*,\s*("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')\s*\)/g;

		Story.filter(function () {
			return true;
		}).forEach(function (p) {
			var m;

			refRe.lastIndex = 0;
			while ((m = refRe.exec(p.text))) {
				referenced[unquoteArg(m[2]).trim()] = true;
			}
		});
		codeTable.codes.forEach(function (c) {
			if (referenced[c.code]) {
				c.pin = true;
			}
		});
		return codeTable;
	}

	function unquoteArg(s) {
		try {
			return s.charAt(0) === '"' ? JSON.parse(s) : s.slice(1, -1).replace(/\\(.)/g, '$1');
		} catch (e) {
			return s.slice(1, -1);
		}
	}

	function usedMarks() {
		var v = State.variables;

		if (!v.sgUsed || typeof v.sgUsed !== 'object') {
			v.sgUsed = {};
		}
		return v.sgUsed;
	}

	function codeMessage(text) {
		setup.signaly.openDialog({title: codes().texts.title, text: text});
	}

	// Код найден в таблице и проверен: действия, ответ, переход.
	function runTableCode(c, person, value) {
		if (c.once) {
			usedMarks()[c.once === 'each' ? c.code + '|' + person.id : c.code] = true;
		}
		// Шаг 3.5: какие коды ввёл сотрудник — для условий «сотрудник ввёл код».
		if (person) {
			var entered = State.variables.sgEntered;

			if (!entered || typeof entered !== 'object') {
				entered = State.variables.sgEntered = {};
			}
			if (!Array.isArray(entered[person.id])) {
				entered[person.id] = [];
			}
			if (entered[person.id].indexOf(c.code) === -1) {
				entered[person.id].push(c.code);
			}
		}
		State.temporary.code = value;
		State.temporary.who = person ? person.id : '';
		codePerson = person;
		try {
			if (c.run.trim() !== '') {
				Wikifier.wikifyEval(c.run);
			}
		} catch (e) {
			console.error('СИГНАЛЫ: код ' + c.code, e);
		}
		codePerson = null;
		if (c.title || c.answer) {
			setup.signaly.openDialog({title: c.title, text: c.answer});
		}
		if (c.goto && Story.has(c.goto)) {
			accessGo(c.goto, 'code', c.code);
		}
	}

	// Проверка с известным вводящим (или без него, если коду это не важно).
	function checkTableCode(c, person, value) {
		var marks = usedMarks();

		if (person && c.who.length && c.who.indexOf(person.id) === -1) {
			codeMessage(c.denied || codes().texts.denied);
			return;
		}
		if ((c.once === 'all' && marks[c.code]) || (c.once === 'each' && person && marks[c.code + '|' + person.id])) {
			codeMessage(c.used || codes().texts.used);
			return;
		}
		runTableCode(c, person, value);
	}

	function findTableCode(value) {
		var found = null;

		codes().codes.forEach(function (c) {
			if (!found && c.code !== '' && c.code === value) {
				found = c;
			}
		});
		return found;
	}

	// Шаг 4.5: буквы и знаки просто не печатаются (и при вставке из буфера).
	function onlyDigits(el) {
		el.setAttribute('inputmode', 'numeric');
		el.addEventListener('input', function () {
			var clean = el.value.replace(/\D/g, '');

			if (clean !== el.value) {
				var at = el.selectionStart - (el.value.length - clean.length);

				el.value = clean;
				el.setSelectionRange(Math.max(0, at), Math.max(0, at));
			}
		});
	}

	Macro.add('sg-code', {
		tags: ['sg-case', 'sg-wrong'],
		handler: function () {
			var a = blockArgs(this, [], ['var', 'button', 'gap'], ['password', 'focus', 'clear', 'table', 'digits']);
			var cases = [];
			var wrong = null;

			this.payload.slice(1).forEach(function (part) {
				var isCase = part.name === 'sg-case';
				var o = blockArgs(
					{args: part.args},
					isCase ? ['code'] : [],
					['goto', 'title', 'passage', 'sound'],
					[]
				);

				o.text = trimContent(part.contents);
				if (isCase) {
					cases.push(o);
				} else {
					wrong = o;
				}
			});

			var input = document.createElement('input');
			var varName = a['var'] ? String(a['var']).replace(/^\$/, '') : '';

			input.type = a.password ? 'password' : 'text';
			input.className = 'sg-code';
			input.setAttribute('tabindex', '0');
			if (a.digits) {
				onlyDigits(input);
			}
			if (varName) {
				var start = State.variables[varName];

				input.value = start === undefined || start === null ? '' : String(start);
				input.addEventListener('input', function () {
					State.variables[varName] = input.value;
				});
			}

			// Шаг 3.4: второе поле — личный код того, кто вводит.
			var pinHolder = document.createElement('span');

			pinHolder.className = 'sg-code-pin';

			function closePin() {
				while (pinHolder.firstChild) {
					pinHolder.removeChild(pinHolder.firstChild);
				}
			}

			function askPin(entry, value) {
				var texts = codes().texts;
				var pin = document.createElement('input');

				function checkPin() {
					var typed = pin.value.trim();
					var person = null;

					codes().people.forEach(function (p) {
						if (!person && p.pin !== '' && p.pin === typed) {
							person = p;
						}
					});
					closePin();
					if (!person) {
						codeMessage(texts.badpin);
						return;
					}
					checkTableCode(entry, person, value);
				}

				pinHolder.appendChild(document.createElement('br'));
				if (texts.ask) {
					pinHolder.appendChild(document.createTextNode(texts.ask));
					pinHolder.appendChild(document.createElement('br'));
				}
				pin.type = a.password ? 'password' : 'text';
				pin.className = 'sg-code';
				pin.setAttribute('tabindex', '0');
				if (a.digits) {
					onlyDigits(pin);
				}
				pin.addEventListener('keydown', function (ev) {
					if (ev.key === 'Enter') {
						ev.preventDefault();
						checkPin();
					}
				});
				pinHolder.appendChild(pin);
				if (a.button) {
					var gap = a.gap === undefined ? 1 : Math.max(0, Number(a.gap) || 0);

					if (gap === 0) {
						pinHolder.appendChild(document.createTextNode(' '));
					}
					for (var i = 0; i < gap; i++) {
						pinHolder.appendChild(document.createElement('br'));
					}
					actionControl(pinHolder, a.button, true, checkPin);
				}
				pin.focus();
			}

			// Шаг 4.5: у кода своё «когда можно ввести». Раньше времени — как у
			// закрытого экрана: пассаж блокировки, код не тратится.
			function tableEarly(entry) {
				var open = true;

				if (preview || !entry.when) {
					return false;
				}
				try {
					open = !!Scripting.evalTwineScript(entry.when);
				} catch (e) {
					console.error('СИГНАЛЫ: условие кода ' + entry.code, e);
				}
				if (open) {
					return false;
				}

				var shared = Story.filter(function (p) {
					return p.tags.indexOf('sg-lock') !== -1;
				});
				var lock = entry.lock && Story.has(entry.lock) ? entry.lock : shared.length ? shared[0].title : '';

				if (!lock || lock === State.passage) {
					codeMessage(codes().texts.wrong);
					return true;
				}
				State.variables.sgEventFrom = State.passage;
				accessSkip = true;
				try {
					Engine.play(lock);
				} finally {
					accessSkip = false;
				}
				return true;
			}

			function tableEntry(entry, value) {
				if (entry.once === 'all' && usedMarks()[entry.code]) {
					codeMessage(entry.used || codes().texts.used);
				} else if (tableEarly(entry)) {
					return;
				} else if (accessEarly(entry.goto, entry.code, tableRefuse(entry))) {
					return;
				} else if (entry.pin) {
					askPin(entry, value);
				} else {
					checkTableCode(entry, null, value);
				}
			}

			// Шаг 4.3: чем ответить, если код пришёл на закрытый экран раньше времени.
			function tableRefuse(entry) {
				return {
					wrong: function () {
						codeMessage(codes().texts.wrong);
					},
					denied: function () {
						codeMessage(entry.denied || codes().texts.denied);
					}
				};
			}

			function fieldRefuse(value) {
				return {
					wrong: function () {
						if (wrong) {
							codeAction(wrong, value);
						} else {
							codeMessage(codes().texts.wrong);
						}
					},
					denied: function () {
						codeMessage(codes().texts.denied);
					}
				};
			}

			function confirm() {
				var value = input.value;
				var found = null;
				var entry = null;

				cases.forEach(function (c) {
					if (!found && String(c.code) === value) {
						found = c;
					}
				});
				if (a.clear) {
					input.value = '';
					if (varName) {
						State.variables[varName] = '';
					}
				}
				closePin();
				if (!found && a.table) {
					entry = findTableCode(value.trim());
				}
				if (found && accessEarly(found.goto, String(found.code), fieldRefuse(value))) {
					return;
				}
				if (found) {
					codeAction(found, value);
				} else if (entry) {
					tableEntry(entry, value.trim());
				} else if (wrong) {
					codeAction(wrong, value);
				} else if (a.table) {
					State.temporary.code = value;
					codeMessage(codes().texts.wrong);
				}
			}

			input.addEventListener('keydown', function (ev) {
				if (ev.key === 'Enter') {
					ev.preventDefault();
					confirm();
				}
			});
			this.output.appendChild(input);

			if (a.button) {
				var gap = a.gap === undefined ? 1 : Math.max(0, Number(a.gap) || 0);

				if (gap === 0) {
					this.output.appendChild(document.createTextNode(' '));
				}
				for (var i = 0; i < gap; i++) {
					this.output.appendChild(document.createElement('br'));
				}
				actionControl(this.output, a.button, true, confirm);
			}
			if (a.table) {
				this.output.appendChild(pinHolder);
			}
			if (a.focus) {
				$(document).one(':passagedisplay', function () {
					input.focus();
				});
			}
		}
	});

	/* Окно KR2 (экран с тегом kr2): текст и навигация, картинка, статусы.
	   Если в JavaScript истории остался свой код KR2 — движок его не трогает. */

	$(document).one(':passageinit', function () {
		if (Macro.has('kr2image') || Macro.has('kr2vars') || Macro.has('kr2main')) {
			return;
		}

		var kr2 = null;

		function reset() {
			kr2 = {image: '', vars: null, main: null, cols: null, rows: null};
		}

		function render(contents) {
			var tmp = $('<div style="display:none"></div>').appendTo(document.body);
			var frag = document.createDocumentFragment();

			tmp.wiki(contents);
			while (tmp[0].firstChild) {
				frag.appendChild(tmp[0].firstChild);
			}
			tmp.remove();
			return frag;
		}

		reset();

		Macro.add('kr2image', {
			handler: function () {
				kr2.image = this.args[0] || '';
			}
		});
		Macro.add('kr2layout', {
			handler: function () {
				kr2.cols = Number(this.args[0]) || null;
				kr2.rows = Number(this.args[1]) || null;
			}
		});
		Macro.add('kr2vars', {
			tags: null,
			handler: function () {
				kr2.vars = render(this.payload[0].contents);
			}
		});
		Macro.add('kr2main', {
			tags: null,
			handler: function () {
				kr2.main = render(this.payload[0].contents);
			}
		});

		$(document).on(':passagestart', function () {
			reset();
			$('#kr2-overlay').remove();
		});

		$(document).on(':passageend', function () {
			var passage = Story.get(State.passage);
			var $passages = $('#passages');

			if (!passage.tags.includes('kr2')) {
				$passages.removeClass('kr2-layout').css({gridTemplateColumns: '', gridTemplateRows: ''});
				return;
			}

			$passages.addClass('kr2-layout').css({
				gridTemplateColumns: kr2.cols ? kr2.cols + '% ' + (100 - kr2.cols) + '%' : '',
				gridTemplateRows: kr2.rows ? kr2.rows + '% ' + (100 - kr2.rows) + '%' : ''
			});

			var $passageEl = $passages.find('.passage');
			var $main = $('<div id="kr2-main"></div>');
			var $nav = $('<div id="kr2-nav"></div>');
			var $vars = $('<div id="kr2-vars"></div>');
			var $img = $('<div id="kr2-image"></div>');
			var image = kr2.image;

			if (kr2.vars) {
				$vars.append(kr2.vars);
			}
			$passageEl.find('a, button').each(function () {
				$nav.append(this);
			});
			if (kr2.main) {
				$main.append(kr2.main);
			} else {
				$passageEl.find('p').each(function () {
					if ($(this).text().trim() === '' && $(this).children().length === 0) {
						$(this).remove();
					}
				});
				$main.append($passageEl.contents());
			}
			if (image) {
				$('<img>').attr('src', image).attr('alt', '').appendTo($img);
			}

			// Щелчок по картинке — во весь терминал; ещё щелчок — обратно.
			$img.on('click', function () {
				if ($('#kr2-overlay').length) {
					$('#kr2-overlay').remove();
					return;
				}
				if (!image) {
					return;
				}

				var $overlay = $('<div id="kr2-overlay"></div>');

				$('<img>').attr('src', image).attr('alt', '').appendTo($overlay);
				$overlay.on('click', function () {
					$(this).remove();
				});
				$passages.append($overlay);
			});

			$passageEl.empty().append($main, $nav, $img, $vars);
		});
	});

	/* ----- События, заходы на экраны, коды сотрудников (шаг 3.5) ----- */

	/* Событие — пассаж с тегом sg-event, первой строкой
	     <<sg-event [repeat] [delay N] [priority N] условие>>.
	   Терминал сам переходит на него, когда условие станет верным (проверка —
	   при каждом изменении и 4 раза в секунду). Отметки событий — $sgEvents,
	   откуда перешли — $sgEventFrom, заходы на экраны — $sgVisits, коды,
	   введённые сотрудниками, — $sgEntered (всё попадает в автокопию,
	   «Новая игра» стирает). */

	// В самом экране команда события ничего не показывает.
	Macro.add('sg-event', {
		skipArgs: true,
		handler: function () {}
	});

	function varObject(name) {
		var v = State.variables;

		if (!v[name] || typeof v[name] !== 'object') {
			v[name] = {};
		}
		return v[name];
	}

	// Сколько раз заходили на экран (свой счётчик: у SugarCube история в один
	// шаг, а после сбоя visited() начинает заново).
	setup.visits = function (title) {
		var visits = State.variables.sgVisits;

		return (visits && Number(visits[String(title)])) || 0;
	};

	// Ввёл ли сотрудник код общей таблицы кодов.
	setup.entered = function (person, code) {
		var entered = State.variables.sgEntered;
		var list = entered && entered[String(person).trim()];

		return Array.isArray(list) && list.indexOf(String(code).trim()) !== -1;
	};

	var prevPassage = '';

	$(document).on(':passageinit', function () {
		prevPassage = State.passage;
	});

	$(document).on(':passagestart', function (ev) {
		// После сбоя тот же экран показывается заново — это не новый заход.
		if (restoring) {
			return;
		}

		var visits = varObject('sgVisits');
		var title = ev.passage.title;

		visits[title] = (Number(visits[title]) || 0) + 1;
	});

	// «Вернуться на экран, где были»: туда, откуда терминал перешёл на
	// событие; если события не было — на предыдущий экран.
	function goBack(target) {
		setTimeout(function () {
			// Назад ведёт туда, где уже были, — доступ не проверяется.
			accessSkip = true;
			articleReturn = true;
			try {
				Engine.play(target);
			} finally {
				accessSkip = false;
			}
		}, Engine.DOM_DELAY || 40);
	}

	Macro.add('sg-back', {
		handler: function () {
			var target = State.variables.sgEventFrom || prevPassage;

			if (target && Story.has(target)) {
				goBack(target);
			}
		}
	});

	/* ----- Статьи (шаг 4.4) ----- */

	// Экран с тегом sg-article: первой строкой <<sg-article title … section …
	// order … back …>>. На самом экране команда ничего не выводит.
	// <<sg-articles>> собирает список при показе экрана, поэтому новая статья
	// попадает в него сама; закрытые статьи скрывает accessScan, как любую
	// ссылку. Внизу статьи — ссылка «Назад» на экран, откуда статью открыли:
	// $sgArticles = {"Статья": "Откуда"}. Возврат не переписывает запись, поэтому
	// цепочка «список → статья → другая статья» разматывается назад до списка.
	var articleCollect = null;
	var articleTable = null;
	var articleReturn = false;

	Macro.add('sg-article', {
		handler: function () {
			if (articleCollect) {
				var a = blockArgs(this, [], ['title', 'section', 'order', 'back'], []);

				articleCollect.title = String(a.title || articleCollect.name);
				articleCollect.section = String(a.section || '');
				articleCollect.order = Number(a.order) || 0;
				articleCollect.back = String(a.back || '');
			}
		}
	});

	function articles() {
		if (articleTable) {
			return articleTable;
		}
		articleTable = {};
		Story.filter(function (p) {
			return p.tags.indexOf('sg-article') !== -1;
		}).forEach(function (p) {
			var rec = {name: p.title, title: p.title, section: '', order: 0, back: ''};
			var m = /<<sg-article(?=[\s>])/.exec(p.text);
			var end = m ? macroEnd(p.text, m.index + 2) : -1;

			articleTable[p.title] = rec;
			if (end === -1) {
				return;
			}
			articleCollect = rec;
			try {
				new Wikifier(document.createDocumentFragment(), p.text.slice(m.index, end + 2));
			} catch (e) {
				console.error('СИГНАЛЫ: статья «' + p.title + '»', e);
			}
			articleCollect = null;
		});
		return articleTable;
	}

	// Разделы: по наименьшему порядку статьи в них, потом по названию; статьи
	// без раздела — в конце. Внутри раздела — по порядку, потом по названию.
	function articleGroups(picked) {
		var table = articles();
		var groups = [];
		var bySection = {};

		Object.keys(table)
			.map(function (name) {
				return table[name];
			})
			.filter(function (rec) {
				return !picked.length || picked.indexOf(rec.section) !== -1;
			})
			.sort(function (x, y) {
				return x.order - y.order || x.title.localeCompare(y.title, 'ru');
			})
			.forEach(function (rec) {
				var key = 's:' + rec.section;

				if (!bySection[key]) {
					bySection[key] = {name: rec.section, order: rec.order, items: []};
					groups.push(bySection[key]);
				}
				bySection[key].items.push(rec);
			});
		return groups.sort(function (x, y) {
			if (!x.name !== !y.name) {
				return x.name ? -1 : 1;
			}
			return x.order - y.order || x.name.localeCompare(y.name, 'ru');
		});
	}

	Macro.add('sg-articles', {
		handler: function () {
			var a = blockArgs(this, [], ['sections', 'form', 'kind', 'columns'], ['headings']);
			var picked = String(a.sections || '')
				.split(',')
				.map(function (name) {
					return name.trim();
				})
				.filter(Boolean);
			var tag = a.form === 'button' ? 'button' : 'link';
			var columns = Math.max(1, Math.round(Number(a.columns)) || 1);
			var box = document.createElement('div');

			box.className = 'sg-art-list';
			articleGroups(picked).forEach(function (group) {
				var section = document.createElement('div');
				var grid = document.createElement('div');

				section.className = 'sg-art-section';
				if (a.headings && group.name) {
					var heading = document.createElement('div');

					heading.className = 'sg-art-heading';
					heading.textContent = group.name;
					section.appendChild(heading);
				}
				grid.className = 'sg-art-grid';
				grid.style.gridTemplateColumns = 'repeat(' + columns + ', minmax(0, 1fr))';
				group.items.forEach(function (rec) {
					var item = document.createElement('div');
					var inner = item;

					item.className = 'sg-art-item';
					if (a.kind) {
						inner = document.createElement('span');
						inner.className = String(a.kind);
						item.appendChild(inner);
					}
					$(inner).wiki(
						'<<' + tag + ' ' + JSON.stringify(rec.title) + ' ' + JSON.stringify(rec.name) + '>><</' + tag + '>>'
					);
					grid.appendChild(item);
				});
				section.appendChild(grid);
				box.appendChild(section);
			});
			this.output.appendChild(box);
		}
	});

	function articleFrom(title) {
		var map = State.variables.sgArticles;
		var from = map && map[title];

		return from && Story.has(from) ? from : '';
	}

	Macro.add('sg-article-back', {
		handler: function () {
			var from = articleFrom(State.passage);

			if (from) {
				goBack(from);
			}
		}
	});

	// Откуда открыли статью. Обработчик стоит раньше saveEntry, поэтому запись
	// попадает в автокопию; после сбоя «Назад» ведёт туда же.
	$(document).on(':passagestart', function (ev) {
		var returning = articleReturn;
		var title = ev.passage.title;

		articleReturn = false;
		if (!restoring && !returning && prevPassage && prevPassage !== title && articles()[title]) {
			varObject('sgArticles')[title] = prevPassage;
		}
	});

	$(document).on(':passagedisplay', function (ev) {
		var rec = articles()[State.passage];

		if (!rec || (!preview && !articleFrom(State.passage))) {
			return;
		}

		var box = document.createElement('div');
		var inner = box;
		var kind = String(opt('article-kind', ''));
		var tag = opt('article-button', 0) ? 'button' : 'link';
		var label = rec.back || String(opt('article-back', 'Назад'));

		box.className = 'sg-art-back';
		if (kind) {
			inner = document.createElement('span');
			inner.className = kind;
			box.appendChild(inner);
		}
		$(inner).wiki('<<' + tag + ' ' + JSON.stringify(label) + '>><<sg-article-back>><</' + tag + '>>');
		ev.content.appendChild(box);
	});

	/* ----- Список состояний (шаг 5.1) ----- */

	// Процедуры и системы ИНЖИНАРИУМА: <<sg-list>> с <<sg-state>> (надпись, вид,
	// цвет и действие состояния — одни на весь список) и <<sg-row>> (номер,
	// название, переменная, экран). Состояние строки — значение её переменной:
	// пустая считается 0, значения нет в списке — первое состояние. Значение
	// меняется кодом или клавишей, поэтому строка перерисовывается сама.
	// В предпросмотре строки показаны в разных состояниях: видны все сразу.
	var listTimer = 0;

	function listFill(text, row) {
		return String(text === undefined ? '' : text)
			.split('{номер}')
			.join(String(row.num === undefined ? '' : row.num))
			.split('{название}')
			.join(String(row.name === undefined ? '' : row.name));
	}

	function listIndex(info) {
		var states = info.list.states;

		if (preview) {
			return info.index % states.length;
		}

		var value = info.row['var'] ? State.getVar(String(info.row['var'])) : undefined;
		var text = value === undefined || value === null || value === false ? '0' : value === true ? '1' : String(value);

		for (var i = 0; i < states.length; i++) {
			if (String(states[i].value) === text) {
				return i;
			}
		}
		return 0;
	}

	function listSpan(cls, text) {
		var span = document.createElement('span');

		span.className = cls;
		span.textContent = text;
		return span;
	}

	function listDraw(item) {
		var info = item.sgList;
		var list = info.list;
		var row = info.row;
		var index = listIndex(info);
		var st = list.states[index];
		var key = row.key && st.keykind;
		var kind = key ? st.keykind : st.kind;
		var color = key ? '' : st.color;
		var label = listFill(st.label, row);
		var name = String(row.name || row.num || '');
		var way = st['do'];
		var go = way === 'row' ? row.passage : way ? '' : st.goto;
		var body = listFill(st.text, row);
		var tile = list.form === 'tile';
		var inner = item;
		var el;

		info.state = index;
		item.textContent = '';
		go = go && Story.has(String(go)) ? String(go) : '';
		if (way === 'window' && row.passage && Story.has(String(row.passage))) {
			body +=
				'<<sg-open ' +
				JSON.stringify(listFill(st.title || '{название}', row)) +
				' passage ' +
				JSON.stringify(String(row.passage)) +
				'>><</sg-open>>';
		}
		if (kind) {
			inner = document.createElement('span');
			inner.className = String(kind);
			item.appendChild(inner);
		}
		if (tile && !go && !body) {
			el = document.createElement('div');
			el.className = 'sg-tile';
			inner.appendChild(el);
		} else {
			var tag = list.form === 'button' ? 'button' : 'link';

			$(inner).wiki(
				'<<' + tag + ' ' + JSON.stringify(label || name || '—') + (go ? ' ' + JSON.stringify(go) : '') + '>>' + body + '<</' + tag + '>>'
			);
			el = inner.querySelector('a, button');
			if (el && tile) {
				el.classList.add('sg-tile');
				el.textContent = '';
			}
		}
		if (!el) {
			return;
		}
		if (tile) {
			el.appendChild(listSpan('sg-tile-name', listFill('{название}', row) || name));
			el.appendChild(listSpan('sg-tile-status', label));
		}
		// Правило «Доступа»: у строки — её название, у состояния со своим
		// экраном — надпись состояния (она одна на весь список).
		el.setAttribute('data-sg-label', way || !st.goto ? name : String(st.label || ''));
		if (color) {
			el.classList.add('sg-list-color');
			el.style.setProperty('--sg-state', String(color));
		}
	}

	function listTick() {
		var items = document.querySelectorAll('.sg-list-item');

		for (var i = 0; i < items.length; i++) {
			if (items[i].sgList && listIndex(items[i].sgList) !== items[i].sgList.state) {
				listDraw(items[i]);
			}
		}
	}

	Macro.add('sg-list', {
		tags: ['sg-state', 'sg-row'],
		handler: function () {
			var a = blockArgs(this, [], ['form', 'columns'], []);
			var list = {form: a.form === 'button' || a.form === 'tile' ? a.form : 'link', states: [], rows: []};
			var columns = Math.max(1, Math.round(Number(a.columns)) || 1);
			var grid = document.createElement('div');

			this.payload.slice(1).forEach(function (part) {
				if (part.name === 'sg-state') {
					var st = blockArgs({args: part.args}, ['value'], ['label', 'kind', 'color', 'keykind', 'do', 'goto', 'title'], []);

					st.text = trimContent(part.contents);
					list.states.push(st);
				} else {
					list.rows.push(blockArgs({args: part.args}, ['num', 'name'], ['var', 'passage'], ['key']));
				}
			});
			grid.className = 'sg-list-grid' + (list.form === 'tile' ? ' sg-list-tiles' : '');
			grid.style.gridTemplateColumns = 'repeat(' + columns + ', minmax(0, 1fr))';
			if (list.states.length) {
				list.rows.forEach(function (row, index) {
					var item = document.createElement('div');

					item.className = 'sg-list-item';
					item.sgList = {list: list, row: row, index: index, state: -1};
					grid.appendChild(item);
					listDraw(item);
				});
			}
			this.output.appendChild(grid);
			if (!listTimer && !preview) {
				listTimer = setInterval(listTick, 250);
			}
		}
	});

	/* ----- Закрытые экраны (шаг 4.3) ----- */

	// Экран с тегом sg-access: <<sg-access слова>>условие<<sg-rule …>><</sg-access>>.
	// Условие верно — экран открыт. Пока оно ложно, каждый источник (ссылка,
	// код, клавиша мастера, событие, таймер, тревога, цепочка видео) ведёт себя,
	// как задано: hide, off, block, pass, wrong, denied, stay. Общий пассаж
	// блокировки — пассаж с тегом sg-lock.
	var accessCollect = null;
	var accessTable = null;
	var accessSkip = false;
	var accessLink = null;

	Macro.add('sg-access', {
		tags: ['sg-rule'],
		handler: function () {
			if (!accessCollect) {
				return;
			}

			var a = blockArgs(this, [], ['lock', 'links', 'codes', 'keys', 'events', 'auto'], []);
			var rec = {
				name: accessCollect.name,
				expr: this.payload[0].contents.trim(),
				lock: a.lock === undefined ? '' : String(a.lock),
				groups: {
					link: a.links || 'hide',
					code: a.codes || 'block',
					key: a.keys || 'pass',
					event: a.events || 'pass',
					auto: a.auto || 'pass'
				},
				rules: {}
			};

			this.payload.slice(1).forEach(function (part) {
				var kind = String(part.args[0]);
				var o = blockArgs({args: part.args.slice(2)}, [], ['from', 'do', 'to'], []);
				var id = String(part.args[1]);

				if (kind === 'link') {
					id = String(o.from) + '\n' + id;
				} else if (kind === 'key') {
					id = comboName(id);
				}
				rec.rules[kind + '\n' + id] = {action: String(o['do']), to: o.to === undefined ? '' : String(o.to)};
			});
			accessCollect.table[rec.name] = rec;
		}
	});

	function access() {
		if (accessTable) {
			return accessTable;
		}
		accessTable = {};
		Story.filter(function (p) {
			return p.tags.indexOf('sg-access') !== -1;
		}).forEach(function (p) {
			var open = p.text.indexOf('<<sg-access');
			var close = p.text.indexOf('<</sg-access>>', open);

			if (open === -1 || close === -1) {
				return;
			}
			accessCollect = {name: p.title, table: accessTable};
			try {
				new Wikifier(document.createDocumentFragment(), p.text.slice(open, close + '<</sg-access>>'.length));
			} catch (e) {
				console.error('СИГНАЛЫ: доступ к экрану «' + p.title + '»', e);
			}
			accessCollect = null;
		});
		return accessTable;
	}

	function accessClosed(title) {
		var rec = access()[title];

		if (!rec || rec.expr === '') {
			return false;
		}
		try {
			return !Scripting.evalTwineScript(rec.expr);
		} catch (e) {
			if (!rec.failed) {
				rec.failed = true;
				console.error('СИГНАЛЫ: условие доступа к экрану «' + title + '»', e);
			}
			return false;
		}
	}

	function accessRule(title, kind, id) {
		var rec = access()[title];

		return rec.rules[kind + '\n' + id] || {action: rec.groups[kind] || 'pass', to: ''};
	}

	// Куда уводит блокировка: свой пассаж источника, экрана, общий.
	function accessLock(title, rule) {
		var rec = access()[title];
		var shared = Story.filter(function (p) {
			return p.tags.indexOf('sg-lock') !== -1;
		});
		var to = rule.to || rec.lock || (shared.length ? shared[0].title : '');

		return to && to !== title && Story.has(to) ? to : '';
	}

	// Куда на самом деле вести; null — остаться на месте.
	function accessRoute(dest, kind, id) {
		var from = State.passage;

		if (preview || restoring || !from || dest === from || !accessClosed(dest)) {
			return dest;
		}

		var rule = accessRule(dest, kind, id);

		if (rule.action === 'pass') {
			return dest;
		}
		if (rule.action === 'stay') {
			return null;
		}

		var lock = accessLock(dest, rule);

		if (!lock || lock === from) {
			return null;
		}
		// «Вернуться на экран, где были» ведёт туда, откуда пришли (ответ 5А).
		State.variables.sgEventFrom = from;
		return lock;
	}

	function accessGo(dest, kind, id) {
		var to = accessRoute(dest, kind, id);

		if (to === null) {
			return false;
		}
		accessSkip = true;
		try {
			Engine.play(to);
		} finally {
			accessSkip = false;
		}
		return true;
	}

	// Код ведёт на закрытый экран: true — код не принят (действия не выполнены,
	// одноразовый не потрачен).
	function accessEarly(dest, code, refuse) {
		if (preview || !dest || !Story.has(dest) || dest === State.passage || !accessClosed(dest)) {
			return false;
		}

		var rule = accessRule(dest, 'code', code);

		if (rule.action === 'pass') {
			return false;
		}
		if (rule.action === 'denied') {
			refuse.denied();
			return true;
		}
		if (rule.action === 'block' && accessLock(dest, rule) && accessGo(dest, 'code', code)) {
			return true;
		}
		refuse.wrong();
		return true;
	}

	// Событие на закрытый экран с поведением «ждать».
	function accessWaits(name) {
		return !!access()[name] && accessClosed(name) && accessRule(name, 'event', '').action === 'stay';
	}

	function accessLinkId(el) {
		var label = el.getAttribute('data-sg-label');

		return State.passage + '\n' + (label === null ? el.textContent : label).replace(/\s+/g, ' ').trim();
	}

	// Поведение ссылки: своё правило или общее. Пока надпись печатается, она
	// совпадает с правилом только началом.
	function accessLinkRule(title, el) {
		var rec = access()[title];
		var id = accessLinkId(el);
		var key = 'link\n' + id;

		if (rec.rules[key]) {
			return rec.rules[key];
		}
		if (el.closest('.macro-type:not(.macro-type-done):not(.macro-type-target)')) {
			var keys = Object.keys(rec.rules);

			for (var i = 0; i < keys.length; i++) {
				if (keys[i].indexOf(key) === 0) {
					return rec.rules[keys[i]];
				}
			}
		}
		return {action: rec.groups.link || 'hide', to: ''};
	}

	function accessLineEdge(node, side) {
		var next = node[side];

		while (
			next &&
			((next.nodeType === 3 && next.nodeValue.trim() === '') ||
				(next.nodeType === 1 && next.classList.contains('sg-acc-hide')))
		) {
			next = next[side];
		}
		return next;
	}

	// В обёртке нет ничего, кроме node и уже скрытого.
	function accessOnly(span, node) {
		for (var c = span.firstChild; c; c = c.nextSibling) {
			var empty =
				c === node ||
				(c.nodeType === 3 && c.nodeValue.trim() === '') ||
				(c.nodeType === 1 && (c.tagName === 'BR' || c.classList.contains('sg-acc-hide')));

			if (!empty) {
				return false;
			}
		}
		return true;
	}

	function isBr(node) {
		return !!node && node.nodeType === 1 && node.tagName === 'BR';
	}

	// Ответ 4А: ссылка исчезает вместе с обёрткой вида и переводом строки, если
	// в строке больше ничего нет; кнопка на экране исчезает целиком.
	function accessHide(el) {
		var top = el.closest('.sg-place, .sg-art-item, .sg-list-item');

		if (top) {
			top.classList.add('sg-acc-hide');
			return;
		}
		top = el;
		while (top.parentNode.tagName === 'SPAN' && accessOnly(top.parentNode, top)) {
			top = top.parentNode;
		}
		top.classList.add('sg-acc-hide');

		var before = accessLineEdge(top, 'previousSibling');
		var after = accessLineEdge(top, 'nextSibling');

		if ((before && !isBr(before)) || (after && !isBr(after))) {
			return;
		}
		if (isBr(after)) {
			after.classList.add('sg-acc-hide');
		} else if (isBr(before)) {
			before.classList.add('sg-acc-hide');
		}
	}

	function accessScan() {
		var marked = document.querySelectorAll('.sg-acc-hide, .sg-acc-off');

		for (var i = 0; i < marked.length; i++) {
			var el = marked[i];

			el.classList.remove('sg-acc-hide');
			if (el.classList.contains('sg-acc-off')) {
				el.classList.remove('sg-acc-off');
				el.removeAttribute('aria-disabled');
				el.setAttribute('tabindex', '0');
			}
		}

		var links = document.querySelectorAll('a[data-passage], button[data-passage]');

		for (var j = 0; j < links.length; j++) {
			var link = links[j];
			var title = link.getAttribute('data-passage');

			if (!access()[title] || title === State.passage || !accessClosed(title)) {
				continue;
			}

			var rule = accessLinkRule(title, link);
			var action = rule.action;

			// Некуда вести — ссылка просто не нажимается.
			if (action === 'block' && !accessLock(title, rule)) {
				action = 'off';
			}
			if (action === 'hide') {
				accessHide(link);
			} else if (action === 'off') {
				link.classList.add('sg-acc-off');
				link.setAttribute('aria-disabled', 'true');
				link.setAttribute('tabindex', '-1');
			}
		}

		// Шаг 4.4: раздел, в котором все статьи скрыты, исчезает с заголовком.
		var sections = document.querySelectorAll('.sg-art-section');

		for (var k = 0; k < sections.length; k++) {
			if (!sections[k].querySelector('.sg-art-item:not(.sg-acc-hide)')) {
				sections[k].classList.add('sg-acc-hide');
			}
		}
	}

	/* ----- Строка событий и цикл (шаг 4.1) ----- */

	// Настройки — пассаж с тегом sg-ticker: <<sg-ticker>>, <<sg-cycle>>,
	// <<sg-cycle-at>>, <<sg-news>>. Строка стоит только на одном экране
	// (главном); условия и смена цикла проверяются всё время, на любом экране.
	// $sgTicker = {msgs: {имя: {at, shown}}, cycle, seen}: когда сообщение
	// включилось и сколько раз показано; цикл сейчас; цикл, который видели.
	var tickerCollect = null;
	var tickerTable = null;
	var tickerStrip = null;
	var tickerLine = null;
	var tickerNum = null;
	var tickerSpin = null;
	var tk = {phase: 'idle', at: 0, cur: null, old: null, round: {}, active: [], live: {}, general: null};

	engineStyle.textContent +=
		'#sg-ticker { position: sticky; top: calc(-1 * var(--sg-win-padding, 20px)); z-index: 10; display: flex; gap: 6px; box-sizing: border-box; ' +
		'padding: 4px; margin: calc(-1 * var(--sg-win-padding, 20px)) calc(-1 * var(--sg-win-padding, 20px)) 8px; ' +
		'background: var(--sg-win-bg, #000); line-height: 1.2; }\n' +
		'.sg-tk-box { box-sizing: border-box; background: var(--sg-win-bg, #000); ' +
		'border: var(--sg-border-width, 2px) solid var(--sg-border-color, currentColor); ' +
		'box-shadow: 0 0 var(--sg-glow-size, 0) var(--sg-glow-color, transparent); }\n' +
		'.sg-tk-line { flex: 1 1 auto; min-width: 0; position: relative; overflow: hidden; }\n' +
		'.sg-tk-msg { position: absolute; left: 10px; top: 50%; white-space: nowrap; will-change: transform, opacity; }\n' +
		'.sg-tk-cycle { flex: 0 0 auto; display: flex; align-items: center; gap: 0.5em; padding: 0 12px; white-space: nowrap; }\n' +
		'.sg-tk-num span { display: inline-block; width: 1ch; text-align: center; }\n';

	Macro.add('sg-ticker', {
		handler: function () {
			if (tickerCollect) {
				tickerCollect.line = blockArgs(this, [], ['screen', 'height', 'size', 'font', 'speed', 'pause', 'hold', 'change', 'mode', 'order'], []);
			}
		}
	});

	Macro.add('sg-cycle', {
		handler: function () {
			if (tickerCollect) {
				tickerCollect.cycle = blockArgs(this, [], ['var', 'spin', 'gap', 'from', 'to', 'rate', 'sound', 'volume'], []);
			}
		}
	});

	Macro.add('sg-cycle-at', {
		handler: function () {
			if (tickerCollect) {
				var a = blockArgs(this, ['progress', 'value'], [], []);

				tickerCollect.rows.push({progress: Number(a.progress) || 0, value: String(a.value === undefined ? '' : a.value)});
			}
		}
	});

	Macro.add('sg-news', {
		tags: ['sg-text'],
		handler: function () {
			if (!tickerCollect) {
				return;
			}

			var a = blockArgs(this, ['name'], ['priority', 'minutes', 'times', 'color', 'effect'], ['general', 'bold', 'italic']);

			a.name = String(a.name === undefined ? '' : a.name);
			a.expr = this.payload[0].contents.trim();
			a.text = this.payload[1] ? this.payload[1].contents.trim() : '';
			a.priority = Number(a.priority) || 0;
			a.minutes = Number(a.minutes) || 0;
			a.times = Number(a.times) || 0;
			a.index = tickerCollect.news.length;
			tickerCollect.news.push(a);
		}
	});

	function ticker() {
		if (tickerTable !== null) {
			return tickerTable;
		}

		var t = {line: null, cycle: null, rows: [], news: []};

		tickerCollect = t;
		Story.filter(function (p) {
			return p.tags.indexOf('sg-ticker') !== -1;
		}).forEach(function (p) {
			try {
				new Wikifier(document.createDocumentFragment(), p.text);
			} catch (e) {
				console.error('СИГНАЛЫ: строка событий', e);
			}
		});
		tickerCollect = null;
		if (!t.line) {
			tickerTable = false;
			return false;
		}

		var a = t.line;
		var number = function (value, fallback) {
			var n = Number(value);

			return value === undefined || isNaN(n) ? fallback : n;
		};

		t.line = {
			screen: String(a.screen || ''),
			height: number(a.height, 48),
			size: number(a.size, 22),
			font: String(a.font || ''),
			speed: Math.max(1, number(a.speed, 60)),
			pause: number(a.pause, 2),
			hold: number(a.hold, 8),
			change: number(a.change, 1.5),
			mode: a.mode === 'scroll' ? 'scroll' : 'fade',
			order: String(a.order || 'new,general,seen').split(',')
		};
		if (t.cycle) {
			t.cycle.name = String(t.cycle['var'] || '').replace(/^\$/, '');
			t.cycle.spin = number(t.cycle.spin, 10);
			t.cycle.gap = Math.max(0, number(t.cycle.gap, 0.5));
			// rate — запись сборок до сессии 15: одна скорость в начале на все цифры.
			var firstRate = number(t.cycle.rate, 20);

			t.cycle.from = digitRates(t.cycle.from, firstRate);
			t.cycle.to = digitRates(t.cycle.to, t.cycle.rate === undefined ? 2 : Math.max(1, Math.round(firstRate / 15)));
			t.cycle.volume = number(t.cycle.volume, 100);
			if (!preview && t.cycle.sound) {
				signalFor(String(t.cycle.sound));
			}
			t.rows.sort(function (x, y) {
				return x.progress - y.progress;
			});
		}
		tickerTable = t;
		return t;
	}

	// Скорости пяти цифр слева направо: «20,20,20,20,20», смен в секунду.
	function digitRates(list, fallback) {
		var words = String(list === undefined ? '' : list).split(',');
		var rates = [];

		for (var i = 0; i < 5; i++) {
			var rate = Number(words[i]);

			rates.push(words[i] !== undefined && words[i] !== '' && rate > 0 ? rate : Math.max(0.1, fallback));
		}
		return rates;
	}

	function padCycle(value, length) {
		return String(value).padStart(length, '0');
	}

	// Цикл — строка таблицы с наибольшим прогрессом, не больше текущего.
	function cycleTarget(t) {
		if (!t.cycle || !t.cycle.name) {
			return null;
		}

		var progress = Number(State.variables[t.cycle.name]) || 0;
		var value = '00000';

		t.rows.forEach(function (row) {
			if (row.progress <= progress) {
				value = row.value;
			}
		});
		return padCycle(value, 5);
	}

	function showCycle(value) {
		if (!tickerNum) {
			return;
		}
		tickerNum.textContent = '';
		String(value).split('').forEach(function (digit) {
			var cell = document.createElement('span');

			cell.textContent = digit;
			tickerNum.appendChild(cell);
		});
	}

	// Меняются только разряды, начиная с первого изменившегося слева. Самая
	// правая цифра останавливается через spin секунд, каждая следующая левее —
	// ещё через gap секунд. Скорость цифры идёт от from к to за всё её время.
	function startSpin(from, to, t) {
		var length = Math.max(from.length, to.length);
		var a = padCycle(from, length);
		var b = padCycle(to, length);
		var first = 0;
		var cells = [];
		var duration = Math.max(0, t.cycle.spin) * 1000;
		var gap = t.cycle.gap * 1000;

		while (first < length && a.charAt(first) === b.charAt(first)) {
			first++;
		}
		for (var i = first; i < length; i++) {
			var slot = i - length + 5;

			cells.push({
				index: i,
				stop: duration + (length - 1 - i) * gap,
				from: t.cycle.from[slot],
				to: t.cycle.to[slot],
				next: 0
			});
		}
		tickerSpin = {to: b, digits: a.split(''), cells: cells, start: performance.now()};
		showCycle(a);
	}

	function spinFrame(now) {
		var spin = tickerSpin;

		if (!spin) {
			return;
		}

		var elapsed = now - spin.start;
		var left = 0;
		var changed = false;

		spin.cells.forEach(function (cell) {
			if (cell.done) {
				return;
			}
			if (elapsed >= cell.stop) {
				cell.done = true;
				spin.digits[cell.index] = spin.to.charAt(cell.index);
				changed = true;
				return;
			}
			left++;
			if (now < cell.next) {
				return;
			}

			var digit = Math.floor(Math.random() * 9);

			spin.digits[cell.index] = String(digit >= Number(spin.digits[cell.index]) ? digit + 1 : digit);
			cell.next = now + 1000 / (cell.from + (cell.to - cell.from) * (elapsed / cell.stop));
			changed = true;
		});
		if (changed) {
			showCycle(spin.digits.join(''));
		}
		if (left === 0) {
			tickerSpin = null;
			showCycle(spin.to);
			varObject('sgTicker').seen = spin.to;
			saveVars();
		}
	}

	function newsTrue(n) {
		if (n.expr === '') {
			return true;
		}
		try {
			return !!Scripting.evalTwineScript(n.expr);
		} catch (e) {
			if (!n.failed) {
				n.failed = true;
				console.error('СИГНАЛЫ: условие сообщения «' + n.name + '»', e);
			}
			return false;
		}
	}

	// Какие сообщения можно показывать: из общих — только включившееся последним
	// (новое общее сменяет старое).
	function tickerRefresh(t, marks, now) {
		var live = {};
		var fresh = [];
		var general = null;

		t.news.forEach(function (n) {
			var m = marks[n.name];

			if (!m || (n.minutes > 0 && now >= m.at + n.minutes * 60000)) {
				return;
			}
			live[n.name] = true;
			if (n.times > 0 && m.shown >= n.times) {
				return;
			}
			if (n.general && (!general || m.at >= marks[general.name].at)) {
				general = n;
			}
			fresh.push(n);
		});
		tk.live = live;
		tk.general = general;
		tk.active = fresh.filter(function (n) {
			return !n.general || n === general;
		});
	}

	function tickerCheck() {
		if (restoring || !State.passage || (!preview && !started) || (Engine.isIdle && !Engine.isIdle())) {
			return;
		}

		var t = ticker();

		if (!t) {
			return;
		}

		var store = varObject('sgTicker');
		var marks = store.msgs || (store.msgs = {});
		var now = Date.now();
		var changed = false;

		t.news.forEach(function (n) {
			var on = newsTrue(n);

			if (on && !marks[n.name]) {
				marks[n.name] = {at: now, shown: 0};
				changed = true;
			} else if (!on && marks[n.name]) {
				delete marks[n.name];
				delete tk.round[n.name];
				changed = true;
			}
		});
		tickerRefresh(t, marks, now);

		var target = cycleTarget(t);

		if (target !== null) {
			if (store.cycle === undefined) {
				store.cycle = target;
				store.seen = target;
				changed = true;
			} else if (store.cycle !== target) {
				store.cycle = target;
				changed = true;
			}
			if (tickerStrip && tickerStrip.isConnected) {
				if (store.seen !== target && (!tickerSpin || tickerSpin.to !== target)) {
					startSpin(tickerSpin ? tickerNum.textContent : store.seen, target, t);
					// Звук — когда игроки видят счётчик (ответ 7б, сессия 15).
					if (!preview && t.cycle.sound) {
						var audio = signalFor(String(t.cycle.sound));

						audio.volume = Math.max(0, Math.min(1, t.cycle.volume / 100));
						audio.currentTime = 0;
						audio.play().catch(function () {});
					}
				} else if (store.seen === target && !tickerSpin && tickerNum.textContent !== target) {
					showCycle(target);
				}
			}
		}
		if (changed) {
			saveVars();
		}
	}

	function tickerFont(font) {
		return !font ? '' : /[\/\\]/.test(font) ? timerFont(font) : '"' + font + '", monospace';
	}

	function buildTicker(t) {
		var strip = document.createElement('div');

		strip.id = 'sg-ticker';
		strip.style.fontSize = t.line.size + 'px';
		strip.style.fontFamily = tickerFont(t.line.font);
		tickerLine = document.createElement('div');
		tickerLine.className = 'sg-tk-box sg-tk-line';
		tickerLine.style.height = t.line.height + 'px';
		strip.appendChild(tickerLine);
		if (t.cycle) {
			var cycle = document.createElement('div');

			cycle.className = 'sg-tk-box sg-tk-cycle';
			cycle.style.height = t.line.height + 'px';
			cycle.textContent = 'Цикл';
			tickerNum = document.createElement('span');
			tickerNum.className = 'sg-tk-num';
			cycle.appendChild(tickerNum);
			strip.appendChild(cycle);
		}
		tickerStrip = strip;
	}

	function tickerClear() {
		tk.phase = 'idle';
		tk.cur = null;
		tk.old = null;
		tickerSpin = null;
		if (tickerLine) {
			tickerLine.textContent = '';
		}
	}

	function placeTicker() {
		var t = ticker();

		if (!t) {
			return;
		}

		var root = document.documentElement;
		var passages = document.getElementById('passages');

		if (State.passage !== t.line.screen) {
			if (tickerStrip && tickerStrip.parentNode) {
				tickerStrip.parentNode.removeChild(tickerStrip);
			}
			tickerClear();
			root.style.removeProperty('--sg-place-shift');
			return;
		}
		if (!tickerStrip) {
			buildTicker(t);
		}

		var fresh = !tickerStrip.isConnected && tk.phase === 'idle';

		passages.insertBefore(tickerStrip, passages.firstChild);
		root.style.setProperty('--sg-place-shift', t.line.height + 12 + 'px');

		if (fresh && t.cycle) {
			var store = varObject('sgTicker');

			showCycle(store.seen !== undefined ? store.seen : cycleTarget(t));
		}
	}

	function msgPlace(item, x, opacity) {
		item.el.style.transform = 'translate(' + x + 'px, -50%)';
		item.el.style.opacity = opacity;
	}

	function buildMsg(n) {
		var el = document.createElement('span');
		var inner = document.createElement('span');

		el.className = 'sg-tk-msg';
		if (n.color) {
			inner.style.color = String(n.color);
		}
		if (n.bold) {
			inner.style.fontWeight = 'bold';
		}
		if (n.italic) {
			inner.style.fontStyle = 'italic';
		}
		$(inner).wiki(n.text);
		if (n.effect === 'blink') {
			inner.className = 'sg-blink';
		} else if (n.effect === 'glitch') {
			inner.className = 'glitchy';
			inner.setAttribute('data-text', inner.textContent);
		}
		el.appendChild(inner);
		tickerLine.appendChild(el);
		return {news: n, el: el, width: el.getBoundingClientRect().width, x: 0};
	}

	function tickerPick(t) {
		if (!tk.active.length) {
			return null;
		}

		var marks = varObject('sgTicker').msgs || {};
		var rank = function (n) {
			var name = !(marks[n.name] && marks[n.name].shown) ? 'new' : n.general ? 'general' : 'seen';

			return t.line.order.indexOf(name);
		};
		var list = tk.active.slice().sort(function (x, y) {
			return rank(x) - rank(y) || y.priority - x.priority || x.index - y.index;
		});

		for (var i = 0; i < list.length; i++) {
			if (!tk.round[list[i].name]) {
				return list[i];
			}
		}
		tk.round = {};
		return list[0];
	}

	function countShow(t, n) {
		var marks = varObject('sgTicker').msgs || {};

		tk.round[n.name] = 1;
		if (marks[n.name]) {
			marks[n.name].shown = (marks[n.name].shown || 0) + 1;
			tickerRefresh(t, marks, Date.now());
			saveVars();
		}
	}

	function tickerEnter(t, n, now) {
		tk.cur = buildMsg(n);
		countShow(t, n);
		tk.phase = 'in';
		tk.at = now;
		msgPlace(tk.cur, t.line.mode === 'scroll' ? tickerLine.clientWidth : 0, t.line.mode === 'scroll' ? 1 : 0);
	}

	function tickerDrop(item) {
		if (item && item.el.parentNode) {
			item.el.parentNode.removeChild(item.el);
		}
	}

	// Текущее сообщение отстояло или его пора убрать: следующее — через смену.
	function tickerNext(t, now) {
		var n = tickerPick(t);

		if (n && tk.cur && n === tk.cur.news && tk.cur.x === 0) {
			countShow(t, n);
			tickerDrop(tk.cur);
			tk.cur = buildMsg(n);
			msgPlace(tk.cur, 0, 1);
			tk.phase = 'hold';
			tk.at = now;
			return;
		}
		if (t.line.mode === 'scroll' && n) {
			tk.old = tk.cur;
			tickerEnter(t, n, now);
			return;
		}
		tk.phase = 'out';
		tk.at = now;
	}

	function tickerFrame(now) {
		requestAnimationFrame(tickerFrame);

		var t = tickerTable;

		if (!t || !tickerStrip || !tickerStrip.isConnected) {
			return;
		}
		spinFrame(now);

		var line = t.line;
		var width = tickerLine.clientWidth - 20;
		var half = (line.change * 1000) / 2 || 1;
		var full = line.change * 1000 || 1;
		var cur = tk.cur;

		if (tk.phase === 'idle') {
			var n = tickerPick(t);

			if (n) {
				tickerEnter(t, n, now);
			}
			return;
		}
		if (cur && (tk.phase === 'hold' || tk.phase === 'run')) {
			var gone = !tk.live[cur.news.name] || (cur.news.general && tk.general && tk.general !== cur.news);

			if (gone) {
				tickerNext(t, now);
				return;
			}
		}
		if (tk.phase === 'in') {
			var enter = (now - tk.at) / (line.mode === 'scroll' ? full : half);

			if (enter >= 1) {
				tickerDrop(tk.old);
				tk.old = null;
				msgPlace(cur, 0, 1);
				tk.phase = 'hold';
				tk.at = now;
			} else if (line.mode === 'scroll') {
				msgPlace(cur, (1 - enter) * tickerLine.clientWidth, 1);
				if (tk.old) {
					msgPlace(tk.old, tk.old.x - enter * tickerLine.clientWidth, 1);
				}
			} else {
				msgPlace(cur, 0, enter);
			}
		} else if (tk.phase === 'hold') {
			var over = cur.width > width;

			if (now - tk.at >= (over ? line.pause : line.hold) * 1000) {
				if (over) {
					tk.phase = 'run';
					tk.at = now;
				} else {
					tickerNext(t, now);
				}
			}
		} else if (tk.phase === 'run') {
			cur.x = -((now - tk.at) / 1000) * line.speed;
			if (cur.x <= -(cur.width + 10)) {
				tickerDrop(cur);
				tk.cur = null;
				tk.phase = 'idle';
			} else {
				msgPlace(cur, cur.x, 1);
			}
		} else if (tk.phase === 'out') {
			var leave = (now - tk.at) / half;

			if (leave >= 1 || !cur) {
				tickerDrop(cur);
				tk.cur = null;
				tk.phase = 'idle';
			} else {
				msgPlace(cur, cur.x, 1 - leave);
			}
		}
	}

	setup.signaly.tickerCheck = tickerCheck;
	// Предпросмотр окна «Строка событий»: показать смену цикла.
	setup.signaly.cycleDemo = function () {
		var t = ticker();

		if (!t || !t.cycle || !tickerNum) {
			return;
		}

		var to = cycleTarget(t);
		var list = t.rows.map(function (row) {
			return padCycle(row.value, 5);
		});
		var at = list.indexOf(to);
		var other = list[at - 1] || list[at + 1];

		startSpin(other && other !== to ? other : padCycle((Number(to) + 25) % 100000, 5), to, t);
	};
	$(document).on(':passagedisplay', placeTicker);
	$(document).on(':passageend', function () {
		setTimeout(tickerCheck, 0);
	});
	setInterval(tickerCheck, 250);
	requestAnimationFrame(tickerFrame);

	/* ----- Первое посещение (шаг 4.5): элементы экрана возникают постепенно, из
	   белого шума, сквозь помехи или через глитч. Способы — переменные
	   --sg-first-<id> блока оформления, на экране — тег sg-first-<id>. Только при
	   самом первом заходе; после сбоя экран не показывается так заново. */

	var fvPrefix = 'sg-first-';
	var fvNow = null;
	var fvRestored = false;
	// Нельзя переносить или накрывать обёрткой: видео сбросится, фиксированное
	// место собьётся из-за фильтра на родителе.
	var fvKeep = '.sg-place, .sg-alarm, .sg-chain, video, iframe, [style*="position: fixed"]';
	var fvOwn = fvKeep + ', img, canvas, svg, input, textarea, select, .sg-timer';

	function fvParse(value) {
		var w = String(value || '').trim().split(/\s+/);

		function part(i) {
			return w[i] && w[i] !== '-' ? w[i] : w[0];
		}

		if (w.length < 7) {
			return null;
		}
		return {
			mode: w[0],
			time: Math.max(0.001, Number(w[1]) || 0) * 1000,
			step: Math.max(0, Number(w[2]) || 0) * 1000,
			delay: Math.max(0, Number(w[3]) || 0) * 1000,
			power: Math.max(0, Number(w[4]) || 0),
			color: w[5],
			skip: w[6] === '1',
			parts: {text: part(7), links: part(8), media: part(9), fields: part(10)}
		};
	}

	function fvWay(tags) {
		var tag = tags.filter(function (name) {
			return name.indexOf(fvPrefix) === 0;
		})[0];

		return tag ? fvParse(rootStyle.getPropertyValue('--' + tag)) : null;
	}

	function fvKind(el) {
		function has(selector) {
			return el.matches(selector) || !!el.querySelector(selector);
		}

		if (has('img, video, canvas, iframe, svg, .sg-chain')) {
			return 'media';
		}
		if (has('input, textarea, select, .sg-timer')) {
			return 'fields';
		}
		return has('a, button') ? 'links' : 'text';
	}

	function fvItem(el, kind, wrap) {
		var look = getComputedStyle(el);

		return {
			el: el,
			kind: kind,
			wrap: !!wrap,
			style: el.getAttribute('style'),
			inline: look.display === 'inline',
			fixed: look.position === 'fixed',
			staticBox: look.position === 'static',
			bare:
				look.display === 'block' &&
				/^(text|links)$/.test(kind) &&
				look.backgroundColor === 'rgba(0, 0, 0, 0)' &&
				parseFloat(look.borderTopWidth) === 0,
			next: 0
		};
	}

	// Элементы экрана по порядку сверху вниз. Текст одной строки — один элемент,
	// ссылки, кнопки, картинки, поля и блоки — отдельные.
	function fvScan(box, items) {
		var run = [];

		function flush() {
			var visible = run.some(function (node) {
				return /\S/.test(node.textContent);
			});

			if (visible) {
				var wrap = document.createElement('span');

				wrap.className = 'sg-fv';
				run[0].parentNode.insertBefore(wrap, run[0]);
				run.forEach(function (node) {
					wrap.appendChild(node);
				});
				items.push(fvItem(wrap, 'text', true));
			}
			run = [];
		}

		Array.prototype.slice.call(box.childNodes).forEach(function (node) {
			if (node.nodeType === 3) {
				run.push(node);
				return;
			}
			if (node.nodeType !== 1) {
				return;
			}
			if (/^(BR|STYLE|SCRIPT)$/.test(node.tagName) || node.matches('.sg-alarm')) {
				flush();
				return;
			}

			var display = getComputedStyle(node).display;

			if (display === 'none') {
				return;
			}
			if (node.matches(fvOwn)) {
				flush();
				if (node.getClientRects().length) {
					items.push(fvItem(node, fvKind(node)));
				}
			} else if (node.querySelector(fvKeep) || node.matches('.sg-art-list, .sg-art-section, .sg-art-grid, .sg-list-grid')) {
				flush();
				fvScan(node, items);
			} else if (display !== 'inline' || node.matches('a, button') || node.querySelector('a, button')) {
				flush();
				if (node.getClientRects().length && /\S/.test(node.textContent + (node.querySelector('img, svg, canvas') ? 'x' : ''))) {
					items.push(fvItem(node, fvKind(node)));
				}
			} else {
				run.push(node);
			}
		});
		flush();
	}

	function fvRestore(item) {
		if (item.style === null) {
			item.el.removeAttribute('style');
		} else {
			item.el.setAttribute('style', item.style);
		}
	}

	function fvRelease(item) {
		fvRestore(item);
		if (item.wrap && item.el.parentNode) {
			while (item.el.firstChild) {
				item.el.parentNode.insertBefore(item.el.firstChild, item.el);
			}
			item.el.parentNode.removeChild(item.el);
		}
	}

	function fvEnd() {
		if (!fvNow) {
			return;
		}
		fvNow.items.forEach(fvRelease);
		[fvNow.canvas, fvNow.svg].forEach(function (el) {
			if (el.parentNode) {
				el.parentNode.removeChild(el);
			}
		});
		fvNow = null;
	}

	function fvRgb(color) {
		var hex = String(color).replace('#', '');

		return [0, 2, 4].map(function (i) {
			var n = parseInt(hex.substr(i, 2), 16);

			return isNaN(n) ? 255 : n;
		});
	}

	// Узор шума: level — плотность, от 1 (редкие точки) до 8 (сплошной).
	function fvTile(level) {
		var key = level + '-' + Math.floor(Math.random() * 3);

		if (fvNow.tiles[key]) {
			return fvNow.tiles[key];
		}

		var size = 128;
		var tile = document.createElement('canvas');
		var rgb = fvRgb(fvNow.way.color);

		tile.width = size;
		tile.height = size;

		var tileCtx = tile.getContext('2d');
		var image = tileCtx.createImageData(size, size);

		for (var i = 0; i < image.data.length; i += 4) {
			var bright = 0.3 + Math.random() * 0.7;

			image.data[i] = rgb[0] * bright;
			image.data[i + 1] = rgb[1] * bright;
			image.data[i + 2] = rgb[2] * bright;
			image.data[i + 3] = Math.random() < level / 8 ? 255 : 0;
		}
		tileCtx.putImageData(image, 0, 0);
		fvNow.tiles[key] = fvNow.ctx.createPattern(tile, 'repeat');
		return fvNow.tiles[key];
	}

	function fvRects(item) {
		var box = fvNow.box;
		var source = item.el;

		// Блок без своего фона и рамки: шум — по тексту, а не во всю ширину строки.
		if (item.bare) {
			source = document.createRange();
			source.selectNodeContents(item.el);
		}
		return Array.prototype.slice.call(source.getClientRects()).map(function (r) {
			if (item.fixed || !box) {
				return r;
			}

			var top = Math.max(r.top, box.top);
			var bottom = Math.min(r.bottom, box.bottom);

			return {left: r.left, top: top, width: r.width, height: bottom - top};
		}).filter(function (r) {
			return r.width > 0 && r.height > 0;
		});
	}

	function fvNoise(item, level) {
		var ctx = fvNow.ctx;
		var rects = fvRects(item);
		var density = Math.ceil(level * 8);

		if (!rects.length || density < 1) {
			return;
		}
		ctx.save();
		ctx.beginPath();
		rects.forEach(function (r) {
			ctx.rect(r.left, r.top, r.width, r.height);
		});
		ctx.clip();
		ctx.imageSmoothingEnabled = false;
		ctx.translate(Math.floor(Math.random() * 128), Math.floor(Math.random() * 128));
		ctx.scale(2, 2);
		ctx.fillStyle = fvTile(density);
		ctx.fillRect(-128, -128, fvNow.canvas.width, fvNow.canvas.height);
		ctx.restore();
	}

	function fvBands(item, level) {
		var ctx = fvNow.ctx;
		var rgb = fvRgb(fvNow.way.color);

		fvRects(item).forEach(function (r) {
			var count = 1 + Math.floor(Math.random() * 3);

			for (var i = 0; i < count; i++) {
				ctx.fillStyle = 'rgba(' + rgb.join(',') + ',' + level * 0.6 + ')';
				ctx.fillRect(r.left, r.top + Math.random() * r.height, r.width, 1 + Math.random() * 2);
			}
		});
	}

	function fvMove(item, dx) {
		if (item.inline) {
			if (item.staticBox) {
				item.el.style.position = 'relative';
			}
			item.el.style.left = dx + 'px';
		} else {
			item.el.style.translate = dx + 'px 0';
		}
	}

	function fvFilter(item) {
		var ns = 'http://www.w3.org/2000/svg';
		var filter = document.createElementNS(ns, 'filter');
		var noise = document.createElementNS(ns, 'feTurbulence');
		var map = document.createElementNS(ns, 'feDisplacementMap');
		var id = 'sg-fv-f' + fvNow.filters++;

		filter.setAttribute('id', id);
		filter.setAttribute('x', '-30%');
		filter.setAttribute('y', '-10%');
		filter.setAttribute('width', '160%');
		filter.setAttribute('height', '120%');
		filter.setAttribute('color-interpolation-filters', 'sRGB');
		noise.setAttribute('type', 'fractalNoise');
		noise.setAttribute('baseFrequency', '0.003 0.25');
		noise.setAttribute('numOctaves', '2');
		noise.setAttribute('result', 'n');
		map.setAttribute('in', 'SourceGraphic');
		map.setAttribute('in2', 'n');
		map.setAttribute('xChannelSelector', 'R');
		map.setAttribute('yChannelSelector', 'A');
		filter.appendChild(noise);
		filter.appendChild(map);
		fvNow.svg.appendChild(filter);
		item.noise = noise;
		item.map = map;
		item.el.style.filter = 'url(#' + id + ')';
	}

	function fvPaint(item, t, now) {
		var way = fvNow.way;
		var left = 1 - t;
		var power = way.power / 100;
		var s = item.el.style;

		s.pointerEvents = '';
		if (item.mode === 'fade') {
			s.opacity = t;
		} else if (item.mode === 'noise') {
			s.opacity = Math.min(1, t * 1.5);
			fvNoise(item, power * left);
		} else if (item.mode === 'wave') {
			if (!item.map) {
				fvFilter(item);
			}
			if (now >= item.next) {
				item.next = now + 50;
				item.noise.setAttribute('seed', Math.floor(Math.random() * 1000));
				item.map.setAttribute('scale', way.power * 1.6 * left * left);
				s.opacity = Math.random() < 0.3 * left ? 0.3 : Math.min(1, 0.3 + t * 2);
			}
			fvBands(item, power * left);
		} else {
			if (now >= item.next) {
				var shift = Math.round((way.power / 4) * left);
				var edge = Math.max(1, shift / 2);

				item.next = now + 60;
				fvMove(item, Math.round((Math.random() * 2 - 1) * shift));
				s.filter =
					'drop-shadow(' + edge + 'px 0 0 ' + fvNow.shadow1 + ') drop-shadow(' + -edge + 'px 0 0 ' + fvNow.shadow2 + ')';
				s.clipPath = '';
				if (Math.random() < left * 0.7) {
					var top = Math.random() * 60;

					s.clipPath = 'inset(' + top + '% 0 ' + Math.random() * (80 - top) + '% 0)';
				}
				s.opacity = Math.random() < left * 0.25 ? 0.25 : 1;
			}
		}
	}

	function fvFrame(now) {
		if (!fvNow) {
			return;
		}

		var run = fvNow;
		var alive = false;
		var boxEl = document.getElementById('passages');

		run.box = boxEl ? boxEl.getBoundingClientRect() : null;
		run.ctx.clearRect(0, 0, run.canvas.width, run.canvas.height);
		run.items.forEach(function (item) {
			var t = (now - run.start - item.at) / run.way.time;

			if (item.over) {
				return;
			}
			if (t >= 1) {
				item.over = true;
				fvRestore(item);
				return;
			}
			alive = true;
			if (t >= 0) {
				fvPaint(item, t, now);
			}
		});
		if (alive) {
			requestAnimationFrame(fvFrame);
		} else {
			fvEnd();
		}
	}

	function fvStart(way) {
		fvEnd();

		var found = [];
		var items = [];
		var at = way.delay;

		$('#passages').children().not('#sg-ticker').each(function () {
			fvScan(this, found);
		});
		found.forEach(function (item) {
			item.mode = way.parts[item.kind];
			if (item.mode === 'now') {
				fvRelease(item);
				return;
			}
			item.at = at;
			at += way.step;
			item.el.style.opacity = '0';
			item.el.style.pointerEvents = 'none';
			items.push(item);
		});
		if (!items.length) {
			return;
		}

		var canvas = document.createElement('canvas');
		var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');

		canvas.id = 'sg-fv-canvas';
		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;
		canvas.style.cssText = 'position: fixed; left: 0; top: 0; z-index: 1001; pointer-events: none;';
		svg.setAttribute('width', '0');
		svg.setAttribute('height', '0');
		svg.style.position = 'absolute';
		document.body.appendChild(svg);
		document.body.appendChild(canvas);
		fvNow = {
			way: way,
			items: items,
			canvas: canvas,
			svg: svg,
			ctx: canvas.getContext('2d'),
			tiles: {},
			filters: 0,
			box: null,
			shadow1: rootStyle.getPropertyValue('--sg-fvs-1').trim() || '#0000ff',
			shadow2: rootStyle.getPropertyValue('--sg-fvs-2').trim() || '#ff0000',
			start: performance.now()
		};
		requestAnimationFrame(fvFrame);
	}

	document.addEventListener('click', function () {
		if (fvNow && fvNow.way.skip) {
			fvEnd();
		}
	}, true);

	$(document).on(':passageinit', fvEnd);
	$(document).on(':passagestart', function () {
		fvRestored = restoring;
	});
	// После обработчика окна KR2: он перекладывает элементы экрана в свои зоны.
	$(document).one(':passageinit', function () {
		$(document).on(':passageend', function (ev) {
			var way = preview || fvRestored ? null : fvWay(ev.passage.tags);

			if (way && setup.visits(ev.passage.title) === 1) {
				fvStart(way);
			}
		});
	});
	// Предпросмотр программы: показать появление на открытом экране.
	setup.signaly.firstDemo = function (value) {
		var way = value ? fvParse(value) : fvWay(Story.get(State.passage).tags);

		if (way) {
			fvStart(way);
		}
	};

	if (preview) {
		// Всегда с выбранного экрана, а не с того, что был в прошлый раз.
		State.reset();
		if (preview === 'start') {
			LoadScreen.lock();
			showStartScreen(function () {});
		}
		return;
	}

	/* ----- Полный экран и звук запуска ----- */

	function requestFullscreen() {
		var root = document.documentElement;

		if (document.fullscreenElement || !root.requestFullscreen) {
			return;
		}
		root.requestFullscreen().catch(function () {});
	}

	function playStartSound() {
		if (!settings.startSound) {
			return;
		}
		try {
			var sound = new Audio(settings.startSound);

			sound.volume = Math.max(0, Math.min(1, settings.startVolume));
			sound.play().catch(function () {});
		} catch (e) {
			console.error('СИГНАЛЫ: звук запуска', e);
		}
	}

	/* ----- Защита экрана ----- */

	if (settings.noContextMenu) {
		document.addEventListener('contextmenu', function (ev) {
			ev.preventDefault();
		});
	}

	if (settings.noZoom) {
		document.addEventListener(
			'wheel',
			function (ev) {
				if (ev.ctrlKey) {
					ev.preventDefault();
				}
			},
			{passive: false}
		);
	}

	if (settings.hideCursorAfter > 0) {
		var cursorTimer = null;
		var showCursor = function () {
			document.documentElement.classList.remove('sg-cursor-hidden');
			clearTimeout(cursorTimer);
			cursorTimer = setTimeout(function () {
				document.documentElement.classList.add('sg-cursor-hidden');
			}, settings.hideCursorAfter * 1000);
		};

		document.addEventListener('mousemove', showCursor);
		document.addEventListener('mousedown', showCursor);
		showCursor();
	}

	/* ----- Автокопия прогресса ----- */

	// В режиме «Тестировать» автокопии нет: проверка всегда начинается заново.
	var autocopyOn = Config.debug !== true;
	var fileName = decodeURIComponent(location.pathname.split('/').pop() || 'index.html');
	// У каждого файла игры своя автокопия.
	var storageKey = 'СИГНАЛЫ/автокопия/' + Story.ifId + '/' + fileName;
	var serial = typeof Serial !== 'undefined' ? Serial : JSON;
	var record = null;
	var stopped = false;
	var started = false;
	var navCount = 0;

	function readCopy() {
		try {
			var raw = localStorage.getItem(storageKey);

			return raw ? JSON.parse(raw) : null;
		} catch (e) {
			return null;
		}
	}

	function writeCopy() {
		if (!autocopyOn || stopped || !record) {
			return;
		}
		try {
			localStorage.setItem(storageKey, JSON.stringify(record));
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия не записана', e);
		}
	}

	function saveEntry() {
		// Состояние на входе в экран — как его запоминает сам SugarCube.
		record = {
			v: 1,
			passage: State.passage,
			vars: serial.stringify(State.variables),
			seen: Object.keys(seen).concat(State.passage),
			time: Date.now()
		};
		writeCopy();
	}

	function afterAction() {
		var turn = navCount;

		setTimeout(function () {
			// Если действие сменило экран, копию уже записал вход в экран.
			if (turn !== navCount || !record) {
				return;
			}
			record.vars = serial.stringify(State.variables);
			record.time = Date.now();
			writeCopy();
		}, 50);
	}

	function startAutocopy() {
		// Шаг 2.3: таймеры меняются не только при переходе — пишем их отдельно.
		setup.signaly.saveTimers = function () {
			if (!record) {
				return;
			}
			try {
				record.timers = JSON.parse(JSON.stringify(State.variables.sgTimers || {}));
			} catch (e) {
				record.timers = {};
			}
			writeCopy();
		};
		$(document).on(':passageinit', function () {
			navCount++;
		});
		$(document).on(':passagestart', saveEntry);
		document.addEventListener('click', afterAction, true);
		document.addEventListener('change', afterAction, true);
		document.addEventListener(
			'keyup',
			function (ev) {
				if (ev.key === 'Enter') {
					afterAction();
				}
			},
			true
		);
	}

	function prepareRestore(copy) {
		// Сеанс вкладки забываем — продолжаем по автокопии.
		State.reset();
		Config.passages.start = copy.passage;
		(copy.seen || []).forEach(function (title) {
			seen[title] = true;
		});
		$(document).one(':passageinit', function () {
			var variables = State.variables;

			Object.keys(variables).forEach(function (name) {
				delete variables[name];
			});
			try {
				Object.assign(variables, serial.parse(copy.vars));
			} catch (e) {
				console.error('СИГНАЛЫ: переменные не восстановлены', e);
			}
			// Таймеры — как были в момент сбоя: идущий таймер не начинается
			// заново, а продолжает по времени окончания.
			if (copy.timers) {
				variables.sgTimers = copy.timers;
			}
			restoring = true;
		});
		$(document).one(':passagedisplay', function () {
			restoring = false;
		});
	}

	/* ----- Новая игра: Shift+Z+N (клавиши можно поменять, шаг 3.3) ----- */

	function newGame() {
		stopped = true;
		try {
			localStorage.removeItem(storageKey);
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия не стёрта', e);
		}
		Engine.restart();
	}

	function askNewGame() {
		if (!started) {
			return;
		}
		Dialog.create('Новая игра');

		var body = $(Dialog.body());

		$('<p></p>').text('Начать новую игру? Текущий прогресс будет стёрт.').appendTo(body);
		$('<button type="button" class="sg-new-game-yes"></button>')
			.text('Да')
			.on('click', newGame)
			.appendTo(body);
		body.append(' ');
		$('<button type="button" class="sg-new-game-no"></button>')
			.text('Нет')
			.on('click', function () {
				Dialog.close();
			})
			.appendTo(body);
		Dialog.open();
	}

	/* ----- Горячие клавиши мастера (шаг 3.3) ----- */

	// Таблица — пассаж с тегом sg-keys («Горячие клавиши»):
	//   <<sg-key "Shift+Z+A" "Подпись" [goto "Экран"] [ask]>>действия<</sg-key>>
	//   <<sg-key "Shift+Z+N" "Новая игра" builtin newgame>><</sg-key>>
	// Удерживать Z и нажать Shift + букву или цифру. Встроенные «новая игра»
	// (Shift+Z+N) и «закрыть тревогу» (Shift+Z+X) можно перевести на другие
	// клавиши (ответ 6Б). Комбинация срабатывает и в поле ввода, а Z и буква в
	// поле не попадают (ответ 5Б).
	var keyTable = null;
	var keyCollect = null;

	Macro.add('sg-key', {
		tags: null,
		handler: function () {
			if (!keyCollect) {
				return;
			}

			var a = blockArgs(this, ['combo', 'label'], ['goto', 'builtin'], ['ask']);

			keyCollect.push({
				combo: comboName(a.combo),
				label: a.label === undefined ? '' : String(a.label),
				goto: a.goto === undefined ? '' : String(a.goto),
				builtin: a.builtin === undefined ? '' : String(a.builtin),
				ask: a.ask === true,
				code: this.payload[0].contents
			});
		}
	});

	function comboName(combo) {
		return String(combo || '').replace(/\s+/g, '').toUpperCase();
	}

	function keys() {
		if (keyTable) {
			return keyTable;
		}
		keyTable = [];
		keyCollect = keyTable;
		Story.filter(function (p) {
			return p.tags.indexOf('sg-keys') !== -1;
		}).forEach(function (p) {
			try {
				new Wikifier(document.createDocumentFragment(), p.text);
			} catch (e) {
				console.error('СИГНАЛЫ: горячие клавиши', e);
			}
		});
		keyCollect = null;

		var builtins = {newgame: 'SHIFT+Z+N', alarm: 'SHIFT+Z+X'};

		keyTable.forEach(function (k) {
			if (builtins[k.builtin]) {
				builtins[k.builtin] = '';
			}
		});
		// Встроенных нет в таблице — они на своих местах.
		Object.keys(builtins).forEach(function (name) {
			if (builtins[name]) {
				keyTable.push({combo: builtins[name], builtin: name, code: ''});
			}
		});
		return keyTable;
	}

	function confirmKey(label, then) {
		Dialog.create(label || 'Горячая клавиша');

		var body = $(Dialog.body());

		$('<p></p>')
			.text('Выполнить «' + (label || 'горячая клавиша') + '»?')
			.appendTo(body);
		$('<button type="button" class="sg-key-yes"></button>')
			.text('Да')
			.on('click', function () {
				Dialog.close();
				then();
			})
			.appendTo(body);
		body.append(' ');
		$('<button type="button" class="sg-key-no"></button>')
			.text('Нет')
			.on('click', function () {
				Dialog.close();
			})
			.appendTo(body);
		Dialog.open();
	}

	function runKey(k) {
		if (k.builtin === 'newgame') {
			askNewGame();
			return;
		}
		if (k.builtin === 'alarm') {
			setup.signaly.closeAlarm();
			return;
		}

		var run = function () {
			try {
				if (k.code.trim() !== '') {
					Wikifier.wikifyEval(k.code);
				}
			} catch (e) {
				console.error('СИГНАЛЫ: горячая клавиша ' + k.combo, e);
			}
			if (!k.goto || !accessGo(k.goto, 'key', k.combo)) {
				afterAction();
			}
		};

		if (k.ask) {
			confirmKey(k.label, run);
		} else {
			run();
		}
	}

	var zDown = false;
	var zInput = null;

	function editable(el) {
		return (
			el &&
			(el.tagName === 'TEXTAREA' ||
				(el.tagName === 'INPUT' && /^(text|password|search|email|url|tel|number|)$/i.test(el.type || '')))
		);
	}

	// Что было в поле до нажатия Z: если Z окажется частью комбинации, поле
	// возвращается к этому виду (и переменная поля тоже).
	function restoreInput() {
		var snap = zInput;

		zInput = null;
		if (!snap || !snap.el.isConnected || snap.el.value === snap.value) {
			return;
		}
		snap.el.value = snap.value;
		try {
			snap.el.setSelectionRange(snap.start, snap.end);
		} catch (e) {
			/* У поля нет выделения. */
		}
		snap.el.dispatchEvent(new Event('input', {bubbles: true}));
	}

	document.addEventListener(
		'keydown',
		function (ev) {
			if (ev.code === 'KeyZ') {
				if (!zDown && editable(ev.target)) {
					zInput = {
						el: ev.target,
						value: ev.target.value,
						start: ev.target.selectionStart,
						end: ev.target.selectionEnd
					};
				}
				zDown = true;
				return;
			}
			if (!zDown || !ev.shiftKey || ev.ctrlKey || ev.altKey || ev.metaKey) {
				return;
			}

			var m = /^(?:Key([A-Z])|Digit([0-9]))$/.exec(ev.code);

			if (!m) {
				return;
			}

			var combo = 'SHIFT+Z+' + (m[1] || m[2]);
			var found = null;

			keys().forEach(function (k) {
				if (!found && k.combo === combo) {
					found = k;
				}
			});
			if (!found) {
				return;
			}
			ev.preventDefault();
			ev.stopPropagation();
			restoreInput();
			if (ev.repeat || !started) {
				return;
			}
			runKey(found);
		},
		true
	);
	document.addEventListener('keyup', function (ev) {
		if (ev.code === 'KeyZ') {
			zDown = false;
			zInput = null;
		}
	});
	window.addEventListener('blur', function () {
		zDown = false;
		zInput = null;
	});

	/* ----- Звук-сигнал (шаг 3.3, ответ 3А) ----- */

	// <<sg-sound "media/audio/x.wav" volume 100 [keep]>> — отдельный звук мимо
	// SimpleAudio: его не задевают кнопки A–E, пауза и громкость групп.
	// keep — не начинать заново, если ещё звучит.
	var signalAudio = {};

	function signalFor(src) {
		if (!signalAudio[src]) {
			var audio = new Audio(src);

			audio.preload = 'auto';
			audio.sgUi = true;
			signalAudio[src] = audio;
		}
		return signalAudio[src];
	}

	Macro.add('sg-sound', {
		handler: function () {
			var a = blockArgs(this, ['src'], ['volume'], ['keep']);

			if (!a.src || !uiSoundOn()) {
				return;
			}

			var audio = signalFor(String(a.src));
			var volume = a.volume === undefined ? 100 : Number(a.volume);

			audio.volume = Math.max(0, Math.min(1, (isNaN(volume) ? 100 : volume) / 100));
			if (!a.keep) {
				audio.currentTime = 0;
			}
			audio.play().catch(function (e) {
				console.error('СИГНАЛЫ: звук-сигнал', e);
			});
		}
	});

	// Файлы звуков-сигналов загружаются заранее, как в коде шаблона.
	$(document).one(':passagestart', function () {
		var re = /<<sg-sound\s+(["'])((?:\\.|(?!\1).)*)\1/g;

		Story.filter(function () {
			return true;
		}).forEach(function (p) {
			var m;

			re.lastIndex = 0;
			while ((m = re.exec(p.text))) {
				signalFor(m[2]);
			}
		});
	});

	/* ----- События: проверка и переход (шаг 3.5) ----- */

	// Ответы автора: проверка сразу после любого изменения; по умолчанию один
	// раз (repeat — снова, когда условие было ложным и стало верным); delay N —
	// через N секунд после того, как условие стало верным (отсчёт в фоне,
	// переживает смену экрана и сбой; условие снова ложно — отсчёт отменяется);
	// несколько готовых событий — по очереди, по важности; с экрана события
	// терминал не уводит — следующее событие ждёт, пока игроки уйдут с него.
	var eventList = null;
	var eventBusy = false;

	function macroEnd(text, from) {
		var quote = '';

		for (var i = from; i < text.length - 1; i++) {
			var ch = text.charAt(i);

			if (quote) {
				if (ch === '\\') {
					i++;
				} else if (ch === quote) {
					quote = '';
				}
			} else if (ch === '"' || ch === "'") {
				quote = ch;
			} else if (ch === '>' && text.charAt(i + 1) === '>') {
				return i;
			}
		}
		return -1;
	}

	function eventArgs(args) {
		var rest = args.trim();
		var a = {repeat: false, delay: 0, priority: 0};
		var m;

		while ((m = /^(repeat|delay|priority)(?:\s+(-?\d+(?:[.,]\d+)?))?(?:\s+|$)/.exec(rest))) {
			if (m[1] !== 'repeat' && m[2] === undefined) {
				break;
			}
			if (m[1] === 'repeat') {
				a.repeat = true;
			} else if (m[1] === 'delay') {
				a.delay = Math.max(0, Number(m[2].replace(',', '.')) || 0);
			} else {
				a.priority = Number(m[2].replace(',', '.')) || 0;
			}
			rest = rest.slice(m[0].length);
		}
		a.expr = rest.trim();
		return a;
	}

	function events() {
		if (eventList) {
			return eventList;
		}
		eventList = [];
		Story.filter(function (p) {
			return p.tags.indexOf('sg-event') !== -1;
		}).forEach(function (p) {
			var m = /<<sg-event(?=[\s>])/.exec(p.text);
			var end = m ? macroEnd(p.text, m.index + 2) : -1;

			if (end === -1) {
				return;
			}

			var a = eventArgs(p.text.slice(m.index + '<<sg-event'.length, end));

			if (a.expr !== '') {
				a.name = p.title;
				eventList.push(a);
			}
		});
		eventList.sort(function (x, y) {
			return y.priority - x.priority || (x.name < y.name ? -1 : x.name > y.name ? 1 : 0);
		});
		return eventList;
	}

	function eventTrue(ev) {
		try {
			return !!Scripting.evalTwineScript(ev.expr);
		} catch (e) {
			if (!ev.failed) {
				ev.failed = true;
				console.error('СИГНАЛЫ: условие события «' + ev.name + '»', e);
			}
			return false;
		}
	}

	function saveVars() {
		if (!record) {
			return;
		}
		record.vars = serial.stringify(State.variables);
		record.time = Date.now();
		writeCopy();
	}

	function checkEvents() {
		if (!started || restoring || eventBusy || !State.passage || (Engine.isIdle && !Engine.isIdle())) {
			return;
		}

		var list = events();

		if (!list.length) {
			return;
		}

		var marks = varObject('sgEvents');
		var now = Date.now();
		var changed = false;

		list.forEach(function (ev) {
			var m = marks[ev.name] || {};
			var before = JSON.stringify(m);

			if (m.done && !ev.repeat) {
				return;
			}
			if (!eventTrue(ev) || accessWaits(ev.name)) {
				delete m.due;
				delete m.was;
			} else if (!m.ready && !m.was) {
				if (ev.delay > 0 && !m.due) {
					m.due = now + ev.delay * 1000;
				}
				if (!m.due || now >= m.due) {
					delete m.due;
					m.ready = 1;
					if (ev.repeat) {
						m.was = 1;
					}
				}
			}
			if (JSON.stringify(m) !== before) {
				changed = true;
				if (Object.keys(m).length) {
					marks[ev.name] = m;
				} else {
					delete marks[ev.name];
				}
			}
		});

		var current = State.passage;
		var here = Story.has(current) && Story.get(current).tags.indexOf('sg-event') !== -1;
		var next = null;

		list.forEach(function (ev) {
			var m = marks[ev.name];

			if (!m || !m.ready) {
				return;
			}
			if (ev.name === current) {
				// Игроки уже на экране события.
				delete m.ready;
				if (!ev.repeat) {
					m.done = 1;
				}
				changed = true;
			} else if (!next && !here) {
				next = ev;
			}
		});

		if (!next) {
			if (changed) {
				saveVars();
			}
			return;
		}

		// Ответ 2А (сессия 14): открытое окно-сообщение успевают прочитать —
		// событие ждёт, пока окно закроют; тревога и поле ввода его не держат.
		if (Dialog.isOpen()) {
			if (changed) {
				saveVars();
			}
			return;
		}

		var mark = marks[next.name];

		delete mark.ready;
		if (!next.repeat) {
			mark.done = 1;
		}
		State.variables.sgEventFrom = current;
		eventBusy = true;
		try {
			accessGo(next.name, 'event', '');
		} finally {
			eventBusy = false;
		}
	}

	setup.signaly.checkEvents = checkEvents;
	setInterval(checkEvents, 250);
	$(document).on(':passageend', function () {
		setTimeout(checkEvents, 0);
	});
	['click', 'change', 'keyup'].forEach(function (type) {
		document.addEventListener(
			type,
			function () {
				setTimeout(checkEvents, 60);
			},
			true
		);
	});

	/* ----- Закрытые экраны в игре (шаг 4.3) ----- */

	if (
		Story.filter(function (p) {
			return p.tags.indexOf('sg-access') !== -1;
		}).length
	) {
		// Какую ссылку нажали: переход SugarCube сделает уже после щелчка.
		document.addEventListener(
			'click',
			function (ev) {
				var el = ev.target.closest ? ev.target.closest('a[data-passage], button[data-passage]') : null;

				accessLink = el;
			},
			true
		);
		Config.navigation.override = function (title) {
			var el = accessLink;

			accessLink = null;
			if (accessSkip || !access()[title]) {
				return title;
			}

			var to = accessRoute(title, 'link', el ? accessLinkId(el) : '');

			return to === null ? State.passage : to;
		};
		$(document).on(':passagedisplay', accessScan);
		setInterval(accessScan, 250);
		new MutationObserver(accessScan).observe(document.body, {childList: true, subtree: true, characterData: true});
	}

	/* ----- Стартовый экран ----- */

	// SugarCube ждёт, пока экран загрузки не будет отпущен, — до клика игра не
	// запускается, и звуки первого экрана не теряются.
	var lockId = LoadScreen.lock();

	showStartScreen(function (screen) {
		if (started) {
			return;
		}
		started = true;
		requestFullscreen();
		playStartSound();
		screen.parentNode.removeChild(screen);

		try {
			var copy = autocopyOn ? readCopy() : null;

			if (copy && copy.passage && Story.has(copy.passage)) {
				prepareRestore(copy);
			}
			if (autocopyOn) {
				startAutocopy();
			}
		} catch (e) {
			console.error('СИГНАЛЫ: автокопия', e);
		}

		LoadScreen.unlock(lockId);
	});
})();
/* ===== СИГНАЛЫ: конец движка терминала ===== */


/* СИГНАЛЫ: горячие клавиши мастера перенесены в пассаж «Горячие клавиши» (окно «Горячие клавиши», шаг 3.3). */


/* ===== Цвета кнопок и ссылок =====
   СИГНАЛЫ: цвет задаётся в самом пассаже, а не поиском по надписи:
   <span class="amber">…ссылки…</span> — янтарные,
   <span class="red-big">…</span> — красные большие,
   <span class="yellow-small">…</span> — жёлтые маленькие.
   Стили — в таблице стилей. */


/* СИГНАЛЫ: звуки наведения и нажатия перенесены в наборы (окно «Звуки», вид «Обычный», шаг 2.2). */


UIBar.destroy();

/* СИГНАЛЫ: таймер экрана Clocks перенесён в блок «Таймер» (шаг 2.3). */


/* hovertip v2.0 - Старт*/
window.UpdateHoverTipTxt = function (container) {
	if (Engine.isIdle()) {
		clearInterval(HTTIntervalID);
		if (container === undefined) {
			container = $(document);
		} else {
			container = $(container);
		}
		var i, id, top, left, parent, elementList, element, hoverPos, boxPos, zindex;
		elementList = container.find('span[id^="hoverTipTxt"]');
		for (i = 0; i < elementList.length; i++) {
			element = $(elementList[i]);
			id = elementList[i].id.substring(11);
			/* Найдите родительский элемент подсказки при наведении курсора мыши на страницу. */
			parent = $(container).find("#hoverTip" + (id));
			/* Расположите нижнюю часть hoverTipTxt чуть выше родительского элемента. */
			top = Math.round(-element.outerHeight() - 6);
			/* Центрируйте hoverTipTxt горизонтально над родительским текстом. */
			left = Math.round((parent.outerWidth() - element.outerWidth()) / 2);
			/* Посмотрите, содержится ли подсказка при наведении курсора мыши в чем-то с более высоким z-индексом. */
			zindex = element.css("z-index");
			if (zindex === "auto") {
				zindex = 0;
			} else {
				zindex = parseInt(zindex, 10);
			}
			while (parent.parent()[0] !== document) {
				if ((parent.parent().css("z-index") !== "auto") && (parseInt(parent.parent().css("z-index"), 10) > zindex)) {
					/* Получить прямоугольник контейнера. */
					boxPos = parent[0].getBoundingClientRect();
					break;
				}
				parent = parent.parent();
			}
			/* Обновить позицию. */
			element.css({ top: top, left: left });
			hoverPos = element[0].getBoundingClientRect();
			/* Убедитесь, что текст не выходит за пределы нижней части экрана. */
			if (hoverPos.top > window.innerHeight - hoverPos.height - 10) {
				top -= hoverPos.top - (window.innerHeight - hoverPos.height - 10);
			}
			/* Убедитесь, что текст не выходит за пределы верхней части экрана. */
			if (hoverPos.top < 4) {
				top -= hoverPos.top - 4;
			}
			/* Убедитесь, что текст находится не за пределами правой части экрана. */
			if (hoverPos.left > window.innerWidth - hoverPos.width - 26) {
				left -= hoverPos.left - (window.innerWidth - hoverPos.width - 26);
			}
			/* Убедитесь, что текст находится не за пределами левой части экрана. */
			if (hoverPos.left < 4) {
				left -= hoverPos.left - 4;
			}
			/* Обновить позицию. */
			element.css({ top: Math.round(top), left: Math.round(left) });
			hoverPos = element[0].getBoundingClientRect();
			if (boxPos) {  /* Вписывается в диалоговые окна и тому подобное. */
				/* Убедитесь, что текст не выходит за пределы нижней части поля. */
				if (hoverPos.top > boxPos.bottom - hoverPos.height - 10) {
					top -= hoverPos.top - (boxPos.bottom - hoverPos.height - 10);
				}
				/* Убедитесь, что текст не выходит за пределы верхней части поля. */
				if (hoverPos.top < boxPos.top + 4) {
					top -= hoverPos.top - (boxPos.top + 4);
				}
				/* Убедитесь, что текст не выходит за пределы правого поля. */
				if (hoverPos.left > boxPos.right - hoverPos.width - 26) {
					left -= hoverPos.left - (boxPos.right - hoverPos.width - 26);
				}
				/* Убедитесь, что текст не выходит за пределы левого поля. */
				if (hoverPos.left < boxPos.left + 4) {
					left -= hoverPos.left - boxPos.left - 4;
				}
				/* Обновить позицию. */
				element.css({ top: Math.round(top), left: Math.round(left) });
			}
		}
	} else {
		clearInterval(HTTIntervalID);
		HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
	}
};
/*  Ожидает, пока отрывок будет полностью отрисован, прежде чем что-либо делать.  */
var HTTIntervalID = 0;
$(document).on(":passageend", function (ev) {
	UpdateHoverTipTxt();
});
$(window).on("resize scroll", function (ev) {
	clearInterval(HTTIntervalID);
	HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
});
$("#ui-bar-toggle").on("click", function (ev) {
	clearInterval(HTTIntervalID);
	HTTIntervalID = setInterval(UpdateHoverTipTxt, 300);
});
/* <<hovertip>> макрос*/
Macro.add("hovertip", {
	tags	 : null,
	handler  : function () {
		if (this.args.length > 0) {
			var mw = "";
			if ((this.args.length > 1) && (!isNaN(parseInt(this.args[1], 10)))) {
				mw = ' style="max-width: ' + parseInt(this.args[1], 10) + 'px;"';
			}
			if (State.temporary.HoverTipCount == undefined) {
				State.temporary.HoverTipCount = 1;
			} else {
				State.temporary.HoverTipCount++;
			}
			while ($("#hoverTip" + State.temporary.HoverTipCount).length) {
				/* Найден существующий hoverTip. */
				State.temporary.HoverTipCount++;
			}
			var output = '<span id="hoverTip' + State.temporary.HoverTipCount +
					'" class="hoverTipTxt hoverTip" tabindex="0" ' +
					'onmouseenter="UpdateHoverTipTxt();">' +
					this.payload[0].contents + '<span id="hoverTipTxt' +
					State.temporary.HoverTipCount + '" class="hoverBox hoverTail"' +
					mw + '>' + this.args[0] + '</span></span>';
			$(this.output).wiki(output);
		} else {
			$(this.output).wiki(this.payload[0].contents);
		}
	}
});
/* hovertip v2.0 - Конец*/




/* ===== Камера и захват окна ===== */
setup.webcamStream = null;

setup.initWebcam = function () {
    if (setup.webcamStream) return Promise.resolve(setup.webcamStream);

    return navigator.mediaDevices.getUserMedia({ video: true, audio: false })
        .then(function(stream) {
            setup.webcamStream = stream;
            return stream;
        })
        .catch(function(err) {
            console.log("Ошибка доступа к камере:", err);
        });
};


setup.xiaomiStream = null;
setup.initXiaomi = function () {
    if (setup.xiaomiStream) return Promise.resolve(setup.xiaomiStream);
    return navigator.mediaDevices.getDisplayMedia({
        video: true,
        audio: false
    })
        .then(function(stream) {
            setup.xiaomiStream = stream;
            // Если захват остановлен — следующее нажатие кнопки запросит его заново
            stream.getVideoTracks().forEach(function (track) {
                track.addEventListener('ended', function () {
                    setup.xiaomiStream = null;
                });
            });
            return stream;
        })
        .catch(function(err) {
            console.log("Ошибка захвата экрана:", err);
        });
};






/* СИГНАЛЫ: код окна KR2 перенесён в движок терминала (шаг 1.4). */


:: StoryStylesheet [stylesheet]
/* ===== СИГНАЛЫ: оформление терминала — не редактировать вручную ===== */
/* Меняется в окне «Оформление терминала» программы «Twine СИГНАЛЫ».
   В своих стилях можно брать эти значения: var(--sg-text), var(--sg-font-size) и т. д. */
/* СИГНАЛЫ-настройки: {"v":1,"pageBg":"#000000","textColor":"#00cc00","font":"Courier New","fontFile":"","fontSize":25,"winWidth":1050,"winHeight":1050,"winPadding":20,"winOffsetX":0,"winOffsetY":0,"winBg":"#000000","borderWidth":2,"borderColor":"#00cc00","glowColor":"#00cc00","glowSize":10,"flicker":true,"flickerPeriod":0.1,"flickerDepth":5,"vignette":0,"noise":0,"noSelect":false,"noContextMenu":false,"noZoom":false,"hideCursor":0,"lineScroll":false,"startText":"Нажмите, чтобы запустить систему","startSound":"","startVolume":100,"savedColors":["#00cc00","#ffbf00","#cc0000","#cccc00","#cc00cc","#000000"],"dialogOn":true,"dialogBg":"#000000","dialogColor":"#00cc00","dialogSize":25,"dialogBorderColor":"#00cc00","dialogBorderWidth":2,"dialogGlow":10,"dialogTitleBg":"#000000","dialogTitleColor":"#00cc00","dialogTitleSize":25,"dialogTitleLine":1,"typeClick":true,"typeSeen":true,"inputOn":true,"inputBg":"#000000","inputColor":"#00cc00","inputBorderColor":"#00cc00","inputHoverBg":"#333333","inputHoverBorderColor":"#eeeeee","inputBorderWidth":1,"inputGlow":5,"inputFont":"","inputSize":25,"inputWidth":0,"articleBack":"Назад","articleBackKind":"","articleBackButton":false,"screens":[],"textStyles":[],"firstWays":[],"glitchColor":"#00cc00","glitchBg":"#111111","glitchShadow1":"#0000ff","glitchShadow2":"#ff0000","glitchShift":5,"glitchSpeed":2} */
:root {
	--sg-page-bg: #000000;
	--sg-text: #00cc00;
	--sg-font: "Courier New", monospace;
	--sg-font-size: 25px;
	--sg-win-bg: #000000;
	--sg-win-width: 1050px;
	--sg-win-height: 1050px;
	--sg-win-padding: 20px;
	--sg-win-offset-x: 0px;
	--sg-win-offset-y: 0px;
	--sg-border-width: 2px;
	--sg-border-color: #00cc00;
	--sg-glow-color: #00cc00;
	--sg-glow-size: 10px;
	--sg-start-text: "Нажмите, чтобы запустить систему";
	--sg-start-sound: "";
	--sg-start-volume: 1;
	--sg-protect-menu: 0;
	--sg-protect-zoom: 0;
	--sg-hide-cursor: 0;
	--sg-line-scroll: 0;
	--sg-type-click: 1;
	--sg-type-seen: 1;
	--sg-article-back: "Назад";
	--sg-article-kind: "";
	--sg-article-button: 0;
}
body {
	background-color: var(--sg-page-bg);
	color: var(--sg-text);
	font-family: var(--sg-font);
	font-size: var(--sg-font-size);
	margin: 0;
	height: 100vh;
	display: flex;
	justify-content: center;
	align-items: center;
	position: relative;
}
#passages {
	background-color: var(--sg-win-bg);
	border: var(--sg-border-width) solid var(--sg-border-color);
	box-shadow: 0 0 var(--sg-glow-size) var(--sg-glow-color), 0 0 calc(var(--sg-glow-size) * 2) var(--sg-glow-color);
	width: var(--sg-win-width);
	max-width: none;
	height: var(--sg-win-height);
	padding: var(--sg-win-padding);
	box-sizing: border-box;
	overflow: auto;
	animation: sg-flicker 0.1s infinite;
}
@keyframes sg-flicker {
	0% { opacity: 1; }
	50% { opacity: 0.95; }
	100% { opacity: 1; }
}
html.sg-cursor-hidden, html.sg-cursor-hidden * { cursor: none !important; }
#sg-fx {
	position: fixed;
	pointer-events: none;
	z-index: 1000;
	overflow: hidden;
}
#sg-start {
	position: fixed;
	inset: 0;
	z-index: 2147483647;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 1em;
	box-sizing: border-box;
	background-color: var(--sg-page-bg);
	color: var(--sg-text);
	font-family: var(--sg-font);
	font-size: var(--sg-font-size);
	text-align: center;
	cursor: pointer;
	user-select: none;
}
#sg-start::after {
	content: var(--sg-start-text);
	animation: sg-blink 1.2s steps(1, end) infinite;
}
@keyframes sg-blink {
	50% { opacity: 0; }
}
#ui-dialog {
	background-color: #000000;
	border: 2px solid #00cc00;
	box-shadow: 0 0 10px #00cc00, 0 0 20px #00cc00;
	color: #00cc00;
	font-size: 25px;
}
#ui-dialog-titlebar {
	background-color: #000000;
	color: #00cc00;
	border-bottom: 1px solid #00cc00;
	font-size: 25px;
}
#ui-dialog-close {
	color: #00cc00;
}
#ui-dialog-body {
	background-color: #000000;
	border: none;
	color: #00cc00;
	font-size: 25px;
}
html input, html textarea {
	background-color: #000000;
	color: #00cc00;
	border: 1px solid #00cc00;
	box-shadow: 0 0 5px #00cc00;
	font-size: 25px;
}
html input:hover, html textarea:hover, html[data-outlines] input:focus, html[data-outlines] textarea:focus {
	background-color: #333333;
	border-color: #eeeeee;
}
html .glitchy { color: #00cc00; position: relative; }
html .glitchy::before { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -9px; text-shadow: 1px 0 #0000ff; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-2 3s infinite linear alternate-reverse; }
html .glitchy::after { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -5px; text-shadow: -1px 0 #ff0000; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-1 2s infinite linear alternate-reverse; }
@keyframes sg-glitch-1 { 0% { clip-path: polygon(0 80px, 100% 80px, 100% 16px, 0 16px); } 5% { clip-path: polygon(0 94px, 100% 94px, 100% 17px, 0 17px); } 10% { clip-path: polygon(0 9px, 100% 9px, 100% 92px, 0 92px); } 15.0% { clip-path: polygon(0 37px, 100% 37px, 100% 4px, 0 4px); } 20% { clip-path: polygon(0 53px, 100% 53px, 100% 47px, 0 47px); } 25% { clip-path: polygon(0 99px, 100% 99px, 100% 69px, 0 69px); } 30.0% { clip-path: polygon(0 15px, 100% 15px, 100% 49px, 0 49px); } 35% { clip-path: polygon(0 83px, 100% 83px, 100% 81px, 0 81px); } 40% { clip-path: polygon(0 55px, 100% 55px, 100% 43px, 0 43px); } 45% { clip-path: polygon(0 28px, 100% 28px, 100% 27px, 0 27px); } 50% { clip-path: polygon(0 64px, 100% 64px, 100% 28px, 0 28px); } 55.0% { clip-path: polygon(0 76px, 100% 76px, 100% 91px, 0 91px); } 60.0% { clip-path: polygon(0 29px, 100% 29px, 100% 72px, 0 72px); } 65% { clip-path: polygon(0 70px, 100% 70px, 100% 10px, 0 10px); } 70% { clip-path: polygon(0 5px, 100% 5px, 100% 84px, 0 84px); } 75% { clip-path: polygon(0 46px, 100% 46px, 100% 81px, 0 81px); } 80% { clip-path: polygon(0 7px, 100% 7px, 100% 85px, 0 85px); } 85.0% { clip-path: polygon(0 17px, 100% 17px, 100% 89px, 0 89px); } 90% { clip-path: polygon(0 41px, 100% 41px, 100% 59px, 0 59px); } 95% { clip-path: polygon(0 53px, 100% 53px, 100% 90px, 0 90px); } 100% { clip-path: polygon(0 10px, 100% 10px, 100% 30px, 0 30px); } }
@keyframes sg-glitch-2 { 0% { clip-path: polygon(0 84px, 100% 84px, 100% 3px, 0 3px); } 5% { clip-path: polygon(0 31px, 100% 31px, 100% 69px, 0 69px); } 10% { clip-path: polygon(0 37px, 100% 37px, 100% 33px, 0 33px); } 15.0% { clip-path: polygon(0 18px, 100% 18px, 100% 6px, 0 6px); } 20% { clip-path: polygon(0 25px, 100% 25px, 100% 87px, 0 87px); } 25% { clip-path: polygon(0 100px, 100% 100px, 100% 8px, 0 8px); } 30.0% { clip-path: polygon(0 24px, 100% 24px, 100% 87px, 0 87px); } 35% { clip-path: polygon(0 39px, 100% 39px, 100% 16px, 0 16px); } 40% { clip-path: polygon(0 96px, 100% 96px, 100% 25px, 0 25px); } 45% { clip-path: polygon(0 16px, 100% 16px, 100% 100px, 0 100px); } 50% { clip-path: polygon(0 92px, 100% 92px, 100% 76px, 0 76px); } 55.0% { clip-path: polygon(0 29px, 100% 29px, 100% 40px, 0 40px); } 60.0% { clip-path: polygon(0 40px, 100% 40px, 100% 39px, 0 39px); } 65% { clip-path: polygon(0 94px, 100% 94px, 100% 44px, 0 44px); } 70% { clip-path: polygon(0 2px, 100% 2px, 100% 78px, 0 78px); } 75% { clip-path: polygon(0 86px, 100% 86px, 100% 50px, 0 50px); } 80% { clip-path: polygon(0 2px, 100% 2px, 100% 46px, 0 46px); } 85.0% { clip-path: polygon(0 41px, 100% 41px, 100% 71px, 0 71px); } 90% { clip-path: polygon(0 75px, 100% 75px, 100% 15px, 0 15px); } 95% { clip-path: polygon(0 41px, 100% 41px, 100% 8px, 0 8px); } 100% { clip-path: polygon(0 23px, 100% 23px, 100% 75px, 0 75px); } }
/* ===== СИГНАЛЫ: конец оформления терминала ===== */

/* ===== СИГНАЛЫ: виды кнопок и ссылок — не редактировать вручную ===== */
/* Меняется в окне «Виды кнопок и ссылок» программы «Twine СИГНАЛЫ».
   В пассаже вид назначается обёрткой: <span class="amber">…ссылки и кнопки…</span>. */
/* СИГНАЛЫ-виды: {"v":1,"kinds":[{"cls":"","name":"Обычный","link":{"normal":{"color":"#00cc00","bg":"","borderWidth":0,"borderColor":"#00cc00","glow":0,"glowColor":"#00cc00","underline":false},"hover":{"color":"#00ff00","bg":"","borderWidth":0,"borderColor":"#00ff00","glow":0,"glowColor":"#00ff00","underline":true},"active":null,"padV":0,"padH":0,"size":100,"transition":0.2},"button":{"normal":{"color":"#00cc00","bg":"#000000","borderWidth":1,"borderColor":"#00cc00","glow":5,"glowColor":"#00cc00","underline":false},"hover":{"color":"#000000","bg":"#00cc00","borderWidth":0,"borderColor":"#00cc00","glow":5,"glowColor":"#00cc00","underline":false},"active":null,"padV":5,"padH":10,"size":100,"transition":0.3},"buttonAsLink":false},{"cls":"red-big","name":"Красный большой","link":{"normal":{"color":"#cc0000","bg":"","borderWidth":0,"borderColor":"#cc0000","glow":0,"glowColor":"#cc0000","underline":false},"hover":{"color":"#ff0000","bg":"","borderWidth":0,"borderColor":"#ff0000","glow":0,"glowColor":"#ff0000","underline":true},"active":null,"padV":0,"padH":0,"size":120,"transition":0.3},"button":{"normal":{"color":"#cc0000","bg":"#000000","borderWidth":1,"borderColor":"#cc0000","glow":5,"glowColor":"#cc0000","underline":false},"hover":{"color":"#000000","bg":"#cc0000","borderWidth":0,"borderColor":"#cc0000","glow":5,"glowColor":"#cc0000","underline":false},"active":null,"padV":10,"padH":20,"size":120,"transition":0.3},"buttonAsLink":false},{"cls":"yellow-small","name":"Жёлтый маленький","link":{"normal":{"color":"#cccc00","bg":"#000000","borderWidth":1,"borderColor":"#cccc00","glow":5,"glowColor":"#cccc00","underline":false},"hover":{"color":"#000000","bg":"#cccc00","borderWidth":0,"borderColor":"#cccc00","glow":5,"glowColor":"#cccc00","underline":true},"active":null,"padV":3,"padH":6,"size":80,"transition":0.3},"button":{"normal":{"color":"#cccc00","bg":"#000000","borderWidth":1,"borderColor":"#cccc00","glow":5,"glowColor":"#cccc00","underline":false},"hover":{"color":"#000000","bg":"#cccc00","borderWidth":0,"borderColor":"#cccc00","glow":5,"glowColor":"#cccc00","underline":false},"active":null,"padV":3,"padH":6,"size":80,"transition":0.3},"buttonAsLink":false},{"cls":"amber","name":"Янтарный","link":{"normal":{"color":"#ffbf00","bg":"#000000","borderWidth":2,"borderColor":"#ffbf00","glow":5,"glowColor":"#ffbf00","underline":false},"hover":{"color":"#000000","bg":"#ffbf00","borderWidth":2,"borderColor":"#ffbf00","glow":5,"glowColor":"#ffbf00","underline":false},"active":null,"padV":4,"padH":9,"size":120,"transition":0.3},"button":{"normal":{"color":"#ffbf00","bg":"#000000","borderWidth":2,"borderColor":"#ffbf00","glow":5,"glowColor":"#ffbf00","underline":false},"hover":{"color":"#000000","bg":"#ffbf00","borderWidth":2,"borderColor":"#ffbf00","glow":5,"glowColor":"#ffbf00","underline":false},"active":null,"padV":4,"padH":9,"size":120,"transition":0.3},"buttonAsLink":false},{"cls":"purple","name":"Фиолетовый","link":{"normal":{"color":"#cc00cc","bg":"","borderWidth":0,"borderColor":"#cc00cc","glow":0,"glowColor":"#cc00cc","underline":false},"hover":{"color":"#ff00ff","bg":"","borderWidth":0,"borderColor":"#ff00ff","glow":0,"glowColor":"#ff00ff","underline":true},"active":null,"padV":0,"padH":0,"size":100,"transition":0.3},"button":{"normal":{"color":"#cc00cc","bg":"#000000","borderWidth":1,"borderColor":"#cc00cc","glow":5,"glowColor":"#cc00cc","underline":false},"hover":{"color":"#000000","bg":"#cc00cc","borderWidth":1,"borderColor":"#cc00cc","glow":5,"glowColor":"#cc00cc","underline":false},"active":null,"padV":5,"padH":10,"size":100,"transition":0.3},"buttonAsLink":false}],"places":[]} */
a {
	color: #00cc00;
	text-decoration: none;
	transition: all 0.2s;
}
a:hover {
	color: #00ff00;
	text-decoration: underline;
}
button {
	color: #00cc00;
	background-color: #000000;
	border: 1px solid #00cc00;
	box-shadow: 0 0 5px #00cc00;
	text-decoration: none;
	padding: 5px 10px;
	transition: all 0.3s;
}
button:hover {
	color: #000000;
	background-color: #00cc00;
	border: none;
}
.red-big a {
	color: #cc0000;
	background-color: transparent;
	border: none;
	box-shadow: none;
	text-decoration: none;
	padding: 0px 0px;
	font-size: 1.2em;
	transition: all 0.3s;
}
.red-big a:hover {
	color: #ff0000;
	text-decoration: underline;
}
.red-big button {
	color: #cc0000;
	background-color: #000000;
	border: 1px solid #cc0000;
	box-shadow: 0 0 5px #cc0000;
	text-decoration: none;
	padding: 10px 20px;
	font-size: 1.2em;
	transition: all 0.3s;
}
.red-big button:hover {
	color: #000000;
	background-color: #cc0000;
	border: none;
}
.yellow-small a {
	color: #cccc00;
	background-color: #000000;
	border: 1px solid #cccc00;
	box-shadow: 0 0 5px #cccc00;
	text-decoration: none;
	padding: 3px 6px;
	font-size: 0.8em;
	transition: all 0.3s;
}
.yellow-small a:hover {
	color: #000000;
	background-color: #cccc00;
	border: none;
	text-decoration: underline;
}
.yellow-small button {
	color: #cccc00;
	background-color: #000000;
	border: 1px solid #cccc00;
	box-shadow: 0 0 5px #cccc00;
	text-decoration: none;
	padding: 3px 6px;
	font-size: 0.8em;
	transition: all 0.3s;
}
.yellow-small button:hover {
	color: #000000;
	background-color: #cccc00;
	border: none;
}
.amber a {
	color: #ffbf00;
	background-color: #000000;
	border: 2px solid #ffbf00;
	box-shadow: 0 0 5px #ffbf00;
	text-decoration: none;
	padding: 4px 9px;
	font-size: 1.2em;
	transition: all 0.3s;
}
.amber a:hover {
	color: #000000;
	background-color: #ffbf00;
}
.amber button {
	color: #ffbf00;
	background-color: #000000;
	border: 2px solid #ffbf00;
	box-shadow: 0 0 5px #ffbf00;
	text-decoration: none;
	padding: 4px 9px;
	font-size: 1.2em;
	transition: all 0.3s;
}
.amber button:hover {
	color: #000000;
	background-color: #ffbf00;
}
.purple a {
	color: #cc00cc;
	background-color: transparent;
	border: none;
	box-shadow: none;
	text-decoration: none;
	padding: 0px 0px;
	font-size: 1em;
	transition: all 0.3s;
}
.purple a:hover {
	color: #ff00ff;
	text-decoration: underline;
}
.purple button {
	color: #cc00cc;
	background-color: #000000;
	border: 1px solid #cc00cc;
	box-shadow: 0 0 5px #cc00cc;
	text-decoration: none;
	padding: 5px 10px;
	font-size: 1em;
	transition: all 0.3s;
}
.purple button:hover {
	color: #000000;
	background-color: #cc00cc;
}
/* ===== СИГНАЛЫ: конец видов кнопок и ссылок ===== */


.ui-dialog {
    background-color: #000000;
    border: 2px solid #00cc00;
    box-shadow: 0 0 10px #00cc00, 0 0 20px #00cc00;
    color: #00cc00;
       font-size: 25px;
}

.ui-dialog-titlebar {
    background-color: #000000;
    color: #00cc00;
    border-bottom: 1px solid #00cc00;
     font-size: 25px;
}

.ui-dialog-body {
    color: #00cc00;
     font-size: 25px;
}

input, textarea {
    background-color: #000000;
    color: #00cc00;
    border: 1px solid #00cc00;
    box-shadow: 0 0 5px #00cc00;
    padding: 5px;
     font-size: 25px;
}

#ui-bar, #ui-bar-toggle {
    background-color: #000000;
    color: #00cc00;
    border: none;
     font-size: 25px;
}


/* Подключаем шрифт DSEG7 Classic для сегментного дизайна */
@font-face {
    font-family: 'DSEG7';
    src: url('media/fonts/DSEG7Classic-Regular.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
}

#timer-display {
    font-family: 'DSEG7', monospace;
    font-size: 125px; /* Размер шрифта для читаемости */
    color: #cc0000; /* Красный цвет */
    background-color: #000000;
    border: 2px solid #cc0000;
    box-shadow: 0 0 10px #cc0000, 0 0 20px #cc0000;
    padding: 10px 20px;
    width: fit-content; /* Ширина подстраивается под содержимое */
    display: inline-block; /* Делает контейнер компактным */
    margin: 20px auto; /* Центрирует элемент по горизонтали */
    text-align: center; /* Центрирует текст внутри элемента */
    display: flex; /* Используем flexbox для точного центрирования */
    justify-content: center; /* Центрирует содержимое по горизонтали */
    align-items: center; /* Центрирует содержимое по вертикали (если нужно) */
}

.center-text {
    text-align: center; /* По центру по горизонтали */
}

.side-text {
    text-align: right; /* Справа по горизонтали */
}



#blockscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #cc0000;
    color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 70px;
    z-index: 1002;
}

#blackscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 70px;
    z-index: 1002;
}




/* Стили для поля ввода пароля */
.password-input {
    background-color: #000000;
    color: #00cc00;
    border: 1px solid #00cc00;
    box-shadow: 0 0 5px #00cc00;
    padding: 5px;
    font-size: 20px;
    font-family: "Courier New", monospace;
    width: 200px; /* Ширина поля ввода */
    display: block; /* Делает поле блочным элементом */
    margin: 20px auto; /* Центрируем поле */
}






#terminalDisplay {
    width: 100%;
    height: 70%;
    overflow: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
      text-align: center;
    line-height: 1.5;
}

#likenessDisplay {
    width: 100%;
    height: 10%;
    overflow: auto;
    text-align: center;
    margin-top: 10px;
}

#attemptsLeft {
    width: 100%;
    height: 10%;
    margin-top: 10px;
    text-align: center;
}

.word {
    color: #00cc00; /* Зеленый текст */
    background-color: #000000; /* Черный фон */
}

.word:hover {
    color: #000000; /* Черный текст при наведении */
    background-color: #00cc00; /* Зеленый фон при наведении */
}




/* Глючный текст - старт */

/* "Clip" в ".glitch" не используется, поэтому технически вы должны использовать "clip-path", который находится в ".glitchy", однако Internet Explorer не поддерживает "clip-path", а большинство браузеров по-прежнему поддерживают "clip". */


.glitchy {
  color: #00cc00;
  position: relative;
}
.glitchy::before {
  content: attr(data-text);
  width: calc(100% + 0.5em);
  position: absolute;
  left: -9px;
  text-shadow: 1px 0 blue;
  top: -5px;
  color: #00cc00;
  background: #111;
  overflow: hidden;
  clip-path: polygon(0 0);
  animation: noise-animY-2 3s infinite linear alternate-reverse;
  -webkit-animation: noise-animY-2 3s infinite linear alternate-reverse;
}
.glitchy::after {
  content: attr(data-text);
  width: calc(100% + 0.5em);
  position: absolute;
  left: -5px;
  text-shadow: -1px 0 red;
  top: -5px;
  color: #00cc00;
  background: #111;
  overflow: hidden;
  clip-path: polygon(0 0);
  animation: noise-animY 2s infinite linear alternate-reverse;
  -webkit-animation: noise-animY 2s infinite linear alternate-reverse;
}
@keyframes noise-animY {
  0% {
    clip-path: polygon(0 80px, 100% 80px, 100% 16px, 0 16px);
  }
  5% {
    clip-path: polygon(0 94px, 100% 94px, 100% 17px, 0 17px);
  }
  10% {
    clip-path: polygon(0 9px, 100% 9px, 100% 92px, 0 92px);
  }
  15.0% {
    clip-path: polygon(0 37px, 100% 37px, 100% 4px, 0 4px);
  }
  20% {
