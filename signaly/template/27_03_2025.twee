:: Горячие клавиши [sg-keys] {"position":"1625,0","size":"100,100"}
/* СИГНАЛЫ: горячие клавиши мастера — правьте в окне «Горячие клавиши» (вкладка «История»).
   Удерживать Z и нажать Shift + букву или цифру. Этот экран игрокам не показывается. */
<<sg-key "Shift+Z+N" "Новая игра" builtin newgame>><</sg-key>>
<<sg-key "Shift+Z+X" "Закрыть экран тревоги" builtin alarm>><</sg-key>>
<<sg-key "Shift+Z+A" "Мастерское сообщение">>
<<sg-open "Мастерское сообщение" passage "showPSGinfo">><</sg-open>>
<<sg-sound "media/audio/msgsoundA.wav" volume 100>>
<</sg-key>>
<<sg-key "Shift+Z+B" "Переход на gotoPSG" goto "gotoPSG">>
<<sg-sound "media/audio/click3.wav" volume 100>>
<</sg-key>>
<<sg-key "Shift+Z+C" "Звук radiovinyl">>
<<sg-sound "media/audio/radiovinyl.wav" volume 100 keep>>
<</sg-key>>


:: Музыка [sg-music] {"position":"1775,0","size":"100,100"}
/* СИГНАЛЫ: музыка — правьте в окне «Музыка» (вкладка «История»). Папки и треки идут
   по порядку; трек относится к папке выше. Условие трека — внутри <<sg-track>>…<</sg-track>>. */
<<sg-music volume 10 spin 0.8 auto>>
<<sg-folder "Классика" section ambient>>
<<sg-track "gaal" "media/audio/musics/classic/gaal.mp3">><</sg-track>>
<<sg-track "MALLOC" "media/audio/musics/classic/MALLOC.mp3">><</sg-track>>
<<sg-track "PEOPLE" "media/audio/musics/classic/PEOPLE.mp3">><</sg-track>>
<<sg-folder "new" section ambient>>
<<sg-track "Gaal_Pirate" "media/audio/musics/new/Gaal_Pirate.mp3">><</sg-track>>
<<sg-track "Human_Pirate" "media/audio/musics/new/Human_Pirate.mp3">><</sg-track>>
<<sg-track "Maloc_Pirate" "media/audio/musics/new/Maloc_Pirate.mp3">><</sg-track>>
<<sg-folder "третья" section ambient>>
<<sg-track "Beyond_reach" "media/audio/musics/третья/Beyond_reach.mp3">><</sg-track>>
<<sg-track "fight" "media/audio/musics/третья/fight.mp3">><</sg-track>>
<<sg-track "WEAPON" "media/audio/musics/третья/WEAPON.mp3">><</sg-track>>
<<sg-folder "Радио" section radio>>
<<sg-track "Трек 1 radioRegentropfen" "media/audio/radioRegentropfen.wav" pre "media/audio/radiovinyl.wav" wait 8 tail 2>><</sg-track>>
<<sg-track "Трек 2 radioSchubert_serenade" "media/audio/radioSchubert_serenade.wav" pre "media/audio/radiovinyl.wav" wait 8 tail 2>><</sg-track>>
<<sg-track "Трек 3 radioraindrop" "media/audio/radioraindrop.wav" pre "media/audio/radiovinyl.wav" wait 8 tail 2>><</sg-track>>


:: Радио [sg-radio] {"position":"1925,0","size":"100,100"}
/* СИГНАЛЫ: виды радио — правьте в окне «Радио» (вкладка «История»). На экран радио
   ставится блоком: «Добавить блок» → «Радио». */
<<sg-radio-view "Сломанное" type broken frame "#c9a24a" elements "#39ff7a" label "ОРБИТА-3" sparks 30>>


:: StoryScript [script]
/* ===== СИГНАЛЫ: звуки наведения и нажатия — не редактировать вручную ===== */
/* Наборы звуков — в окне «Звуки», звуки видов — в окне «Виды кнопок и ссылок». */
setup.signalySounds = {
	"sets": [
		{
			"name": "Наведение",
			"files": [
				"media/audio/hover1.wav",
				"media/audio/hover2.wav",
				"media/audio/hover3.wav",
				"media/audio/hover4.wav",
				"media/audio/hover5.wav",
				"media/audio/hover6.wav"
			],
			"volume": 5,
			"delay": 0
		},
		{
			"name": "Нажатие",
			"files": [
				"media/audio/click1.wav",
				"media/audio/click2.wav",
				"media/audio/click3.wav"
			],
			"volume": 5,
			"delay": 0
		}
	],
	"kinds": {
		"": {
			"hover": "Наведение",
			"click": "Нажатие"
		}
	}
};
/* ===== СИГНАЛЫ: конец звуков наведения и нажатия ===== */


/* ===== СИГНАЛЫ: движок терминала — не редактировать вручную ===== */
/* Версия движка: 34. Обновляется программой «Twine СИГНАЛЫ».
   Настройки — в окне «Оформление терминала» (они лежат в таблице стилей).
   Свой код пишите ниже конца этого блока. */
(function () {
	'use strict';

	// История в один шаг: «назад» в браузере не откатывает игру.
	Config.history.maxStates = 1;

	var rootStyle = getComputedStyle(document.documentElement);

	function opt(name, fallback) {
		var raw = rootStyle.getPropertyValue('--sg-' + name).trim();

		if (raw === '') {
			return fallback;
		}
		if (raw.charAt(0) === '"') {
			try {
				return JSON.parse(raw);
			} catch (e) {
				return fallback;
			}
		}

		var number = Number(raw);

		return isNaN(number) ? raw : number;
	}

	var settings = {
		startSound: opt('start-sound', ''),
		startVolume: opt('start-volume', 1),
		noContextMenu: opt('protect-menu', 0) === 1,
		noZoom: opt('protect-zoom', 0) === 1,
		hideCursorAfter: opt('hide-cursor', 0),
		lineScroll: opt('line-scroll', 0) === 1,
		// Печать текста (шаг 2.1): по умолчанию включено (ответ автора 6А).
		typeClick: opt('type-click', 1) === 1,
		typeSeen: opt('type-seen', 1) === 1
	};

	// Предпросмотр в программе: без стартового экрана, автокопии и защиты.
	var preview = window.SIGNALY_PREVIEW;

	setup.signaly = {engine: 34, preview: !!preview};

	// Русские служебные надписи SugarCube (этап 6, ответ 4А). Код автора стоит
	// ниже движка, поэтому его надписи главнее.
	Object.assign(l10nStrings, {"textAbort":"Прервать","textAborting":"Прерывание","textCancel":"Отмена","textClear":"Очистить","textClose":"Закрыть","textDelete":"Удалить","textExport":"Экспорт","textIdentity":"игра","textImport":"Импорт","textLoad":"Загрузить","textOff":"Выкл","textOk":"ОК","textOn":"Вкл","textSave":"Сохранить","textTurn":"Ход","errorNonexistentPassage":"пассажа «{passage}» не существует","warningNoStorage":"Нет доступного хранилища браузера. Возможные причины: запрещены сторонние файлы cookie (этот запрет действует и на Web Storage) или включён приватный режим.","warningNoWebStorage":"Нет Web Storage, поэтому игра работает в упрощённом режиме. Продолжить можно, но некоторые части могут работать неправильно.","warningDegraded":"Браузер поддерживает не всё, что нужно игре, поэтому она работает в упрощённом режиме. Продолжить можно, но некоторые части могут работать неправильно.","warningNoSaves":"Браузер поддерживает не всё, что нужно для сохранений, поэтому в этом сеансе они отключены.","saveErrorDisallowed":"Сейчас сохранять нельзя.","saveErrorDecodeFail":"не удалось прочитать сохранение: вероятно, оно повреждено","saveErrorDiskLoadFail":"не удалось загрузить файл сохранения с диска","saveErrorIdMismatch":"сохранение относится к другой игре","saveErrorInvalidData":"в сохранении нет нужных данных: вероятно, оно повреждено","saveErrorLoadTooEarly":"так рано сохранение загрузить нельзя","saveErrorNonexistent":"сохранение не найдено","uiBarLabelToggle":"Показать или скрыть боковую панель","uiBarLabelBackward":"Назад по истории игры","uiBarLabelForward":"Вперёд по истории игры","uiBarLabelJumpto":"Перейти к выбранному месту истории игры","alertTitle":"Внимание","restartTitle":"Начать заново","restartMesgPrompt":"Всё несохранённое будет потеряно. Начать заново?","continueTitle":"Продолжить","savesTitle":"Сохранения","savesHeaderBrowser":"В браузере","savesHeaderDisk":"На диске","savesLabelBrowserClear":"Удалить все сохранения браузера","savesLabelBrowserExport":"Выгрузить сохранения браузера в файл","savesLabelBrowserImport":"Загрузить сохранения браузера из файла","savesLabelDiskLoad":"Загрузить с диска","savesLabelDiskSave":"Сохранить на диск","savesTextBrowserAuto":"Автосохранение","savesTextBrowserSlot":"Ячейка","savesTextNoDate":"дата неизвестна","settingsTitle":"Настройки","settingsTextReset":"Вернуть значения по умолчанию","errorViewTitle":"Ошибка","errorViewLabelToggle":"Показать или скрыть подробности ошибки","debugBarLabelToggle":"Показать или скрыть панель отладки","debugBarLabelViewsToggle":"Показать или скрыть отладочные метки","debugBarLabelWatchAdd":"Добавить переменную в наблюдение","debugBarLabelWatchAll":"Наблюдать за всеми","debugBarLabelWatchClear":"Убрать все наблюдения","debugBarLabelWatchDelete":"Убрать это наблюдение","debugBarLabelWatchPlaceholder":"имя переменной","debugBarLabelPassagePlaceholder":"имя пассажа","debugBarLabelPassagePlay":"Перейти на пассаж","debugBarLabelWatchToggle":"Показать или скрыть наблюдение","debugBarMesgNoWatches":"Наблюдений нет","debugBarTextAdd":"Добавить","debugBarTextPassage":"Пассаж","debugBarTextViews":"Метки","debugBarTextWatch":"Наблюдение","macroBackText":"Назад","macroReturnText":"Вернуться","autoloadTitle":"Автозагрузка","autoloadMesgPrompt":"Есть автосохранение. Загрузить его или начать сначала?","autoloadTextCancel":"Начать сначала","autoloadTextOk":"Загрузить автосохранение","jumptoTitle":"Перейти","jumptoMesgUnavailable":"Пока некуда перейти…","shareTitle":"Поделиться"});
	// Крестик окна SugarCube создаёт раньше, чем выполняется «JavaScript истории».
	$('#ui-dialog-close').attr('aria-label', l10nStrings.textClose);

	function showStartScreen(onClick) {
		var screen = document.createElement('div');

		screen.id = 'sg-start';
		document.body.appendChild(screen);
		screen.addEventListener('click', function () {
			onClick(screen);
		});
		return screen;
	}

	/* ----- Прокрутка по одной строке ----- */

	function scrollTarget(element) {
		while (element && element !== document.documentElement) {
			var style = getComputedStyle(element);

			if (
				/(auto|scroll)/.test(style.overflowY) &&
				element.scrollHeight > element.clientHeight
			) {
				return element;
			}
			element = element.parentElement;
		}
		return null;
	}

	if (settings.lineScroll) {
		document.addEventListener(
			'wheel',
			function (ev) {
				if (ev.ctrlKey || ev.deltaY === 0) {
					return;
				}

				var target = scrollTarget(ev.target);

				if (!target) {
					return;
				}

				// Высота строки — меряем настоящую строку текста этого блока.
				var probe = document.createElement('div');

				probe.textContent = 'X';
				probe.style.cssText = 'position:absolute;visibility:hidden;left:0;top:0;';
				target.appendChild(probe);

				var line = probe.getBoundingClientRect().height;

				target.removeChild(probe);
				ev.preventDefault();
				target.scrollBy({top: ev.deltaY > 0 ? line : -line, behavior: 'instant'});
			},
			{passive: false}
		);
	}

	/* ----- Слой эффектов поверх терминала ----- */

	// Шум и затемнение углов — в слое #sg-fx точно по рамке #passages. Слой
	// живёт внутри #passages (мерцает вместе с ним, экран тревоги остаётся
	// сверху), но закреплён на экране и не прокручивается вместе с текстом.
	function placeEffects() {
		var passages = document.getElementById('passages');

		if (!passages) {
			return;
		}

		var fx = document.getElementById('sg-fx');

		if (!fx) {
			fx = document.createElement('div');
			fx.id = 'sg-fx';
			fx.setAttribute('aria-hidden', 'true');
		}
		if (fx.parentNode !== passages) {
			passages.appendChild(fx);
		}

		var rect = passages.getBoundingClientRect();

		fx.style.left = rect.left + 'px';
		fx.style.top = rect.top + 'px';
		fx.style.width = rect.width + 'px';
		fx.style.height = rect.height + 'px';
	}

	$(document).on(':passagedisplay', placeEffects);
	window.addEventListener('resize', placeEffects);
	document.addEventListener('fullscreenchange', placeEffects);
	setInterval(placeEffects, 1000);

	/* ----- Звук по событию (шаг 3.3, с шага 5.4 — и до границы предпросмотра) ----- */

	// Отдельный звук мимо SimpleAudio: его не задевают кнопки A–E, пауза и
	// громкость групп. Файл загружается заранее, звучит до конца.
	var signalAudio = {};

	function signalFor(src) {
		if (!signalAudio[src]) {
			var audio = new Audio(src);

			audio.preload = 'auto';
			audio.sgUi = true;
			signalAudio[src] = audio;
		}
		return signalAudio[src];
	}

	function signalPlay(src, volume, keep) {
		if (!src || !uiSoundOn()) {
			return;
		}

		var audio = signalFor(String(src));
		var level = volume === undefined ? 100 : Number(volume);

		audio.volume = Math.max(0, Math.min(1, (isNaN(level) ? 100 : level) / 100));
		if (!keep) {
			audio.currentTime = 0;
		}
		audio.play().catch(function (e) {
			console.error('СИГНАЛЫ: звук-сигнал', e);
		});
	}

	/* ----- Блоки экрана (шаг 1.4) ----- */

	// Команды: <<sg-image>>, <<sg-video>>, <<sg-alarm>>, <<sg-dialog>>,
	// <<sg-code>> (с <<sg-case>> и <<sg-wrong>>), окно KR2. Их вставляет панель
	// «Добавить блок»; в обычном Twine они работают так же.

	var engineStyle = document.createElement('style');

	engineStyle.id = 'sg-engine-style';
	engineStyle.textContent =
		'@keyframes sg-alarm-blink { 50% { filter: brightness(0.45); } }\n' +
		'html[data-sg-dialog="noclose"] #ui-dialog-close { display: none; }\n' +
		'.sg-dialog-ok { margin-top: 1em; text-align: center; }\n' +
		// Эффекты текста (шаг 2.1): мигание; глитч — с нулевой силой (:where),
		// его перекрывают и блок оформления, и стили автора.
		'@keyframes sg-text-blink { 50% { opacity: 0; } }\n' +
		'.sg-blink { animation: sg-text-blink 1s steps(1, end) infinite; }\n' +
		// Сессия 7: ссылка в печатающемся тексте ждёт конца своей надписи;
		// глитч и мигание до своего начала — обычный текст.
		'.sg-type-wait { pointer-events: none !important; }\n' +
		// Шаг 4.3: ссылка на закрытый экран — скрыта или не нажимается.
		'.sg-acc-hide { display: none !important; }\n' +
		'.sg-acc-off { pointer-events: none !important; }\n' +
		// Шаг 4.4: список статей и ссылка «Назад».
		'.sg-art-section { margin-bottom: 1em; }\n' +
		'.sg-art-heading { font-weight: bold; margin-bottom: 0.4em; }\n' +
		'.sg-art-grid { display: grid; gap: 0.3em 2em; justify-items: start; }\n' +
		'.sg-art-back { margin-top: 1.5em; }\n' +
		// Шаг 5.1: список состояний и плитка.
		'.sg-list-grid { display: grid; gap: 0.4em 1.5em; justify-items: start; }\n' +
		'.sg-list-tiles { gap: 0.8em; justify-items: stretch; }\n' +
		'.sg-list-tiles .sg-list-item > span { display: block; }\n' +
		'.sg-tile { border: 2px solid currentColor; box-sizing: border-box; display: block; padding: 0.4em 0.7em; text-decoration: none; }\n' +
		'a.sg-tile:not(.sg-list-color):hover { filter: brightness(1.3); }\n' +
		// Свой цвет состояния: те же правила, что у видов, — при наведении цвета
		// меняются местами. Правило сильнее вида, инлайн-стиль убил бы наведение.
		'.sg-list-item .sg-list-color { border-color: var(--sg-state); color: var(--sg-state); }\n' +
		'.sg-list-item button.sg-list-color { box-shadow: 0 0 5px var(--sg-state); }\n' +
		'.sg-list-item a.sg-list-color:hover, .sg-list-item button.sg-list-color:hover { background-color: var(--sg-state); color: #000000; }\n' +
		'.sg-tile-name { display: block; font-weight: bold; }\n' +
		'.sg-tile-status { display: block; }\n' +
		// Шаг 5.2: терминал взлома.
		'.sg-hack { --sg-hack-light: var(--sg-text, #00cc00); display: grid; grid-template: "top top top" auto "left field right" auto "bottom bottom bottom" auto / auto minmax(0, 1fr) auto; text-align: center; }\n' +
		'.sg-hack-field { display: grid; font-variant-ligatures: none; grid-area: field; justify-content: safe center; line-height: 1.5; overflow: auto; user-select: none; white-space: pre; }\n' +
		'.sg-hack-framed .sg-hack-field { border: var(--sg-border-width, 1px) solid var(--sg-border-color, currentColor); box-shadow: inset 0 0 14px var(--sg-glow-color, transparent); padding: 0.7em 1em; }\n' +
		'.sg-hack-final { align-items: center; justify-items: center; text-align: center; white-space: pre-line; }\n' +
		'.sg-hack-slot { display: flex; flex-direction: column; gap: 10px; justify-content: center; min-width: 0; }\n' +
		'.sg-hack-slot:empty { display: none; }\n' +
		'.sg-hack-top { grid-area: top; margin-bottom: 10px; }\n' +
		'.sg-hack-bottom { grid-area: bottom; margin-top: 10px; }\n' +
		'.sg-hack-left { grid-area: left; margin-right: 1.5em; }\n' +
		'.sg-hack-right { grid-area: right; margin-left: 1.5em; }\n' +
		'.sg-hack-hint { min-height: 1.5em; }\n' +
		// Шаг 5.3: камера.
		'.sg-camera { display: block; width: fit-content; }\n' +
		'.sg-camera-box { position: relative; overflow: hidden; }\n' +
		'.sg-camera-box video.sg-camera-fill { width: 100%; height: 100%; display: block; }\n' +
		'.sg-camera-off { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; background: #000000; }\n' +
		'.sg-camera-off canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; image-rendering: pixelated; }\n' +
		'.sg-camera-off span { position: relative; padding: 0 0.5em; }\n' +
		// Заглушка предпросмотра: сетка и крест по центру видео — видно, как оно сдвинуто.
		'.sg-camera-grid { background-color: #555555; background-image: linear-gradient(transparent calc(50% - 4px), #cccccc calc(50% - 4px), #cccccc calc(50% + 4px), transparent calc(50% + 4px)), linear-gradient(90deg, transparent calc(50% - 4px), #cccccc calc(50% - 4px), #cccccc calc(50% + 4px), transparent calc(50% + 4px)), linear-gradient(#999999 3px, transparent 3px), linear-gradient(90deg, #999999 3px, transparent 3px); background-size: 100% 100%, 100% 100%, 100px 100px, 100px 100px; }\n' +
		// Шаг 5.4: кнопка камеры прячется, когда захват подключён; подсказка.
		'.sg-camera-link.sg-off { display: none; }\n' +
		'.sg-toggle { cursor: pointer; }\n' +
		".hoverTip { border-width: 0; display: inline-block; top: 4px; }\n.hoverTipTxt { line-height: initial; position: relative; vertical-align: text-bottom; }\n.hoverTipTxt .hoverBox { position: absolute; visibility: hidden; }\n.hoverTipTxt:hover .hoverBox, .hoverTipTxt:focus .hoverBox { visibility: visible; }\n.hoverBox { box-shadow: 0 0 12px 2px rgba(0, 0, 0, 0.75); line-height: initial; padding: 3px 10px; text-align: left; width: max-content; z-index: 100; }\n.hoverTail::after { border-style: solid; border-width: 8px; content: \"\"; left: 50%; margin-left: -5px; position: absolute; top: 100%; z-index: 100; }\n.hoverBox a { transition-duration: unset; }\n#ui-bar .hoverBox { max-width: 230px; }\nhtml .hoverTip { border-bottom: var(--sg-tip-line, 2px) dotted var(--sg-tip-line-color, #00cc00); }\nhtml .hoverBox { background-color: var(--sg-tip-bg, #000000); border: var(--sg-tip-border, 2px) solid var(--sg-tip-border-color, #00cc00); border-radius: var(--sg-tip-radius, 6px); color: var(--sg-tip-color, #00cc00); font-family: var(--sg-tip-font, inherit); font-size: var(--sg-tip-size, inherit); max-width: var(--sg-tip-width, 333px); }\nhtml .hoverTail::after { border-color: var(--sg-tip-border-color, #00cc00) transparent transparent transparent; }\n" +
		'.sg-hack-c:hover, .sg-hack-word:hover { background-color: var(--sg-hack-light); color: #000000; }\n' +
		'.sg-hack-word { cursor: pointer; }\n' +
		'.sg-hack-word:hover { box-shadow: 0 0 8px var(--sg-hack-light); }\n' +
		'.sg-hack-used { cursor: default; pointer-events: none; }\n' +
		'.sg-hack-boxes { display: flex; gap: 0.4em; justify-content: center; }\n' +
		'.sg-hack-box { border: 2px solid var(--sg-hack-light); box-sizing: border-box; height: 0.9em; width: 0.9em; }\n' +
		'.sg-hack-box.sg-on { background-color: var(--sg-hack-light); box-shadow: 0 0 6px var(--sg-hack-light); }\n' +
		'.sg-hack-label { font-weight: bold; line-height: 1.1; visibility: hidden; }\n' +
		'.sg-hack-label.sg-on { visibility: visible; }\n' +
		'.sg-hack-layer { pointer-events: none; position: fixed; z-index: 1002; }\n' +
		'.sg-hack-over { align-items: center; display: flex; font-weight: bold; justify-content: center; line-height: 1; pointer-events: none; position: fixed; text-align: center; z-index: 1003; }\n' +
		'@keyframes sg-hack-flash { 0% { opacity: 0.85; } 100% { opacity: 0; } }\n' +
		'@keyframes sg-hack-flicker { 0%, 40%, 80% { opacity: 0.8; } 20%, 60%, 100% { opacity: 0; } }\n' +
		'.sg-blink.sg-off { animation: none; }\n' +
		'html .glitchy.sg-off { color: inherit; }\n' +
		'html .glitchy.sg-off::before, html .glitchy.sg-off::after { content: none; }\n' +
		":where(.glitchy) { color: #00cc00; position: relative; }\n:where(.glitchy)::before { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -9px; text-shadow: 1px 0 #0000ff; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-2 3s infinite linear alternate-reverse; }\n:where(.glitchy)::after { content: attr(data-text); width: calc(100% + 0.5em); position: absolute; left: -5px; text-shadow: -1px 0 #ff0000; top: -5px; color: #00cc00; background: #111111; overflow: hidden; clip-path: polygon(0 0); pointer-events: none; animation: sg-glitch-1 2s infinite linear alternate-reverse; }\n@keyframes sg-glitch-1 { 0% { clip-path: polygon(0 80px, 100% 80px, 100% 16px, 0 16px); } 5% { clip-path: polygon(0 94px, 100% 94px, 100% 17px, 0 17px); } 10% { clip-path: polygon(0 9px, 100% 9px, 100% 92px, 0 92px); } 15.0% { clip-path: polygon(0 37px, 100% 37px, 100% 4px, 0 4px); } 20% { clip-path: polygon(0 53px, 100% 53px, 100% 47px, 0 47px); } 25% { clip-path: polygon(0 99px, 100% 99px, 100% 69px, 0 69px); } 30.0% { clip-path: polygon(0 15px, 100% 15px, 100% 49px, 0 49px); } 35% { clip-path: polygon(0 83px, 100% 83px, 100% 81px, 0 81px); } 40% { clip-path: polygon(0 55px, 100% 55px, 100% 43px, 0 43px); } 45% { clip-path: polygon(0 28px, 100% 28px, 100% 27px, 0 27px); } 50% { clip-path: polygon(0 64px, 100% 64px, 100% 28px, 0 28px); } 55.0% { clip-path: polygon(0 76px, 100% 76px, 100% 91px, 0 91px); } 60.0% { clip-path: polygon(0 29px, 100% 29px, 100% 72px, 0 72px); } 65% { clip-path: polygon(0 70px, 100% 70px, 100% 10px, 0 10px); } 70% { clip-path: polygon(0 5px, 100% 5px, 100% 84px, 0 84px); } 75% { clip-path: polygon(0 46px, 100% 46px, 100% 81px, 0 81px); } 80% { clip-path: polygon(0 7px, 100% 7px, 100% 85px, 0 85px); } 85.0% { clip-path: polygon(0 17px, 100% 17px, 100% 89px, 0 89px); } 90% { clip-path: polygon(0 41px, 100% 41px, 100% 59px, 0 59px); } 95% { clip-path: polygon(0 53px, 100% 53px, 100% 90px, 0 90px); } 100% { clip-path: polygon(0 10px, 100% 10px, 100% 30px, 0 30px); } }\n@keyframes sg-glitch-2 { 0% { clip-path: polygon(0 84px, 100% 84px, 100% 3px, 0 3px); } 5% { clip-path: polygon(0 31px, 100% 31px, 100% 69px, 0 69px); } 10% { clip-path: polygon(0 37px, 100% 37px, 100% 33px, 0 33px); } 15.0% { clip-path: polygon(0 18px, 100% 18px, 100% 6px, 0 6px); } 20% { clip-path: polygon(0 25px, 100% 25px, 100% 87px, 0 87px); } 25% { clip-path: polygon(0 100px, 100% 100px, 100% 8px, 0 8px); } 30.0% { clip-path: polygon(0 24px, 100% 24px, 100% 87px, 0 87px); } 35% { clip-path: polygon(0 39px, 100% 39px, 100% 16px, 0 16px); } 40% { clip-path: polygon(0 96px, 100% 96px, 100% 25px, 0 25px); } 45% { clip-path: polygon(0 16px, 100% 16px, 100% 100px, 0 100px); } 50% { clip-path: polygon(0 92px, 100% 92px, 100% 76px, 0 76px); } 55.0% { clip-path: polygon(0 29px, 100% 29px, 100% 40px, 0 40px); } 60.0% { clip-path: polygon(0 40px, 100% 40px, 100% 39px, 0 39px); } 65% { clip-path: polygon(0 94px, 100% 94px, 100% 44px, 0 44px); } 70% { clip-path: polygon(0 2px, 100% 2px, 100% 78px, 0 78px); } 75% { clip-path: polygon(0 86px, 100% 86px, 100% 50px, 0 50px); } 80% { clip-path: polygon(0 2px, 100% 2px, 100% 46px, 0 46px); } 85.0% { clip-path: polygon(0 41px, 100% 41px, 100% 71px, 0 71px); } 90% { clip-path: polygon(0 75px, 100% 75px, 100% 15px, 0 15px); } 95% { clip-path: polygon(0 41px, 100% 41px, 100% 8px, 0 8px); } 100% { clip-path: polygon(0 23px, 100% 23px, 100% 75px, 0 75px); } }";
	document.head.appendChild(engineStyle);

	// Слова команды: сначала значения по порядку, потом «имя значение» и галочки.
	function blockArgs(ctx, positional, keys, flags) {
		var args = ctx.args.slice();
		var result = {};

		positional.forEach(function (name) {
			if (args.length) {
				result[name] = args.shift();
			}
		});
		while (args.length) {
			var word = String(args.shift());

			if (flags.indexOf(word) !== -1) {
				result[word] = true;
			} else if (keys.indexOf(word) !== -1 && args.length) {
				result[word] = args.shift();
			}
		}
		return result;
	}

	var placeKeys = ['place', 'corner', 'x', 'y', 'border', 'color', 'glow'];

	// Внешний вид картинки или видео: рамка, свечение, место «на экране» —
	// от угла окна терминала, как кнопки на экране.
	function placeStyle(el, a) {
		var color = a.color || 'var(--sg-text, #00cc00)';
		var border = Number(a.border) || 0;
		var glow = Number(a.glow) || 0;

		if (border > 0) {
			el.style.border = border + 'px solid ' + color;
		}
		if (glow > 0) {
			el.style.boxShadow = '0 0 ' + glow + 'px ' + color + ', 0 0 ' + glow * 2 + 'px ' + color;
		}
		if (a.place === 'screen') {
			var corner = String(a.corner || 'tl');
			var right = corner === 'tr' || corner === 'br';
			var bottom = corner === 'bl' || corner === 'br';
			var halfW = 'var(--sg-win-width, 1050px) / 2';
			var halfH = 'var(--sg-win-height, 1050px) / 2';
			var offX = 'var(--sg-win-offset-x, 0px)';
			var offY = 'var(--sg-win-offset-y, 0px)';
			var x = (Number(a.x) || 0) + 'px';
			var y = (Number(a.y) || 0) + 'px';

			el.style.position = 'fixed';
			el.style[right ? 'right' : 'left'] = right
				? 'calc(50% - ' + halfW + ' - ' + offX + ' + ' + x + ')'
				: 'calc(50% - ' + halfW + ' + ' + offX + ' + ' + x + ')';
			el.style[bottom ? 'bottom' : 'top'] = bottom
				? 'calc(50% - ' + halfH + ' - ' + offY + ' + ' + y + ')'
				: 'calc(50% - ' + halfH + ' + ' + offY + ' + ' + y + ' + var(--sg-place-shift, 0px))';
		}
	}

	// Вывод блока: «по центру» — в отдельной строке по центру.
	function putPlaced(ctx, el, a, type) {
		if (preview) {
			// Для перетаскивания мышью в предпросмотре программы.
			el.setAttribute('data-sg-block', type);
			el.setAttribute('data-sg-src', ctx.source);
		}
		if (a.place === 'center') {
			var wrap = document.createElement('div');

			wrap.style.textAlign = 'center';
			wrap.appendChild(el);
			ctx.output.appendChild(wrap);
		} else {
			ctx.output.appendChild(el);
		}
	}

	// Кнопка или ссылка SugarCube с действием (та же разметка, что у <<button>>).
	function actionControl(output, label, asButton, action) {
		var name = asButton ? 'button' : 'link';
		var holder = document.createElement('span');

		$(holder).wiki('<<' + name + ' ' + JSON.stringify(String(label)) + '>><</' + name + '>>');

		// В режиме «Тестировать» SugarCube оборачивает кнопку в рамку отладки.
		var control = holder.querySelector(asButton ? 'button' : 'a');

		$(control).on('click', action);
		while (holder.firstChild) {
			output.appendChild(holder.firstChild);
		}
		return control;
	}

	function videoType(src) {
		var ext = String(src).split('.').pop().toLowerCase();

		return ext === 'webm' ? 'video/webm' : ext === 'ogv' || ext === 'ogg' ? 'video/ogg' : 'video/mp4';
	}

	// Шаг 5.4 (ответ 7А): картинка-переключатель. Щелчок переключает переменную
	// и меняет картинку: выключено — первая, включено — вторая (second). Значение
	// меняет и всё остальное в игре (код, клавиша мастера): картинка следит сама.
	var toggleItems = [];
	var toggleTimer = null;

	function toggleDraw(item) {
		var on = !!State.getVar(item.name);

		if (item.on !== on) {
			item.on = on;
			item.img.src = on ? item.second : item.first;
		}
	}

	function toggleTick() {
		toggleItems.forEach(toggleDraw);
	}

	$(document).on(':passageinit', function () {
		toggleItems = [];
	});

	function imageToggle(img, a) {
		var item = {
			img: img,
			name: /^[$_]/.test(a.toggle) ? a.toggle : '$' + a.toggle,
			first: a.src || '',
			second: a.second || a.src || ''
		};

		// Обе картинки загружены заранее: смена без мигания.
		new Image().src = item.second;
		if (a.sound) {
			signalFor(String(a.sound));
		}
		img.classList.add('sg-toggle');
		toggleDraw(item);
		toggleItems.push(item);
		$(img).on('click', function () {
			var value = State.getVar(item.name);

			// Число остаётся числом: так шаблон сравнивает $buttoner с 0 и 1.
			State.setVar(item.name, typeof value === 'number' ? (value ? 0 : 1) : !value);
			toggleDraw(item);
			signalPlay(a.sound, a.volume);
		});
		if (!toggleTimer) {
			toggleTimer = setInterval(toggleTick, 250);
		}
	}

	Macro.add('sg-image', {
		handler: function () {
			var a = blockArgs(this, ['src'], ['width', 'second', 'toggle', 'sound', 'volume'].concat(placeKeys), []);
			var img = document.createElement('img');

			img.src = a.src || '';
			img.alt = '';
			if (Number(a.width) > 0) {
				img.style.width = Number(a.width) + 'px';
			}
			placeStyle(img, a);
			if (a.toggle) {
				imageToggle(img, a);
			}
			putPlaced(this, img, a, 'image');
		}
	});

	Macro.add('sg-video', {
		handler: function () {
			var a = blockArgs(
				this,
				['src'],
				['width', 'height'].concat(placeKeys),
				['autoplay', 'loop', 'muted', 'controls', 'buttons']
			);
			var video = document.createElement('video');
			var source = document.createElement('source');

			['controls', 'autoplay', 'loop', 'muted'].forEach(function (flag) {
				if (a[flag]) {
					video.setAttribute(flag, '');
					video[flag] = true;
				}
			});
			video.setAttribute('playsinline', '');
			if (Number(a.width) > 0) {
				video.setAttribute('width', Number(a.width));
			}
			if (Number(a.height) > 0) {
				video.setAttribute('height', Number(a.height));
			}
			source.src = a.src || '';
			source.type = videoType(a.src || '');
			video.appendChild(source);
			placeStyle(video, a);

			if (!a.buttons) {
				putPlaced(this, video, a, 'video');
				return;
			}

			// С кнопками «Воспроизвести» и «Остановить» — как в Videotest.
			var box = document.createDocumentFragment();

			box.appendChild(video);
			box.appendChild(document.createElement('br'));
			actionControl(box, 'Воспроизвести', true, function () {
				video.play().catch(function () {});
			});
			box.appendChild(document.createElement('br'));
			actionControl(box, 'Остановить', true, function () {
				video.pause();
			});
			if (preview) {
				video.setAttribute('data-sg-block', 'video');
				video.setAttribute('data-sg-src', this.source);
			}
			if (a.place === 'center') {
				var wrap = document.createElement('div');

				wrap.style.textAlign = 'center';
				wrap.appendChild(box);
				this.output.appendChild(wrap);
			} else {
				this.output.appendChild(box);
			}
		}
	});

	/* ----- Камера (шаг 5.3) ----- */

	// <<sg-camera [source window] width W height H [vwidth … vheight … shiftx … shifty …]
	// [button "…"] [nosignal "…"] [nocolor "…"] [nonoise N] [место, рамка, свечение]>>.
	// Подключение одно на источник и живёт до закрытия игры: смена экрана его не
	// теряет. Веб-камера подключается сама, захват окна браузер разрешает только
	// после нажатия кнопки. Нет живого подключения — надпись и шум поверх картинки.
	var cameraDefaults = {"width":1000,"height":1000,"button":"Подключить камеру","nosignal":"НЕТ СИГНАЛА","nonoise":30};
	var cameraKeys = ["source","width","height","vwidth","vheight","shiftx","shifty","button","nosignal","nocolor","nonoise","place","corner","x","y","border","color","glow"];
	var cameraStreams = {};
	var cameraAsked = {};
	var cameraItems = [];
	var cameraTimer = null;

	function cameraLive(source) {
		var stream = cameraStreams[source];

		return !!stream && stream.getVideoTracks().some(function (track) {
			return track.readyState === 'live';
		});
	}

	function cameraRefresh() {
		cameraItems.forEach(function (item) {
			if (!item.video) {
				return;
			}

			var live = cameraLive(item.source);

			item.off.style.display = live ? 'none' : '';
			// Шаг 5.4 (ответ 2А): подключено — кнопки нет, отключилось — вернулась.
			if (item.link) {
				item.link.classList.toggle('sg-off', live);
			}
			if (live && item.video.srcObject !== cameraStreams[item.source]) {
				item.video.srcObject = cameraStreams[item.source];
				item.video.play().catch(function () {});
			} else if (!live && item.video.srcObject) {
				item.video.srcObject = null;
			}
		});
	}

	function cameraConnect(source) {
		var media = navigator.mediaDevices;

		if (preview || !media || cameraLive(source) || cameraAsked[source]) {
			return;
		}
		cameraAsked[source] = true;

		var ask = source === 'window'
			? media.getDisplayMedia({video: true, audio: false})
			: media.getUserMedia({video: true, audio: false});

		ask.then(function (stream) {
			cameraStreams[source] = stream;
			stream.getVideoTracks().forEach(function (track) {
				track.addEventListener('ended', cameraRefresh);
			});
		}).catch(function (error) {
			console.log('Камера не подключена:', error);
		}).then(function () {
			cameraAsked[source] = false;
			cameraRefresh();
		});
	}

	function cameraNoise(item) {
		var canvas = item.canvas;
		var context = canvas.getContext('2d');
		var image = context.createImageData(canvas.width, canvas.height);

		for (var i = 0; i < image.data.length; i += 4) {
			var value = Math.floor(Math.random() * 256);

			image.data[i] = image.data[i + 1] = image.data[i + 2] = value;
			image.data[i + 3] = 255;
		}
		context.putImageData(image, 0, 0);
	}

	function cameraTick() {
		cameraRefresh();
		cameraItems.forEach(function (item) {
			if (item.canvas && item.off.style.display !== 'none' && item.box.isConnected) {
				cameraNoise(item);
			}
		});
	}

	$(document).on(':passageinit', function () {
		cameraItems = [];
	});

	Macro.add('sg-camera', {
		handler: function () {
			var a = blockArgs(this, [], cameraKeys, []);
			var source = a.source === 'window' ? 'window' : 'web';
			var width = Number(a.width) > 0 ? Number(a.width) : cameraDefaults.width;
			var height = Number(a.height) > 0 ? Number(a.height) : cameraDefaults.height;
			var vwidth = Number(a.vwidth) || 0;
			var vheight = Number(a.vheight) || 0;
			var root = document.createElement('div');
			var box = document.createElement('div');
			var off = document.createElement('div');
			var label = document.createElement('span');
			var noise = a.nonoise === undefined ? cameraDefaults.nonoise : Number(a.nonoise) || 0;
			var item = {box: box, off: off, source: source};
			var picture;

			root.className = 'sg-camera';
			box.className = 'sg-camera-box';
			box.style.width = width + 'px';
			box.style.height = height + 'px';
			placeStyle(root, {place: a.place, corner: a.corner, x: a.x, y: a.y});
			placeStyle(box, {border: a.border, color: a.color, glow: a.glow});

			// В предпросмотре вместо картинки — серая заглушка с сеткой.
			if (preview) {
				picture = document.createElement('div');
				picture.className = 'sg-camera-grid';
				picture.style.width = vwidth > 0 ? vwidth + 'px' : '100%';
				picture.style.height = vheight > 0 ? vheight + 'px' : '100%';
			} else {
				picture = document.createElement('video');
				['autoplay', 'muted'].forEach(function (flag) {
					picture.setAttribute(flag, '');
					picture[flag] = true;
				});
				picture.setAttribute('playsinline', '');
				if (vwidth > 0 || vheight > 0) {
					picture.setAttribute('width', vwidth || width);
					picture.setAttribute('height', vheight || height);
				} else {
					picture.className = 'sg-camera-fill';
				}
				item.video = picture;
			}
			picture.style.marginLeft = (Number(a.shiftx) || 0) + 'px';
			picture.style.marginTop = (Number(a.shifty) || 0) + 'px';
			box.appendChild(picture);

			off.className = 'sg-camera-off';
			off.style.color = a.nocolor || 'var(--sg-text, #00cc00)';
			off.style.fontSize = Math.max(16, Math.round(Math.min(width, height * 2) / 12)) + 'px';
			if (noise > 0) {
				item.canvas = document.createElement('canvas');
				item.canvas.width = 160;
				item.canvas.height = Math.max(1, Math.round(160 * height / width));
				item.canvas.style.opacity = Math.min(100, noise) / 100;
				off.appendChild(item.canvas);
			}
			label.textContent = a.nosignal === undefined ? cameraDefaults.nosignal : String(a.nosignal);
			off.appendChild(label);
			box.appendChild(off);
			root.appendChild(box);

			if (source === 'window') {
				item.link = document.createElement('span');
				item.link.className = 'sg-camera-link';
				item.link.appendChild(document.createElement('br'));
				actionControl(item.link, a.button || cameraDefaults.button, true, function () {
					cameraConnect('window');
				});
				root.appendChild(item.link);
			}
			if (preview) {
				// Щелчок в предпросмотре показывает, как выглядит «нет сигнала».
				off.style.display = 'none';
				box.addEventListener('click', function () {
					off.style.display = off.style.display === 'none' ? '' : 'none';
				});
			}
			if (a.place === 'center') {
				root.style.display = 'inline-block';
				root.style.verticalAlign = 'top';
			}
			cameraItems.push(item);
			putPlaced(this, root, a, 'camera');
			cameraRefresh();
			if (source === 'web') {
				cameraConnect('web');
			}
			if (!cameraTimer) {
				cameraTimer = setInterval(cameraTick, 90);
			}
		}
	});

	if (!preview) {
		// Как в шаблоне: веб-камера подключается при запуске игры, разрешение
		// браузер спрашивает до первого экрана с камерой.
		$(document).one(':passagestart', function () {
			if (Story.filter(function (p) {
				return /<<sg-camera(?=[\s>])(?![^>]*\bsource\s+"?window)/.test(p.text);
			}).length) {
				cameraConnect('web');
			}
		});
		if (navigator.mediaDevices && navigator.mediaDevices.addEventListener) {
			navigator.mediaDevices.addEventListener('devicechange', function () {
				if (cameraItems.some(function (item) { return item.source === 'web'; })) {
					cameraConnect('web');
				}
			});
		}
	}

	/* ----- Подсказка при наведении (шаг 5.4, ответ 4А) ----- */

	// <<hovertip "Текст подсказки" [ширина]>>текст<</hovertip>> — hovertip v2.0
	// шаблона: команда и места те же, вид рамки — в «Оформлении терминала». Код
	// шаблона, не узнанный при переносе, остаётся и работает сам: второй раз
	// SugarCube команду не примет, поэтому проверка — когда код истории выполнен.
	var tipTimer = 0;

	function tipLater() {
		clearInterval(tipTimer);
		tipTimer = setInterval(window.UpdateHoverTipTxt, 300);
	}

	function tipPlace(element, container) {
		var id = element.id.substring(11);
		var parent = container.find('#hoverTip' + id);
		var box = $(element);
		var top = Math.round(-box.outerHeight() - 6);
		var left = Math.round((parent.outerWidth() - box.outerWidth()) / 2);
		var zindex = box.css('z-index');
		var limit, rect;

		function keepInside(area) {
			if (rect.top > area.bottom - rect.height - 10) {
				top -= rect.top - (area.bottom - rect.height - 10);
			}
			if (rect.top < area.top + 4) {
				top -= rect.top - (area.top + 4);
			}
			if (rect.left > area.right - rect.width - 26) {
				left -= rect.left - (area.right - rect.width - 26);
			}
			if (rect.left < area.left + 4) {
				left -= rect.left - area.left - 4;
			}
			box.css({top: Math.round(top), left: Math.round(left)});
		}

		zindex = zindex === 'auto' ? 0 : parseInt(zindex, 10);
		// Подсказка внутри чего-то с большим слоем (окно-сообщение) держится в нём.
		while (parent.parent()[0] !== document) {
			if (parent.parent().css('z-index') !== 'auto' && parseInt(parent.parent().css('z-index'), 10) > zindex) {
				limit = parent[0].getBoundingClientRect();
				break;
			}
			parent = parent.parent();
		}
		box.css({top: top, left: left});
		rect = element.getBoundingClientRect();
		keepInside({top: 0, left: 0, right: window.innerWidth, bottom: window.innerHeight});
		if (limit) {
			rect = element.getBoundingClientRect();
			keepInside(limit);
		}
	}

	$(document).one(':passageinit', function () {
		if (Macro.has('hovertip')) {
			return;
		}
		window.UpdateHoverTipTxt = function (container) {
			clearInterval(tipTimer);
			if (!Engine.isIdle()) {
				tipLater();
				return;
			}

			var area = container === undefined ? $(document) : $(container);

			area.find('span[id^="hoverTipTxt"]').each(function () {
				tipPlace(this, area);
			});
		};
		$(document).on(':passageend', function () {
			window.UpdateHoverTipTxt();
		});
		$(window).on('resize scroll', tipLater);
		$('#ui-bar-toggle').on('click', tipLater);
		Macro.add('hovertip', {
			tags: null,
			handler: function () {
				if (this.args.length === 0) {
					$(this.output).wiki(this.payload[0].contents);
					return;
				}

				var width = parseInt(this.args[1], 10);
				var count = (State.temporary.HoverTipCount || 0) + 1;

				while ($('#hoverTip' + count).length) {
					count++;
				}
				State.temporary.HoverTipCount = count;
				$(this.output).wiki(
					'<span id="hoverTip' + count + '" class="hoverTipTxt hoverTip" tabindex="0" onmouseenter="UpdateHoverTipTxt();">' +
					this.payload[0].contents +
					'<span id="hoverTipTxt' + count + '" class="hoverBox hoverTail"' +
					(width > 0 ? ' style="max-width: ' + width + 'px;"' : '') + '>' +
					this.args[0] + '</span></span>'
				);
			}
		});
	});

	// Предпросмотр окна оформления: показать образец подсказки на открытом экране.
	setup.signaly.tipDemo = function () {
		var old = document.getElementById('sg-tip-demo');

		if (old) {
			old.remove();
			return;
		}

		var demo = document.createElement('div');
		var box = document.createElement('span');
		var host = document.createElement('span');

		demo.id = 'sg-tip-demo';
		demo.style.cssText = 'left: 50%; position: fixed; top: 50%; transform: translate(-50%, -50%); z-index: 1002;';
		host.className = 'hoverTip';
		host.textContent = 'Текст с подсказкой';
		host.style.position = 'relative';
		box.className = 'hoverBox hoverTail';
		box.textContent = 'Так выглядит подсказка при наведении.';
		box.style.cssText = 'bottom: calc(100% + 14px); left: 50%; position: absolute; transform: translateX(-50%);';
		host.appendChild(box);
		demo.appendChild(host);
		document.body.appendChild(demo);
	};

	/* Кнопка на экране (сессия 6): содержимое стоит на месте от угла окна
	   терминала и не прокручивается с текстом; kind — вид кнопок и ссылок. */

	Macro.add('sg-place', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, [], ['kind', 'corner', 'x', 'y', 'hover', 'click'], []);
			var el = document.createElement('span');

			el.className = 'sg-place' + (a.kind ? ' ' + a.kind : '');
			// Шаг 2.2: свой звук наведения и нажатия (none — без звука).
			['hover', 'click'].forEach(function (which) {
				if (a[which] !== undefined) {
					el.setAttribute('data-sg-' + which, a[which] === 'none' ? '' : String(a[which]));
				}
			});
			placeStyle(el, {place: 'screen', corner: a.corner, x: a.x, y: a.y});
			if (preview) {
				el.setAttribute('data-sg-block', 'place');
				el.setAttribute('data-sg-src', this.source);
			}
			$(el).wiki(this.payload[0].contents);
			this.output.appendChild(el);
		}
	});

	/* ----- Таймеры (шаг 2.3) ----- */

	// Таймер именной и идёт в фоне: время окончания лежит в переменной
	// $sgTimers (попадает в автокопию), табло того же таймера можно поставить
	// на несколько экранов. По окончании — переход, окно-сообщение или звук.
	var timerDefaults = {"font":"media/fonts/DSEG7Classic-Regular.woff2","color":"#cc0000","bg":"#000000","size":125,"border":2,"glow":10};
	var timerFonts = {};
	var restoring = false;

	function timerStore() {
		var v = State.variables;

		if (!v.sgTimers || typeof v.sgTimers !== 'object') {
			v.sgTimers = {};
		}
		return v.sgTimers;
	}

	function timersChanged() {
		if (setup.signaly.saveTimers) {
			setup.signaly.saveTimers();
		}
	}

	function pad(n) {
		return n < 10 ? '0' + n : String(n);
	}

	function timerText(end, format) {
		var left = Math.max(0, Math.ceil((end - Date.now()) / 1000));

		if (format === 'hms') {
			return pad(Math.floor(left / 3600)) + ':' + pad(Math.floor(left / 60) % 60) + ':' + pad(left % 60);
		}
		return pad(Math.floor(left / 60)) + ':' + pad(left % 60);
	}

	// Шрифт табло — файл из папки игры (свой @font-face на каждый файл).
	function timerFont(file) {
		if (file === 'none') {
			return '';
		}
		if (!timerFonts[file]) {
			var family = 'sg-timer-font-' + (Object.keys(timerFonts).length + 1);
			var style = document.createElement('style');

			style.textContent =
				'@font-face { font-family: "' + family + '"; src: url(' + JSON.stringify(file) +
				'); font-weight: normal; font-style: normal; }';
			document.head.appendChild(style);
			timerFonts[file] = family;
		}
		return '"' + timerFonts[file] + '", monospace';
	}

	function timerEnded(name, t) {
		var store = timerStore();

		delete store[name];
		timersChanged();
		if (t.sound) {
			try {
				new Audio(t.sound).play().catch(function () {});
			} catch (e) {
				console.error('СИГНАЛЫ: звук таймера', e);
			}
		}
		if (t.passage || t.text || t.title) {
			setup.signaly.openDialog({title: t.title, passage: t.passage, text: t.text});
		}
		if (t.goto && Story.has(t.goto)) {
			accessGo(t.goto, 'auto', 'timer:' + name);
		}
	}

	function tickTimers() {
		var store = State.variables && State.variables.sgTimers;

		if (!store || restoring || (Engine.isIdle && !Engine.isIdle())) {
			return;
		}
		$('.sg-timer[data-sg-timer]').each(function () {
			var t = store[this.getAttribute('data-sg-timer')];

			if (t) {
				this.firstChild.textContent = timerText(t.end, this.getAttribute('data-sg-format'));
			}
		});
		Object.keys(store).forEach(function (name) {
			var t = store[name];

			if (t && Date.now() >= t.end && State.variables.sgTimers === store && store[name] === t) {
				timerEnded(name, t);
			}
		});
	}

	setInterval(tickTimers, 250);

	Macro.add('sg-timer', {
		handler: function () {
			var a = blockArgs(
				this,
				['name'],
				['hours', 'minutes', 'seconds', 'start', 'goto', 'title', 'passage', 'text', 'sound',
					'font', 'color', 'bg', 'size', 'border', 'glow', 'format'],
				['hidden']
			);
			var name = String(a.name || State.passage);
			var store = timerStore();

			if (a.start !== 'running' && !(restoring && store[name])) {
				var total =
					(Number(a.hours) || 0) * 3600 + (Number(a.minutes) || 0) * 60 + (Number(a.seconds) || 0);
				var t = {end: Date.now() + total * 1000};

				['goto', 'title', 'passage', 'text', 'sound'].forEach(function (key) {
					if (a[key] !== undefined && a[key] !== '') {
						t[key] = String(a[key]);
					}
				});
				store[name] = t;
				timersChanged();
			}

			var running = store[name];

			// Табло не видно: скрытый таймер или таймер ещё не идёт.
			if (a.hidden || !running) {
				return;
			}

			var color = a.color || timerDefaults.color;
			var border = a.border === undefined ? timerDefaults.border : Number(a.border) || 0;
			var glow = a.glow === undefined ? timerDefaults.glow : Number(a.glow) || 0;
			var el = document.createElement('div');
			var text = document.createElement('span');
			var s = el.style;
			var font = timerFont(a.font === undefined ? timerDefaults.font : String(a.font));

			el.className = 'sg-timer';
			el.setAttribute('data-sg-timer', name);
			if (a.format === 'hms') {
				el.setAttribute('data-sg-format', 'hms');
			}
			if (font) {
				s.fontFamily = font;
			}
			s.fontSize = (a.size === undefined ? timerDefaults.size : Number(a.size) || 0) + 'px';
			s.color = color;
			s.backgroundColor = a.bg || timerDefaults.bg;
			if (border > 0) {
				s.border = border + 'px solid ' + color;
			}
			if (glow > 0) {
				s.boxShadow = '0 0 ' + glow + 'px ' + color + ', 0 0 ' + glow * 2 + 'px ' + color;
			}
			s.padding = '10px 20px';
			s.width = 'fit-content';
			s.margin = '20px auto';
			s.textAlign = 'center';
			s.display = 'flex';
			s.justifyContent = 'center';
			s.alignItems = 'center';
			text.textContent = timerText(running.end, a.format);
			el.appendChild(text);
			this.output.appendChild(el);
		}
	});

	// Действие ссылки или кнопки (шаг 3.2): остановить таймер по имени.
	// Запустить — тот же <<sg-timer … hidden>> внутри ссылки.
	Macro.add('sg-timer-stop', {
		handler: function () {
			var store = timerStore();
			var name = String(this.args.length ? this.args[0] : State.passage);

			if (store[name]) {
				delete store[name];
				timersChanged();
			}
		}
	});

	/* ----- Цепочка видео (шаг 2.3) ----- */

	// Шаги по порядку; следующий включает щелчок по видео, окончание видео или
	// N секунд. Все видео загружаются сразу — переход мгновенный (ответ 7А).
	Macro.add('sg-chain', {
		tags: ['sg-step'],
		handler: function () {
			var a = blockArgs(this, [], ['width', 'height', 'goto'].concat(placeKeys), []);
			var steps = this.payload.slice(1).map(function (part) {
				return blockArgs({args: part.args}, ['src'], ['next', 'seconds'], ['loop', 'muted']);
			});
			var box = document.createElement('span');
			var current = 0;
			var stepTimer = null;
			var done = false;
			var look = {border: a.border, glow: a.glow, color: a.color};

			box.className = 'sg-chain';

			var videos = steps.map(function (step, index) {
				var video = document.createElement('video');
				var source = document.createElement('source');

				['loop', 'muted'].forEach(function (flag) {
					if (step[flag]) {
						video.setAttribute(flag, '');
						video[flag] = true;
					}
				});
				if (index === 0) {
					video.setAttribute('autoplay', '');
					video.autoplay = true;
				} else {
					video.setAttribute('preload', 'auto');
					video.style.display = 'none';
				}
				if (Number(a.width) > 0) {
					video.setAttribute('width', Number(a.width));
				}
				if (Number(a.height) > 0) {
					video.setAttribute('height', Number(a.height));
				}
				source.src = step.src || '';
				source.type = videoType(step.src || '');
				video.appendChild(source);
				placeStyle(video, look);
				video.addEventListener('click', function () {
					if ((step.next || 'end') === 'click') {
						advance(index);
					}
				});
				video.addEventListener('ended', function () {
					if ((step.next || 'end') === 'end') {
						advance(index);
					}
				});
				box.appendChild(video);
				if (index > 0) {
					video.load();
				}
				return video;
			});

			function arm(index) {
				var step = steps[index];

				clearTimeout(stepTimer);
				if (step && step.next === 'time') {
					stepTimer = setTimeout(function () {
						advance(index);
					}, Math.max(0, Number(step.seconds) || 0) * 1000);
				}
			}

			function advance(index) {
				if (index !== current || done || !box.isConnected) {
					return;
				}
				clearTimeout(stepTimer);
				if (index + 1 < videos.length) {
					var old = videos[index];
					var next = videos[index + 1];

					old.pause();
					old.style.display = 'none';
					current = index + 1;
					next.style.display = '';
					next.currentTime = 0;
					next.play().catch(function () {});
					arm(current);
					return;
				}
				done = true;
				if (a.goto && Story.has(a.goto)) {
					accessGo(a.goto, 'auto', 'chain:' + State.passage);
				}
			}

			placeStyle(box, {place: a.place, corner: a.corner, x: a.x, y: a.y});
			putPlaced(this, box, a, 'chain');
			if (videos.length) {
				$(document).one(':passagedisplay', function () {
					arm(0);
				});
			}
		}
	});

	/* ----- Эффекты текста (шаг 2.1) ----- */

	// Экраны, которые уже показывали: при возврате <<type>> печатает сразу
	// весь текст (ответ 6А). Список попадает в автокопию.
	var seen = {};
	var seenNow = false;

	setup.signaly.seen = seen;
	$(document).on(':passagestart', function (ev) {
		seenNow = settings.typeSeen && !preview && seen[ev.passage.title] === true;
		skipAll = false;
	});
	$(document).on(':passagedisplay', function (ev) {
		seen[ev.passage.title] = true;
	});

	/* ----- Звуки наведения и нажатия (шаг 2.2) ----- */

	// Наборы — в блоке «СИГНАЛЫ: звуки наведения и нажатия» (setup.signalySounds).
	// У ссылки или кнопки звучит набор её вида (ближайший класс вида у неё или
	// вокруг неё), у вида без своего — набор вида «Обычный». Свой звук у элемента
	// — data-sg-hover / data-sg-click ("" — без звука). Из набора — случайный
	// файл; новый звук наведения прерывает предыдущий.
	var uiAudio = {};
	var hoverNow = null;
	var hoverTimer = null;

	function uiSoundOn() {
		return !preview || window.SIGNALY_UI_SOUND === true;
	}

	function uiAudioFor(file) {
		if (!uiAudio[file]) {
			var audio = new Audio(file);

			audio.preload = 'auto';
			audio.sgUi = true;
			uiAudio[file] = audio;
		}
		return uiAudio[file];
	}

	$(document).one(':passagestart', function () {
		var data = setup.signalySounds;

		if (data && data.sets) {
			data.sets.forEach(function (set) {
				(set.files || []).forEach(uiAudioFor);
			});
		}
	});

	function uiSet(el, which) {
		var data = setup.signalySounds;

		if (!data || !data.sets || !data.kinds) {
			return null;
		}

		var own = $(el).closest('[data-sg-' + which + ']');
		var name;

		if (own.length) {
			name = own.attr('data-sg-' + which);
		} else {
			for (var node = el; node && node.nodeType === 1 && name === undefined; node = node.parentNode) {
				for (var i = 0; i < node.classList.length; i++) {
					var kind = data.kinds[node.classList[i]];

					if (kind && kind[which] !== undefined) {
						name = kind[which];
						break;
					}
				}
			}
			if (name === undefined && data.kinds['']) {
				name = data.kinds[''][which];
			}
		}
		if (!name) {
			return null;
		}
		return (
			data.sets.filter(function (set) {
				return set.name === name;
			})[0] || null
		);
	}

	function playSet(set) {
		var files = set.files || [];
		var file = files[Math.floor(Math.random() * files.length)];

		if (!file) {
			return null;
		}

		var audio = uiAudioFor(file);

		audio.volume = Math.max(0, Math.min(1, (set.volume === undefined ? 100 : set.volume) / 100));
		audio.currentTime = 0;
		audio.play().catch(function () {});
		return audio;
	}

	function later(set, play) {
		if (set.delay > 0) {
			return setTimeout(play, set.delay);
		}
		play();
		return null;
	}

	// Шаг 5.3: символы и слова поля взлома звучат при наведении, как ссылки.
	$(document).on('mouseenter', 'a, button, .sg-hack-c, .sg-hack-word', function () {
		if (!uiSoundOn()) {
			return;
		}

		var set = uiSet(this, 'hover');

		clearTimeout(hoverTimer);
		if (hoverNow) {
			hoverNow.pause();
			hoverNow.currentTime = 0;
			hoverNow = null;
		}
		if (set) {
			hoverTimer = later(set, function () {
				hoverNow = playSet(set);
			});
		}
	});
	function uiClick(el) {
		var set = uiSoundOn() && uiSet(el, 'click');

		if (set) {
			later(set, function () {
				playSet(set);
			});
		}
	}

	$(document).on('click', 'a, button', function () {
		// Шаг 7.4: «РЕВЕРС» держат нажатым — звук нажатия звучит в начале, а не при отпускании.
		if (!this.classList.contains('sg-r-revbtn')) {
			uiClick(this);
		}
	});

	/* ----- Порядок эффектов (сессия 7): «после эффектов выше» ----- */

	// Эффект со словом after (<<type 40ms after>>, <<timed 2s after>>) или span
	// с data-sg-after="1" ждёт, пока всё, что выше по тексту на этом экране,
	// допечатается, появится, сменится или включится, и только потом отсчитывает
	// свою задержку. waits — что ещё не закончилось, waiters — кто ждёт.
	var waits = [];
	var waiters = [];
	var checkTimer = null;

	$(document).on(':passageinit', function () {
		waits = [];
		waiters = [];
	});

	function takeWord(args, word) {
		var at = args.indexOf(word);

		if (at < 1) {
			return false;
		}
		args.splice(at, 1);
		return true;
	}

	function rootOf(node) {
		var el = node.nodeType === 1 ? node : node.parentNode;

		return el && el.closest ? el.closest('#ui-dialog-body, #passages') : null;
	}

	function busyBefore(node) {
		var root = rootOf(node);

		return waits.some(function (w) {
			if (w.node === node || !w.node.isConnected || rootOf(w.node) !== root || !w.pending()) {
				return false;
			}

			var pos = node.compareDocumentPosition(w.node);

			return (pos & Node.DOCUMENT_POSITION_PRECEDING) !== 0 && (pos & Node.DOCUMENT_POSITION_CONTAINS) === 0;
		});
	}

	function runWaiters() {
		checkTimer = null;
		waiters = waiters.filter(function (w) {
			return !w.started && w.node.isConnected;
		});
		waiters.sort(function (a, b) {
			return a.node.compareDocumentPosition(b.node) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
		});
		waiters.forEach(function (w) {
			if (!w.started && w.node.isConnected && !busyBefore(w.node)) {
				w.started = true;
				w.run();
			}
		});
	}

	function check() {
		if (waiters.length && checkTimer === null) {
			checkTimer = setTimeout(runWaiters, 0);
		}
	}

	$(document).on(':passageend :passagedisplay', check);
	setInterval(check, 500);

	function wait(node, run) {
		var waiter = {node: node, run: run, started: false};

		waiters.push(waiter);
		waits.push({
			node: node,
			pending: function () {
				return !waiter.started;
			}
		});
		check();
	}

	// Команда со словом after: на её месте — метка; когда подойдёт очередь,
	// команда выполняется в это место.
	function deferMacro(ctx, run, args) {
		var anchor = document.createComment('sg-after');

		ctx.output.appendChild(anchor);
		wait(anchor, function () {
			var holder = document.createElement('span');
			var parent = anchor.parentNode;

			parent.insertBefore(holder, anchor.nextSibling);
			run(
				Object.create(ctx, {
					_output: {value: holder},
					_debugView: {value: null, writable: true}
				}),
				args
			);
			while (holder.firstChild) {
				parent.insertBefore(holder.firstChild, holder);
			}
			parent.removeChild(holder);
		});
	}

	var typeMacro = Macro.get('type');

	if (typeMacro) {
		var typeHandler = typeMacro.handler;
		var runType = function (ctx, args) {
			var marker = document.createComment('sg-type');
			var was = ctx.self.typeId;

			ctx.output.appendChild(marker);

			var result = typeHandler.apply(ctx, args);
			var id = ctx.self.typeId;

			if (id !== was) {
				waits.push({
					node: marker,
					pending: function () {
						var queue = TempState.macroTypeQueue;

						return !!queue && queue.some(function (item) {
							return item.id === id;
						});
					}
				});
			} else if (marker.parentNode) {
				marker.parentNode.removeChild(marker);
			}
			return result;
		};

		typeMacro.handler = function () {
			var after = takeWord(this.args, 'after');

			if (seenNow && this.args.length) {
				this.args[0] = '0s';
			}
			return after ? deferMacro(this, runType, arguments) : runType(this, arguments);
		};
	}

	var timedMacro = Macro.get('timed');

	if (timedMacro) {
		var timedHandler = timedMacro.handler;
		var timedRegister = timedMacro.registerTimeout;
		var timedNow = null;

		// Появление закончилось — показан последний раздел (и прошла плавность).
		timedMacro.registerTimeout = function (callback, items) {
			var info = timedNow;
			var left = items.length;

			timedNow = null;
			if (!info) {
				return timedRegister.call(this, callback, items);
			}
			info.registered = true;
			return timedRegister.call(
				this,
				function () {
					var result = callback.apply(this, arguments);

					if (--left === 0) {
						setTimeout(function () {
							info.done = true;
							check();
						}, info.fade ? 450 : 0);
					}
					return result;
				},
				items
			);
		};

		var runTimed = function (ctx, args) {
			var info = {done: false, registered: false, fade: ctx.args.length > 1 && /^(?:transition|t8n)$/.test(ctx.args[1])};
			var out = ctx.output;
			var last = out.lastChild;
			var result;

			timedNow = info;
			try {
				result = timedHandler.apply(ctx, args);
			} finally {
				timedNow = null;
			}
			if (info.registered && out.lastChild && out.lastChild !== last) {
				waits.push({
					node: out.lastChild,
					pending: function () {
						return !info.done;
					}
				});
			}
			return result;
		};

		timedMacro.handler = function () {
			return takeWord(this.args, 'after') ? deferMacro(this, runTimed, arguments) : runTimed(this, arguments);
		};
	}

	// Глитч и мигание с началом: data-sg-start="2s" (через N с), data-sg-after="1"
	// (после эффектов выше). До начала — класс sg-off (обычный текст).
	function startSpans(root) {
		$(root)
			.find('[data-sg-start], [data-sg-after]')
			.addBack('[data-sg-start], [data-sg-after]')
			.each(function () {
				var el = this;

				if (el.sgOn !== undefined) {
					return;
				}
				el.sgOn = false;
				el.classList.add('sg-off');

				var go = function () {
					var delay = 0;

					try {
						delay = cssTimeToMS(el.getAttribute('data-sg-start') || '0s');
					} catch (e) {
						delay = 0;
					}
					setTimeout(function () {
						el.sgOn = true;
						el.classList.remove('sg-off');
						check();
					}, delay);
				};

				if (el.getAttribute('data-sg-after')) {
					wait(el, go);
				} else {
					go();
				}
				waits.push({
					node: el,
					pending: function () {
						return !el.sgOn;
					}
				});
			});
	}

	/* ----- Ссылки и глитч в печатающемся тексте (сессия 7) ----- */

	// Ссылка или кнопка внутри <<type>> нажимается, только когда допечатана
	// целиком (пока печатается — класс sg-type-wait). «Тени» глитча печатаются
	// вместе с текстом.
	var typingNow = [];

	function followed(el, wrap) {
		for (var node = el; node && node !== wrap; node = node.parentNode) {
			if (node.nextSibling) {
				return true;
			}
		}
		return false;
	}

	function typingAround(el) {
		return (
			typingNow.some(function (wrap) {
				return (wrap.contains(el) && !followed(el, wrap)) || el.contains(wrap);
			}) ||
			!!el.querySelector('.macro-type-target') ||
			$(el)
				.find('.macro-type:not(.macro-type-done)')
				.toArray()
				.some(function (wrap) {
					return wrap.textContent === '';
				})
		);
	}

	function syncTyping() {
		var waiting = [];

		typingNow.forEach(function (wrap) {
			$(wrap)
				.find('a, button')
				.each(function () {
					if (!followed(this, wrap)) {
						waiting.push(this);
					}
				});
		});
		$('.sg-type-wait').each(function () {
			if (waiting.indexOf(this) === -1) {
				this.classList.remove('sg-type-wait');
			}
		});
		waiting.forEach(function (el) {
			el.classList.add('sg-type-wait');
		});
		$('.glitchy').each(function () {
			var full = this.getAttribute('data-sg-text');

			if (typingAround(this)) {
				if (full === null) {
					full = this.getAttribute('data-text') || '';
					this.setAttribute('data-sg-text', full);
				}
				this.setAttribute('data-text', Array.from(full).slice(0, Array.from(this.textContent).length).join(''));
			} else if (full !== null) {
				this.setAttribute('data-text', full);
				this.removeAttribute('data-sg-text');
			}
		});
	}

	$(document).on(':typingstart', function (ev) {
		typingNow.push(ev.target);
		syncTyping();
	});
	$(document).on(':typingstop', function (ev) {
		setTimeout(function () {
			typingNow = typingNow.filter(function (wrap) {
				return wrap !== ev.target && wrap.isConnected;
			});
			syncTyping();
			check();
		}, 0);
	});
	$(document).on(':passageinit', function () {
		typingNow = [];
	});

	new MutationObserver(function (records) {
		records.forEach(function (record) {
			for (var i = 0; i < record.addedNodes.length; i++) {
				if (record.addedNodes[i].nodeType === 1) {
					startSpans(record.addedNodes[i]);
				}
			}
		});
		if (typingNow.length || document.querySelector('[data-sg-text], .glitchy .macro-type')) {
			syncTyping();
		}
	}).observe(document.body, {childList: true, subtree: true, characterData: true});

	// Щелчок мышью (не по ссылке, кнопке или полю) допечатывает текст сразу —
	// и всё, что на этом экране ещё будет печататься.
	var skipAll = false;

	function skipTyping() {
		setTimeout(function () {
			document.body.dispatchEvent(
				new KeyboardEvent('keydown', {key: Config.macros.typeSkipKey, bubbles: true})
			);
		}, 0);
	}

	$(document).on(':typingstart', function () {
		if (skipAll) {
			skipTyping();
		}
	});
	if (settings.typeClick) {
		document.addEventListener(
			'click',
			function (ev) {
				if (
					!document.querySelector('.macro-type:not(.macro-type-done):not(.macro-type-target)') ||
					$(ev.target).closest('a, button, input, textarea, select, label, #ui-dialog').length
				) {
					return;
				}
				skipAll = true;
				skipTyping();
			},
			true
		);
	}

	/* Экран тревоги: поверх всего экрана, закрывается щелчком, через N секунд
	   или только мастером (Shift+Z+X закрывает любой). */

	var alarmSounds = [];

	function stopAlarmSound(sound) {
		if (sound) {
			sound.pause();
			alarmSounds = alarmSounds.filter(function (s) {
				return s !== sound;
			});
		}
	}

	$(document).on(':passagestart', function () {
		alarmSounds.slice().forEach(stopAlarmSound);
	});

	function closeAlarm(el) {
		if (!el || !el.parentNode || el.getAttribute('data-sg-closed')) {
			return;
		}
		el.setAttribute('data-sg-closed', '1');
		stopAlarmSound(el.sgSound);
		el.parentNode.removeChild(el);

		var target = el.getAttribute('data-sg-goto');

		if (target && Story.has(target)) {
			accessGo(target, 'auto', 'alarm:' + State.passage);
		}
	}

	setup.signaly.closeAlarm = function () {
		var all = document.querySelectorAll('.sg-alarm');

		closeAlarm(all[all.length - 1]);
	};

	Macro.add('sg-alarm', {
		tags: null,
		handler: function () {
			var a = blockArgs(
				this,
				[],
				['bg', 'color', 'size', 'blink', 'sound', 'volume', 'close', 'seconds', 'goto'],
				['loop']
			);
			var el = document.createElement('div');
			var s = el.style;

			el.className = 'sg-alarm';
			s.position = 'fixed';
			s.top = '0';
			s.left = '0';
			s.width = '100%';
			s.height = '100%';
			s.backgroundColor = a.bg || '#cc0000';
			s.color = a.color || '#000000';
			s.display = 'flex';
			s.justifyContent = 'center';
			s.alignItems = 'center';
			s.fontSize = (Number(a.size) || 70) + 'px';
			s.zIndex = '1002';
			if (Number(a.blink) > 0) {
				s.animation = 'sg-alarm-blink ' + Number(a.blink) + 's steps(1, end) infinite';
			}
			if (a.goto) {
				el.setAttribute('data-sg-goto', a.goto);
			}
			$(el).wiki(this.payload[0].contents);
			this.output.appendChild(el);

			if (a.sound) {
				try {
					var sound = new Audio(a.sound);

					sound.loop = !!a.loop;
					sound.volume = Math.max(0, Math.min(1, (a.volume === undefined ? 100 : Number(a.volume)) / 100));
					sound.play().catch(function () {});
					el.sgSound = sound;
					alarmSounds.push(sound);
				} catch (e) {
					console.error('СИГНАЛЫ: звук тревоги', e);
				}
			}
			if (a.close === 'click') {
				el.style.cursor = 'pointer';
				el.addEventListener('click', function () {
					closeAlarm(el);
				});
			} else if (a.close === 'time') {
				setTimeout(function () {
					closeAlarm(el);
				}, Math.max(0, Number(a.seconds) || 5) * 1000);
			}
		}
	});

	/* Окно-сообщение: заголовок, текст или пассаж; закрывается крестиком,
	   только кнопкой «Принято» или само через N секунд. */

	var dialogTurn = 0;

	document.addEventListener(
		'click',
		function (ev) {
			// Пока окно закрывается только кнопкой, щелчок мимо окна его не закрывает.
			if (
				document.documentElement.getAttribute('data-sg-dialog') === 'noclose' &&
				ev.target &&
				ev.target.id === 'ui-overlay'
			) {
				ev.stopPropagation();
				ev.preventDefault();
			}
		},
		true
	);

	function trimContent(text) {
		return String(text || '').replace(/^[ \t]*\n/, '').replace(/\n\s*$/, '');
	}

	setup.signaly.openDialog = function (o) {
		var turn = ++dialogTurn;
		var html = document.documentElement;

		Dialog.create(o.title || '');
		if (o.passage) {
			Dialog.wikiPassage(o.passage);
		} else {
			Dialog.wiki(o.text || '');
		}
		if (o.close === 'ok') {
			html.setAttribute('data-sg-dialog', 'noclose');
			var box = $('<div class="sg-dialog-ok"></div>').appendTo(Dialog.body());

			$('<button type="button" class="ui-close"></button>')
				.text(o.ok || 'Принято')
				.appendTo(box);
		}
		Dialog.open(null, function () {
			if (turn === dialogTurn) {
				html.removeAttribute('data-sg-dialog');
			}
		});
		if (o.close === 'time') {
			setTimeout(function () {
				if (turn === dialogTurn && Dialog.isOpen()) {
					Dialog.close();
				}
			}, Math.max(0, Number(o.seconds) || 5) * 1000);
		}
	};

	Macro.add('sg-dialog', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, ['label'], ['title', 'passage', 'close', 'seconds', 'ok'], ['button']);
			var text = trimContent(this.payload[0].contents);

			actionControl(this.output, a.label === undefined ? '' : a.label, !!a.button, function () {
				setup.signaly.openDialog({
					title: a.title,
					passage: a.passage,
					text: text,
					close: a.close,
					seconds: a.seconds,
					ok: a.ok
				});
			});
		}
	});

	// Действие ссылки или кнопки (шаг 3.2): открыть окно-сообщение —
	// <<sg-open "Заголовок" passage "Пассаж" close ok|time ok "Принято" seconds 5>>текст<</sg-open>>.
	Macro.add('sg-open', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, ['title'], ['passage', 'close', 'seconds', 'ok'], []);

			setup.signaly.openDialog({
				title: a.title,
				passage: a.passage,
				text: trimContent(this.payload[0].contents),
				close: a.close,
				seconds: a.seconds,
				ok: a.ok
			});
		}
	});

	/* Поле кода: таблица «код → действие» прямо в команде. */

	function codeAction(o, code) {
		State.temporary.code = code;
		if (o.sound) {
			try {
				new Audio(o.sound).play().catch(function () {});
			} catch (e) {
				console.error('СИГНАЛЫ: звук поля кода', e);
			}
		}
		if (o.passage || o.text || o.title) {
			setup.signaly.openDialog(o);
		}
		if (o.goto && Story.has(o.goto)) {
			accessGo(o.goto, 'code', String(code));
		}
	}

	/* ----- Общая таблица кодов (шаг 3.4) -----
	   Пассаж с тегом sg-codes («Коды»):
	     <<sg-replies title "Ошибка" wrong "…" denied "…" badpin "…" used "…" ask "…">>
	     <<sg-person "3" pin "417" var "$progress3">>
	     <<sg-entry "205" "Подпись" who "3, 5" once all|each title "…" goto "…" denied "…" used "…">>
	     действия<<sg-answer>>ответ<</sg-entry>>
	   Поле кода со словом table проверяет сначала свои коды, потом таблицу.
	   Если коду важно, кто вводит (who, once each, <<sg-progress>>, _who), —
	   под полем появляется второе поле для личного кода. Отметки одноразовых
	   кодов — в $sgUsed (попадают в автокопию, «Новая игра» их стирает). */

	var codeTable = null;
	var codeCollect = null;
	var codePerson = null;

	// Сессия 32: слово phone '{…}' — данные телефона (персонаж приложения); терминал их не читает.
	Macro.add('sg-person', {
		handler: function () {
			if (!codeCollect) {
				return;
			}

			var a = blockArgs(this, ['id'], ['pin', 'var'], []);

			codeCollect.people.push({
				id: a.id === undefined ? '' : String(a.id),
				pin: a.pin === undefined ? '' : String(a.pin).trim(),
				variable: a['var'] === undefined ? '' : String(a['var']).replace(/^\$/, '')
			});
		}
	});

	Macro.add('sg-replies', {
		handler: function () {
			if (!codeCollect) {
				return;
			}

			var a = blockArgs(this, [], ['title', 'wrong', 'denied', 'badpin', 'used', 'ask'], []);

			Object.keys(a).forEach(function (key) {
				codeCollect.texts[key] = String(a[key]);
			});
		}
	});

	// Сессия 32 (этап Т2 приложения): where phone — код только телефонов (терминал его не знает),
	// where both — у кода и часть телефона <<sg-phone>>…, её терминал пропускает.
	Macro.add('sg-entry', {
		tags: ['sg-answer', 'sg-phone', 'sg-when'],
		handler: function () {
			if (!codeCollect) {
				return;
			}

			var a = blockArgs(this, ['code', 'label'], ['who', 'once', 'title', 'goto', 'denied', 'used', 'lock', 'where'], []);
			var actions = this.payload[0].contents;
			var answer = '';
			var when = '';

			if (a.where === 'phone') {
				return;
			}
			this.payload.slice(1).forEach(function (part) {
				if (part.name === 'sg-answer') {
					answer = trimContent(part.contents);
				} else if (part.name === 'sg-when') {
					when = part.contents.trim();
				}
			});

			var who = a.who === undefined ? [] : String(a.who).split(',').map(function (s) {
				return s.trim();
			}).filter(Boolean);

			codeCollect.codes.push({
				code: a.code === undefined ? '' : String(a.code).trim(),
				who: who,
				once: a.once === 'all' || a.once === 'each' ? a.once : '',
				title: a.title === undefined ? '' : String(a.title),
				goto: a.goto === undefined ? '' : String(a.goto),
				denied: a.denied === undefined ? '' : String(a.denied),
				used: a.used === undefined ? '' : String(a.used),
				lock: a.lock === undefined ? '' : String(a.lock),
				when: when,
				run: actions,
				answer: answer,
				pin:
					who.length > 0 ||
					a.once === 'each' ||
					/<<sg-progress[\s>]|\b_who\b|<<sg-net\s[^>]*\bto\s+self\b/.test(actions + answer + (a.title === undefined ? '' : a.title))
			});
		}
	});

	// Действие «Прогресс вводящего +N»: переменная прогресса того, кто ввёл код.
	Macro.add('sg-progress', {
		handler: function () {
			var n = this.args.length ? Number(this.args[0]) : 1;

			if (!codePerson || !codePerson.variable) {
				return;
			}
			State.variables[codePerson.variable] =
				(Number(State.variables[codePerson.variable]) || 0) + (isFinite(n) ? n : 0);
		}
	});

	function codes() {
		if (codeTable) {
			return codeTable;
		}
		codeTable = {
			people: [],
			codes: [],
			texts: {
				title: 'Ошибка',
				wrong: 'Неверный код',
				denied: 'Нет доступа',
				badpin: 'Неверный личный код',
				used: 'Пусто',
				ask: 'Введите личный код'
			}
		};
		codeCollect = codeTable;
		Story.filter(function (p) {
			return p.tags.indexOf('sg-codes') !== -1;
		}).forEach(function (p) {
			try {
				new Wikifier(document.createDocumentFragment(), p.text);
			} catch (e) {
				console.error('СИГНАЛЫ: таблица кодов', e);
			}
		});
		codeCollect = null;

		// Шаг 3.5: код упомянут в условии «сотрудник ввёл код» — терминал
		// спросит личный код, чтобы знать, кто ввёл.
		var referenced = {};
		var refRe = /setup\.entered\(\s*("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')\s*,\s*("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')\s*\)/g;

		Story.filter(function () {
			return true;
		}).forEach(function (p) {
			var m;

			refRe.lastIndex = 0;
			while ((m = refRe.exec(p.text))) {
				referenced[unquoteArg(m[2]).trim()] = true;
			}
		});
		codeTable.codes.forEach(function (c) {
			if (referenced[c.code]) {
				c.pin = true;
			}
		});
		return codeTable;
	}

	function unquoteArg(s) {
		try {
			return s.charAt(0) === '"' ? JSON.parse(s) : s.slice(1, -1).replace(/\\(.)/g, '$1');
		} catch (e) {
			return s.slice(1, -1);
		}
	}

	function usedMarks() {
		var v = State.variables;

		if (!v.sgUsed || typeof v.sgUsed !== 'object') {
			v.sgUsed = {};
		}
		return v.sgUsed;
	}

	function codeMessage(text) {
		setup.signaly.openDialog({title: codes().texts.title, text: text});
	}

	// Код найден в таблице и проверен: действия, ответ, переход.
	function runTableCode(c, person, value) {
		if (c.once) {
			usedMarks()[c.once === 'each' ? c.code + '|' + person.id : c.code] = true;
		}
		// Шаг 3.5: какие коды ввёл сотрудник — для условий «сотрудник ввёл код».
		if (person) {
			var entered = State.variables.sgEntered;

			if (!entered || typeof entered !== 'object') {
				entered = State.variables.sgEntered = {};
			}
			if (!Array.isArray(entered[person.id])) {
				entered[person.id] = [];
			}
			if (entered[person.id].indexOf(c.code) === -1) {
				entered[person.id].push(c.code);
			}
		}
		State.temporary.code = value;
		State.temporary.who = person ? person.id : '';
		codePerson = person;
		try {
			if (c.run.trim() !== '') {
				Wikifier.wikifyEval(c.run);
			}
		} catch (e) {
			console.error('СИГНАЛЫ: код ' + c.code, e);
		}
		codePerson = null;
		if (c.title || c.answer) {
			setup.signaly.openDialog({title: c.title, text: c.answer});
		}
		if (c.goto && Story.has(c.goto)) {
			accessGo(c.goto, 'code', c.code);
		}
	}

	// Проверка с известным вводящим (или без него, если коду это не важно).
	function checkTableCode(c, person, value) {
		var marks = usedMarks();

		if (person && c.who.length && c.who.indexOf(person.id) === -1) {
			codeMessage(c.denied || codes().texts.denied);
			return;
		}
		if ((c.once === 'all' && marks[c.code]) || (c.once === 'each' && person && marks[c.code + '|' + person.id])) {
			codeMessage(c.used || codes().texts.used);
			return;
		}
		runTableCode(c, person, value);
	}

	function findTableCode(value) {
		var found = null;

		codes().codes.forEach(function (c) {
			if (!found && c.code !== '' && c.code === value) {
				found = c;
			}
		});
		return found;
	}

	// Шаг 4.5: буквы и знаки просто не печатаются (и при вставке из буфера).
	function onlyDigits(el) {
		el.setAttribute('inputmode', 'numeric');
		el.addEventListener('input', function () {
			var clean = el.value.replace(/\D/g, '');

			if (clean !== el.value) {
				var at = el.selectionStart - (el.value.length - clean.length);

				el.value = clean;
				el.setSelectionRange(Math.max(0, at), Math.max(0, at));
			}
		});
	}

	Macro.add('sg-code', {
		tags: ['sg-case', 'sg-wrong'],
		handler: function () {
			var a = blockArgs(this, [], ['var', 'button', 'gap'], ['password', 'focus', 'clear', 'table', 'digits']);
			var cases = [];
			var wrong = null;

			this.payload.slice(1).forEach(function (part) {
				var isCase = part.name === 'sg-case';
				var o = blockArgs(
					{args: part.args},
					isCase ? ['code'] : [],
					['goto', 'title', 'passage', 'sound'],
					[]
				);

				o.text = trimContent(part.contents);
				if (isCase) {
					cases.push(o);
				} else {
					wrong = o;
				}
			});

			var input = document.createElement('input');
			var varName = a['var'] ? String(a['var']).replace(/^\$/, '') : '';

			input.type = a.password ? 'password' : 'text';
			input.className = 'sg-code';
			input.setAttribute('tabindex', '0');
			if (a.digits) {
				onlyDigits(input);
			}
			if (varName) {
				var start = State.variables[varName];

				input.value = start === undefined || start === null ? '' : String(start);
				input.addEventListener('input', function () {
					State.variables[varName] = input.value;
				});
			}

			// Шаг 3.4: второе поле — личный код того, кто вводит.
			var pinHolder = document.createElement('span');

			pinHolder.className = 'sg-code-pin';

			function closePin() {
				while (pinHolder.firstChild) {
					pinHolder.removeChild(pinHolder.firstChild);
				}
			}

			function askPin(entry, value) {
				var texts = codes().texts;
				var pin = document.createElement('input');

				function checkPin() {
					var typed = pin.value.trim();
					var person = null;

					codes().people.forEach(function (p) {
						if (!person && p.pin !== '' && p.pin === typed) {
							person = p;
						}
					});
					closePin();
					if (!person) {
						codeMessage(texts.badpin);
						return;
					}
					checkTableCode(entry, person, value);
				}

				pinHolder.appendChild(document.createElement('br'));
				if (texts.ask) {
					pinHolder.appendChild(document.createTextNode(texts.ask));
					pinHolder.appendChild(document.createElement('br'));
				}
				pin.type = a.password ? 'password' : 'text';
				pin.className = 'sg-code';
				pin.setAttribute('tabindex', '0');
				if (a.digits) {
					onlyDigits(pin);
				}
				pin.addEventListener('keydown', function (ev) {
					if (ev.key === 'Enter') {
						ev.preventDefault();
						checkPin();
					}
				});
				pinHolder.appendChild(pin);
				if (a.button) {
					var gap = a.gap === undefined ? 1 : Math.max(0, Number(a.gap) || 0);

					if (gap === 0) {
						pinHolder.appendChild(document.createTextNode(' '));
					}
					for (var i = 0; i < gap; i++) {
						pinHolder.appendChild(document.createElement('br'));
					}
					actionControl(pinHolder, a.button, true, checkPin);
				}
				pin.focus();
			}

			// Шаг 4.5: у кода своё «когда можно ввести». Раньше времени — как у
			// закрытого экрана: пассаж блокировки, код не тратится.
			function tableEarly(entry) {
				var open = true;

				if (preview || !entry.when) {
					return false;
				}
				try {
					open = !!Scripting.evalTwineScript(entry.when);
				} catch (e) {
					console.error('СИГНАЛЫ: условие кода ' + entry.code, e);
				}
				if (open) {
					return false;
				}

				var shared = Story.filter(function (p) {
					return p.tags.indexOf('sg-lock') !== -1;
				});
				var lock = entry.lock && Story.has(entry.lock) ? entry.lock : shared.length ? shared[0].title : '';

				if (!lock || lock === State.passage) {
					codeMessage(codes().texts.wrong);
					return true;
				}
				State.variables.sgEventFrom = State.passage;
				accessSkip = true;
				try {
					Engine.play(lock);
				} finally {
					accessSkip = false;
				}
				return true;
			}

			function tableEntry(entry, value) {
				if (entry.once === 'all' && usedMarks()[entry.code]) {
					codeMessage(entry.used || codes().texts.used);
				} else if (tableEarly(entry)) {
					return;
				} else if (accessEarly(entry.goto, entry.code, tableRefuse(entry))) {
					return;
				} else if (entry.pin) {
					askPin(entry, value);
				} else {
					checkTableCode(entry, null, value);
				}
			}

			// Шаг 4.3: чем ответить, если код пришёл на закрытый экран раньше времени.
			function tableRefuse(entry) {
				return {
					wrong: function () {
						codeMessage(codes().texts.wrong);
					},
					denied: function () {
						codeMessage(entry.denied || codes().texts.denied);
					}
				};
			}

			function fieldRefuse(value) {
				return {
					wrong: function () {
						if (wrong) {
							codeAction(wrong, value);
						} else {
							codeMessage(codes().texts.wrong);
						}
					},
					denied: function () {
						codeMessage(codes().texts.denied);
					}
				};
			}

			function confirm() {
				var value = input.value;
				var found = null;
				var entry = null;

				cases.forEach(function (c) {
					if (!found && String(c.code) === value) {
						found = c;
					}
				});
				if (a.clear) {
					input.value = '';
					if (varName) {
						State.variables[varName] = '';
					}
				}
				closePin();
				if (!found && a.table) {
					entry = findTableCode(value.trim());
				}
				if (found && accessEarly(found.goto, String(found.code), fieldRefuse(value))) {
					return;
				}
				if (found) {
					codeAction(found, value);
				} else if (entry) {
					tableEntry(entry, value.trim());
				} else if (wrong) {
					codeAction(wrong, value);
				} else if (a.table) {
					State.temporary.code = value;
					codeMessage(codes().texts.wrong);
				}
			}

			input.addEventListener('keydown', function (ev) {
				if (ev.key === 'Enter') {
					ev.preventDefault();
					confirm();
				}
			});
			this.output.appendChild(input);

			if (a.button) {
				var gap = a.gap === undefined ? 1 : Math.max(0, Number(a.gap) || 0);

				if (gap === 0) {
					this.output.appendChild(document.createTextNode(' '));
				}
				for (var i = 0; i < gap; i++) {
					this.output.appendChild(document.createElement('br'));
				}
				actionControl(this.output, a.button, true, confirm);
			}
			if (a.table) {
				this.output.appendChild(pinHolder);
			}
			if (a.focus) {
				$(document).one(':passagedisplay', function () {
					input.focus();
				});
			}
		}
	});

	/* Окно KR2 (экран с тегом kr2): текст и навигация, картинка, статусы.
	   Если в JavaScript истории остался свой код KR2 — движок его не трогает. */

	$(document).one(':passageinit', function () {
		if (Macro.has('kr2image') || Macro.has('kr2vars') || Macro.has('kr2main')) {
			return;
		}

		var kr2 = null;

		function reset() {
			kr2 = {image: '', vars: null, varsSrc: '', main: null, cols: null, rows: null};
		}

		// Статусы обновляются сами (ответ 1А, сессия 25): 4 раза в секунду текст
		// зоны статусов выводится заново в скрытый блок и сравнивается с прошлым;
		// изменился — зона заменяется. Печать и «через N секунд» внутри статусов
		// так не обновляются: каждый новый вывод запускал бы их снова.
		var kr2Live = null;
		var kr2Timer;

		function kr2Fresh(src) {
			var tmp = $('<div style="display:none"></div>').appendTo(document.body);

			tmp.wiki(src);
			return tmp;
		}

		function kr2Tick() {
			var box = document.getElementById('kr2-vars');

			if (!kr2Live || !box || fvNow || !Engine.isIdle()) {
				return;
			}

			var tmp = kr2Fresh(kr2Live.src);
			var html = tmp.html();

			if (html !== kr2Live.html) {
				kr2Live.html = html;
				$(box).empty().append(tmp.contents());
			}
			tmp.remove();
		}

		function render(contents) {
			var tmp = $('<div style="display:none"></div>').appendTo(document.body);
			var frag = document.createDocumentFragment();

			tmp.wiki(contents);
			while (tmp[0].firstChild) {
				frag.appendChild(tmp[0].firstChild);
			}
			tmp.remove();
			return frag;
		}

		reset();

		Macro.add('kr2image', {
			handler: function () {
				kr2.image = this.args[0] || '';
			}
		});
		Macro.add('kr2layout', {
			handler: function () {
				kr2.cols = Number(this.args[0]) || null;
				kr2.rows = Number(this.args[1]) || null;
			}
		});
		Macro.add('kr2vars', {
			tags: null,
			handler: function () {
				kr2.vars = render(this.payload[0].contents);
				kr2.varsSrc = this.payload[0].contents;
			}
		});
		Macro.add('kr2main', {
			tags: null,
			handler: function () {
				kr2.main = render(this.payload[0].contents);
			}
		});

		$(document).on(':passagestart', function () {
			reset();
			kr2Live = null;
			$('#kr2-overlay').remove();
		});

		$(document).on(':passageend', function () {
			var passage = Story.get(State.passage);
			var $passages = $('#passages');

			if (!passage.tags.includes('kr2')) {
				$passages.removeClass('kr2-layout').css({gridTemplateColumns: '', gridTemplateRows: ''});
				return;
			}

			$passages.addClass('kr2-layout').css({
				gridTemplateColumns: kr2.cols ? kr2.cols + '% ' + (100 - kr2.cols) + '%' : '',
				gridTemplateRows: kr2.rows ? kr2.rows + '% ' + (100 - kr2.rows) + '%' : ''
			});

			var $passageEl = $passages.find('.passage');
			var $main = $('<div id="kr2-main"></div>');
			var $nav = $('<div id="kr2-nav"></div>');
			var $vars = $('<div id="kr2-vars"></div>');
			var $img = $('<div id="kr2-image"></div>');
			var image = kr2.image;

			if (kr2.vars) {
				$vars.append(kr2.vars);
				if (!/<<(type|timed)[\s>]/.test(kr2.varsSrc)) {
					var first = kr2Fresh(kr2.varsSrc);

					kr2Live = {src: kr2.varsSrc, html: first.html()};
					first.remove();
					if (!kr2Timer) {
						kr2Timer = setInterval(kr2Tick, 250);
					}
				}
			}
			$passageEl.find('a, button').each(function () {
				$nav.append(this);
			});
			if (kr2.main) {
				$main.append(kr2.main);
			} else {
				$passageEl.find('p').each(function () {
					if ($(this).text().trim() === '' && $(this).children().length === 0) {
						$(this).remove();
					}
				});
				$main.append($passageEl.contents());
			}
			if (image) {
				$('<img>').attr('src', image).attr('alt', '').appendTo($img);
			}

			// Щелчок по картинке — во весь терминал; ещё щелчок — обратно.
			$img.on('click', function () {
				if ($('#kr2-overlay').length) {
					$('#kr2-overlay').remove();
					return;
				}
				if (!image) {
					return;
				}

				var $overlay = $('<div id="kr2-overlay"></div>');

				$('<img>').attr('src', image).attr('alt', '').appendTo($overlay);
				$overlay.on('click', function () {
					$(this).remove();
				});
				$passages.append($overlay);
			});

			$passageEl.empty().append($main, $nav, $img, $vars);
		});
	});

	/* ----- События, заходы на экраны, коды сотрудников (шаг 3.5) ----- */

	/* Событие — пассаж с тегом sg-event, первой строкой
	     <<sg-event [repeat] [delay N] [priority N] условие>>.
	   Терминал сам переходит на него, когда условие станет верным (проверка —
	   при каждом изменении и 4 раза в секунду). Отметки событий — $sgEvents,
	   откуда перешли — $sgEventFrom, заходы на экраны — $sgVisits, коды,
	   введённые сотрудниками, — $sgEntered (всё попадает в автокопию,
	   «Новая игра» стирает). */

	// В самом экране команда события ничего не показывает.
	Macro.add('sg-event', {
		skipArgs: true,
		handler: function () {}
	});
	// Сессия 35 (Т4-4): действия события выполняются, когда оно срабатывает, — на экране их нет.
	Macro.add('sg-event-do', {
		skipArgs: true,
		tags: null,
		handler: function () {}
	});

	function varObject(name) {
		var v = State.variables;

		if (!v[name] || typeof v[name] !== 'object') {
			v[name] = {};
		}
		return v[name];
	}

	// Сколько раз заходили на экран (свой счётчик: у SugarCube история в один
	// шаг, а после сбоя visited() начинает заново).
	setup.visits = function (title) {
		var visits = State.variables.sgVisits;

		return (visits && Number(visits[String(title)])) || 0;
	};

	// Ввёл ли сотрудник код общей таблицы кодов.
	setup.entered = function (person, code) {
		var entered = State.variables.sgEntered;
		var list = entered && entered[String(person).trim()];

		return Array.isArray(list) && list.indexOf(String(code).trim()) !== -1;
	};

	/* ----- Сеть: телефоны игроков (сессия 31, приложение СИГНАЛЫ, этап Т1) ----- */

	function netNorm(s) {
		return String(s === undefined || s === null ? '' : s)
			.toLowerCase()
			.replace(/ё/g, 'е')
			.replace(/\s+/g, ' ')
			.trim();
	}

	// Сколько раз пришло с телефона: код или фраза голосом ("code"), событие ("event");
	// who — номер сотрудника («Номер на терминале» у персонажа приложения), без него — с любого телефона.
	setup.phone = function (what, name, who) {
		var store = State.variables.sgNet;
		var got = store && store.got;

		if (!got) {
			return 0;
		}
		return Number(got[String(what) + '|' + netNorm(name) + '|' + netNorm(who)]) || 0;
	};

	// Кому: 'self' — тот, кто ввёл код (иначе не отправлять), номера через запятую, пусто или all — всем.
	function netTo(to) {
		if (to === 'self') {
			var who = codePerson ? codePerson.id : State.temporary.who;

			return who ? [String(who)] : null;
		}
		if (to === undefined || to === null || to === '' || to === 'all') {
			return [];
		}
		return String(to)
			.split(',')
			.map(function (s) {
				return s.trim();
			})
			.filter(Boolean);
	}

	// Действие «Телефонам: …» — <<sg-net notify "Заголовок" "Текст" [to self | to "3, 5"]>> и др.
	function netRun(args) {
		var N = window.SgTermNet;
		var a = Array.prototype.slice.call(args);
		var at = a.indexOf('to');
		var list = [];

		if (preview || !N) {
			return;
		}
		if (at !== -1) {
			list = netTo(a[at + 1]);
			a.splice(at, 2);
			if (list === null) {
				console.warn('СИГНАЛЫ: «тому, кто ввёл код» — неизвестно, кто ввёл; команда телефонам не отправлена');
				return;
			}
		}
		switch (String(a[0])) {
			case 'notify':
				N.notify(a[1], a[2], list);
				break;
			case 'open':
				N.open(a[1], a[2], list);
				break;
			case 'glitch':
				N.glitch(a[1], list);
				break;
			case 'fix':
				N.fix(a[1], list);
				break;
			case 'module':
				N.module(a[1], a[2], list);
				break;
			case 'alarm':
				N.alarm(a[1] !== 'off', a[1] === 'off' ? '' : a[1], a[2]);
				break;
			case 'chapter':
				N.chapter(a[1]);
				break;
			case 'countdown':
				N.countdown(a[1] === 'off' ? false : a[1], a[2]);
				break;
			case 'event':
				N.event(a[1]);
				break;
			default:
				console.warn('СИГНАЛЫ: <<sg-net>> — неизвестная команда', a[0]);
		}
	}

	if (!Macro.has('sg-net')) {
		Macro.add('sg-net', {
			handler: function () {
				netRun(this.args);
			}
		});
	}

	var prevPassage = '';

	$(document).on(':passageinit', function () {
		prevPassage = State.passage;
	});

	$(document).on(':passagestart', function (ev) {
		// После сбоя тот же экран показывается заново — это не новый заход.
		if (restoring) {
			return;
		}

		var visits = varObject('sgVisits');
		var title = ev.passage.title;

		visits[title] = (Number(visits[title]) || 0) + 1;
	});

	// «Вернуться на экран, где были»: туда, откуда терминал перешёл на
	// событие; если события не было — на предыдущий экран.
	function goBack(target) {
		setTimeout(function () {
			// Назад ведёт туда, где уже были, — доступ не проверяется.
			accessSkip = true;
			articleReturn = true;
			try {
				Engine.play(target);
			} finally {
				accessSkip = false;
			}
		}, Engine.DOM_DELAY || 40);
	}

	Macro.add('sg-back', {
		handler: function () {
			var target = State.variables.sgEventFrom || prevPassage;

			if (target && Story.has(target)) {
				goBack(target);
			}
		}
	});

	/* ----- Статьи (шаг 4.4) ----- */

	// Экран с тегом sg-article: первой строкой <<sg-article title … section …
	// order … back …>>. На самом экране команда ничего не выводит.
	// <<sg-articles>> собирает список при показе экрана, поэтому новая статья
	// попадает в него сама; закрытые статьи скрывает accessScan, как любую
	// ссылку. Внизу статьи — ссылка «Назад» на экран, откуда статью открыли:
	// $sgArticles = {"Статья": "Откуда"}. Возврат не переписывает запись, поэтому
	// цепочка «список → статья → другая статья» разматывается назад до списка.
	var articleCollect = null;
	var articleTable = null;
	var articleReturn = false;

	Macro.add('sg-article', {
		handler: function () {
			if (articleCollect) {
				var a = blockArgs(this, [], ['title', 'section', 'order', 'back'], []);

				articleCollect.title = String(a.title || articleCollect.name);
				articleCollect.section = String(a.section || '');
				articleCollect.order = Number(a.order) || 0;
				articleCollect.back = String(a.back || '');
			}
		}
	});

	function articles() {
		if (articleTable) {
			return articleTable;
		}
		articleTable = {};
		Story.filter(function (p) {
			return p.tags.indexOf('sg-article') !== -1;
		}).forEach(function (p) {
			var rec = {name: p.title, title: p.title, section: '', order: 0, back: ''};
			var m = /<<sg-article(?=[\s>])/.exec(p.text);
			var end = m ? macroEnd(p.text, m.index + 2) : -1;

			articleTable[p.title] = rec;
			if (end === -1) {
				return;
			}
			articleCollect = rec;
			try {
				new Wikifier(document.createDocumentFragment(), p.text.slice(m.index, end + 2));
			} catch (e) {
				console.error('СИГНАЛЫ: статья «' + p.title + '»', e);
			}
			articleCollect = null;
		});
		return articleTable;
	}

	// Разделы: по наименьшему порядку статьи в них, потом по названию; статьи
	// без раздела — в конце. Внутри раздела — по порядку, потом по названию.
	function articleGroups(picked) {
		var table = articles();
		var groups = [];
		var bySection = {};

		Object.keys(table)
			.map(function (name) {
				return table[name];
			})
			.filter(function (rec) {
				return !picked.length || picked.indexOf(rec.section) !== -1;
			})
			.sort(function (x, y) {
				return x.order - y.order || x.title.localeCompare(y.title, 'ru');
			})
			.forEach(function (rec) {
				var key = 's:' + rec.section;

				if (!bySection[key]) {
					bySection[key] = {name: rec.section, order: rec.order, items: []};
					groups.push(bySection[key]);
				}
				bySection[key].items.push(rec);
			});
		return groups.sort(function (x, y) {
			if (!x.name !== !y.name) {
				return x.name ? -1 : 1;
			}
			return x.order - y.order || x.name.localeCompare(y.name, 'ru');
		});
	}

	Macro.add('sg-articles', {
		handler: function () {
			var a = blockArgs(this, [], ['sections', 'form', 'kind', 'columns'], ['headings']);
			var picked = String(a.sections || '')
				.split(',')
				.map(function (name) {
					return name.trim();
				})
				.filter(Boolean);
			var tag = a.form === 'button' ? 'button' : 'link';
			var columns = Math.max(1, Math.round(Number(a.columns)) || 1);
			var box = document.createElement('div');

			box.className = 'sg-art-list';
			articleGroups(picked).forEach(function (group) {
				var section = document.createElement('div');
				var grid = document.createElement('div');

				section.className = 'sg-art-section';
				if (a.headings && group.name) {
					var heading = document.createElement('div');

					heading.className = 'sg-art-heading';
					heading.textContent = group.name;
					section.appendChild(heading);
				}
				grid.className = 'sg-art-grid';
				grid.style.gridTemplateColumns = 'repeat(' + columns + ', minmax(0, 1fr))';
				group.items.forEach(function (rec) {
					var item = document.createElement('div');
					var inner = item;

					item.className = 'sg-art-item';
					if (a.kind) {
						inner = document.createElement('span');
						inner.className = String(a.kind);
						item.appendChild(inner);
					}
					$(inner).wiki(
						'<<' + tag + ' ' + JSON.stringify(rec.title) + ' ' + JSON.stringify(rec.name) + '>><</' + tag + '>>'
					);
					grid.appendChild(item);
				});
				section.appendChild(grid);
				box.appendChild(section);
			});
			this.output.appendChild(box);
		}
	});

	function articleFrom(title) {
		var map = State.variables.sgArticles;
		var from = map && map[title];

		return from && Story.has(from) ? from : '';
	}

	Macro.add('sg-article-back', {
		handler: function () {
			var from = articleFrom(State.passage);

			if (from) {
				goBack(from);
			}
		}
	});

	// Откуда открыли статью. Обработчик стоит раньше saveEntry, поэтому запись
	// попадает в автокопию; после сбоя «Назад» ведёт туда же.
	$(document).on(':passagestart', function (ev) {
		var returning = articleReturn;
		var title = ev.passage.title;

		articleReturn = false;
		if (!restoring && !returning && prevPassage && prevPassage !== title && articles()[title]) {
			varObject('sgArticles')[title] = prevPassage;
		}
	});

	$(document).on(':passagedisplay', function (ev) {
		var rec = articles()[State.passage];

		if (!rec || (!preview && !articleFrom(State.passage))) {
			return;
		}

		var box = document.createElement('div');
		var inner = box;
		var kind = String(opt('article-kind', ''));
		var tag = opt('article-button', 0) ? 'button' : 'link';
		var label = rec.back || String(opt('article-back', 'Назад'));

		box.className = 'sg-art-back';
		if (kind) {
			inner = document.createElement('span');
			inner.className = kind;
			box.appendChild(inner);
		}
		$(inner).wiki('<<' + tag + ' ' + JSON.stringify(label) + '>><<sg-article-back>><</' + tag + '>>');
		ev.content.appendChild(box);
	});

	/* ----- Список состояний (шаг 5.1) ----- */

	// Процедуры и системы ИНЖИНАРИУМА: <<sg-list>> с <<sg-state>> (надпись, вид,
	// цвет и действие состояния — одни на весь список) и <<sg-row>> (номер,
	// название, переменная, экран). Состояние строки — значение её переменной:
	// пустая считается 0, значения нет в списке — первое состояние. Значение
	// меняется кодом или клавишей, поэтому строка перерисовывается сама.
	// В предпросмотре строки показаны в разных состояниях: видны все сразу.
	var listTimer = 0;

	function listFill(text, row) {
		return String(text === undefined ? '' : text)
			.split('{номер}')
			.join(String(row.num === undefined ? '' : row.num))
			.split('{название}')
			.join(String(row.name === undefined ? '' : row.name));
	}

	function listIndex(info) {
		var states = info.list.states;

		if (preview) {
			return info.index % states.length;
		}

		var value = info.row['var'] ? State.getVar(String(info.row['var'])) : undefined;
		var text = value === undefined || value === null || value === false ? '0' : value === true ? '1' : String(value);

		for (var i = 0; i < states.length; i++) {
			if (String(states[i].value) === text) {
				return i;
			}
		}
		return 0;
	}

	function listSpan(cls, text) {
		var span = document.createElement('span');

		span.className = cls;
		span.textContent = text;
		return span;
	}

	function listDraw(item) {
		var info = item.sgList;
		var list = info.list;
		var row = info.row;
		var index = listIndex(info);
		var st = list.states[index];
		var key = row.key && st.keykind;
		var kind = key ? st.keykind : st.kind;
		var color = key ? '' : st.color;
		var label = listFill(st.label, row);
		var name = String(row.name || row.num || '');
		var way = st['do'];
		var go = way === 'row' ? row.passage : way ? '' : st.goto;
		var body = listFill(st.text, row);
		var tile = list.form === 'tile';
		var inner = item;
		var el;

		info.state = index;
		item.textContent = '';
		go = go && Story.has(String(go)) ? String(go) : '';
		if (way === 'window' && row.passage && Story.has(String(row.passage))) {
			body +=
				'<<sg-open ' +
				JSON.stringify(listFill(st.title || '{название}', row)) +
				' passage ' +
				JSON.stringify(String(row.passage)) +
				'>><</sg-open>>';
		}
		if (kind) {
			inner = document.createElement('span');
			inner.className = String(kind);
			item.appendChild(inner);
		}
		if (tile && !go && !body) {
			el = document.createElement('div');
			el.className = 'sg-tile';
			inner.appendChild(el);
		} else {
			var tag = list.form === 'button' ? 'button' : 'link';

			$(inner).wiki(
				'<<' + tag + ' ' + JSON.stringify(label || name || '—') + (go ? ' ' + JSON.stringify(go) : '') + '>>' + body + '<</' + tag + '>>'
			);
			el = inner.querySelector('a, button');
			if (el && tile) {
				el.classList.add('sg-tile');
				el.textContent = '';
			}
		}
		if (!el) {
			return;
		}
		if (tile) {
			el.appendChild(listSpan('sg-tile-name', listFill('{название}', row) || name));
			el.appendChild(listSpan('sg-tile-status', label));
		}
		// Правило «Доступа»: у строки — её название, у состояния со своим
		// экраном — надпись состояния (она одна на весь список).
		el.setAttribute('data-sg-label', way || !st.goto ? name : String(st.label || ''));
		if (color) {
			el.classList.add('sg-list-color');
			el.style.setProperty('--sg-state', String(color));
		}
	}

	function listTick() {
		var items = document.querySelectorAll('.sg-list-item');

		for (var i = 0; i < items.length; i++) {
			if (items[i].sgList && listIndex(items[i].sgList) !== items[i].sgList.state) {
				listDraw(items[i]);
			}
		}
	}

	Macro.add('sg-list', {
		tags: ['sg-state', 'sg-row'],
		handler: function () {
			var a = blockArgs(this, [], ['form', 'columns'], []);
			var list = {form: a.form === 'button' || a.form === 'tile' ? a.form : 'link', states: [], rows: []};
			var columns = Math.max(1, Math.round(Number(a.columns)) || 1);
			var grid = document.createElement('div');

			this.payload.slice(1).forEach(function (part) {
				if (part.name === 'sg-state') {
					var st = blockArgs({args: part.args}, ['value'], ['label', 'kind', 'color', 'keykind', 'do', 'goto', 'title'], []);

					st.text = trimContent(part.contents);
					list.states.push(st);
				} else {
					list.rows.push(blockArgs({args: part.args}, ['num', 'name'], ['var', 'passage'], ['key']));
				}
			});
			grid.className = 'sg-list-grid' + (list.form === 'tile' ? ' sg-list-tiles' : '');
			grid.style.gridTemplateColumns = 'repeat(' + columns + ', minmax(0, 1fr))';
			if (list.states.length) {
				list.rows.forEach(function (row, index) {
					var item = document.createElement('div');

					item.className = 'sg-list-item';
					item.sgList = {list: list, row: row, index: index, state: -1};
					grid.appendChild(item);
					listDraw(item);
				});
			}
			this.output.appendChild(grid);
			if (!listTimer && !preview) {
				listTimer = setInterval(listTick, 250);
			}
		}
	});

	/* ----- Музыка: каталог, общий плеер, громкость, музыка экрана (шаг 7.1) ----- */

	// Каталог — пассажи с тегом sg-music: <<sg-music>>, <<sg-folder>>, <<sg-track>>.
	// Звучит один трек (ответ 3А), громкость одна, 0–99 (ответ 4А). Состояние —
	// $sgMusic = {vol, auto, cur, playing, pos: {трек: секунды}, seen: {трек: 1},
	// last: {ambient, radio}}. Плеер — свой Audio, мимо SimpleAudio: кнопки A–E
	// старого вида его не трогают. После сбоя музыку включает мастер (решение 37).
	var musCollect = null;
	var musTable = null;
	// duck — приглушение звуком-сигналом (сессия 30: и общий плеер, и эфир; было только SimpleAudio).
	var mus = {audio: null, id: '', mult: 1, duck: 1, pre: null, rev: null, timers: [], ramps: [], screen: [], fresh: true};
	var volItems = [];
	var volTimer = null;

	function musNum(value, fallback) {
		var n = Number(String(value === undefined ? '' : value).replace(',', '.'));

		return value !== undefined && value !== '' && isFinite(n) ? n : fallback;
	}

	function musClamp(n) {
		return Math.max(0, Math.min(99, Math.round(Number(n) || 0)));
	}

	Macro.add('sg-music', {
		handler: function () {
			if (musCollect) {
				musCollect.settings = blockArgs(this, [], ['volume', 'spin'], ['auto']);
			}
		}
	});

	Macro.add('sg-folder', {
		handler: function () {
			if (musCollect) {
				var a = blockArgs(this, ['name'], ['section', 'tip'], []);

				musCollect.folders.push({
					name: String(a.name || ''),
					section: a.section === 'radio' || a.section === 'air' || a.section === 'jam' ? a.section : 'ambient',
					tip: a.tip ? String(a.tip) : '',
					tracks: []
				});
			}
		}
	});

	Macro.add('sg-track', {
		tags: null,
		handler: function () {
			if (!musCollect) {
				return;
			}

			var a = blockArgs(this, ['name', 'src'], ['pre', 'wait', 'tail', 'prevolume', 'start', 'gain', 'to', 'width', 'text', 'reverse'], []);

			if (!musCollect.folders.length) {
				musCollect.folders.push({name: 'Музыка', section: 'ambient', tracks: []});
			}
			musCollect.folders[musCollect.folders.length - 1].tracks.push({
				name: String(a.name || ''),
				src: String(a.src || ''),
				pre: a.pre ? String(a.pre) : '',
				wait: Math.max(0, musNum(a.wait, 3)),
				tail: Math.max(0, musNum(a.tail, 2)),
				prevolume: Math.max(0, Math.min(100, musNum(a.prevolume, 100))),
				start: a.start === undefined ? undefined : musClamp(a.start),
				when: trimContent(this.payload[0].contents),
				// Шаг 7.3: громкость файла (ответ 2А); у передачи эфира — куда после поимки,
				// ширина слышимости и своё сообщение.
				gain: Math.max(1, Math.min(100, musNum(a.gain, 100))),
				to: a.to ? String(a.to) : '',
				width: Math.max(0.1, Math.min(20, musNum(a.width, 1.5))),
				text: a.text ? String(a.text) : '',
				// Шаг 7.4, ответ 2А: свой файл «что слышно задом наперёд»; нет — копия программы.
				rev: a.reverse ? String(a.reverse) : ''
			});
		}
	});

	function music() {
		if (musTable !== null) {
			return musTable;
		}

		var c = {settings: {}, folders: []};

		musCollect = c;
		Story.filter(function (p) {
			return p.tags.indexOf('sg-music') !== -1;
		}).forEach(function (p) {
			try {
				new Wikifier(document.createDocumentFragment(), p.text);
			} catch (e) {
				console.error('СИГНАЛЫ: музыка', e);
			}
		});
		musCollect = null;
		// Сессия 30: папки раздела «Помехи» (section jam) названы по видам радио — в byName их нет,
		// у их треков id «jam:Вид/Трек»; jamsByView — помехи каждого вида.
		var jamFolders = c.folders.filter(function (f) {
			return f.section === 'jam';
		});

		c.folders = c.folders.filter(function (f) {
			return f.section !== 'jam';
		});
		musTable = {
			volume: musClamp(musNum(c.settings.volume, 30)),
			spin: Math.max(0, musNum(c.settings.spin, 0.8)),
			auto: !!c.settings.auto,
			folders: c.folders,
			byId: {},
			byName: {},
			air: [],
			jamsByView: {}
		};
		c.folders.forEach(function (f) {
			musTable.byName[f.name] = f;
		});
		// Шаг 7.3, ответ 1Б: вложенная папка — путь через «/»; раздел — как у папки выше.
		c.folders.forEach(function (f) {
			f.parent = musParent(f.name);
		});
		c.folders.slice().sort(function (x, y) {
			return x.name.split('/').length - y.name.split('/').length;
		}).forEach(function (f) {
			if (f.parent) {
				f.section = musTable.byName[f.parent].section;
			}
		});
		c.folders.forEach(function (f) {
			f.tracks.slice().forEach(function (t) {
				t.id = f.name + '/' + t.name;
				t.folder = f;
				musTable.byId[t.id] = t;
				if (f.section === 'air') {
					// Передача эфира: в каталоге — в своей папке радио, когда поймана.
					var home = t.to && musTable.byName[t.to];

					t.air = true;
					musTable.air.push(t);
					if (home && home.section === 'radio') {
						t.folder = home;
						home.tracks.push(t);
					} else {
						t.only = true;
					}
				}
			});
		});
		musJams(jamFolders);
		return musTable;
	}

	// Помехи по видам радио (сессия 30). Нет папки — старая запись jam у вида. Пойманная помеха —
	// трек папки радио «Помехи» (своя папка радио «Помехи» — она, иначе папка появляется сама).
	function musJams(jamFolders) {
		var views = radioViews();
		var home = null;

		radioOrder.forEach(function (name) {
			var view = views[name];

			if (view.type === 'broken' || !view.jams.length || jamFolders.some(function (f) {
				return f.name === name;
			})) {
				return;
			}

			var used = {};

			jamFolders.push({name: name, section: 'jam', tip: '', tracks: view.jams.map(function (j) {
				var base = String(j.src).replace(/^.*\//, '').replace(/\.[^.]*$/, '') || j.src;
				var nm = base;

				for (var n = 2; used[nm]; n++) {
					nm = base + ' ' + n;
				}
				used[nm] = 1;
				return {name: nm, src: j.src, pre: '', wait: 3, tail: 2, prevolume: 100, start: undefined, when: '', gain: Math.max(1, j.volume), to: '', width: j.width, text: '', rev: ''};
			})});
		});
		jamFolders.forEach(function (f) {
			if (!f.tracks.length) {
				return;
			}
			if (!home) {
				home = musTable.byName['Помехи'];
				if (!home || home.section !== 'radio') {
					home = {name: 'Помехи', section: 'radio', tip: '', tracks: [], parent: '', virtual: true};
					musTable.folders.push(home);
					musTable.byName[home.name] = home;
				}
			}
			musTable.jamsByView[f.name] = f.tracks;
			f.tracks.forEach(function (t) {
				t.id = 'jam:' + f.name + '/' + t.name;
				t.air = true;
				t.jam = true;
				t.view = f.name;
				t.folder = home;
				musTable.byId[t.id] = t;
				home.tracks.push(t);
			});
		});
	}

	// Папка выше: ближайшая существующая по пути, иначе '' (верхняя).
	function musParent(name) {
		var parts = name.split('/');

		while (parts.length > 1) {
			parts.pop();
			if (musTable.byName[parts.join('/')]) {
				return parts.join('/');
			}
		}
		return '';
	}

	// Есть ли в папке или во вложенных хоть один видимый трек.
	function musDeep(f) {
		return f.tracks.some(musVisible) || music().folders.some(function (c) {
			return c.name.indexOf(f.name + '/') === 0 && c.tracks.some(musVisible);
		});
	}

	function musState() {
		var st = varObject('sgMusic');

		if (st.vol === undefined) {
			st.vol = music().volume;
			st.auto = music().auto;
		}
		['pos', 'seen', 'last', 'lastIn', 'done', 'from', 'caught'].forEach(function (key) {
			if (!st[key] || typeof st[key] !== 'object') {
				st[key] = {};
			}
		});
		// После сбоя страница новая: что играло, уже молчит (музыку включает мастер);
		// поиск в эфире тоже выключен.
		if (mus.fresh) {
			mus.fresh = false;
			st.playing = false;
			st.scan = false;
			st.dec = false;
		}
		return st;
	}

	// Передача эфира видна в каталоге, когда поймана; условие у неё — для эфира (musCond).
	function musVisible(t) {
		if (t.air) {
			return !preview && !!musState().caught[t.id];
		}
		return musCond(t);
	}

	function musCond(t) {
		if (!t.when) {
			return true;
		}
		try {
			return !!Scripting.evalTwineScript(t.when);
		} catch (e) {
			console.error('СИГНАЛЫ: условие трека «' + t.id + '»', e);
			return false;
		}
	}

	function musFolder(name) {
		return music().byName[name];
	}

	function musFirst(folders) {
		for (var i = 0; i < folders.length; i++) {
			var list = folders[i].tracks.filter(musVisible);

			if (list.length) {
				return list[0].id;
			}
		}
		return '';
	}

	function musChanged() {
		saveVars();
		volDrawAll();
		radioDrawAll();
		ambDrawAll();
	}

	/* ----- Реверс (шаг 7.4) ----- */

	// Длина треков, секунды: узнаётся при загрузке (для прогресса и реверса).
	var musDur = {};

	// Развёрнутый файл трека: свой (ответ 2А) или копия программы (ответ 1А) —
	// media/audio/reverse/<путь внутри media/audio без расширения>.wav
	// (то же правило — reversePath в signaly-reverse.ts).
	function musRevSrc(t) {
		if (t.rev) {
			return t.rev;
		}

		var src = String(t.src).replace(/^\.\//, '');
		var rel = src.indexOf('media/audio/') === 0 ? src.slice(12) : src.indexOf('media/') === 0 ? src.slice(6) : src;

		return 'media/audio/reverse/' + rel.replace(/\.[^./]*$/, '') + '.wav';
	}

	// Длина трека; не знаем — узнать в фоне (вернётся 0).
	function musLength(t) {
		if (musDur[t.id]) {
			return musDur[t.id];
		}
		if (mus.audio && mus.id === t.id && isFinite(mus.audio.duration) && mus.audio.duration > 0) {
			musDur[t.id] = mus.audio.duration;
			return musDur[t.id];
		}
		if (!preview && !musDur['?' + t.id]) {
			musDur['?' + t.id] = 1;

			var probe = new Audio();

			probe.preload = 'metadata';
			probe.addEventListener('loadedmetadata', function () {
				if (isFinite(probe.duration) && probe.duration > 0) {
					musDur[t.id] = probe.duration;
				}
			}, {once: true});
			probe.src = t.src;
		}
		return 0;
	}

	// Где трек, пока звучит задом наперёд: место в развёрнутом файле → место в прямом
	// (по доле длины: свой файл с посланием может быть другой длины).
	function revPosition(rev) {
		if (!rev.ok) {
			return rev.at;
		}

		var q = rev.audio.ended ? rev.rdur : rev.audio.currentTime;

		return Math.max(0, (rev.rdur - q) * rev.dur / rev.rdur);
	}

	// Ответ 4А: пока кнопка зажата — трек задом наперёд с обычной скоростью, место едет
	// назад; дошли до начала — тишина, пока держат.
	function revStart() {
		var st = musState();
		var t = music().byId[st.cur];

		if (preview || !t || t.folder.section !== 'radio' || mus.rev) {
			return;
		}

		var at = mus.audio && mus.id === t.id ? mus.audio.currentTime : Number(st.pos[t.id]) || 0;
		var dur = musLength(t);

		musHalt(true);
		if (st.scan) {
			st.scan = false;
			airStop();
		}

		var audio = new Audio(musRevSrc(t));
		var rev = {audio: audio, t: t, at: at, dur: dur, rdur: 0, ok: false};

		audio.preload = 'auto';
		audio.addEventListener('loadedmetadata', function () {
			if (mus.rev !== rev || !isFinite(audio.duration) || audio.duration <= 0) {
				return;
			}
			rev.rdur = audio.duration;
			rev.dur = rev.dur || musLength(t) || audio.duration;
			audio.currentTime = Math.max(0, Math.min(audio.duration, audio.duration - rev.at * audio.duration / rev.dur));
			rev.ok = true;
			audio.play().catch(function () {});
		}, {once: true});
		audio.addEventListener('error', function () {
			// Сессия 30, ответ 5А: копии нет — строка пишет, пока держат.
			rev.err = true;
			musChanged();
			console.warn('СИГНАЛЫ: нет развёрнутого файла «' + audio.getAttribute('src') + '» для трека «' + t.id + '»');
		});
		mus.rev = rev;
		mus.id = t.id;
		st.cur = t.id;
		st.playing = true;
		musApply();
		musChanged();
	}

	// Отпустили — трек играет вперёд с нового места (без предзвука).
	function revEnd() {
		var rev = mus.rev;

		if (preview || !rev) {
			return;
		}

		var pos = revPosition(rev);

		rev.audio.pause();
		mus.rev = null;
		musState().pos[rev.t.id] = pos;
		musPlay(rev.t.id, 0, true);
	}

	// Текущий трек, где он и сколько длится — для полосы прогресса.
	function musWhere() {
		var st = radioState();
		var t = music().byId[st.cur];

		if (!t || preview) {
			return null;
		}

		var pos = mus.rev && mus.rev.t === t ? revPosition(mus.rev) : mus.audio && mus.id === t.id ? mus.audio.currentTime : Number(st.pos[t.id]) || 0;

		return {t: t, pos: pos, dur: musLength(t)};
	}

	// Перемотка полосой прогресса (ответ 5Б): и на паузе — место запоминается.
	function musSeek(frac) {
		var w = musWhere();

		if (!w || !w.dur || mus.rev) {
			return;
		}

		var pos = Math.max(0, Math.min(w.dur - 0.05, frac * w.dur));

		if (mus.audio && mus.id === w.t.id) {
			mus.audio.currentTime = pos;
		}
		musState().pos[w.t.id] = pos;
		saveVars();
	}

	// Громкость файла трека (шаг 7.3, ответ 2А), 1–100 %.
	function musGain(id) {
		var t = music().byId[id];

		return t ? t.gain / 100 : 1;
	}

	function musApply() {
		var master = (musState().vol / 99) * mus.duck;

		if (mus.audio) {
			mus.audio.volume = Math.max(0, Math.min(1, master * mus.mult * musGain(mus.id)));
		}
		if (mus.rev) {
			mus.rev.audio.volume = Math.max(0, Math.min(1, master * musGain(mus.rev.t.id)));
		}
		if (mus.pre) {
			mus.pre.volume = Math.max(0, Math.min(1, master * mus.pre.sgLevel));
		}
	}

	function musClear() {
		mus.timers.forEach(clearTimeout);
		mus.timers = [];
		if (mus.pre) {
			mus.pre.pause();
			mus.pre = null;
		}
	}

	// Плавно: from → to за seconds; step(значение) на каждом шаге, done в конце.
	function musRamp(from, to, seconds, step, done) {
		var start = Date.now();
		var ramp = {};

		ramp.timer = setInterval(function () {
			var k = seconds > 0 ? Math.min(1, (Date.now() - start) / (seconds * 1000)) : 1;

			step(from + (to - from) * k);
			if (k >= 1) {
				clearInterval(ramp.timer);
				mus.ramps.splice(mus.ramps.indexOf(ramp), 1);
				if (done) {
					done();
				}
			}
		}, 50);
		mus.ramps.push(ramp);
		return ramp;
	}

	// Остановить текущий трек (место запоминается); silent — не трогать «играет».
	function musHalt(keepPlace) {
		var st = musState();

		musClear();
		if (mus.rise) {
			clearInterval(mus.rise.timer);
			mus.rise = null;
		}
		if (mus.audio) {
			st.pos[mus.id] = keepPlace && !mus.audio.ended ? mus.audio.currentTime : 0;
			mus.audio.pause();
			mus.audio = null;
		}
		if (mus.rev) {
			// Шаг 7.4: реверс прервало другое действие — место там, куда доехали назад.
			st.pos[mus.rev.t.id] = keepPlace ? revPosition(mus.rev) : 0;
			mus.rev.audio.pause();
			mus.rev = null;
		}
		mus.mult = 1;
	}

	// quiet — без предзвука (шаг 7.4: трек играет дальше после реверса).
	function musPlay(id, rise, quiet) {
		var t = music().byId[id];
		var st = musState();

		if (!t || preview) {
			return;
		}
		musHalt(true);
		// Шаг 7.3, ответ 7А: включили трек — поиск в эфире выключается.
		if (st.scan) {
			st.scan = false;
			airStop();
		}
		st.cur = id;
		st.playing = true;
		st.last[t.folder.section] = id;
		st.lastIn[t.folder.name] = id;
		if (!st.seen[id]) {
			st.seen[id] = 1;
			if (t.start !== undefined) {
				st.vol = musClamp(t.start);
			}
		}

		var audio = new Audio(t.src);
		var at = Number(st.pos[id]) || 0;

		audio.preload = 'auto';
		if (at > 0) {
			audio.addEventListener('loadedmetadata', function () {
				if (at < audio.duration) {
					audio.currentTime = at;
				}
			}, {once: true});
		}
		audio.addEventListener('ended', function () {
			if (mus.audio === audio) {
				musEnded(id);
			}
		});
		audio.addEventListener('loadedmetadata', function () {
			if (isFinite(audio.duration) && audio.duration > 0) {
				musDur[id] = audio.duration;
			}
		}, {once: true});
		mus.audio = audio;
		mus.id = id;
		mus.mult = rise > 0 ? 0 : 1;
		musApply();

		var go = function () {
			if (mus.audio !== audio) {
				return;
			}
			audio.play().catch(function (e) {
				console.warn('СИГНАЛЫ: трек «' + id + '»', e);
			});
			if (rise > 0) {
				mus.rise = musRamp(0, 1, rise, function (k) {
					mus.mult = k;
					musApply();
				}, function () {
					mus.rise = null;
				});
			}
		};

		if (t.pre && !quiet) {
			// Предзвук: сначала он, через wait секунд — трек, ещё tail секунд — оба.
			var pre = new Audio(t.pre);

			pre.sgLevel = t.prevolume / 100;
			mus.pre = pre;
			musApply();
			pre.play().catch(function () {});
			mus.timers.push(setTimeout(go, t.wait * 1000));
			mus.timers.push(setTimeout(function () {
				if (mus.pre === pre) {
					pre.pause();
					mus.pre = null;
				}
			}, (t.wait + t.tail) * 1000));
		} else {
			go();
		}
		musChanged();
	}

	function musEnded(id) {
		var st = musState();
		var t = music().byId[id];

		st.pos[id] = 0;
		// Шаг 7.2, ответ 7А: прослушан — доигран до конца хотя бы раз.
		st.done[id] = 1;
		mus.audio = null;
		if (st.auto && t) {
			// «АВТО»: следующий трек той же папки, после последнего — первый.
			var next = musAfter(t);

			if (next) {
				st.pos[next.id] = 0;
				musPlay(next.id);
				return;
			}
		}
		st.playing = false;
		musChanged();
	}

	// Следующий трек папки: по порядку (после последнего — первый) или, при
	// «Случайно» (шаг 7.2, ответ 6А), случайный, кроме текущего.
	function musAfter(t) {
		var list = t.folder.tracks.filter(musVisible);
		// Сессия 30: у радио своё «СЛУЧАЙНО» (rshuffle), у Атмосферы — своё (shuffle).
		var random = t.folder.section === 'radio' ? musState().rshuffle : musState().shuffle;

		if (random && list.length > 1) {
			var others = list.filter(function (x) {
				return x !== t;
			});

			return others[Math.floor(Math.random() * others.length)];
		}
		return list[(list.indexOf(t) + 1) % list.length] || list[0];
	}

	// Раздел: последний трек раздела, иначе первый, который есть в каталоге.
	function musSection(section) {
		var st = musState();

		return st.last[section] && music().byId[st.last[section]] ? st.last[section] : musFirst(music().folders.filter(function (f) {
			return f.section === section;
		}));
	}

	function musStop() {
		var st = musState();

		musHalt(false);
		if (st.cur) {
			st.pos[st.cur] = 0;
		}
		st.playing = false;
		musChanged();
	}

	function musPause() {
		musHalt(true);
		musState().playing = false;
		musChanged();
	}

	// Затухание за seconds, потом пауза (место запоминается).
	function musFadeOut(seconds) {
		var st = musState();
		var audio = mus.audio;
		var id = mus.id;
		var from = mus.mult;
		var gain = musGain(id);

		musClear();
		if (!audio) {
			st.playing = false;
			return;
		}
		mus.audio = null;
		st.playing = false;
		musRamp(from, 0, seconds, function (k) {
			audio.volume = Math.max(0, Math.min(1, (st.vol / 99) * mus.duck * k * gain));
		}, function () {
			st.pos[id] = audio.ended ? 0 : audio.currentTime;
			audio.pause();
			saveVars();
		});
		mus.mult = 1;
		musChanged();
	}

	function musToggle(section) {
		var st = musState();
		var t = music().byId[st.cur];

		if (st.playing && t && t.folder.section === section) {
			musPause();
			return;
		}

		var id = musSection(section);

		if (id) {
			musPlay(id);
		}
	}

	function musNext() {
		var st = musState();
		var t = music().byId[st.cur];

		if (!t) {
			return;
		}

		var next = musAfter(t);

		if (next) {
			musHalt(true);
			st.pos[next.id] = 0;
			musPlay(next.id);
		}
	}

	function musSetVolume(n) {
		var st = musState();

		st.vol = musClamp(n);
		musApply();
		musChanged();
	}

	function musWords(raw) {
		var re = /"((?:\\.|[^"\\])*)"|'([^']*)'|(\S+)/g;
		var out = [];
		var m;

		while ((m = re.exec(raw))) {
			out.push(m[1] !== undefined ? m[1].replace(/\\(.)/g, '$1') : m[2] !== undefined ? m[2] : m[3]);
		}
		return out;
	}

	// <<sg-mus …>> — действие ссылки, кнопки, клавиши, кода.
	Macro.add('sg-mus', {
		skipArgs: true,
		handler: function () {
			if (preview) {
				return;
			}

			var w = musWords(this.args.raw || this.args.full || '');
			var st = musState();

			switch (w[0]) {
				case 'play':
					if (w[1] === 'track') {
						musPlay(w[2]);
					} else if (w[1] === 'section') {
						var sid = musSection(w[2] === 'radio' ? 'radio' : 'ambient');

						if (sid && !(st.cur === sid && st.playing)) {
							musPlay(sid);
						}
					} else if (w[1] === 'folder') {
						var f = musFolder(w[2]);
						var id = f ? musFirst([f]) : '';

						if (id) {
							musPlay(id);
						}
					}
					break;
				case 'toggle':
					musToggle(w[1] === 'radio' ? 'radio' : 'ambient');
					break;
				case 'pause':
					musPause();
					break;
				case 'resume':
					if (st.cur && !st.playing) {
						musPlay(st.cur);
					}
					break;
				case 'stop':
					musStop();
					break;
				case 'next':
					musNext();
					break;
				case 'volume':
					var v = String(w[1] || '');

					musSetVolume(/^[+-]/.test(v) ? st.vol + Number(v) : Number(v));
					break;
				case 'auto':
					st.auto = w[1] === 'on' ? true : w[1] === 'off' ? false : !st.auto;
					musChanged();
					break;
			}
		}
	});

	// Музыка экрана: <<sg-screen-music delay 5 now fade fade 3 play folder "Папка" after 1 rise 2>>.
	// Отсчёт идёт, пока игроки на экране; ушли раньше — отменяется. Смена началась —
	// доходит до конца, новая музыка играет дальше (ответ 5А).
	function screenMusicRun(o) {
		var st = musState();
		var wasPlaying = st.playing;
		var id = '';

		if (o.play === 'track') {
			id = music().byId[o.target] ? o.target : '';
		} else if (o.play === 'folder') {
			var f = musFolder(o.target);

			id = f ? musFirst([f]) : '';
		} else if (o.play === 'ambient' && !(wasPlaying && o.now === '')) {
			// Как на главном экране шаблона: Атмосфера продолжает, только если её
			// уже включали; в начале игры здесь тишина.
			id = st.last.ambient && music().byId[st.last.ambient] ? st.last.ambient : '';
		}
		// Уже играет то же — ничего не трогать.
		if (id && id === st.cur && wasPlaying) {
			return;
		}
		if (o.now === 'stop') {
			musPause();
		} else if (o.now === 'fade') {
			musFadeOut(o.fade);
		}
		if (!id) {
			return;
		}
		if (o.now === 'fade' && o.after > 0 && wasPlaying) {
			mus.screen.push(setTimeout(function () {
				musPlay(id, o.rise);
			}, o.after * 1000));
		} else if (o.now === '' && wasPlaying) {
			musPlay(id, o.rise);
		} else {
			musPlay(id, o.rise);
		}
	}

	Macro.add('sg-screen-music', {
		skipArgs: true,
		handler: function () {
			if (preview || restoring) {
				return;
			}

			var w = musWords(this.args.raw || this.args.full || '');
			var o = {delay: 0, now: '', fade: 3, play: '', target: '', after: 0, rise: 0};

			for (var i = 0; i < w.length; i++) {
				if (/^(delay|fade|after|rise)$/.test(w[i])) {
					o[w[i]] = Math.max(0, musNum(w[i + 1], 0));
					i++;
				} else if (w[i] === 'now') {
					o.now = w[i + 1] === 'stop' || w[i + 1] === 'fade' ? w[i + 1] : '';
					i++;
				} else if (w[i] === 'play') {
					o.play = w[i + 1];
					if (o.play === 'track' || o.play === 'folder') {
						o.target = w[i + 2] || '';
						i++;
					}
					i++;
				}
			}
			mus.screen.push(setTimeout(function () {
				screenMusicRun(o);
			}, o.delay * 1000));
		}
	});

	$(document).on(':passageinit', function () {
		mus.screen.forEach(clearTimeout);
		mus.screen = [];
		volItems = [];
	});

	/* Громкость: «−», окошко 00–99 цифрами DSEG7, «+». На паузе — 00 (ТЗ, раздел 2). */

	function volShown() {
		var st = preview ? {vol: music().volume, playing: true} : musState();

		return ('0' + (st.playing ? st.vol : 0)).slice(-2);
	}

	function volDraw(item, now) {
		var target = volShown();

		if (item.target === null) {
			// Первый показ — сразу, без кручения.
			item.target = target;
			item.chars = target.split('');
			item.cells[0].textContent = target[0];
			item.cells[1].textContent = target[1];
		} else if (target !== item.target) {
			item.target = target;
			for (var i = 0; i < 2; i++) {
				if (target[i] !== item.chars[i]) {
					var spin = preview ? 0 : music().spin * 1000;

					// Цифры крутятся и останавливаются справа налево, как у цикла.
					item.stop[i] = now + spin * (i === 0 ? 1 : 0.7);
					item.start[i] = now;
					item.next[i] = now;
				}
			}
		}
		for (var j = 0; j < 2; j++) {
			if (item.stop[j] === 0) {
				continue;
			}
			if (now >= item.stop[j]) {
				item.stop[j] = 0;
				item.chars[j] = target[j];
				item.cells[j].textContent = target[j];
			} else if (now >= item.next[j]) {
				var k = (now - item.start[j]) / Math.max(1, item.stop[j] - item.start[j]);
				var rate = 25 + (4 - 25) * k;

				item.cells[j].textContent = String(Math.floor(Math.random() * 10));
				item.next[j] = now + 1000 / rate;
			}
		}
	}

	function volDrawAll() {
		var now = Date.now();

		volItems.forEach(function (item) {
			volDraw(item, now);
		});
	}

	Macro.add('sg-volume', {
		handler: function () {
			var a = blockArgs(this, [], ['step', 'size', 'kind'].concat(placeKeys), []);
			var step = Math.max(1, musNum(a.step, 5));
			var box = document.createElement('span');
			var inner = box;
			var digits = document.createElement('span');
			var item = {target: null, chars: ['', ''], cells: [], stop: [0, 0], start: [0, 0], next: [0, 0]};

			box.className = 'sg-volume';
			if (a.kind) {
				inner = document.createElement('span');
				inner.className = String(a.kind);
				box.appendChild(inner);
			}
			$(inner).wiki('<<button "−">><</button>>');
			digits.className = 'sg-vol-box';
			digits.style.fontFamily = timerFont(timerDefaults.font);
			digits.style.fontSize = Math.max(8, musNum(a.size, 40)) + 'px';
			for (var i = 0; i < 2; i++) {
				var cell = document.createElement('span');

				cell.textContent = '0';
				digits.appendChild(cell);
				item.cells.push(cell);
			}
			inner.appendChild(digits);
			$(inner).wiki('<<button "+">><</button>>');

			var buttons = inner.querySelectorAll('button');

			$(buttons[0]).on('click', function () {
				if (!preview) {
					musSetVolume(musState().vol - step);
				}
			});
			$(buttons[buttons.length - 1]).on('click', function () {
				if (!preview) {
					musSetVolume(musState().vol + step);
				}
			});
			placeStyle(box, a);
			putPlaced(this, box, a, 'volume');
			volItems.push(item);
			volDraw(item, Date.now());
			if (!volTimer) {
				volTimer = setInterval(volDrawAll, 40);
			}
		}
	});

	engineStyle.textContent +=
		'.sg-volume { display: inline-flex; align-items: center; gap: 0.4em; }\n' +
		'.sg-volume > span { display: inline-flex; align-items: center; gap: 0.4em; }\n' +
		'.sg-vol-box { display: inline-flex; padding: 0.1em 0.25em; line-height: 1; ' +
		'border: var(--sg-border-width, 2px) solid var(--sg-border-color, currentColor); ' +
		'box-shadow: 0 0 var(--sg-glow-size, 0) var(--sg-glow-color, transparent); background: var(--sg-win-bg, #000); }\n' +
		'.sg-vol-box span { display: inline-block; width: 1ch; text-align: center; }\n';

	/* ----- Радио и «Каталог Атмосферы» (шаг 7.2) ----- */

	// Виды радио — пассажи с тегом sg-radio: <<sg-radio-view "Имя" type broken frame "#…"
	// elements "#…" label "…" sparks 30 [sparksound "…" sparkvolume 80]>> (окно «Радио», ответ 1).
	// На экране — <<sg-radio "Имя" [size N]>>: каркас С2 линиями (SVG), кнопки и окна поверх.
	// Звучит общий плеер «Музыки»: радио — его пульт.
	var radioCollect = null;
	var radioTable = null;
	// Порядок видов в пассаже «Радио» — порядок радио в игре (сессия 30).
	var radioOrder = [];
	var radioItems = [];
	var radioTimer = null;
	var ambItems = [];
	var ambTipCount = 5000;
	var svgNS = 'http://www.w3.org/2000/svg';

	Macro.add('sg-radio-view', {
		handler: function () {
			if (radioCollect) {
				radioCollect.push(blockArgs(this, ['name'], ['type', 'frame', 'elements', 'label', 'sparks', 'sparksound', 'sparkvolume',
					'noise', 'noisevolume', 'noiseranges', 'jam', 'jamsmin', 'jamsmax', 'incoming', 'catch',
					'buttons', 'power', 'scale', 'catalog', 'inner', 'lamp', 'decoder'], []));
			}
		}
	});

	function radioViews() {
		if (radioTable !== null) {
			return radioTable;
		}

		var list = [];

		radioCollect = list;
		Story.filter(function (p) {
			return p.tags.indexOf('sg-radio') !== -1;
		}).forEach(function (p) {
			try {
				new Wikifier(document.createDocumentFragment(), p.text);
			} catch (e) {
				console.error('СИГНАЛЫ: радио', e);
			}
		});
		radioCollect = null;
		radioTable = {};
		radioOrder = [];
		list.forEach(function (a) {
			var name = String(a.name === undefined ? '' : a.name);

			if (!radioTable[name]) {
				radioOrder.push(name);
			}
			radioTable[name] = {
				name: name,
				type: a.type === 'fixed' || a.type === 'reverse' || a.type === 'decoder' ? a.type : 'broken',
				frame: String(a.frame || '#c9a24a'),
				elements: String(a.elements || '#39ff7a'),
				label: a.label === undefined ? 'ОРБИТА-3' : String(a.label),
				// Сессия 29: свои цвета частей; нет — как у элементов (внутренний каркас — как у каркаса).
				buttons: a.buttons ? String(a.buttons) : '',
				power: a.power ? String(a.power) : '',
				scale: a.scale ? String(a.scale) : '',
				catalog: a.catalog ? String(a.catalog) : '',
				inner: a.inner ? String(a.inner) : '',
				lamp: a.lamp ? String(a.lamp) : '',
				decoder: a.decoder ? String(a.decoder) : '',
				sparks: Math.max(0, Math.min(100, musNum(a.sparks, 30))),
				sound: a.sparksound ? String(a.sparksound) : '',
				volume: Math.max(0, Math.min(100, musNum(a.sparkvolume, 80))),
				// Эфир (шаг 7.3): белый шум и где он звучит, помехи и сколько их выпадает,
				// сообщение строки, сколько секунд держать точную настройку.
				noise: a.noise ? String(a.noise) : '',
				noiseVolume: Math.max(0, Math.min(100, musNum(a.noisevolume, 60))),
				noiseRanges: airRanges(a.noiseranges === undefined ? '88-108' : String(a.noiseranges)),
				jams: String(a.jam || '').split(';').map(function (part) {
					var f = part.split('|').map(function (x) {
						return x.trim();
					});

					return {
						src: f[0],
						width: Math.max(0.1, Math.min(20, musNum(f[1], 1))),
						volume: Math.max(0, Math.min(100, musNum(f[2], 80)))
					};
				}).filter(function (j) {
					return j.src;
				}),
				jamsMin: Math.max(0, Math.round(musNum(a.jamsmin, 4))),
				jamsMax: Math.max(0, Math.round(musNum(a.jamsmax, 5))),
				incoming: a.incoming === undefined ? 'ВХОДЯЩАЯ ПЕРЕДАЧА' : String(a.incoming),
				catchTime: Math.max(1, musNum(a['catch'], 10))
			};
		});
		return radioTable;
	}

	// «88-95, 101.5-108» → [[880, 950], [1015, 1080]] (десятые доли МГц).
	function airRanges(value) {
		var out = [];
		var re = /(\d+(?:\.\d+)?)\s*[-–—]\s*(\d+(?:\.\d+)?)/g;
		var m;

		while ((m = re.exec(value))) {
			if (Number(m[2]) > Number(m[1])) {
				out.push([Math.round(Number(m[1]) * 10), Math.round(Number(m[2]) * 10)]);
			}
		}
		return out;
	}

	function svgEl(tag, attrs, parent) {
		var node = document.createElementNS(svgNS, tag);

		Object.keys(attrs).forEach(function (key) {
			node.setAttribute(key, attrs[key]);
		});
		if (parent) {
			parent.appendChild(node);
		}
		return node;
	}

	// Каркас С2 в квадрате 1000×1000: рама с разошедшимся углом и щелью сверху,
	// трещина справа, перегородка с изломом, динамик справа сверху. Искры — в щели,
	// на конце трещины и на изломе перегородки.
	function radioFrame(view) {
		var svg = svgEl('svg', {viewBox: '0 0 1000 1000', 'class': 'sg-r-frame', 'aria-hidden': 'true'});
		var segs = [];
		var sparks = [];

		function seg(tag, attrs) {
			attrs['class'] = (attrs['class'] || 'sg-r-fr') + ' sg-r-seg';
			segs.push(svgEl(tag, attrs, svg));
		}

		seg('polyline', {points: '292,14 14,14 14,986 986,986 986,66'});
		seg('polyline', {points: '322,24 974,24 974,48'});
		seg('line', {x1: 292, y1: 14, x2: 306, y2: 27});
		seg('polyline', {points: '660,132 660,560 672,576 664,986', 'class': 'sg-r-thin'});
		seg('polyline', {points: '986,688 956,708 972,730 940,752', 'class': 'sg-r-crack'});

		var grille = svgEl('g', {'class': 'sg-r-grille'}, svg);

		svgEl('rect', {x: 686, y: 140, width: 276, height: 140, 'class': 'sg-r-thin'}, grille);
		for (var y = 156; y < 272; y += 15) {
			for (var x = 702; x < 952; x += 15) {
				svgEl('circle', {cx: x, cy: y, r: 2.6}, grille);
			}
		}
		if (view.label) {
			var text = svgEl('text', {x: 690, y: 968, 'class': 'sg-r-label'}, svg);

			text.textContent = view.label;
		}
		[[304, 20], [940, 752], [668, 568]].forEach(function (p) {
			var g = svgEl('g', {'class': 'sg-r-spark'}, svg);

			for (var a = 0; a < 6; a++) {
				var ang = a * 1.047 + 0.3;
				var len = 12 + (a % 2) * 12;

				svgEl('line', {x1: p[0], y1: p[1], x2: p[0] + Math.cos(ang) * len, y2: p[1] + Math.sin(ang) * len}, g);
			}
			svgEl('circle', {cx: p[0], cy: p[1], r: 4.5}, g);
			sparks.push(g);
		});
		return {svg: svg, segs: segs, sparks: sparks};
	}

	// Каркас Р2 (шаг 7.3) в квадрате 1000×1000: целая рама, под строкой — линия, под
	// шкалой частот — вторая; винты внизу по углам и заплатка между ними.
	function radioFrameFixed(view) {
		var svg = svgEl('svg', {viewBox: '0 0 1000 1000', 'class': 'sg-r-frame', 'aria-hidden': 'true'});

		svgEl('rect', {x: 14, y: 14, width: 972, height: 972, 'class': 'sg-r-fr'}, svg);
		svgEl('line', {x1: 14, y1: 136, x2: 986, y2: 136, 'class': 'sg-r-thin'}, svg);
		svgEl('line', {x1: 14, y1: 338, x2: 986, y2: 338, 'class': 'sg-r-thin'}, svg);
		[[40, 962], [960, 962]].forEach(function (p) {
			svgEl('circle', {cx: p[0], cy: p[1], r: 9, 'class': 'sg-r-fr'}, svg);
			svgEl('line', {x1: p[0] - 5, y1: p[1] - 5, x2: p[0] + 5, y2: p[1] + 5, 'class': 'sg-r-thin'}, svg);
			svgEl('line', {x1: p[0] - 5, y1: p[1] + 5, x2: p[0] + 5, y2: p[1] - 5, 'class': 'sg-r-thin'}, svg);
		});
		svgEl('rect', {x: 420, y: 950, width: 150, height: 24, 'class': 'sg-r-thin sg-r-patch'}, svg);
		[[428, 958], [562, 958], [428, 966], [562, 966]].forEach(function (p) {
			svgEl('circle', {cx: p[0], cy: p[1], r: 2.4, 'class': 'sg-r-rivet'}, svg);
		});
		if (view.label) {
			var text = svgEl('text', {x: 812, y: 90, 'class': 'sg-r-label'}, svg);

			text.textContent = view.label;
		}
		return {svg: svg, segs: [], sparks: []};
	}

	// Каркас В2 (шаг 7.4) в квадрате 1000×1000: целая рама, под строкой — линия; слева
	// сверху — окно с катушками (крутятся, пока трек играет, при реверсе — назад), под
	// ним и шкалами — вторая линия; винты внизу по углам.
	function radioFrameReverse(view) {
		var svg = svgEl('svg', {viewBox: '0 0 1000 1000', 'class': 'sg-r-frame', 'aria-hidden': 'true'});
		var reels = [];

		svgEl('rect', {x: 14, y: 14, width: 972, height: 972, 'class': 'sg-r-fr'}, svg);
		svgEl('line', {x1: 14, y1: 136, x2: 986, y2: 136, 'class': 'sg-r-thin'}, svg);
		svgEl('line', {x1: 14, y1: 350, x2: 986, y2: 350, 'class': 'sg-r-thin'}, svg);
		svgEl('rect', {x: 30, y: 152, width: 270, height: 184, rx: 14, 'class': 'sg-r-thin'}, svg);
		[106, 224].forEach(function (cx) {
			var cy = 236;

			svgEl('circle', {cx: cx, cy: cy, r: 52, 'class': 'sg-r-reelrim'}, svg);

			var g = svgEl('g', {'class': 'sg-r-reel'}, svg);

			svgEl('circle', {cx: cx, cy: cy, r: 18, 'class': 'sg-r-thin'}, g);
			for (var a = 0; a < 3; a++) {
				var ang = a * 2.094 - 1.571;

				svgEl('line', {x1: cx + Math.cos(ang) * 18, y1: cy + Math.sin(ang) * 18, x2: cx + Math.cos(ang) * 44, y2: cy + Math.sin(ang) * 44, 'class': 'sg-r-thin'}, g);
			}
			reels.push({g: g, cx: cx, cy: cy});
		});
		svgEl('line', {x1: 106, y1: 288, x2: 224, y2: 288, 'class': 'sg-r-thin'}, svg);
		[[40, 962], [960, 962]].forEach(function (p) {
			svgEl('circle', {cx: p[0], cy: p[1], r: 9, 'class': 'sg-r-fr'}, svg);
			svgEl('line', {x1: p[0] - 5, y1: p[1] - 5, x2: p[0] + 5, y2: p[1] + 5, 'class': 'sg-r-thin'}, svg);
			svgEl('line', {x1: p[0] - 5, y1: p[1] + 5, x2: p[0] + 5, y2: p[1] - 5, 'class': 'sg-r-thin'}, svg);
		});
		if (view.label) {
			// Надпись прижата к правому краю: «ОРБИТА-РЕВЕРС» длиннее «ОРБИТА-3М».
			var text = svgEl('text', {x: 966, y: 90, 'text-anchor': 'end', 'class': 'sg-r-label'}, svg);

			text.textContent = view.label;
		}
		return {svg: svg, segs: [], sparks: [], reels: reels};
	}

	// Каркас Д2 (сессия 30) в квадрате 1000×1000: целая рама, под строкой — линия, над
	// каталогом — вторая; справа — окно катушек; винты внизу справа (слева внизу — каталог).
	function radioFrameDecoder(view) {
		var svg = svgEl('svg', {viewBox: '0 0 1000 1000', 'class': 'sg-r-frame', 'aria-hidden': 'true'});
		var reels = [];

		svgEl('rect', {x: 14, y: 14, width: 972, height: 972, 'class': 'sg-r-fr'}, svg);
		svgEl('line', {x1: 14, y1: 136, x2: 986, y2: 136, 'class': 'sg-r-thin'}, svg);
		svgEl('line', {x1: 14, y1: 596, x2: 986, y2: 596, 'class': 'sg-r-thin'}, svg);
		svgEl('rect', {x: 770, y: 268, width: 194, height: 132, rx: 12, 'class': 'sg-r-thin'}, svg);
		[818, 916].forEach(function (cx) {
			var cy = 334;

			svgEl('circle', {cx: cx, cy: cy, r: 40, 'class': 'sg-r-reelrim'}, svg);

			var g = svgEl('g', {'class': 'sg-r-reel'}, svg);

			svgEl('circle', {cx: cx, cy: cy, r: 13, 'class': 'sg-r-thin'}, g);
			for (var a = 0; a < 3; a++) {
				var ang = a * 2.094 - 1.571;

				svgEl('line', {x1: cx + Math.cos(ang) * 13, y1: cy + Math.sin(ang) * 13, x2: cx + Math.cos(ang) * 33, y2: cy + Math.sin(ang) * 33, 'class': 'sg-r-thin'}, g);
			}
			reels.push({g: g, cx: cx, cy: cy});
		});
		svgEl('line', {x1: 818, y1: 374, x2: 916, y2: 374, 'class': 'sg-r-thin'}, svg);
		[[662, 962], [960, 962]].forEach(function (p) {
			svgEl('circle', {cx: p[0], cy: p[1], r: 9, 'class': 'sg-r-fr'}, svg);
			svgEl('line', {x1: p[0] - 5, y1: p[1] - 5, x2: p[0] + 5, y2: p[1] + 5, 'class': 'sg-r-thin'}, svg);
			svgEl('line', {x1: p[0] - 5, y1: p[1] + 5, x2: p[0] + 5, y2: p[1] - 5, 'class': 'sg-r-thin'}, svg);
		});
		if (view.label) {
			var text = svgEl('text', {x: 966, y: 90, 'text-anchor': 'end', 'class': 'sg-r-label'}, svg);

			text.textContent = view.label;
		}
		return {svg: svg, segs: [], sparks: [], reels: reels};
	}

	// Места частей радио в долях 1000: [x, y, ширина, высота].
	var radioPlaces = {
		// Сессия 30: у всех радио — полоса прогресса (prog) и «СЛУЧАЙНО» (shuffle).
		broken: {
			mq: [36, 40, 928, 82], cat: [36, 136, 600, 740], prog: [36, 890, 600, 60], cap: [686, 300, 276, 30],
			minus: [686, 340, 64, 84], digits: [762, 340, 124, 84], plus: [898, 340, 64, 84],
			play: [686, 470, 84, 84], pause: [782, 470, 84, 84], stop: [878, 470, 84, 84],
			auto: [686, 590, 276, 52], shuffle: [686, 654, 276, 52], power: [686, 760, 276, 150]
		},
		fixed: {
			mq: [36, 36, 760, 82], scan: [36, 152, 116, 172], scale: [164, 152, 594, 172],
			freq: [770, 152, 194, 84], fminus: [770, 248, 92, 76], fplus: [872, 248, 92, 76],
			cat: [36, 352, 600, 500], prog: [36, 868, 600, 60], cap: [686, 362, 276, 30],
			minus: [686, 400, 64, 84], digits: [762, 400, 124, 84], plus: [898, 400, 64, 84],
			play: [686, 520, 84, 84], pause: [782, 520, 84, 84], stop: [878, 520, 84, 84],
			auto: [686, 630, 276, 50], shuffle: [686, 690, 276, 50], power: [686, 766, 276, 150]
		},
		reverse: {
			mq: [36, 36, 712, 82], scan: [316, 152, 96, 110], scale: [424, 152, 360, 110],
			freq: [796, 152, 168, 60], fminus: [796, 218, 78, 44], fplus: [886, 218, 78, 44],
			prog: [316, 276, 648, 60],
			cat: [36, 366, 560, 576], cap: [620, 372, 344, 30],
			minus: [620, 406, 70, 80], digits: [702, 406, 180, 80], plus: [894, 406, 70, 80],
			play: [620, 504, 102, 80], pause: [741, 504, 102, 80], stop: [862, 504, 102, 80],
			rev: [620, 602, 344, 84], auto: [620, 706, 166, 58], shuffle: [798, 706, 166, 58], power: [620, 784, 344, 150]
		},
		// Сессия 30: радио с декодером (Д2) — окно картинки и ДЕКОД слева сверху.
		decoder: {
			mq: [36, 36, 712, 82], dec: [36, 152, 360, 360], decbtn: [36, 524, 360, 56],
			scan: [412, 152, 100, 104], scale: [524, 152, 440, 104],
			freq: [412, 268, 170, 60], fminus: [594, 268, 76, 60], fplus: [682, 268, 76, 60],
			prog: [412, 340, 346, 60], cap: [412, 416, 260, 28],
			minus: [412, 450, 72, 70], digits: [496, 450, 124, 70], plus: [632, 450, 72, 70],
			play: [720, 450, 74, 70], pause: [805, 450, 74, 70], stop: [890, 450, 74, 70],
			rev: [412, 524, 552, 56], cat: [36, 612, 590, 352],
			auto: [642, 612, 322, 50], shuffle: [642, 672, 322, 50], power: [642, 742, 322, 150]
		}
	};

	function radioAt(parent, tag, cls, place) {
		return radioBox(parent, tag, cls, place[0], place[1], place[2], place[3]);
	}

	// Элемент поверх каркаса: место и размер — в долях 1000 (var(--u) = сторона / 1000).
	function radioBox(parent, tag, cls, x, y, w, h) {
		var el = document.createElement(tag);

		el.className = cls;
		el.style.left = 'calc(var(--u) * ' + x + ')';
		el.style.top = 'calc(var(--u) * ' + y + ')';
		el.style.width = 'calc(var(--u) * ' + w + ')';
		if (h) {
			el.style.height = 'calc(var(--u) * ' + h + ')';
		}
		if (tag === 'button') {
			el.type = 'button';
		}
		parent.appendChild(el);
		return el;
	}

	function radioState() {
		return preview ? {playing: false, cur: '', auto: music().auto, vol: music().volume, pos: {}, last: {}, from: {}} : musState();
	}

	// Папки радио на уровне dir ('' — верхний), в которых есть что показать (ответ 1Б).
	function radioFolders(dir) {
		return music().folders.filter(function (f) {
			return f.section === 'radio' && f.parent === (dir || '') && musDeep(f);
		});
	}

	// Что играет — для бегущей строки радио и строки Атмосферы.
	function musNowText(ambient) {
		var st = radioState();
		var t = music().byId[st.cur];

		if (!t) {
			return ambient ? 'Тишина' : '■ ТИШИНА';
		}
		if (ambient) {
			return (st.playing ? 'Сейчас: ' : 'Пауза: ') + t.name + ' — ' + t.folder.name;
		}
		if (mus.rev && mus.rev.err) {
			return '◀◀ РЕВЕРС НЕДОСТУПЕН   ·   ' + t.name;
		}
		return (mus.rev ? '◀◀ РЕВЕРС: ' : st.playing ? '▶ СЕЙЧАС ИГРАЕТ: ' : '❚❚ ПАУЗА: ') + t.name + '   ·   ПАПКА «' + t.folder.name + '»';
	}

	// Каталог как файловая система старого терминала (ответ 3): папки → переход
	// внутрь, первая строка — «◄ ..» на уровень выше; всё прокручивается в своей
	// рамке и не выходит поверх других частей радио.
	function radioCatalog(item) {
		var st = radioState();
		var folder = item.dir ? musFolder(item.dir) : null;

		// Папки не стало или в ней пусто — на уровень выше, где есть что показать.
		while (item.dir && !(folder && folder.section === 'radio' && musDeep(folder))) {
			item.dir = folder ? folder.parent : '';
			folder = item.dir ? musFolder(item.dir) : null;
		}

		var folders = radioFolders(item.dir);
		var tracks = folder ? folder.tracks.filter(musVisible) : [];
		var key = [item.dir, st.cur, st.playing].concat(folders.map(function (f) { return f.name; }), tracks.map(function (t) { return t.id; })).join('|');

		if (key === item.catKey) {
			return;
		}
		item.catKey = key;
		item.path.textContent = 'КАТАЛОГ  /' + (item.dir ? item.dir + '/' : '');

		var list = item.list;

		$(list).empty();

		function line(mark, name, side, cls, action) {
			var b = document.createElement('button');
			var m = document.createElement('span');
			var n = document.createElement('span');
			var s = document.createElement('span');

			b.type = 'button';
			b.className = 'sg-r-line' + (cls ? ' ' + cls : '');
			m.className = 'sg-r-mark';
			m.textContent = mark;
			n.className = 'sg-r-name';
			n.textContent = name;
			s.className = 'sg-r-side';
			s.textContent = side;
			b.appendChild(m);
			b.appendChild(n);
			b.appendChild(s);
			$(b).on('click', action);
			list.appendChild(b);
			return b;
		}

		var cur = music().byId[st.cur];

		function dirLine(f) {
			var here = cur && (cur.folder === f || cur.folder.name.indexOf(f.name + '/') === 0);

			line(here ? (st.playing ? '▶' : '❚❚') : '▸', f.name.slice(f.name.lastIndexOf('/') + 1), '<DIR>', 'sg-r-dir', function () {
				item.dir = f.name;
				radioCatalog(item);
				list.scrollTop = 0;
			});
		}

		if (item.dir) {
			line('◄', '..', '', 'sg-r-up', function () {
				item.dir = folder.parent;
				radioCatalog(item);
				list.scrollTop = 0;
			});
			// Как в файловой системе: сначала папки, потом треки.
			folders.forEach(dirLine);
			tracks.forEach(function (t) {
				var cur = t.id === st.cur;

				line(cur ? (st.playing ? '▶' : '❚❚') : '', t.name, '', cur ? 'sg-r-cur' : '', function () {
					if (preview) {
						return;
					}

					var now = radioState();

					if (now.cur !== t.id || !now.playing) {
						musPlay(t.id);
					}
				});
			});
		} else if (folders.length) {
			folders.forEach(dirLine);
		} else {
			line('', '— ПУСТО —', '', 'sg-r-empty', function () {});
		}
		// Поймали передачу (сессия 29): каталог в её папке, строка трека видна.
		if (item.scrollCur) {
			item.scrollCur = false;

			var curLine = list.querySelector('.sg-r-cur');

			if (curLine) {
				list.scrollTop = Math.max(0, curLine.offsetTop - list.offsetTop - list.clientHeight / 3);
			}
		}
	}

	function radioMarquee(item) {
		var text = item.scale ? airMarquee(item) : musNowText(false);

		if (text === item.mqText && item.mqWidth === item.mq.clientWidth) {
			return;
		}
		item.mqText = text;
		item.mqWidth = item.mq.clientWidth;
		item.mqLine.textContent = text;
		item.mqLine.style.animation = 'none';
		item.mqLine.classList.remove('sg-r-run');

		var width = item.mqLine.scrollWidth;

		if (width > item.mq.clientWidth) {
			// Не помещается — бежит по кругу, как строка новостей.
			var gap = '\u00a0\u00a0\u00a0\u00a0✦\u00a0\u00a0\u00a0\u00a0';

			item.mqLine.textContent = text + gap + text + gap;
			item.mqLine.classList.add('sg-r-run');
			item.mqLine.style.animation = 'sg-r-run ' + Math.max(4, (item.mqLine.scrollWidth / 2) / (90 * item.unit)) + 's linear infinite';
		}
	}

	function radioDraw(item) {
		var st = radioState();
		var cur = music().byId[st.cur];
		var radioCur = cur && cur.folder.section === 'radio';

		radioCatalog(item);
		radioMarquee(item);
		if (item.scale) {
			airDraw(item);
			// Поиск включён, а эфир ещё не звучит (вернулись на экран) — запустить.
			if (!preview && !airTimer && st.scan) {
				airTick();
			}
		}
		item.play.classList.toggle('sg-r-lit', !!(st.playing && cur));
		item.pause.classList.toggle('sg-r-lit', !!(!st.playing && cur && radioCur));
		item.auto.classList.toggle('sg-r-lit', !!st.auto);
		item.shuffle.classList.toggle('sg-r-lit', !!st.rshuffle);
		progDraw(item);
		if (item.decBox) {
			decDraw(item);
		}
	}

	function radioDrawAll() {
		radioItems = radioItems.filter(function (item) {
			return item.el.isConnected || !item.placed;
		});
		radioItems.forEach(function (item) {
			if (item.el.isConnected) {
				item.placed = true;
				radioFit(item);
				radioDraw(item);
			}
		});
	}

	// Квадрат под поле игры (решение 125): сторона — меньшее из ширины и высоты
	// поля без отступов; size — своя сторона.
	function radioFit(item) {
		var side = item.size;

		if (!side) {
			var box = document.getElementById('passages');

			if (!box) {
				return;
			}

			var cs = getComputedStyle(box);
			var w = box.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
			var h = box.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);

			side = Math.max(300, Math.floor(Math.min(w, h)) - 4);
		}
		if (side !== item.side) {
			item.side = side;
			item.unit = side / 1000;
			item.el.style.width = side + 'px';
			item.el.style.height = side + 'px';
			item.el.style.setProperty('--u', side / 1000 + 'px');
			item.mqText = null;
		}
	}

	// Искры (ответ 2А): в случайный момент вспыхивает одна из искр, дрожит линия каркаса,
	// звучит звук искры. Частота — ползунок вида: 0 — нет, 100 — часто.
	function radioSpark(item) {
		if (item.view.type !== 'broken' || !item.view.sparks || !item.el.isConnected && item.placed) {
			return;
		}

		var mean = 12000 / (1 + item.view.sparks / 8);

		item.sparkTimer = setTimeout(function () {
			if (!item.el.isConnected) {
				if (item.placed) {
					return;
				}
				radioSpark(item);
				return;
			}

			var spark = item.frame.sparks[Math.floor(Math.random() * item.frame.sparks.length)];
			var seg = item.frame.segs[Math.floor(Math.random() * item.frame.segs.length)];

			[spark, seg].forEach(function (node, i) {
				var cls = i ? 'sg-r-jit' : 'sg-r-on';

				node.classList.remove(cls);
				void node.getBoundingClientRect();
				node.classList.add(cls);
			});
			if (item.view.sound && !preview) {
				signalPlay(item.view.sound, item.view.volume);
			}
			radioSpark(item);
		}, mean * (0.4 + Math.random() * 1.2));
	}

	/* ----- Эфир отремонтированного радио (шаг 7.3) ----- */

	// Шкала 88,0–108,0 МГц, шаг 0,1; частота хранится в десятых: $sgMusic.freq = 980.
	// Передачи — треки раздела «Эфир» окна «Музыка» (ответ 3А), помехи и белый шум — у вида
	// (ответ 6). При каждом входе на экран передачи и выпавшие помехи встают в случайные
	// места шкалы. Слышно в пределах своей ширины: чем ближе — тем громче, остальные и шум
	// тише; в ±0,1 МГц — только ближайшая (ответ 4А). Точная настройка, удержанная catch
	// секунд, — передача поймана: она в каталоге в своей папке и продолжает звучать уже
	// как трек каталога, на 10 тише, через 10 с плавно громче. «ПОИСК» ставит каталог на
	// паузу, выключенный — эфир молчит (ответ 7А).
	var airItems = [];
	var airTimer = null;
	var airLo = 880;
	var airHi = 1080;

	function airX(f10) {
		return 18 + (f10 - airLo) / (airHi - airLo) * 552;
	}

	function airFreq() {
		var st = radioState();
		var f = Math.round(Number(st.freq));

		return f >= airLo && f <= airHi ? f : 980;
	}

	function airText(f10) {
		return (f10 / 10).toFixed(1);
	}

	// Передачи, которые сейчас в эфире: условие верно, ещё не пойманы (помехи — всегда).
	function airTracks() {
		var caught = preview ? {} : musState().caught;

		return music().air.filter(function (t) {
			return (t.only || !caught[t.id]) && musCond(t);
		});
	}

	// Непойманные передачи, которые попадут в каталог: для сообщения строки (ответ 5А).
	function airPending() {
		return airTracks().filter(function (t) {
			return !t.only;
		});
	}

	// Свободное место на шкале: от 88,5 до 107,5, не ближе 0,6 МГц к другим точкам.
	function airSpot(taken) {
		var best = 0;

		for (var n = 0; n < 200; n++) {
			var c = 885 + Math.floor(Math.random() * 191);

			best = c;
			if (taken.every(function (x) {
				return Math.abs(x - c) >= 6;
			})) {
				break;
			}
		}
		taken.push(best);
		return best;
	}

	// Расстановка при входе на экран: передачи и случайный набор помех.
	// Сессия 30: какие помехи могут выпасть. mine — этого радио, fresh — ещё не пойманные этого
	// радио и радио выше в окне «Радио» (по порядку видов).
	function airJamPool(view) {
		var caught = preview ? {} : musState().caught;
		var byView = music().jamsByView;
		var order = radioOrder.filter(function (n) {
			return radioViews()[n].type !== 'broken';
		});
		var at = order.indexOf(view.name);
		var mine = (byView[view.name] || []).filter(musCond);
		var all = mine.slice();

		order.slice(0, Math.max(0, at)).forEach(function (n) {
			all = all.concat((byView[n] || []).filter(musCond));
		});
		return {
			caught: mine.filter(function (t) {
				return caught[t.id];
			}),
			fresh: all.filter(function (t) {
				return !caught[t.id];
			})
		};
	}

	function airTake(list) {
		return list.splice(Math.floor(Math.random() * list.length), 1)[0];
	}

	// Расстановка при входе на экран: передачи и случайный набор помех — одна уже пойманная
	// этого радио, остальные ещё не пойманные; не хватает — ещё пойманные этого радио.
	function airLayout(item) {
		var view = item.view;
		var taken = [];
		var pool = airJamPool(view);
		var lo = Math.min(view.jamsMin, view.jamsMax);
		var want = lo + Math.floor(Math.random() * (Math.abs(view.jamsMax - view.jamsMin) + 1));
		var picked = [];

		if (want > 0 && pool.caught.length) {
			picked.push(airTake(pool.caught));
		}
		while (picked.length < want && pool.fresh.length) {
			picked.push(airTake(pool.fresh));
		}
		while (picked.length < want && pool.caught.length) {
			picked.push(airTake(pool.caught));
		}
		item.srcs = [];
		airTracks().forEach(function (t) {
			item.srcs.push({kind: 'tx', t: t, c: airSpot(taken), w: t.width * 10, base: t.gain / 100});
		});
		picked.forEach(function (t) {
			item.srcs.push({kind: 'jam', t: t, src: t.src, c: airSpot(taken), w: t.width * 10, base: t.gain / 100});
		});
		item.taken = taken;
	}

	// Передача появилась (условие стало верным) или ушла — шкала следит сама.
	function airSync(item) {
		var now = airTracks();

		item.srcs = item.srcs.filter(function (s) {
			if (s.kind !== 'tx' || now.indexOf(s.t) !== -1) {
				return true;
			}
			airMute(s);
			return false;
		});
		now.forEach(function (t) {
			if (!item.srcs.some(function (s) {
				return s.t === t;
			})) {
				item.srcs.push({kind: 'tx', t: t, c: airSpot(item.taken), w: t.width * 10, base: t.gain / 100});
			}
		});
	}

	function airMute(s) {
		if (s.audio) {
			s.audio.pause();
			s.audio = null;
		}
	}

	function airStop() {
		airItems.forEach(function (item) {
			(item.srcs || []).forEach(airMute);
			airMute(item.noise || {});
			item.hold = null;
			if (item.lamp) {
				item.lamp.classList.remove('sg-r-lamp-on');
			}
		});
		if (airTimer) {
			clearInterval(airTimer);
			airTimer = null;
		}
	}

	function airAudio(s, src) {
		if (!s.audio) {
			s.audio = new Audio(src);
			s.audio.loop = true;
			s.audio.preload = 'auto';
			s.audio.volume = 0;
			s.audio.play().catch(function () {});
		}
		return s.audio;
	}

	// Слышимость точки на частоте f: 1 — на точке, 0 — за краем её ширины.
	function airNear(s, f) {
		return Math.max(0, 1 - Math.abs(f - s.c) / s.w);
	}

	// Белый шум: 1 внутри своих диапазонов, к краю — плавно за 0,3 МГц.
	function airNoiseAt(view, f) {
		var k = 0;

		view.noiseRanges.forEach(function (r) {
			var out = f < r[0] ? r[0] - f : f > r[1] ? f - r[1] : 0;

			k = Math.max(k, 1 - out / 3);
		});
		return k;
	}

	// Каждые 0,1 с, пока включён поиск: громкости, удержание точной настройки, поимка.
	function airTick() {
		if (preview) {
			return;
		}

		var st = musState();
		var live = airItems.filter(function (item) {
			return item.el.isConnected;
		});

		if (!st.scan || !live.length) {
			airStop();
			return;
		}
		if (!airTimer) {
			airTimer = setInterval(airTick, 100);
		}

		var master = st.vol / 99 * mus.duck;
		var f = airFreq();

		live.forEach(function (item) {
			var view = item.view;
			var top = null;
			var best = 0;
			var exact = null;

			airSync(item);
			item.srcs.forEach(function (s) {
				var k = airNear(s, f);

				if (k > best) {
					best = k;
					top = s;
				}
				if (Math.abs(f - s.c) <= 1 && (!exact || Math.abs(f - s.c) < Math.abs(f - exact.c))) {
					exact = s;
				}
			});
			item.srcs.forEach(function (s) {
				var k = airNear(s, f);
				var v = exact ? (s === exact ? 1 : 0) : s === top ? k : k * (1 - best);

				if (v > 0 || s.audio) {
					airAudio(s, s.kind === 'tx' ? s.t.src : s.src).volume = Math.max(0, Math.min(1, master * s.base * v));
				}
			});
			if (view.noise) {
				item.noise = item.noise || {};
				airAudio(item.noise, view.noise).volume = Math.max(0, Math.min(1, exact ? 0 : master * view.noiseVolume / 100 * airNoiseAt(view, f) * (1 - best)));
			}

			// Точная настройка на передачу, которая попадёт в каталог (ответ 4А), или на ещё не
			// пойманную помеху (сессия 30: помехи ловятся так же).
			var catchable = exact && (exact.kind === 'tx' ? !exact.t.only : !st.caught[exact.t.id]);
			var aim = catchable && f === exact.c ? exact : null;

			// Сессия 29: лампочка — точно на передаче и встали кнопками (не иглой).
			item.lamp.classList.toggle('sg-r-lamp-on', !!(aim && item.byButton));

			if (!aim) {
				item.hold = null;
			} else if (!item.hold || item.hold.s !== aim) {
				item.hold = {s: aim, since: Date.now()};
			} else if (Date.now() - item.hold.since >= view.catchTime * 1000) {
				airCatch(item, aim);
			}
		});
	}

	// Поймана: передача в каталоге и звучит дальше как трек каталога — на 10 тише,
	// через 10 с плавно до общей громкости (ТЗ, раздел 4).
	function airCatch(item, s) {
		var st = musState();
		var t = s.t;
		var audio = airAudio(s, t.src);

		s.audio = null;
		item.srcs.splice(item.srcs.indexOf(s), 1);
		st.caught[t.id] = 1;
		st.seen[t.id] = 1;
		st.scan = false;
		airStop();
		musHalt(true);
		audio.loop = false;
		audio.addEventListener('ended', function () {
			if (mus.audio === audio) {
				musEnded(t.id);
			}
		});
		mus.audio = audio;
		mus.id = t.id;
		st.cur = t.id;
		st.playing = true;
		st.last.radio = t.id;
		st.lastIn[t.folder.name] = t.id;

		// Сессия 29: на 10 тише, но не тише половины — при малой громкости (10 в шаблоне)
		// «на 10 тише» было тишиной, и казалось, что после поимки радио замолкло.
		var low = st.vol > 0 ? Math.max(st.vol - 10, st.vol / 2) / st.vol : 0;

		mus.mult = low;
		musApply();
		mus.timers.push(setTimeout(function () {
			if (mus.audio === audio) {
				mus.rise = musRamp(low, 1, 3, function (k) {
					mus.mult = k;
					musApply();
				}, function () {
					mus.rise = null;
				});
			}
		}, 10000));
		item.dir = t.folder.name;
		item.scrollCur = true;
		musChanged();
	}

	// byButton — частоту поменяли кнопками −/+ (для лампочки), а не иглой.
	function airTune(item, f10, byButton) {
		var f = Math.max(airLo, Math.min(airHi, Math.round(f10)));

		item.byButton = !!byButton;
		if (preview) {
			item.pfreq = f;
		} else {
			musState().freq = f;
			saveVars();
		}
		airDraw(item);
		airTick();
	}

	function airScan(item) {
		if (preview) {
			item.pscan = !item.pscan;
			airDraw(item);
			return;
		}

		var st = musState();

		st.scan = !st.scan;
		if (st.scan) {
			// Поиск включён — музыка каталога на паузе (ответ 7А).
			if (st.playing) {
				musPause();
			}
		}
		airTick();
		musChanged();
	}

	function airDraw(item) {
		var f = preview && item.pfreq ? item.pfreq : airFreq();
		var on = preview ? !!item.pscan : !!musState().scan;
		var text = airText(f);

		item.needle.setAttribute('transform', 'translate(' + airX(f).toFixed(2) + ' 0)');
		item.scale.classList.toggle('sg-r-scan', on);
		item.scanBtn.classList.toggle('sg-r-lit', on);
		if (text !== item.freqShown) {
			item.freqShown = text;
			var ch = ('   ' + text).slice(-5).split('');

			[0, 1, 2, 4].forEach(function (pos, i) {
				item.fcells[i].textContent = ch[pos] === ' ' ? '' : ch[pos];
			});
		}
	}

	// Строка: пока в эфире есть непойманная передача — сообщение (своё у передачи или вида),
	// за ним что играет; при поиске без передач — «ПОИСК».
	function airMarquee(item) {
		var now = musNowText(false);
		var st = radioState();
		var pending = preview ? [] : airPending();
		var own = pending.filter(function (t) {
			return t.text;
		})[0];

		if (pending.length) {
			return '◉ ' + (own ? own.text : item.view.incoming) + (st.playing ? '   ·   ' + now : '');
		}
		if (preview ? item.pscan : st.scan) {
			return '◉ ПОИСК' + (st.playing ? '   ·   ' + now : '');
		}
		return now;
	}

	function airBuild(item, el, P) {
		item.srcs = [];
		item.taken = [];

		// ПОИСК — подсветка шкалы, каталог на паузе.
		item.scanBtn = radioAt(el, 'button', 'sg-r-btn sg-r-scanbtn', P.scan);
		item.scanBtn.innerHTML = '<span>ПОИСК</span><span class="sg-r-dot"></span>';
		$(item.scanBtn).on('click', function () {
			airScan(item);
		});

		// Шкала: деления по 0,5 МГц, подписи через 2 МГц, игла тянется мышью.
		item.scale = radioAt(el, 'div', 'sg-r-box sg-r-scale', P.scale);

		var svg = svgEl('svg', {viewBox: '0 0 588 166', 'class': 'sg-r-dial', 'aria-hidden': 'true'}, item.scale);

		svgEl('rect', {x: 0, y: 0, width: 588, height: 166, 'class': 'sg-r-glass'}, svg);
		svgEl('text', {x: 14, y: 26, 'class': 'sg-r-unit'}, svg).textContent = 'МГц';
		for (var f = airLo; f <= airHi; f += 5) {
			var big = f % 10 === 0;
			var x = airX(f);

			svgEl('line', {x1: x, y1: 156, x2: x, y2: big ? 128 : 140, 'class': big ? 'sg-r-tick sg-r-big' : 'sg-r-tick'}, svg);
			if (f % 20 === 0) {
				svgEl('text', {x: x, y: 118, 'class': 'sg-r-num'}, svg).textContent = String(f / 10);
			}
		}
		item.needle = svgEl('g', {'class': 'sg-r-needle'}, svg);
		svgEl('line', {x1: 0, y1: 8, x2: 0, y2: 158}, item.needle);
		svgEl('polygon', {points: '-9,6 9,6 0,20'}, item.needle);
		// Лампочка (сессия 29): горит на точной частоте передачи, если встали на неё кнопками.
		item.lamp = svgEl('circle', {cx: 566, cy: 24, r: 10, 'class': 'sg-r-lamp'}, svg);

		var dragging = false;
		var at = function (ev) {
			var r = svg.getBoundingClientRect();
			var x = (ev.clientX - r.left) / r.width * 588;

			airTune(item, airLo + (x - 18) / 552 * (airHi - airLo), false);
		};

		$(item.scale).on('pointerdown', function (ev) {
			dragging = true;
			try {
				item.scale.setPointerCapture(ev.originalEvent.pointerId);
			} catch (e) {}
			at(ev.originalEvent);
			ev.preventDefault();
		}).on('pointermove', function (ev) {
			if (dragging) {
				at(ev.originalEvent);
			}
		}).on('pointerup pointercancel', function () {
			dragging = false;
		});

		// Окно частоты и −/+ на 0,1 МГц, не чаще раза в секунду (ответ 6А).
		var freq = radioAt(el, 'div', 'sg-r-box sg-r-digits sg-r-freq', P.freq);

		freq.style.fontFamily = timerFont(timerDefaults.font);
		item.fcells = [];
		for (var i = 0; i < 4; i++) {
			var cell = document.createElement('span');

			if (i === 3) {
				var dot = document.createElement('span');

				dot.className = 'sg-r-dotch';
				dot.textContent = '.';
				freq.appendChild(dot);
			}
			freq.appendChild(cell);
			item.fcells.push(cell);
		}

		var step = function (button, by) {
			button.textContent = by < 0 ? '−' : '+';
			button.setAttribute('aria-label', by < 0 ? 'Частота ниже' : 'Частота выше');
			$(button).on('click', function () {
				var now = Date.now();

				if (now - (item.stepAt || 0) < 1000) {
					return;
				}
				item.stepAt = now;
				[item.fminus, item.fplus].forEach(function (b) {
					b.classList.add('sg-r-wait');
				});
				setTimeout(function () {
					[item.fminus, item.fplus].forEach(function (b) {
						b.classList.remove('sg-r-wait');
					});
				}, 1000);
				airTune(item, (preview && item.pfreq ? item.pfreq : airFreq()) + by, true);
			});
		};

		item.fminus = radioAt(el, 'button', 'sg-r-btn sg-r-fbtn', P.fminus);
		item.fplus = radioAt(el, 'button', 'sg-r-btn sg-r-fbtn', P.fplus);
		step(item.fminus, -1);
		step(item.fplus, 1);
		airLayout(item);
		airDraw(item);
	}

	/* ----- Радио с реверсом (шаг 7.4): РЕВЕРС, прогресс трека, катушки ----- */

	var revItems = [];
	var revFrame = null;
	var revLast = 0;

	// Полоса прогресса без цифр времени (ответ 5Б; с сессии 30 — у всех радио).
	function progDraw(item) {
		var w = musWhere();
		var frac = preview ? (item.pfrac === undefined ? 0.35 : item.pfrac) : w && w.dur ? Math.max(0, Math.min(1, w.pos / w.dur)) : 0;
		var text = frac.toFixed(4);

		if (text !== item.progShown) {
			item.progShown = text;
			item.progFill.style.width = (frac * 100).toFixed(2) + '%';
			item.progThumb.style.left = 'calc(var(--u) * 14 + (100% - var(--u) * 28) * ' + text + ')';
		}
		item.prog.classList.toggle('sg-r-none', !preview && !w);
	}

	// Подсветка РЕВЕРСА и прогресс.
	function revDraw(item) {
		progDraw(item);
		item.revBtn.classList.toggle('sg-r-lit', preview ? !!item.pback : !!mus.rev);
	}

	// Прогресс трека: тянуть ползунок или щёлкнуть — туда; работает и на паузе.
	function progBuild(item, el, P) {
		var prog = radioAt(el, 'div', 'sg-r-prog', P.prog);
		var dragging = false;

		prog.innerHTML = '<span class="sg-r-prog-line"><span class="sg-r-prog-fill"></span></span><span class="sg-r-prog-thumb"></span>';
		item.prog = prog;
		item.progFill = prog.querySelector('.sg-r-prog-fill');
		item.progThumb = prog.querySelector('.sg-r-prog-thumb');

		var at = function (ev) {
			var r = prog.querySelector('.sg-r-prog-line').getBoundingClientRect();
			var frac = Math.max(0, Math.min(1, (ev.clientX - r.left) / Math.max(1, r.width)));

			if (preview) {
				item.pfrac = frac;
			} else {
				musSeek(frac);
			}
			item.progShown = null;
			progDraw(item);
		};

		$(prog).on('pointerdown', function (ev) {
			dragging = true;
			try {
				prog.setPointerCapture(ev.originalEvent.pointerId);
			} catch (e) {}
			at(ev.originalEvent);
			ev.preventDefault();
		}).on('pointermove', function (ev) {
			if (dragging) {
				at(ev.originalEvent);
			}
		}).on('pointerup pointercancel', function () {
			dragging = false;
		});
		progDraw(item);
	}

	// Катушки крутятся, пока трек играет; при реверсе — в обратную сторону; на паузе
	// стоят (ответ 6А). Покадрово, чтобы смена направления не дёргала рисунок.
	function revLoop(now) {
		revItems = revItems.filter(function (item) {
			return item.el.isConnected || !item.placed;
		});
		if (!revItems.length) {
			revFrame = null;
			revLast = 0;
			return;
		}

		var dt = revLast ? Math.min(0.1, (now - revLast) / 1000) : 0;
		var dir = 0;

		revLast = now;
		if (!preview) {
			if (mus.rev) {
				dir = mus.rev.ok && !mus.rev.audio.paused && !mus.rev.audio.ended ? -1 : 0;
			} else if (mus.audio && !mus.audio.paused) {
				dir = 1;
			}
		}
		revItems.forEach(function (item) {
			if (!item.el.isConnected) {
				return;
			}

			var d = preview ? (item.pback ? -1 : 0) : dir;

			if (d) {
				item.reelAngle = (item.reelAngle + d * 160 * dt + 360) % 360;
				item.frame.reels.forEach(function (rl) {
					rl.g.setAttribute('transform', 'rotate(' + item.reelAngle.toFixed(1) + ' ' + rl.cx + ' ' + rl.cy + ')');
				});
			}
			item.el.classList.toggle('sg-r-spin', !!d);
			revDraw(item);
		});
		revFrame = requestAnimationFrame(revLoop);
	}

	function revBuild(item, el, P) {
		// РЕВЕРС — держать нажатой (ответ 4А): звук нажатия — в начале.
		var btn = radioAt(el, 'button', 'sg-r-btn sg-r-revbtn', P.rev);
		var down = false;

		btn.innerHTML = '<span>◀◀ РЕВЕРС</span><small>держать нажатой</small>';
		btn.setAttribute('aria-label', 'Реверс — держать нажатой');

		var release = function () {
			if (!down) {
				return;
			}
			down = false;
			btn.classList.remove('sg-r-held');
			item.pback = false;
			revEnd();
		};

		$(btn).on('pointerdown', function (ev) {
			if (ev.originalEvent.button || down) {
				return;
			}
			down = true;
			btn.classList.add('sg-r-held');
			try {
				btn.setPointerCapture(ev.originalEvent.pointerId);
			} catch (e) {}
			uiClick(btn);
			item.pback = preview;
			revStart();
			ev.preventDefault();
		}).on('pointerup pointercancel lostpointercapture', release);
		item.revBtn = btn;
		item.reelAngle = 0;
		revItems.push(item);
		if (!revFrame) {
			revFrame = requestAnimationFrame(revLoop);
		}
		revDraw(item);
	}

	/* ----- Радио с декодером (сессия 30): ДЕКОД и окно картинки SSTV ----- */

	// Картинки SSTV программа достаёт из помех и передач при «Сохранить» в окне «Музыка»: файл
	// media/img/sstv/…png и строка <<sg-sstv "трек" stamp "…" img "…png" mode "Robot 36" at 4.911
	// line 0.15 rows 240 per 1 width 320 height 240>> в пассаже с тегом sg-sstv (игра из папки
	// прочитать звук своих файлов не может). Движок набирает картинку строка за строкой в такт
	// звуку: строка r видна, когда место трека ≥ at + (⌊r / per⌋ + 1) · line. Источник — играющий
	// трек каталога или самая слышная точка эфира с картинкой; настроились неточно — строки с
	// шумом пропорционально; звучит не SSTV — строки помех; тишина — набор стоит; трек начался
	// заново — новая картинка. Набранное живёт между экранами; сессия 33 (ответ автора 3Б): какая
	// картинка и сколько строк набрано — в автокопии ($sgMusic.decImg), после сбоя набранное
	// снова в окне, когда декодер включат (сам декодер после сбоя выключен, как раньше).
	var sstvCollect = null;
	var sstvTableCache = null;
	var decItems = [];
	var decFrame = null;
	var decLast = 0;
	var dec = {buf: null, key: '', drawn: 0, w: 320, h: 256, mode: '', gy: 0, acc: 0, noise: 0, ver: 0, state: 'idle', row: null, restored: false, pending: null, savedAt: 0};

	// Сессия 33 (3Б): набранное — в автокопию (не чаще раза в секунду и когда картинка готова).
	function decRemember(force) {
		var st = musState();
		var keep = dec.key && dec.key !== 'garbage' && dec.drawn > 0 ? {key: dec.key, drawn: dec.drawn} : null;
		var was = st.decImg || null;

		if (keep && was && was.key === keep.key && was.drawn === keep.drawn) {
			return;
		}
		if (!keep && !was) {
			return;
		}
		st.decImg = keep;

		var now = Date.now();

		if ((force || now - dec.savedAt > 1000) && setup.signaly.saveVars) {
			dec.savedAt = now;
			setup.signaly.saveVars();
		}
	}

	// После сбоя (новая страница): картинка из автокопии — до первой строки нового сигнала.
	function decRestore() {
		dec.restored = true;

		var keep = musState().decImg;

		if (!keep || typeof keep.key !== 'string') {
			return;
		}

		var at = keep.key.lastIndexOf('#');
		var list = at > 0 ? sstvFor(keep.key.slice(0, at)) : null;
		var e = list ? list[Number(keep.key.slice(at + 1))] : null;

		if (!e) {
			return;
		}
		decCanvas(e.w, e.h);
		dec.key = keep.key;
		dec.mode = e.mode;
		dec.drawn = 0;
		dec.state = 'done';
		dec.pending = {e: e, key: keep.key, drawn: Math.max(0, Math.min(e.h, Math.round(Number(keep.drawn) || 0)))};
	}

	function decPending() {
		var p = dec.pending;
		var img = p ? sstvImage(p.e) : null;

		if (!img) {
			return;
		}
		dec.pending = null;
		// Пока картинка грузилась, мог начаться новый сигнал — тогда она не нужна.
		if (dec.key !== p.key || dec.drawn > 0) {
			return;
		}
		if (p.drawn > 0) {
			dec.buf.getContext('2d').drawImage(img, 0, 0, p.e.w, p.drawn, 0, 0, p.e.w, p.drawn);
		}
		dec.drawn = p.drawn;
		dec.ver++;
	}

	Macro.add('sg-sstv', {
		handler: function () {
			if (sstvCollect) {
				sstvCollect.push(blockArgs(this, ['src'], ['stamp', 'img', 'mode', 'at', 'line', 'rows', 'per', 'width', 'height'], ['none']));
			}
		}
	});

	function sstvClean(src) {
		return String(src || '').replace(/^\.\//, '');
	}

	function sstvTable() {
		if (sstvTableCache) {
			return sstvTableCache;
		}

		var list = [];

		sstvCollect = list;
		Story.filter(function (p) {
			return p.tags.indexOf('sg-sstv') !== -1;
		}).forEach(function (p) {
			try {
				new Wikifier(document.createDocumentFragment(), p.text);
			} catch (e) {
				console.error('СИГНАЛЫ: SSTV', e);
			}
		});
		sstvCollect = null;
		sstvTableCache = {};
		list.forEach(function (a) {
			if (a.none || !a.img) {
				return;
			}

			var key = sstvClean(a.src);
			var line = musNum(a.line, 0);

			if (!(line > 0)) {
				return;
			}
			(sstvTableCache[key] = sstvTableCache[key] || []).push({
				img: String(a.img),
				mode: String(a.mode || 'SSTV'),
				at: musNum(a.at, 0),
				line: line,
				rows: Math.max(1, Math.round(musNum(a.rows, 1))),
				per: Math.max(1, Math.round(musNum(a.per, 1))),
				w: Math.max(1, Math.round(musNum(a.width, 320))),
				h: Math.max(1, Math.round(musNum(a.height, 256))),
				el: null
			});
		});
		Object.keys(sstvTableCache).forEach(function (key) {
			sstvTableCache[key].sort(function (x, y) {
				return x.at - y.at;
			});
		});
		return sstvTableCache;
	}

	function sstvFor(src) {
		return sstvTable()[sstvClean(src)] || null;
	}

	// Картинка загружена? Загружается при первом обращении.
	function sstvImage(e) {
		if (!e.el) {
			e.el = new Image();
			e.el.src = e.img;
		}
		return e.el.complete && e.el.naturalWidth > 0 ? e.el : null;
	}

	// Что сейчас слышно для декодера: {src, imgs, pos, noise}, {sound: true} (звучит не SSTV) или null.
	function decSource() {
		if (mus.rev) {
			return {sound: true};
		}
		if (mus.audio && !mus.audio.paused && !mus.audio.ended && mus.audio.volume > 0) {
			var t = music().byId[mus.id];
			var own = t ? sstvFor(t.src) : null;

			return own ? {src: t.src, imgs: own, pos: mus.audio.currentTime, noise: 0} : {sound: true};
		}

		var best = null;
		var any = false;
		var f = airFreq();

		airItems.forEach(function (item) {
			if (!item.el.isConnected) {
				return;
			}
			(item.srcs || []).forEach(function (s) {
				if (!s.audio || s.audio.paused || s.audio.volume <= 0.002) {
					return;
				}
				any = true;

				var imgs = sstvFor(s.kind === 'tx' ? s.t.src : s.src);

				if (imgs && (!best || s.audio.volume > best.vol)) {
					best = {src: s.kind === 'tx' ? s.t.src : s.src, imgs: imgs, pos: s.audio.currentTime, vol: s.audio.volume, noise: 1 - airNear(s, f)};
				}
			});
			if (item.noise && item.noise.audio && !item.noise.audio.paused && item.noise.audio.volume > 0.002) {
				any = true;
			}
		});
		if (best) {
			return {src: best.src, imgs: best.imgs, pos: best.pos, noise: Math.max(0, Math.min(1, best.noise))};
		}
		return any ? {sound: true} : null;
	}

	function decCanvas(w, h) {
		if (!dec.buf) {
			dec.buf = document.createElement('canvas');
		}
		dec.buf.width = w;
		dec.buf.height = h;
		dec.w = w;
		dec.h = h;

		var ctx = dec.buf.getContext('2d');

		ctx.fillStyle = '#000';
		ctx.fillRect(0, 0, w, h);
		dec.ver++;
	}

	// Строка шума: level — непрозрачность (0…1), garbage — строка помех (полосы и рябь).
	function decNoiseRow(y, level, garbage) {
		if (!dec.row || dec.row.width !== dec.w) {
			dec.row = document.createElement('canvas');
			dec.row.width = dec.w;
			dec.row.height = 1;
		}

		var rctx = dec.row.getContext('2d');
		var data = rctx.createImageData(dec.w, 1);
		var tint = garbage ? [Math.random() * 120, Math.random() * 120, Math.random() * 120] : [0, 0, 0];
		var band = garbage ? Math.random() * dec.w : -1;

		for (var x = 0; x < dec.w; x++) {
			var v = Math.random() * 255;
			var i = x * 4;
			var near = band >= 0 && Math.abs(x - band) < dec.w * 0.08;

			data.data[i] = near ? 255 : (v + tint[0]) % 256;
			data.data[i + 1] = near ? 255 : (v + tint[1]) % 256;
			data.data[i + 2] = near ? 255 : (v + tint[2]) % 256;
			data.data[i + 3] = 255;
		}
		rctx.putImageData(data, 0, 0);

		var ctx = dec.buf.getContext('2d');

		ctx.globalAlpha = Math.max(0, Math.min(1, level));
		ctx.drawImage(dec.row, 0, y);
		ctx.globalAlpha = 1;
	}

	function decStep(dt) {
		if (!dec.restored) {
			decRestore();
		}

		var src = decSource();

		if (!dec.buf) {
			decCanvas(320, 256);
		}
		if (dec.pending) {
			decPending();
		}
		if (!src) {
			dec.state = dec.state === 'image' || dec.state === 'done' ? 'done' : 'idle';
			return;
		}
		if (src.sound) {
			// Звучит не SSTV — строки помех, как у декодера без синхронизации (~7 строк в секунду).
			if (dec.key !== 'garbage') {
				dec.key = 'garbage';
				dec.gy = 0;
				dec.acc = 0;
				dec.pending = null;
				decRemember(true);
			}
			dec.state = 'garbage';
			dec.acc += dt * 7;
			while (dec.acc >= 1) {
				dec.acc -= 1;
				decNoiseRow(dec.gy, 1, true);
				dec.gy = (dec.gy + 1) % dec.h;
				dec.ver++;
			}
			return;
		}

		// Какая картинка трека сейчас: последняя, чей заголовок (≈1 с до первой строки) уже прозвучал.
		var index = -1;

		src.imgs.forEach(function (e, i) {
			if (src.pos >= e.at - 1) {
				index = i;
			}
		});
		if (index < 0) {
			// Тот же трек начался заново — экран чистый, ждём заголовок картинки.
			if (dec.key.indexOf(sstvClean(src.src) + '#') === 0 && dec.key !== sstvClean(src.src) + '#-1') {
				dec.key = sstvClean(src.src) + '#-1';
				dec.drawn = 0;
				dec.pending = null;
				decCanvas(dec.w, dec.h);
				decRemember(true);
			}
			dec.state = 'idle';
			return;
		}

		var e = src.imgs[index];
		var key = sstvClean(src.src) + '#' + index;
		var target = Math.max(0, Math.min(e.h, Math.floor((src.pos - e.at) / e.line) * e.per));

		// Новая картинка или трек начался заново — чистый экран.
		if (key !== dec.key || target < dec.drawn - e.per * 2) {
			dec.key = key;
			dec.drawn = 0;
			dec.mode = e.mode;
			dec.pending = null;
			decCanvas(e.w, e.h);
		}
		dec.noise = src.noise;
		dec.state = target >= e.h ? 'done' : 'image';

		var img = sstvImage(e);

		if (!img || target <= dec.drawn) {
			return;
		}

		var ctx = dec.buf.getContext('2d');

		ctx.drawImage(img, 0, dec.drawn, e.w, target - dec.drawn, 0, dec.drawn, e.w, target - dec.drawn);
		if (src.noise > 0.01) {
			for (var y = dec.drawn; y < target; y++) {
				decNoiseRow(y, src.noise, false);
			}
		}
		dec.drawn = target;
		dec.ver++;
		decRemember(target >= e.h);
	}

	function decCaption() {
		if (dec.state === 'image') {
			return dec.mode.toUpperCase() + '  ·  ' + Math.round(dec.drawn / dec.h * 100) + '%';
		}
		if (dec.state === 'done') {
			return dec.mode.toUpperCase();
		}
		if (dec.state === 'garbage') {
			return 'НЕТ СИНХРОНИЗАЦИИ';
		}
		return 'ЖДУ СИГНАЛ';
	}

	// Предпросмотр: цветные полосы набраны наполовину, чтобы было видно окно.
	function decDemo(item) {
		var c = item.decCanvas;
		var ctx = c.getContext('2d');
		var colors = ['#c0c0c0', '#c0c000', '#00c0c0', '#00c000', '#c000c0', '#c00000', '#0000c0'];

		c.width = 320;
		c.height = 256;
		ctx.fillStyle = '#000';
		ctx.fillRect(0, 0, 320, 256);
		colors.forEach(function (col, i) {
			ctx.fillStyle = col;
			ctx.fillRect(Math.round(i * 320 / 7), 0, Math.ceil(320 / 7), 150);
		});
	}

	function decDraw(item) {
		var on = preview ? !!item.pdec : !!musState().dec;

		item.decBtn.classList.toggle('sg-r-lit', on);
		item.decBox.classList.toggle('sg-r-dec-off', !on);
		if (preview) {
			item.decCap.textContent = on ? 'ПРЕДПРОСМОТР' : 'ДЕКОДЕР ВЫКЛЮЧЕН';
			return;
		}

		var cap = on ? decCaption() : 'ДЕКОДЕР ВЫКЛЮЧЕН';

		if (item.decCap.textContent !== cap) {
			item.decCap.textContent = cap;
		}
		if (dec.buf && item.decVer !== dec.ver) {
			item.decVer = dec.ver;
			if (item.decCanvas.width !== dec.w || item.decCanvas.height !== dec.h) {
				item.decCanvas.width = dec.w;
				item.decCanvas.height = dec.h;
			}
			item.decCanvas.getContext('2d').drawImage(dec.buf, 0, 0);
		}
	}

	function decLoop(now) {
		decItems = decItems.filter(function (item) {
			return item.el.isConnected || !item.placed;
		});
		if (!decItems.length) {
			decFrame = null;
			decLast = 0;
			return;
		}

		var dt = decLast ? Math.min(0.25, (now - decLast) / 1000) : 0;

		decLast = now;
		if (!preview && musState().dec) {
			decStep(dt);
		}
		decItems.forEach(function (item) {
			if (item.el.isConnected) {
				item.placed = true;
				decDraw(item);
				if (item.decFull) {
					decFit(item);
				}
			}
		});
		decFrame = requestAnimationFrame(decLoop);
	}

	// На весь терминал (щелчок по окну) и обратно.
	function decFit(item) {
		var box = document.getElementById('passages');
		var r = box ? box.getBoundingClientRect() : {left: 0, top: 0, width: window.innerWidth, height: window.innerHeight};
		var st = item.decBox.style;

		st.left = r.left + 'px';
		st.top = r.top + 'px';
		st.width = r.width + 'px';
		st.height = r.height + 'px';
	}

	function decToggleFull(item) {
		item.decFull = !item.decFull;
		item.decBox.classList.toggle('sg-r-dec-full', item.decFull);
		if (item.decFull) {
			decFit(item);
		} else {
			['left', 'top', 'width', 'height'].forEach(function (k) {
				item.decBox.style[k] = item.decPlace[k];
			});
		}
	}

	function decBuild(item, el, P) {
		var box = radioAt(el, 'div', 'sg-r-box sg-r-dec', P.dec);
		var canvas = document.createElement('canvas');
		var cap = document.createElement('span');

		canvas.width = 320;
		canvas.height = 256;
		cap.className = 'sg-r-dec-cap';
		box.appendChild(canvas);
		box.appendChild(cap);
		box.setAttribute('role', 'button');
		box.setAttribute('aria-label', 'Окно декодера — на весь терминал');
		item.decBox = box;
		item.decCanvas = canvas;
		item.decCap = cap;
		item.decVer = -1;
		item.decPlace = {left: box.style.left, top: box.style.top, width: box.style.width, height: box.style.height};
		$(box).on('click', function () {
			uiClick(box);
			decToggleFull(item);
		});

		item.decBtn = radioAt(el, 'button', 'sg-r-btn sg-r-decbtn', P.decbtn);
		item.decBtn.innerHTML = '<span class="sg-r-dot"></span>ДЕКОД';
		item.decBtn.setAttribute('aria-label', 'Декодер');
		$(item.decBtn).on('click', function () {
			if (preview) {
				item.pdec = !item.pdec;
			} else {
				musState().dec = !musState().dec;
				saveVars();
			}
			decDraw(item);
		});
		if (preview) {
			decDemo(item);
		} else {
			// Картинки — заранее, чтобы набор не ждал загрузки.
			var table = sstvTable();

			Object.keys(table).forEach(function (key) {
				table[key].forEach(sstvImage);
			});
		}
		decItems.push(item);
		if (!decFrame) {
			decFrame = requestAnimationFrame(decLoop);
		}
	}

	function decLeave() {
		decItems = [];
	}

	// Декодер — для проверок.
	setup.signaly.dec = function () {
		return {on: !preview && !!musState().dec, key: dec.key, drawn: dec.drawn, w: dec.w, h: dec.h, mode: dec.mode, state: dec.state, noise: dec.noise, gy: dec.gy, caption: decCaption(),
			pixel: function (x, y) {
				try {
					return Array.prototype.slice.call(dec.buf.getContext('2d').getImageData(x, y, 1, 1).data);
				} catch (e) {
					return null;
				}
			}};
	};

	Macro.add('sg-radio', {
		handler: function () {
			var a = blockArgs(this, ['view'], ['size'], []);
			var views = radioViews();
			var name = a.view === undefined ? '' : String(a.view);
			var view = views[name] || views[Object.keys(views)[0]] || {
				name: '', type: 'broken', frame: '#c9a24a', elements: '#39ff7a', label: 'ОРБИТА-3', sparks: 30, sound: '', volume: 80
			};
			var el = document.createElement('div');
			var fixed = view.type !== 'broken';
			var decoder = view.type === 'decoder';
			var reverse = view.type === 'reverse' || decoder;
			var P = radioPlaces[decoder ? 'decoder' : reverse ? 'reverse' : fixed ? 'fixed' : 'broken'];
			var frame = decoder ? radioFrameDecoder(view) : reverse ? radioFrameReverse(view) : fixed ? radioFrameFixed(view) : radioFrame(view);
			var item = {el: el, view: view, frame: frame, size: Math.max(0, musNum(a.size, 0)), side: 0, unit: 1, dir: '', catKey: null, mqText: null};
			var st = radioState();
			var here = State.passage;

			if (!views[name]) {
				console.warn('СИГНАЛЫ: вида радио «' + name + '» нет в пассаже «Радио»');
			}
			el.className = 'sg-radio sg-radio-' + (fixed ? 'fixed' : 'broken') + (reverse ? ' sg-radio-reverse' : '') + (decoder ? ' sg-radio-decoder' : '');
			el.style.setProperty('--sg-rf', view.frame);
			el.style.setProperty('--sg-re', view.elements);
			// Сессия 29: свои цвета кнопок, выключателя, шкалы, каталога, внутреннего каркаса.
			el.style.setProperty('--sg-rb', view.buttons || view.elements);
			el.style.setProperty('--sg-rp', view.power || view.elements);
			el.style.setProperty('--sg-rs', view.scale || view.elements);
			el.style.setProperty('--sg-rc', view.catalog || view.elements);
			el.style.setProperty('--sg-ri', view.inner || view.frame);
			// Сессия 30, ответ 6Б: свой цвет лампочки; нет — как у шкалы.
			if (view.lamp) {
				el.style.setProperty('--sg-rl', view.lamp);
			}
			el.style.setProperty('--sg-rd', view.decoder || view.elements);
			el.style.setProperty('--u', '1px');
			el.appendChild(frame.svg);

			// Бегущая строка — во всю ширину сверху.
			item.mq = radioAt(el, 'div', 'sg-r-box sg-r-mq', P.mq);
			item.mqLine = document.createElement('span');
			item.mqLine.className = 'sg-r-mq-text';
			item.mq.appendChild(item.mqLine);

			// Каталог — крупно слева.
			var cat = radioAt(el, 'div', 'sg-r-box sg-r-cat', P.cat);

			item.path = document.createElement('div');
			item.path.className = 'sg-r-path';
			item.list = document.createElement('div');
			item.list.className = 'sg-r-list';
			cat.appendChild(item.path);
			cat.appendChild(item.list);

			// Громкость: «−», окошко 00–99, «+».
			radioAt(el, 'div', 'sg-r-cap', P.cap).textContent = 'ГРОМКОСТЬ';

			var minus = radioAt(el, 'button', 'sg-r-btn', P.minus);
			var digits = radioAt(el, 'div', 'sg-r-box sg-r-digits', P.digits);
			var plus = radioAt(el, 'button', 'sg-r-btn', P.plus);
			var vol = {target: null, chars: ['', ''], cells: [], stop: [0, 0], start: [0, 0], next: [0, 0]};

			minus.textContent = '−';
			plus.textContent = '+';
			digits.style.fontFamily = timerFont(timerDefaults.font);
			for (var i = 0; i < 2; i++) {
				var cell = document.createElement('span');

				cell.textContent = '0';
				digits.appendChild(cell);
				vol.cells.push(cell);
			}
			$(minus).on('click', function () {
				if (!preview) {
					musSetVolume(musState().vol - 5);
				}
			});
			$(plus).on('click', function () {
				if (!preview) {
					musSetVolume(musState().vol + 5);
				}
			});

			// ▶ ❚❚ ■ — играть, пауза (место запоминается), стоп (с начала).
			item.play = radioAt(el, 'button', 'sg-r-btn sg-r-play', P.play);
			item.pause = radioAt(el, 'button', 'sg-r-btn sg-r-pause', P.pause);
			item.stop = radioAt(el, 'button', 'sg-r-btn sg-r-stop', P.stop);
			item.play.textContent = '▶';
			item.pause.textContent = '❚❚';
			item.stop.textContent = '■';
			item.play.setAttribute('aria-label', 'Играть');
			item.pause.setAttribute('aria-label', 'Пауза');
			item.stop.setAttribute('aria-label', 'Стоп');
			$(item.play).on('click', function () {
				if (preview) {
					return;
				}

				var now = musState();
				var t = music().byId[now.cur];

				if (t && t.folder.section === 'radio') {
					if (!now.playing) {
						musPlay(now.cur);
					}
					return;
				}

				var folder = item.dir ? musFolder(item.dir) : null;
				var id = folder ? musFirst([folder]) : musSection('radio');

				if (id) {
					musPlay(id);
				}
			});
			$(item.pause).on('click', function () {
				if (!preview && musState().playing) {
					musPause();
				}
			});
			$(item.stop).on('click', function () {
				if (!preview) {
					musStop();
				}
			});

			// «АВТО» — следующий трек той же папки, когда кончился текущий.
			item.auto = radioAt(el, 'button', 'sg-r-btn sg-r-auto', P.auto);
			item.auto.innerHTML = '<span class="sg-r-dot"></span>АВТО ⟳';
			$(item.auto).on('click', function () {
				if (!preview) {
					musState().auto = !musState().auto;
					musChanged();
				}
			});

			// «СЛУЧАЙНО» (сессия 30) — следующий трек папки радио случайный, кроме текущего.
			item.shuffle = radioAt(el, 'button', 'sg-r-btn sg-r-auto sg-r-shuffle', P.shuffle);
			item.shuffle.innerHTML = '<span class="sg-r-dot"></span>СЛУЧАЙНО';
			$(item.shuffle).on('click', function () {
				if (!preview) {
					musState().rshuffle = !musState().rshuffle;
					musChanged();
				}
			});
			progBuild(item, el, P);

			// Выключатель — выход на экран, откуда пришли (ответ 4А); музыка играет дальше.
			var power = radioAt(el, 'button', 'sg-r-power', P.power);

			power.setAttribute('aria-label', 'Выключить радио');
			power.innerHTML = '<span class="sg-r-switch"><span class="sg-r-lever"></span><span class="sg-r-knob"></span></span>' +
				'<span class="sg-r-off-text">ВЫКЛ<small>выход</small></span>';
			if (!preview && !restoring && prevPassage && prevPassage !== here) {
				st.from[here] = prevPassage;
			}
			$(power).on('click', function () {
				if (power.classList.contains('sg-r-down')) {
					return;
				}
				power.classList.add('sg-r-down');

				var target = preview ? '' : musState().from[here] || Config.passages.start;

				setTimeout(function () {
					if (target && Story.has(target)) {
						goBack(target);
					} else {
						power.classList.remove('sg-r-down');
					}
				}, 260);
			});

			// Отремонтированное радио (шаг 7.3): шкала частот, игла, ПОИСК, частота −/+.
			if (fixed) {
				airBuild(item, el, P);
			}
			// Радио с реверсом (шаг 7.4): РЕВЕРС, катушки.
			if (reverse) {
				revBuild(item, el, P);
			}
			// Радио с декодером (сессия 30): ДЕКОД и окно картинки.
			if (decoder) {
				decBuild(item, el, P);
			}

			// Каталог открыт там, где играет радио.
			var cur = music().byId[st.cur];

			if (cur && cur.folder.section === 'radio' && musVisible(cur)) {
				item.dir = cur.folder.name;
			}
			if (preview) {
				el.setAttribute('data-sg-block', 'radio');
				el.setAttribute('data-sg-src', this.source);
			}
			this.output.appendChild(el);
			radioItems.push(item);
			if (fixed) {
				airItems.push(item);
			}
			volItems.push(vol);
			volDraw(vol, Date.now());
			if (!volTimer) {
				volTimer = setInterval(volDrawAll, 40);
			}
			if (!radioTimer) {
				radioTimer = setInterval(function () {
					radioDrawAll();
					ambDrawAll();
				}, 250);
				$(window).on('resize', radioDrawAll);
			}
			radioSpark(item);
			setTimeout(radioDrawAll, 0);
		}
	});

	$(document).on(':passageinit', function () {
		radioItems.forEach(function (item) {
			clearTimeout(item.sparkTimer);
		});
		radioItems = [];
		ambItems = [];
		airStop();
		airItems = [];
		revItems = [];
		decLeave();
	});
	$(document).on(':passagedisplay', function () {
		radioDrawAll();
		ambDrawAll();
	});

	// «Каталог Атмосферы» (ответ 6А): альбомы (папки раздела «Атмосфера») плиткой,
	// у каждого «прослушано N из M» и подсказка; «Случайно / По порядку», «Сбросить
	// прогресс»; щелчок по альбому — играть и открыть список треков. Прослушан —
	// доигран до конца хотя бы раз (ответ 7А); сброс стирает только отметки.
	function ambFolders() {
		return music().folders.filter(function (f) {
			return f.section === 'ambient' && f.tracks.some(musVisible);
		});
	}

	function ambCount(folder) {
		var st = radioState();
		var list = folder.tracks.filter(musVisible);

		return list.filter(function (t) {
			return st.done && st.done[t.id];
		}).length + ' из ' + list.length;
	}

	// Сброс — со вторым нажатием: случайный щелчок не стирает прогресс.
	function ambConfirm(control, label, action) {
		var timer = null;

		control.textContent = label;
		$(control).on('click', function () {
			if (preview) {
				return;
			}
			if (timer) {
				clearTimeout(timer);
				timer = null;
				control.textContent = label;
				action();
				return;
			}
			control.textContent = 'Нажмите ещё раз';
			timer = setTimeout(function () {
				timer = null;
				control.textContent = label;
			}, 3000);
		});
	}

	function ambOpen(folder) {
		var st = musState();
		var t = music().byId[st.cur];

		if (t && t.folder === folder && st.playing) {
			return;
		}

		var list = folder.tracks.filter(musVisible);
		var last = st.lastIn[folder.name];
		var id = last && music().byId[last] && musVisible(music().byId[last]) ? last : '';

		if (!id && list.length) {
			id = st.shuffle ? list[Math.floor(Math.random() * list.length)].id : list[0].id;
		}
		if (id) {
			musPlay(id);
		}
	}

	function ambDraw(item) {
		var st = radioState();
		var folders = ambFolders();
		var folder = item.dir ? musFolder(item.dir) : null;

		if (folder && folders.indexOf(folder) === -1) {
			item.dir = '';
			folder = null;
		}

		var tracks = folder ? folder.tracks.filter(musVisible) : [];
		var key = [item.dir, st.cur, st.playing, !!st.shuffle].concat(
			folders.map(function (f) { return f.name + ':' + ambCount(f); }),
			tracks.map(function (t) { return t.id + ':' + !!(st.done && st.done[t.id]); })
		).join('|');

		item.now.textContent = musNowText(true);
		item.shuffle.textContent = st.shuffle ? 'Случайно' : 'По порядку';
		if (key === item.key) {
			return;
		}
		item.key = key;
		$(item.body).empty();
		if (!folder) {
			var grid = document.createElement('div');

			grid.className = 'sg-amb-grid';
			grid.style.gridTemplateColumns = 'repeat(' + item.columns + ', minmax(0, 1fr))';
			folders.forEach(function (f) {
				var cell = document.createElement('div');
				var host = cell;

				cell.className = 'sg-amb-cell';
				if (f.tip) {
					// Подсказка — та же рамка, что у <<hovertip>> (вид — в «Оформлении терминала»).
					var n = ++ambTipCount;
					var box = document.createElement('span');

					host = document.createElement('span');
					host.id = 'hoverTip' + n;
					host.className = 'hoverTipTxt hoverTip sg-amb-tipped';
					box.id = 'hoverTipTxt' + n;
					box.className = 'hoverBox hoverTail';
					box.textContent = f.tip;
					$(host).on('mouseenter', function () {
						if (window.UpdateHoverTipTxt) {
							window.UpdateHoverTipTxt();
						}
					});
					cell.appendChild(host);
					host.appendChild(box);
				}

				var holder = document.createElement('span');
				var tile = actionControl(holder, f.name, false, function () {
					if (!preview) {
						item.dir = f.name;
						ambOpen(f);
						ambDraw(item);
					}
				});
				var here = music().byId[st.cur] && music().byId[st.cur].folder === f;

				tile.classList.add('sg-tile', 'sg-amb-tile');
				tile.classList.toggle('sg-amb-here', !!here);
				tile.innerHTML = '';
				tile.appendChild(Object.assign(document.createElement('span'), {className: 'sg-tile-name', textContent: (here ? (st.playing ? '▶ ' : '❚❚ ') : '') + f.name}));
				tile.appendChild(Object.assign(document.createElement('span'), {className: 'sg-tile-status', textContent: 'Прослушано: ' + ambCount(f)}));
				host.insertBefore(holder, host.firstChild);
				grid.appendChild(cell);
			});
			if (!folders.length) {
				grid.textContent = 'Альбомов пока нет.';
			}
			item.body.appendChild(grid);
			return;
		}

		var album = document.createElement('div');
		var head = document.createElement('div');

		album.className = 'sg-amb-album';
		head.className = 'sg-amb-head';
		actionControl(head, '◄ ..', false, function () {
			item.dir = '';
			ambDraw(item);
		}).classList.add('sg-amb-up');
		head.appendChild(Object.assign(document.createElement('span'), {className: 'sg-amb-title', textContent: folder.name + ' · прослушано ' + ambCount(folder)}));
		ambConfirm(actionControl(head, 'Сбросить альбом', item.asButton, function () {}), 'Сбросить альбом', function () {
			folder.tracks.forEach(function (t) {
				delete musState().done[t.id];
			});
			musChanged();
		});
		album.appendChild(head);
		tracks.forEach(function (t) {
			var row = document.createElement('div');
			var cur = t.id === st.cur;
			actionControl(row, t.name, false, function () {
				if (!preview && (musState().cur !== t.id || !musState().playing)) {
					musPlay(t.id);
				}
			});

			row.className = 'sg-amb-track' + (cur ? ' sg-amb-here' : '');
			row.insertBefore(Object.assign(document.createElement('span'), {
				className: 'sg-amb-mark',
				textContent: cur ? (st.playing ? '▶' : '❚❚') : st.done && st.done[t.id] ? '✓' : ''
			}), row.firstChild);
			album.appendChild(row);
		});
		item.body.appendChild(album);
	}

	function ambDrawAll() {
		ambItems.forEach(function (item) {
			if (item.el.isConnected) {
				ambDraw(item);
			}
		});
	}

	Macro.add('sg-ambient', {
		handler: function () {
			var a = blockArgs(this, [], ['columns', 'kind'], ['buttons']);
			var el = document.createElement('div');
			var inner = el;
			var bar = document.createElement('div');
			var item = {el: el, columns: Math.max(1, Math.min(6, Math.round(musNum(a.columns, 3)))), dir: '', key: null, asButton: !!a.buttons};

			el.className = 'sg-amb';
			if (a.kind) {
				inner = document.createElement('span');
				inner.className = String(a.kind);
				el.appendChild(inner);
			}
			bar.className = 'sg-amb-bar';
			item.now = document.createElement('span');
			item.now.className = 'sg-amb-now';
			bar.appendChild(item.now);
			item.shuffle = actionControl(bar, 'По порядку', item.asButton, function () {
				if (!preview) {
					musState().shuffle = !musState().shuffle;
					musChanged();
				}
			});
			ambConfirm(actionControl(bar, 'Сбросить прогресс', item.asButton, function () {}), 'Сбросить прогресс', function () {
				var st = musState();

				music().folders.forEach(function (f) {
					if (f.section === 'ambient') {
						f.tracks.forEach(function (t) {
							delete st.done[t.id];
						});
					}
				});
				musChanged();
			});
			item.body = document.createElement('div');
			item.body.className = 'sg-amb-body';
			inner.appendChild(bar);
			inner.appendChild(item.body);

			var st = radioState();
			var cur = music().byId[st.cur];

			if (cur && cur.folder.section === 'ambient' && st.playing) {
				item.dir = cur.folder.name;
			}
			if (preview) {
				el.setAttribute('data-sg-block', 'ambient');
				el.setAttribute('data-sg-src', this.source);
			}
			this.output.appendChild(el);
			ambItems.push(item);
			ambDraw(item);
			if (!radioTimer) {
				radioTimer = setInterval(function () {
					radioDrawAll();
					ambDrawAll();
				}, 250);
				$(window).on('resize', radioDrawAll);
			}
		}
	});

	engineStyle.textContent +=
		'.sg-radio { --sg-rf: #c9a24a; --sg-re: #39ff7a; color: var(--sg-re); display: block; margin: 0 auto; max-width: none; position: relative; ' +
		'font-size: calc(var(--u) * 30); line-height: 1.25; text-align: left; user-select: none; }\n' +
		'.sg-radio .sg-r-frame { height: 100%; left: 0; overflow: visible; position: absolute; top: 0; width: 100%; }\n' +
		'.sg-r-frame .sg-r-fr, .sg-r-frame .sg-r-thin, .sg-r-frame .sg-r-crack, .sg-r-frame .sg-r-reelrim { fill: none; stroke: var(--sg-rf); stroke-linejoin: round; }\n' +
		// Сессия 29: внутренний каркас (перегородки, решётка, заплатка, катушки) — свой цвет.
		'.sg-r-frame .sg-r-thin, .sg-r-frame .sg-r-reelrim { stroke: var(--sg-ri, var(--sg-rf)); }\n' +
		'.sg-r-frame .sg-r-reelrim { stroke-width: 4; }\n' +
		'.sg-r-frame .sg-r-fr { stroke-width: 4; }\n' +
		'.sg-r-frame .sg-r-thin { opacity: 0.75; stroke-width: 2; }\n' +
		'.sg-r-frame .sg-r-crack { stroke-width: 3; }\n' +
		'.sg-r-frame .sg-r-grille circle { fill: var(--sg-ri, var(--sg-rf)); opacity: 0.55; }\n' +
		'.sg-r-frame .sg-r-label { fill: var(--sg-rf); font-family: inherit; font-size: 20px; letter-spacing: 0.18em; }\n' +
		'.sg-r-frame .sg-r-spark { opacity: 0; }\n' +
		'.sg-r-frame .sg-r-spark line { stroke: #fff7c2; stroke-width: 2.6; }\n' +
		'.sg-r-frame .sg-r-spark circle { fill: #fffbe6; }\n' +
		'.sg-r-frame .sg-r-spark.sg-r-on { animation: sg-r-spark 0.5s steps(1) 1; }\n' +
		'@keyframes sg-r-spark { 0% { opacity: 1; } 18% { opacity: 0.15; } 30% { opacity: 1; } 46% { opacity: 0.4; } 58%, 100% { opacity: 0; } }\n' +
		'.sg-r-frame .sg-r-seg.sg-r-jit { animation: sg-r-jit 0.32s steps(1) 1; }\n' +
		'@keyframes sg-r-jit { 0% { opacity: 0.35; transform: translate(3px, -2px); } 30% { opacity: 1; transform: translate(-2px, 1px); } ' +
		'60% { opacity: 0.55; transform: translate(1px, 2px); } 100% { opacity: 1; transform: none; } }\n' +
		'.sg-radio .sg-r-box, .sg-radio .sg-r-cap, .sg-radio .sg-r-btn, .sg-radio .sg-r-power { box-sizing: border-box; position: absolute; }\n' +
		'.sg-radio .sg-r-box { border: calc(var(--u) * 3) solid var(--sg-re); }\n' +
		'.sg-radio .sg-r-cap { font-size: calc(var(--u) * 22); letter-spacing: 0.12em; opacity: 0.6; }\n' +
		'.sg-radio .sg-r-mq { align-items: center; display: flex; overflow: hidden; padding: 0 calc(var(--u) * 14); }\n' +
		'.sg-radio .sg-r-mq-text { filter: drop-shadow(0 0 calc(var(--u) * 3) var(--sg-re)); flex: none; font-size: calc(var(--u) * 40); letter-spacing: 0.06em; white-space: pre; }\n' +
		'@keyframes sg-r-run { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n' +
		'.sg-radio .sg-r-cat { display: flex; flex-direction: column; padding: calc(var(--u) * 10); }\n' +
		'.sg-radio .sg-r-path { border-bottom: calc(var(--u) * 2) solid var(--sg-re); flex: none; font-size: calc(var(--u) * 22); letter-spacing: 0.1em; ' +
		'opacity: 0.7; overflow: hidden; padding: 0 calc(var(--u) * 6) calc(var(--u) * 8); text-overflow: ellipsis; white-space: nowrap; }\n' +
		'.sg-radio .sg-r-list { flex: 1 1 auto; min-height: 0; overflow-x: hidden; overflow-y: auto; scrollbar-color: var(--sg-re) transparent; scrollbar-width: thin; }\n' +
		'html body .sg-radio button { all: unset; box-sizing: border-box; color: var(--sg-re); cursor: pointer; font-family: inherit; position: absolute; }\n' +
		'html body .sg-radio .sg-r-list button.sg-r-line { align-items: baseline; display: flex; gap: calc(var(--u) * 10); padding: calc(var(--u) * 6) calc(var(--u) * 8); ' +
		'position: relative; width: 100%; }\n' +
		'.sg-radio .sg-r-line:hover, .sg-radio .sg-r-line:focus-visible, .sg-radio .sg-r-cur { background: rgba(255, 255, 255, 0.07); }\n' +
		'.sg-radio .sg-r-line:hover .sg-r-name, .sg-radio .sg-r-cur .sg-r-name { filter: drop-shadow(0 0 calc(var(--u) * 3) var(--sg-re)); }\n' +
		'.sg-radio .sg-r-mark { flex: none; text-align: center; width: 1.6em; }\n' +
		'.sg-radio .sg-r-name { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n' +
		'.sg-radio .sg-r-side { flex: none; opacity: 0.55; }\n' +
		'.sg-radio .sg-r-up .sg-r-mark, .sg-radio .sg-r-up .sg-r-name { font-weight: bold; }\n' +
		'.sg-radio .sg-r-empty { cursor: default; opacity: 0.5; }\n' +
		'html body .sg-radio button.sg-r-btn { align-items: center; border: calc(var(--u) * 3) solid var(--sg-re); border-radius: calc(var(--u) * 6); display: flex; ' +
		'font-size: calc(var(--u) * 34); justify-content: center; }\n' +
		'.sg-radio .sg-r-btn::before { background: var(--sg-re); border-radius: inherit; content: ""; inset: calc(var(--u) * 5); opacity: 0; position: absolute; }\n' +
		'.sg-radio .sg-r-btn.sg-r-lit::before { opacity: 0.2; }\n' +
		'.sg-radio .sg-r-btn:hover::before, .sg-radio .sg-r-btn:focus-visible::before { opacity: 0.12; }\n' +
		'.sg-radio .sg-r-btn.sg-r-lit:hover::before { opacity: 0.3; }\n' +
		'.sg-radio .sg-r-btn:active { transform: translateY(calc(var(--u) * 2)); }\n' +
		'html body .sg-radio button.sg-r-auto { border-radius: calc(var(--u) * 29); font-size: calc(var(--u) * 28); gap: calc(var(--u) * 14); justify-content: flex-start; padding-left: calc(var(--u) * 16); }\n' +
		'.sg-radio .sg-r-dot { border: calc(var(--u) * 2) solid var(--sg-re); border-radius: 50%; height: calc(var(--u) * 14); width: calc(var(--u) * 14); }\n' +
		'.sg-radio .sg-r-auto.sg-r-lit .sg-r-dot { background: var(--sg-re); box-shadow: 0 0 calc(var(--u) * 6) var(--sg-re); }\n' +
		'.sg-radio .sg-r-digits { align-items: center; display: flex; font-size: calc(var(--u) * 56); justify-content: center; line-height: 1; }\n' +
		'.sg-radio .sg-r-digits span { display: inline-block; filter: drop-shadow(0 0 calc(var(--u) * 3) var(--sg-re)); text-align: center; width: 1ch; }\n' +
		// Шаг 7.3: шкала частот, игла, ПОИСК, окно частоты, каркас Р2.
		'.sg-radio .sg-r-freq { font-size: calc(var(--u) * 50); }\n' +
		'.sg-radio .sg-r-freq span.sg-r-dotch { width: 0.35ch; }\n' +
		'.sg-radio .sg-r-scale { cursor: ew-resize; overflow: hidden; touch-action: none; }\n' +
		'.sg-radio .sg-r-dial { display: block; height: 100%; width: 100%; }\n' +
		'.sg-radio .sg-r-dial .sg-r-glass { fill: var(--sg-re); opacity: 0.05; transition: opacity 0.3s; }\n' +
		'.sg-radio .sg-r-scan .sg-r-glass { opacity: 0.18; }\n' +
		'.sg-radio .sg-r-scan { box-shadow: 0 0 calc(var(--u) * 14) var(--sg-re); }\n' +
		'.sg-radio .sg-r-dial .sg-r-tick { stroke: var(--sg-re); stroke-width: 1.4; }\n' +
		'.sg-radio .sg-r-dial .sg-r-big { stroke-width: 2.4; }\n' +
		'.sg-radio .sg-r-dial .sg-r-num { fill: var(--sg-re); font-family: inherit; font-size: 20px; opacity: 0.75; text-anchor: middle; }\n' +
		'.sg-radio .sg-r-dial .sg-r-unit { fill: var(--sg-re); font-family: inherit; font-size: 16px; opacity: 0.55; }\n' +
		'.sg-radio .sg-r-needle line { stroke: var(--sg-re); stroke-width: 4; }\n' +
		'.sg-radio .sg-r-needle polygon { fill: var(--sg-re); }\n' +
		'.sg-radio .sg-r-needle { filter: drop-shadow(0 0 3px var(--sg-re)); }\n' +
		'html body .sg-radio button.sg-r-scanbtn { flex-direction: column; font-size: calc(var(--u) * 24); gap: calc(var(--u) * 16); letter-spacing: 0.06em; }\n' +
		'.sg-radio .sg-r-scanbtn.sg-r-lit .sg-r-dot { background: var(--sg-re); box-shadow: 0 0 calc(var(--u) * 6) var(--sg-re); }\n' +
		'html body .sg-radio button.sg-r-fbtn { font-size: calc(var(--u) * 44); }\n' +
		'.sg-radio .sg-r-fbtn.sg-r-wait { opacity: 0.45; }\n' +
		'.sg-r-frame .sg-r-patch { stroke-dasharray: 8 5; }\n' +
		'.sg-r-frame .sg-r-rivet { fill: var(--sg-ri, var(--sg-rf)); }\n' +
		'html body .sg-radio button.sg-r-power { align-items: center; display: flex; gap: calc(var(--u) * 24); }\n' +
		'.sg-radio .sg-r-switch { border: calc(var(--u) * 3) solid var(--sg-re); border-radius: calc(var(--u) * 8); flex: none; height: calc(var(--u) * 140); position: relative; width: calc(var(--u) * 72); }\n' +
		'.sg-radio .sg-r-lever { background: var(--sg-re); border-radius: calc(var(--u) * 6); height: calc(var(--u) * 64); left: calc(50% - var(--u) * 6); position: absolute; ' +
		'top: calc(var(--u) * 6); transform: rotate(18deg); transform-origin: 50% 100%; transition: transform 0.22s ease-in; width: calc(var(--u) * 12); }\n' +
		'.sg-radio .sg-r-knob { background: var(--sg-re); border-radius: 50%; height: calc(var(--u) * 20); left: calc(50% - var(--u) * 10); position: absolute; top: calc(var(--u) * 60); width: calc(var(--u) * 20); }\n' +
		'.sg-radio .sg-r-down .sg-r-lever { transform: rotate(162deg); }\n' +
		'.sg-radio .sg-r-power:hover .sg-r-switch { box-shadow: 0 0 calc(var(--u) * 8) var(--sg-re); }\n' +
		'.sg-radio .sg-r-off-text { display: flex; flex-direction: column; font-size: calc(var(--u) * 34); letter-spacing: 0.08em; }\n' +
		'.sg-radio .sg-r-off-text small { font-size: calc(var(--u) * 20); opacity: 0.6; }\n' +
		// Сессия 29: свои цвета частей — переменная элементов внутри части подменяется.
		'html body .sg-radio button.sg-r-btn { --sg-re: var(--sg-rb, #39ff7a); }\n' +
		'html body .sg-radio button.sg-r-power { --sg-re: var(--sg-rp, #39ff7a); }\n' +
		'.sg-radio .sg-r-cat { --sg-re: var(--sg-rc, #39ff7a); color: var(--sg-re); }\n' +
		'.sg-radio .sg-r-scale, .sg-radio .sg-r-freq, .sg-radio .sg-r-prog { --sg-re: var(--sg-rs, #39ff7a); color: var(--sg-re); }\n' +
		// Лампочка точной настройки: круг на шкале, горит — залит и светится.
		'.sg-radio .sg-r-dial .sg-r-lamp { fill: none; stroke: var(--sg-rl, var(--sg-re)); stroke-width: 2.4; opacity: 0.55; transition: fill 0.15s, opacity 0.15s; }\n' +
		'.sg-radio .sg-r-dial .sg-r-lamp.sg-r-lamp-on { fill: var(--sg-rl, var(--sg-re)); filter: drop-shadow(0 0 6px var(--sg-rl, var(--sg-re))); opacity: 1; }\n' +
		// Шаг 7.4: радио с реверсом — меньше окно частоты, РЕВЕРС, прогресс трека.
		'.sg-radio-reverse .sg-r-freq { font-size: calc(var(--u) * 40); }\n' +
		'html body .sg-radio-reverse button.sg-r-fbtn { font-size: calc(var(--u) * 36); }\n' +
		'html body .sg-radio button.sg-r-revbtn { flex-direction: column; font-size: calc(var(--u) * 34); gap: calc(var(--u) * 2); letter-spacing: 0.06em; touch-action: none; }\n' +
		'.sg-radio .sg-r-revbtn small { font-size: calc(var(--u) * 18); letter-spacing: 0.1em; opacity: 0.6; }\n' +
		'.sg-radio .sg-r-revbtn.sg-r-held { transform: translateY(calc(var(--u) * 2)); }\n' +
		'.sg-radio .sg-r-prog { box-sizing: border-box; cursor: pointer; position: absolute; touch-action: none; }\n' +
		'.sg-radio .sg-r-prog-line { background: color-mix(in srgb, var(--sg-re) 25%, transparent); height: calc(var(--u) * 6); left: calc(var(--u) * 14); ' +
		'position: absolute; right: calc(var(--u) * 14); top: calc(50% - var(--u) * 3); }\n' +
		'.sg-radio .sg-r-prog-fill { background: var(--sg-re); box-shadow: 0 0 calc(var(--u) * 6) var(--sg-re); display: block; height: 100%; width: 0; }\n' +
		'.sg-radio .sg-r-prog-thumb { background: var(--sg-re); border-radius: calc(var(--u) * 3); height: calc(var(--u) * 40); position: absolute; ' +
		'top: calc(50% - var(--u) * 20); transform: translateX(-50%); width: calc(var(--u) * 16); }\n' +
		'.sg-radio .sg-r-prog.sg-r-none { opacity: 0.35; }\n' +
		// Сессия 30: «СЛУЧАЙНО», радио с декодером — окно картинки и ДЕКОД.
		'html body .sg-radio-reverse:not(.sg-radio-decoder) button.sg-r-auto { font-size: calc(var(--u) * 24); gap: calc(var(--u) * 10); padding-left: calc(var(--u) * 12); }\n' +
		'.sg-radio .sg-r-dec { --sg-re: var(--sg-rd, #39ff7a); align-items: center; background: #000; color: var(--sg-re); cursor: zoom-in; display: flex; justify-content: center; overflow: hidden; }\n' +
		'.sg-radio .sg-r-dec canvas { display: block; height: 100%; image-rendering: pixelated; object-fit: contain; width: 100%; }\n' +
		'.sg-radio .sg-r-dec-cap { background: rgba(0, 0, 0, 0.65); bottom: 0; font-size: calc(var(--u) * 18); left: 0; letter-spacing: 0.1em; padding: calc(var(--u) * 4) calc(var(--u) * 10); position: absolute; right: 0; text-align: center; }\n' +
		'.sg-radio .sg-r-dec.sg-r-dec-off canvas { opacity: 0.25; }\n' +
		'.sg-radio .sg-r-dec.sg-r-dec-full { border-width: 3px; cursor: zoom-out; position: fixed; z-index: 1000; }\n' +
		'.sg-radio .sg-r-dec.sg-r-dec-full .sg-r-dec-cap { font-size: 22px; padding: 6px 12px; }\n' +
		'html body .sg-radio button.sg-r-decbtn { --sg-re: var(--sg-rd, #39ff7a); font-size: calc(var(--u) * 30); gap: calc(var(--u) * 14); letter-spacing: 0.08em; }\n' +
		'.sg-radio .sg-r-decbtn.sg-r-lit .sg-r-dot { background: var(--sg-re); box-shadow: 0 0 calc(var(--u) * 6) var(--sg-re); }\n' +
		'.sg-radio-decoder .sg-r-freq { font-size: calc(var(--u) * 40); }\n' +
		'html body .sg-radio-decoder button.sg-r-btn { font-size: calc(var(--u) * 30); }\n' +
		'html body .sg-radio-decoder button.sg-r-auto { font-size: calc(var(--u) * 26); }\n' +
		'html body .sg-radio-decoder button.sg-r-scanbtn { font-size: calc(var(--u) * 19); gap: calc(var(--u) * 10); }\n' +
		'html body .sg-radio-decoder button.sg-r-revbtn { flex-direction: row; font-size: calc(var(--u) * 30); gap: calc(var(--u) * 22); }\n' +
		'.sg-amb-bar { align-items: baseline; display: flex; flex-wrap: wrap; gap: 0.6em 1.5em; margin-bottom: 1em; }\n' +
		'.sg-amb-now { flex: 1 1 100%; }\n' +
		'.sg-amb-grid { display: grid; gap: 0.8em; }\n' +
		'.sg-amb-cell, .sg-amb-cell > .sg-amb-tipped { display: block; min-width: 0; }\n' +
		'html .sg-amb .sg-amb-tipped { border-bottom: 0; top: 0; }\n' +
		'.sg-amb-cell a.sg-tile { height: 100%; }\n' +
		'.sg-amb-cell .sg-amb-here { box-shadow: 0 0 8px currentColor; }\n' +
		'.sg-amb-head { align-items: baseline; display: flex; flex-wrap: wrap; gap: 0.6em 1.5em; margin-bottom: 0.8em; }\n' +
		'.sg-amb-title { font-weight: bold; }\n' +
		'.sg-amb-track { display: flex; gap: 0.6em; }\n' +
		'.sg-amb-mark { flex: none; text-align: center; width: 1.6em; }\n';

	// Для проверок и предпросмотра.
	setup.signaly.music = function () {
		var table = music();

		return {table: {folders: table.folders.map(function (f) { return f.name; }), ids: Object.keys(table.byId)}, state: preview ? null : musState(), playing: !!(mus.audio && !mus.audio.paused), src: mus.audio ? mus.audio.src : '', volume: mus.audio ? mus.audio.volume : null, pre: mus.pre ? mus.pre.src : ''};
	};

	// Эфир — для проверок: расстановка, громкости, удержание; airPlace — передвинуть точку.
	setup.signaly.air = function () {
		return {
			freq: airFreq(),
			items: airItems.filter(function (item) {
				return item.el.isConnected;
			}).map(function (item) {
				return {
					srcs: (item.srcs || []).map(function (s) {
						return {kind: s.kind, name: s.kind === 'tx' ? s.t.id : s.src, id: s.t ? s.t.id : '', c: s.c, w: s.w, vol: s.audio && !s.audio.paused ? s.audio.volume : 0};
					}),
					noise: item.noise && item.noise.audio && !item.noise.audio.paused ? item.noise.audio.volume : 0,
					hold: item.hold ? {name: item.hold.s.t.id, ms: Date.now() - item.hold.since} : null,
					lamp: !!(item.lamp && item.lamp.classList.contains('sg-r-lamp-on'))
				};
			})
		};
	};
	// Реверс (шаг 7.4) — для проверок: звучит ли задом наперёд, где трек, катушки.
	setup.signaly.rev = function () {
		var w = musWhere();

		return {
			rev: !!mus.rev,
			src: mus.rev ? mus.rev.audio.src : '',
			ok: !!(mus.rev && mus.rev.ok),
			revTime: mus.rev ? mus.rev.audio.currentTime : null,
			revPlaying: !!(mus.rev && !mus.rev.audio.paused && !mus.rev.audio.ended),
			pos: w ? w.pos : null,
			dur: w ? w.dur : null,
			reels: revItems.map(function (item) {
				return item.reelAngle;
			})
		};
	};
	setup.signaly.airPlace = function (name, c) {
		airItems.forEach(function (item) {
			(item.srcs || []).forEach(function (s) {
				if ((s.kind === 'tx' ? s.t.id : s.src) === name) {
					s.c = c;
				}
			});
		});
	};

	/* ----- Кнопка-перебор (этап 6, ответ 2А) ----- */

	// <<sg-pick var "$mode" [form button|image] [kind amber] [width N] [sound "x" volume N]>>
	// со строками <<sg-opt "Надпись" значение [img "media/img/x.jpg"]>>. Щелчок даёт следующее значение, значение лежит
	// в переменной. Его меняет и всё остальное в игре (код, клавиша мастера):
	// надпись следит сама, 4 раза в секунду.
	var pickItems = [];
	var pickTimer = null;

	function pickIndex(item) {
		var value = State.getVar(item.name);
		var text = value === false ? '0' : value === true ? '1' : String(value);

		for (var i = 0; i < item.options.length; i++) {
			if (String(item.options[i].value) === text) {
				return i;
			}
		}
		return -1;
	}

	function pickDraw(item) {
		var index = Math.max(0, pickIndex(item));

		if (index !== item.index) {
			item.index = index;
			if (item.image) {
				// Порция 2, ответ 3А: у значения своя картинка; нет своей — первая найденная.
				item.el.src = String(item.options[index].img || item.image);
				item.el.alt = String(item.options[index].label || '');
			} else {
				item.el.textContent = String(item.options[index].label || '—');
			}
		}
	}

	function pickTick() {
		pickItems.forEach(pickDraw);
	}

	function pickNext(item) {
		var now = State.getVar(item.name);
		var next = item.options[(Math.max(-1, pickIndex(item)) + 1) % item.options.length].value;

		// Да-нет остаётся да-нет, как у картинки-переключателя.
		State.setVar(item.name, typeof now === 'boolean' ? !!next : next);
		pickDraw(item);
	}

	$(document).on(':passageinit', function () {
		pickItems = [];
	});

	Macro.add('sg-pick', {
		tags: ['sg-opt'],
		handler: function () {
			var a = blockArgs(this, [], ['var', 'form', 'kind', 'width', 'sound', 'volume'], []);
			var options = this.payload.slice(1).map(function (part) {
				return blockArgs({args: part.args}, ['label', 'value'], ['img'], []);
			});
			var name = String(a['var'] || '');

			if (!name || !options.length) {
				return;
			}

			var item = {name: /^[$_]/.test(name) ? name : '$' + name, options: options, index: -1};
			var box = document.createElement('span');
			var inner = box;
			var tag = a.form === 'button' ? 'button' : 'link';

			box.className = 'sg-pick';
			if (a.kind) {
				inner = document.createElement('span');
				inner.className = String(a.kind);
				box.appendChild(inner);
			}
			// Переменная без значения получает первое: на экране и в условиях одно и то же.
			if (State.getVar(item.name) === undefined) {
				State.setVar(item.name, options[0].value);
			}
			if (a.form === 'image') {
				// Картинками (порция 2, ответ 3А): щелчок по картинке, свой звук щелчка.
				item.image = (options.filter(function (o) { return o.img; })[0] || {}).img || '';
				item.el = document.createElement('img');
				item.el.className = 'sg-toggle';
				if (Number(a.width) > 0) {
					item.el.width = Number(a.width);
				}
				inner.appendChild(item.el);
			} else {
				$(inner).wiki('<<' + tag + ' "—">><</' + tag + '>>');
				item.el = inner.querySelector('a, button');
			}
			pickDraw(item);
			$(item.el).on('click', function () {
				if (item.image && a.sound) {
					signalPlay(a.sound, a.volume);
				}
				pickNext(item);
			});
			pickItems.push(item);
			this.output.appendChild(box);
			if (!pickTimer) {
				pickTimer = setInterval(pickTick, 250);
			}
		}
	});

	/* ----- Живое значение (этап 6, ответ 1А) ----- */

	// <span class="sg-value">Глава: <<= $chapter>></span> — обычный SugarCube, текст
	// экрана тот же. Движок запоминает выражение команды <<=>> внутри такого блока
	// и 4 раза в секунду сверяет значение. Выражение лежит в атрибуте, а не в
	// памяти: <<type>> печатает копии узлов.
	var valueTimer;
	var valueMacro = Macro.get('=');
	var valuePrint = valueMacro.handler;

	function valueTick() {
		var items = document.querySelectorAll('.sg-value-now');

		for (var i = 0; i < items.length; i++) {
			var shown;

			try {
				shown = stringFrom(Scripting.evalJavaScript(items[i].getAttribute('data-sg-code')));
			} catch (ex) {
				continue;
			}
			if (String(shown) !== items[i].getAttribute('data-sg-shown')) {
				items[i].setAttribute('data-sg-shown', String(shown));
				items[i].textContent = '';
				if (shown !== null) {
					new Wikifier(items[i], shown);
				}
			}
		}
	}

	valueMacro.handler = function () {
		var output = this.output;
		var inside = output && output.closest && output.closest('.sg-value');
		var last = inside ? output.lastChild : null;
		var result = valuePrint.apply(this, arguments);
		var shown;

		if (!inside) {
			return result;
		}
		try {
			shown = stringFrom(Scripting.evalJavaScript(this.args.full));
		} catch (ex) {
			return result; // Ошибку уже показала сама команда.
		}

		var live = document.createElement('span');
		var node = last ? last.nextSibling : output.firstChild;

		live.className = 'sg-value-now';
		live.setAttribute('data-sg-code', this.args.full);
		live.setAttribute('data-sg-shown', String(shown));
		while (node) {
			var next = node.nextSibling;

			live.appendChild(node);
			node = next;
		}
		output.appendChild(live);
		if (!valueTimer) {
			valueTimer = setInterval(valueTick, 250);
		}
		return result;
	};

	/* ----- Раскрытие, которое запоминается (этап 6, ответ 2Б) ----- */

	// <<sg-reveal "sg-reveal1" "[РАСШИФРОВАТЬ]" [link] [kind "amber"]>>текст<</sg-reveal>>
	// Отметка — $sgRevealed = {"Экран|sg-reveal1": 1}: она в автокопии, «Новая игра»
	// её стирает. Уже раскрытое выводится сразу, поэтому работает внутри печати.
	Macro.add('sg-reveal', {
		tags: null,
		handler: function () {
			var a = blockArgs(this, ['id', 'label'], ['kind'], ['link']);
			var text = this.payload[0].contents;
			var key = State.passage + '|' + a.id;
			var box = document.createElement('span');
			var inner = box;
			var tag = a.link ? 'link' : 'button';

			box.id = String(a.id);
			this.output.appendChild(box);
			if (varObject('sgRevealed')[key]) {
				$(box).wiki(text);
				return;
			}
			if (a.kind) {
				inner = document.createElement('span');
				inner.className = String(a.kind);
				box.appendChild(inner);
			}
			$(inner).wiki('<<' + tag + ' ' + JSON.stringify(String(a.label)) + '>><</' + tag + '>>');
			$(inner.querySelector('a, button')).on('click', function () {
				varObject('sgRevealed')[key] = 1;
				saveVars();
				$(box).empty().wiki(text);
			});
		}
	});

	/* ----- Терминал взлома (шаг 5.2) ----- */

	// <<sg-hack слова>> с частями <<sg-hack-win>>, <<sg-hack-fail>>, <<sg-hack-miss>>
	// (действия как у ссылки). В каждой попытке слова одной длины; ключевое слово
	// случайное и не повторяет прошлое, если не задано явно. Попытки сбрасываются
	// при входе. $sgHack = {"Экран": {last, done, win}}: после успеха экран больше
	// не показывается, переход на него ведёт сразу на экран успеха.
	var hackDefaults = {"count":5,"attempts":3,"rows":10,"cols":60,"columns":1,"gap":4,"chars":"АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789","hinttext":"{совпало}/{всего} ВЕРНО","triestext":"Осталось попыток: {попытки}","wintext":"Доступ разрешён!\nПароль: {слово}","winnote":"Взлом завершён успешно!","failtext":"Доступ запрещён!\nТерминал заблокирован.","delay":1,"misslabel":"ОШИБКА","misstime":1,"misscolor":"#ff0000","fxcolor":"#ffffff","misssize":72,"missover":240,"missvolume":100};
	var hackKeys = ["words","key","count","attempts","rows","cols","columns","gap","size","chars","light","hint","tries","triesshow","hinttext","triestext","wintext","winnote","failtext","delay","win","fail","misssound","missvolume","missfx","misstime","misslabel","missplace","misssize","misscolor","fxcolor"];
	var hackLayers = [];
	var hackFrame = 0;

	function hackChars(text) {
		return Array.from(String(text));
	}

	function hackList(value) {
		var seen = {};

		return String(value === undefined ? '' : value)
			.split(/[\s,;]+/)
			.filter(function (word) {
				if (!word || seen[word]) {
					return false;
				}
				seen[word] = true;
				return true;
			});
	}

	function hackShuffle(list) {
		var next = list.slice();

		for (var i = next.length - 1; i > 0; i--) {
			var j = Math.floor(Math.random() * (i + 1));
			var keep = next[i];

			next[i] = next[j];
			next[j] = keep;
		}
		return next;
	}

	function hackNumber(value, fallback, min) {
		var n = Number(value);

		return value === undefined || value === '' || isNaN(n) ? fallback : Math.max(min, n);
	}

	// Слова этой попытки: ключевое и варианты той же длины.
	function hackPick(all, fixed, count, last) {
		var groups = {};
		var most = 0;

		all.forEach(function (word) {
			var size = hackChars(word).length;

			groups[size] = (groups[size] || []).concat([word]);
			most = Math.max(most, groups[size].length);
		});

		var key = fixed;

		if (!key) {
			// Длина выпадает только та, где слов хватает на все варианты.
			var enough = Math.min(count, most);
			var full = all.filter(function (word) {
				return groups[hackChars(word).length].length >= enough;
			});
			var fresh = full.filter(function (word) {
				return word !== last;
			});
			var from = fresh.length ? fresh : full;

			key = from[Math.floor(Math.random() * from.length)];
		}

		var others = (groups[hackChars(key).length] || []).filter(function (word) {
			return word !== key;
		});

		return {key: key, words: [key].concat(hackShuffle(others).slice(0, Math.max(0, count - 1)))};
	}

	// Куда поставить слова: по столбцам по очереди, не вплотную друг к другу.
	function hackPlace(words, rows, width, columns) {
		var lines = {};
		var shift = Math.floor(Math.random() * columns);

		function free(column, row, start, size) {
			return (lines[column + ':' + row] || []).every(function (spot) {
				return start > spot.to || start + size < spot.from;
			});
		}

		function put(word, column, row, start, size) {
			var id = column + ':' + row;

			lines[id] = (lines[id] || []).concat([{from: start, to: start + size, word: word}]);
		}

		words.forEach(function (word, index) {
			var size = hackChars(word).length;
			var column = (index + shift) % columns;
			var i;

			for (i = 0; i < 60; i++) {
				var row = Math.floor(Math.random() * rows);
				var start = Math.floor(Math.random() * (width - size + 1));

				if (free(column, row, start, size) && (i >= 30 || !lines[column + ':' + row])) {
					put(word, column, row, start, size);
					return;
				}
			}
			for (var c = 0; c < columns; c++) {
				for (var r = 0; r < rows; r++) {
					for (var s = 0; s <= width - size; s++) {
						if (free((column + c) % columns, r, s, size)) {
							put(word, (column + c) % columns, r, s, size);
							return;
						}
					}
				}
			}
		});
		return lines;
	}

	function hackDraw(run) {
		var a = run.a;
		var rows = hackNumber(a.rows, hackDefaults.rows, 1);
		var columns = hackNumber(a.columns, hackDefaults.columns, 1);
		var longest = run.words.reduce(function (max, word) {
			return Math.max(max, hackChars(word).length);
		}, 0);
		var width = Math.max(hackNumber(a.cols, hackDefaults.cols, 1), longest + 2);
		var chars = hackChars(a.chars === undefined || a.chars === '' ? hackDefaults.chars : a.chars);
		var lines = hackPlace(run.words, rows, width, columns);
		var field = run.field;

		field.textContent = '';
		field.style.gridTemplateColumns = 'repeat(' + columns + ', max-content)';
		field.style.columnGap = hackNumber(a.gap, hackDefaults.gap, 0) + 'ch';
		for (var c = 0; c < columns; c++) {
			var column = document.createElement('div');

			for (var r = 0; r < rows; r++) {
				var line = document.createElement('div');
				var spots = lines[c + ':' + r] || [];

				line.className = 'sg-hack-line';
				for (var x = 0; x < width; x++) {
					var spot = spots.filter(function (s) {
						return s.from === x;
					})[0];
					var span = document.createElement('span');

					if (spot) {
						span.className = 'sg-hack-word';
						span.textContent = spot.word;
						span.setAttribute('data-word', spot.word);
						x = spot.to - 1;
					} else {
						span.className = 'sg-hack-c';
						span.textContent = chars[Math.floor(Math.random() * chars.length)];
					}
					line.appendChild(span);
				}
				column.appendChild(line);
			}
			field.appendChild(column);
		}
	}

	function hackText(text, values) {
		return Object.keys(values).reduce(function (result, name) {
			return result.split('{' + name + '}').join(String(values[name]));
		}, String(text));
	}

	function hackOption(a, name) {
		return a[name] === undefined ? hackDefaults[name] : a[name];
	}

	function hackShowTries(run) {
		var a = run.a;
		var show = String(a.triesshow || 'text');
		var el = run.tries;

		el.textContent = '';
		if (show !== 'boxes') {
			var text = document.createElement('div');

			text.textContent = hackText(hackOption(a, 'triestext'), {'попытки': run.left});
			el.appendChild(text);
		}
		if (show !== 'text') {
			var boxes = document.createElement('div');

			boxes.className = 'sg-hack-boxes';
			for (var i = 0; i < run.attempts; i++) {
				var box = document.createElement('span');

				box.className = 'sg-hack-box' + (i < run.left ? ' sg-on' : '');
				boxes.appendChild(box);
			}
			el.appendChild(boxes);
		}
	}

	function hackRunCode(code) {
		if (code && !preview) {
			Wikifier.wikifyEval(code);
		}
	}

	function hackClear() {
		cancelAnimationFrame(hackFrame);
		hackLayers.forEach(function (el) {
			el.remove();
		});
		hackLayers = [];
	}

	function hackLayer(className, time, keep) {
		var win = document.getElementById('passages');
		var rect = win ? win.getBoundingClientRect() : {left: 0, top: 0, width: window.innerWidth, height: window.innerHeight};
		var el = document.createElement('div');

		el.className = className;
		el.style.left = rect.left + 'px';
		el.style.top = rect.top + 'px';
		el.style.width = rect.width + 'px';
		el.style.height = rect.height + 'px';
		document.body.appendChild(el);
		hackLayers.push(el);
		setTimeout(function () {
			el.remove();
			hackLayers = hackLayers.filter(function (other) {
				return other !== el;
			});
			if (keep) {
				keep();
			}
		}, time);
		return el;
	}

	// Рябь: тот же приём, что у помех первого посещения, но по всему окну
	// терминала и слоем сверху: фильтр на #passages сдвинул бы кнопки на экране.
	function hackRipple(time) {
		var ns = 'http://www.w3.org/2000/svg';
		var svg = document.createElementNS(ns, 'svg');
		var filter = document.createElementNS(ns, 'filter');
		var noise = document.createElementNS(ns, 'feTurbulence');
		var map = document.createElementNS(ns, 'feDisplacementMap');
		var layer = hackLayer('sg-hack-layer', time, function () {
			svg.remove();
		});
		var begin = performance.now();

		svg.setAttribute('width', '0');
		svg.setAttribute('height', '0');
		svg.style.position = 'absolute';
		filter.setAttribute('id', 'sg-hack-ripple');
		filter.setAttribute('color-interpolation-filters', 'sRGB');
		noise.setAttribute('type', 'fractalNoise');
		noise.setAttribute('baseFrequency', '0.004 0.2');
		noise.setAttribute('numOctaves', '2');
		noise.setAttribute('result', 'n');
		map.setAttribute('in', 'SourceGraphic');
		map.setAttribute('in2', 'n');
		map.setAttribute('xChannelSelector', 'R');
		map.setAttribute('yChannelSelector', 'G');
		filter.appendChild(noise);
		filter.appendChild(map);
		svg.appendChild(filter);
		document.body.appendChild(svg);
		hackLayers.push(svg);
		layer.style.backdropFilter = 'url(#sg-hack-ripple)';
		(function step(now) {
			var part = Math.min(1, (now - begin) / time);

			noise.setAttribute('seed', String(Math.floor(now / 50) % 100));
			map.setAttribute('scale', String(70 * (1 - part)));
			if (part < 1 && layer.isConnected) {
				hackFrame = requestAnimationFrame(step);
			}
		})(begin);
	}

	function hackReact(run) {
		var a = run.a;
		var time = hackNumber(a.misstime, hackDefaults.misstime, 0.1) * 1000;
		var color = String(hackOption(a, 'misscolor'));
		var fx = String(a.missfx || '');
		var flash = String(hackOption(a, 'fxcolor'));

		// В предпросмотре <<sg-sound>> нет: он объявлен после границы предпросмотра.
		if (a.misssound && !preview) {
			Wikifier.wikifyEval('<<sg-sound ' + JSON.stringify(String(a.misssound)) + ' volume ' + hackNumber(a.missvolume, hackDefaults.missvolume, 0) + '>>');
		}
		if (fx === 'flash' || fx === 'flicker') {
			var layer = hackLayer('sg-hack-layer', time);

			layer.style.backgroundColor = flash;
			layer.style.opacity = '0';
			layer.style.animation = 'sg-hack-' + fx + ' ' + time + 'ms linear';
		} else if (fx === 'ripple') {
			hackRipple(time);
		}
		if (a.missplace === 'over') {
			var over = hackLayer('sg-hack-over', time);

			over.style.color = color;
			over.style.fontSize = hackNumber(a.misssize, hackDefaults.missover, 1) + 'px';
			over.textContent = String(hackOption(a, 'misslabel'));
		} else if (run.label) {
			run.label.classList.add('sg-on');
			clearTimeout(run.labelTimer);
			run.labelTimer = setTimeout(function () {
				run.label.classList.remove('sg-on');
			}, time);
		}
	}

	function hackFinal(run, text) {
		var field = run.field;

		run.over = true;
		if (field.isConnected) {
			field.style.minHeight = field.offsetHeight + 'px';
			field.style.minWidth = field.offsetWidth + 'px';
			field.style.boxSizing = 'border-box';
		}
		field.style.gridTemplateColumns = '';
		field.classList.add('sg-hack-final');
		field.textContent = text;
	}

	function hackLeave(run, to) {
		var box = run.box;

		if (!to || preview) {
			return;
		}
		setTimeout(function () {
			if (box.isConnected && Story.has(String(to))) {
				accessGo(String(to), 'auto', 'hack:' + run.screen);
			}
		}, hackNumber(run.a.delay, hackDefaults.delay, 0) * 1000);
	}

	function hackChoose(run, word) {
		var a = run.a;
		var guess = word.getAttribute('data-word');

		run.left--;
		word.classList.add('sg-hack-used');
		if (a.usedglitch) {
			word.classList.add('glitchy');
			word.setAttribute('data-text', guess);
		}
		if (guess === run.key) {
			if (!preview) {
				var memo = varObject('sgHack')[run.screen];

				memo.done = 1;
				if (a.win && Story.has(String(a.win))) {
					memo.win = String(a.win);
				}
			}
			hackRunCode(run.code.win);
			run.hint.textContent = '';
			run.tries.textContent = String(hackOption(a, 'winnote'));
			hackFinal(run, hackText(hackOption(a, 'wintext'), {'слово': run.key}));
			saveVars();
			hackLeave(run, a.win);
			return;
		}

		var key = hackChars(run.key);
		var same = hackChars(guess).filter(function (ch, i) {
			return ch === key[i];
		}).length;

		// Ошибка считается всегда, в том числе последняя.
		hackRunCode(run.code.miss);
		run.hint.textContent = hackText(hackOption(a, 'hinttext'), {'совпало': same, 'всего': key.length, 'слово': guess});
		hackShowTries(run);
		if (run.left > 0) {
			hackReact(run);
			return;
		}
		hackRunCode(run.code.fail);
		run.hint.textContent = '';
		hackFinal(run, String(hackOption(a, 'failtext')));
		saveVars();
		hackLeave(run, a.fail);
	}

	Macro.add('sg-hack', {
		tags: ['sg-hack-win', 'sg-hack-fail', 'sg-hack-miss'],
		handler: function () {
			var a = blockArgs(this, [], hackKeys, ['frame', 'usedglitch']);
			var screen = State.passage;
			var store = varObject('sgHack');
			var memo = store[screen] || (store[screen] = {});
			var run = {a: a, code: {}, screen: screen, over: false};
			var box = document.createElement('div');
			var slots = {};

			this.payload.slice(1).forEach(function (part) {
				run.code[part.name.slice('sg-hack-'.length)] = trimContent(part.contents);
			});
			['top', 'left', 'right', 'bottom'].forEach(function (place) {
				slots[place] = document.createElement('div');
				slots[place].className = 'sg-hack-slot sg-hack-' + place;
				box.appendChild(slots[place]);
			});
			box.className = 'sg-hack' + (a.frame ? ' sg-hack-framed' : '');
			if (a.size) {
				box.style.fontSize = Number(a.size) + 'px';
			}
			if (a.light) {
				box.style.setProperty('--sg-hack-light', String(a.light));
			}
			run.box = box;
			run.field = document.createElement('div');
			run.field.className = 'sg-hack-field';
			run.hint = document.createElement('div');
			run.hint.className = 'sg-hack-hint';
			run.tries = document.createElement('div');
			run.tries.className = 'sg-hack-tries';
			box.appendChild(run.field);
			(slots[String(a.hint)] || slots.bottom).appendChild(run.hint);
			(slots[String(a.tries)] || slots.bottom).appendChild(run.tries);
			if (a.missplace && slots[String(a.missplace)]) {
				run.label = document.createElement('div');
				run.label.className = 'sg-hack-label';
				run.label.style.color = String(hackOption(a, 'misscolor'));
				run.label.style.fontSize = hackNumber(a.misssize, hackDefaults.misssize, 1) + 'px';
				run.label.textContent = String(hackOption(a, 'misslabel'));
				slots[String(a.missplace)].appendChild(run.label);
			}
			this.output.appendChild(box);

			// Экран взломан, а показан всё равно (например, после сбоя): ведём дальше.
			if (memo.done && !preview) {
				run.key = memo.last;
				hackFinal(run, hackText(hackOption(a, 'wintext'), {'слово': memo.last || ''}));
				run.tries.textContent = String(hackOption(a, 'winnote'));
				if (memo.win) {
					setTimeout(function () {
						if (box.isConnected) {
							accessGo(memo.win, 'auto', 'hack:' + screen);
						}
					}, Engine.DOM_DELAY);
				}
				return;
			}

			if (a.misssound && !preview) {
				signalFor(String(a.misssound));
			}

			var all = hackList(a.words);
			var fixed = a.key === undefined ? '' : String(a.key).trim();
			var count = hackNumber(a.count, hackDefaults.count, 1);

			if (fixed && all.indexOf(fixed) === -1) {
				all.push(fixed);
			}
			if (!all.length) {
				return;
			}

			var picked = hackPick(all, fixed, count, memo.last);

			run.key = picked.key;
			run.words = hackShuffle(picked.words.slice(1));
			run.words.unshift(picked.key);
			run.attempts = hackNumber(a.attempts, hackDefaults.attempts, 1);
			run.left = run.attempts;
			memo.last = picked.key;
			hackDraw(run);
			hackShowTries(run);
			run.field.addEventListener('click', function (ev) {
				var word = ev.target.closest ? ev.target.closest('.sg-hack-word') : null;

				if (word && !run.over && !word.classList.contains('sg-hack-used')) {
					uiClick(word);
					hackChoose(run, word);
				}
			});
		}
	});

	$(document).on(':passageinit', hackClear);

	/* ----- Закрытые экраны (шаг 4.3) ----- */

	// Экран с тегом sg-access: <<sg-access слова>>условие<<sg-rule …>><</sg-access>>.
	// Условие верно — экран открыт. Пока оно ложно, каждый источник (ссылка,
	// код, клавиша мастера, событие, таймер, тревога, цепочка видео) ведёт себя,
	// как задано: hide, off, block, pass, wrong, denied, stay. Общий пассаж
	// блокировки — пассаж с тегом sg-lock.
	var accessCollect = null;
	var accessTable = null;
	var accessSkip = false;
	var accessLink = null;

	Macro.add('sg-access', {
		tags: ['sg-rule'],
		handler: function () {
			if (!accessCollect) {
				return;
			}

			var a = blockArgs(this, [], ['lock', 'links', 'codes', 'keys', 'events', 'auto'], []);
			var rec = {
				name: accessCollect.name,
				expr: this.payload[0].contents.trim(),
				lock: a.lock === undefined ? '' : String(a.lock),
				groups: {
					link: a.links || 'hide',
					code: a.codes || 'block',
					key: a.keys || 'pass',
					event: a.events || 'pass',
					auto: a.auto || 'pass'
				},
				rules: {}
			};

			this.payload.slice(1).forEach(function (part) {
				var kind = String(part.args[0]);
				var o = blockArgs({args: part.args.slice(2)}, [], ['from', 'do', 'to'], []);
				var id = String(part.args[1]);

				if (kind === 'link') {
					id = String(o.from) + '\n' + id;
				} else if (kind === 'key') {
					id = comboName(id);
				}
				rec.rules[kind + '\n' + id] = {action: String(o['do']), to: o.to === undefined ? '' : String(o.to)};
			});
			accessCollect.table[rec.name] = rec;
		}
	});

	function access() {
		if (accessTable) {
			return accessTable;
		}
		accessTable = {};
		Story.filter(function (p) {
			return p.tags.indexOf('sg-access') !== -1;
		}).forEach(function (p) {
			var open = p.text.indexOf('<<sg-access');
			var close = p.text.indexOf('<</sg-access>>', open);

			if (open === -1 || close === -1) {
				return;
			}
			accessCollect = {name: p.title, table: accessTable};
			try {
				new Wikifier(document.createDocumentFragment(), p.text.slice(open, close + '<</sg-access>>'.length));
			} catch (e) {
				console.error('СИГНАЛЫ: доступ к экрану «' + p.title + '»', e);
			}
			accessCollect = null;
		});
		return accessTable;
	}

	function accessClosed(title) {
		var rec = access()[title];

		if (!rec || rec.expr === '') {
			return false;
		}
		try {
			return !Scripting.evalTwineScript(rec.expr);
		} catch (e) {
			if (!rec.failed) {
				rec.failed = true;
				console.error('СИГНАЛЫ: условие доступа к экрану «' + title + '»', e);
			}
			return false;
		}
	}

	function accessRule(title, kind, id) {
		var rec = access()[title];

		return rec.rules[kind + '\n' + id] || {action: rec.groups[kind] || 'pass', to: ''};
	}

	// Куда уводит блокировка: свой пассаж источника, экрана, общий.
	function accessLock(title, rule) {
		var rec = access()[title];
		var shared = Story.filter(function (p) {
			return p.tags.indexOf('sg-lock') !== -1;
		});
		var to = rule.to || rec.lock || (shared.length ? shared[0].title : '');

		return to && to !== title && Story.has(to) ? to : '';
	}

	// Куда на самом деле вести; null — остаться на месте.
	function accessRoute(dest, kind, id) {
		var from = State.passage;

		if (preview || restoring || !from || dest === from || !accessClosed(dest)) {
			return dest;
		}

		var rule = accessRule(dest, kind, id);

		if (rule.action === 'pass') {
			return dest;
		}
		if (rule.action === 'stay') {
			return null;
		}

		var lock = accessLock(dest, rule);

		if (!lock || lock === from) {
			return null;
		}
		// «Вернуться на экран, где были» ведёт туда, откуда пришли (ответ 5А).
		State.variables.sgEventFrom = from;
		return lock;
	}

	function accessGo(dest, kind, id) {
		var to = accessRoute(dest, kind, id);

		if (to === null) {
			return false;
		}
		accessSkip = true;
		try {
			Engine.play(to);
		} finally {
			accessSkip = false;
		}
		return true;
	}

	// Код ведёт на закрытый экран: true — код не принят (действия не выполнены,
	// одноразовый не потрачен).
	function accessEarly(dest, code, refuse) {
		if (preview || !dest || !Story.has(dest) || dest === State.passage || !accessClosed(dest)) {
			return false;
		}

		var rule = accessRule(dest, 'code', code);

		if (rule.action === 'pass') {
			return false;
		}
		if (rule.action === 'denied') {
			refuse.denied();
			return true;
		}
		if (rule.action === 'block' && accessLock(dest, rule) && accessGo(dest, 'code', code)) {
			return true;
		}
		refuse.wrong();
		return true;
	}

	// Событие на закрытый экран с поведением «ждать».
	function accessWaits(name) {
		return !!access()[name] && accessClosed(name) && accessRule(name, 'event', '').action === 'stay';
	}

	function accessLinkId(el) {
		var label = el.getAttribute('data-sg-label');

		return State.passage + '\n' + (label === null ? el.textContent : label).replace(/\s+/g, ' ').trim();
	}

	// Поведение ссылки: своё правило или общее. Пока надпись печатается, она
	// совпадает с правилом только началом.
	function accessLinkRule(title, el) {
		var rec = access()[title];
		var id = accessLinkId(el);
		var key = 'link\n' + id;

		if (rec.rules[key]) {
			return rec.rules[key];
		}
		if (el.closest('.macro-type:not(.macro-type-done):not(.macro-type-target)')) {
			var keys = Object.keys(rec.rules);

			for (var i = 0; i < keys.length; i++) {
				if (keys[i].indexOf(key) === 0) {
					return rec.rules[keys[i]];
				}
			}
		}
		return {action: rec.groups.link || 'hide', to: ''};
	}

	function accessLineEdge(node, side) {
		var next = node[side];

		while (
			next &&
			((next.nodeType === 3 && next.nodeValue.trim() === '') ||
				(next.nodeType === 1 && next.classList.contains('sg-acc-hide')))
		) {
			next = next[side];
		}
		return next;
	}

	// В обёртке нет ничего, кроме node и уже скрытого.
	function accessOnly(span, node) {
		for (var c = span.firstChild; c; c = c.nextSibling) {
			var empty =
				c === node ||
				(c.nodeType === 3 && c.nodeValue.trim() === '') ||
				(c.nodeType === 1 && (c.tagName === 'BR' || c.classList.contains('sg-acc-hide')));

			if (!empty) {
				return false;
			}
		}
		return true;
	}

	function isBr(node) {
		return !!node && node.nodeType === 1 && node.tagName === 'BR';
	}

	// Ответ 4А: ссылка исчезает вместе с обёрткой вида и переводом строки, если
	// в строке больше ничего нет; кнопка на экране исчезает целиком.
	function accessHide(el) {
		var top = el.closest('.sg-place, .sg-art-item, .sg-list-item');

		if (top) {
			top.classList.add('sg-acc-hide');
			return;
		}
		top = el;
		while (top.parentNode.tagName === 'SPAN' && accessOnly(top.parentNode, top)) {
			top = top.parentNode;
		}
		top.classList.add('sg-acc-hide');

		var before = accessLineEdge(top, 'previousSibling');
		var after = accessLineEdge(top, 'nextSibling');

		if ((before && !isBr(before)) || (after && !isBr(after))) {
			return;
		}
		if (isBr(after)) {
			after.classList.add('sg-acc-hide');
		} else if (isBr(before)) {
			before.classList.add('sg-acc-hide');
		}
	}

	function accessScan() {
		var marked = document.querySelectorAll('.sg-acc-hide, .sg-acc-off');

		for (var i = 0; i < marked.length; i++) {
			var el = marked[i];

			el.classList.remove('sg-acc-hide');
			if (el.classList.contains('sg-acc-off')) {
				el.classList.remove('sg-acc-off');
				el.removeAttribute('aria-disabled');
				el.setAttribute('tabindex', '0');
			}
		}

		var links = document.querySelectorAll('a[data-passage], button[data-passage]');

		for (var j = 0; j < links.length; j++) {
			var link = links[j];
			var title = link.getAttribute('data-passage');

			if (!access()[title] || title === State.passage || !accessClosed(title)) {
				continue;
			}

			var rule = accessLinkRule(title, link);
			var action = rule.action;

			// Некуда вести — ссылка просто не нажимается.
			if (action === 'block' && !accessLock(title, rule)) {
				action = 'off';
			}
			if (action === 'hide') {
				accessHide(link);
			} else if (action === 'off') {
				link.classList.add('sg-acc-off');
				link.setAttribute('aria-disabled', 'true');
				link.setAttribute('tabindex', '-1');
			}
		}

		// Шаг 4.4: раздел, в котором все статьи скрыты, исчезает с заголовком.
		var sections = document.querySelectorAll('.sg-art-section');

		for (var k = 0; k < sections.length; k++) {
			if (!sections[k].querySelector('.sg-art-item:not(.sg-acc-hide)')) {
				sections[k].classList.add('sg-acc-hide');
			}
		}
	}

	/* ----- Строка событий и цикл (шаг 4.1) ----- */

	// Настройки — пассаж с тегом sg-ticker: <<sg-ticker>>, <<sg-cycle>>,
	// <<sg-cycle-at>>, <<sg-news>>. Строка стоит только на одном экране
	// (главном); условия и смена цикла проверяются всё время, на любом экране.
	// $sgTicker = {msgs: {имя: {at, shown}}, cycle, seen}: когда сообщение
	// включилось и сколько раз показано; цикл сейчас; цикл, который видели.
	var tickerCollect = null;
	var tickerTable = null;
	var tickerStrip = null;
	var tickerLine = null;
	var tickerNum = null;
	var tickerSpin = null;
	var tk = {phase: 'idle', at: 0, cur: null, old: null, round: {}, active: [], live: {}, general: null};

	engineStyle.textContent +=
		'#sg-ticker { position: sticky; top: calc(-1 * var(--sg-win-padding, 20px)); z-index: 10; display: flex; gap: 6px; box-sizing: border-box; ' +
		'padding: 4px; margin: calc(-1 * var(--sg-win-padding, 20px)) calc(-1 * var(--sg-win-padding, 20px)) 8px; ' +
		'background: var(--sg-win-bg, #000); line-height: 1.2; }\n' +
		'.sg-tk-box { box-sizing: border-box; background: var(--sg-win-bg, #000); ' +
		'border: var(--sg-border-width, 2px) solid var(--sg-border-color, currentColor); ' +
		'box-shadow: 0 0 var(--sg-glow-size, 0) var(--sg-glow-color, transparent); }\n' +
		'.sg-tk-line { flex: 1 1 auto; min-width: 0; position: relative; overflow: hidden; }\n' +
		'.sg-tk-msg { position: absolute; left: 10px; top: 50%; white-space: nowrap; will-change: transform, opacity; }\n' +
		'.sg-tk-cycle { flex: 0 0 auto; display: flex; align-items: center; gap: 0.5em; padding: 0 12px; white-space: nowrap; }\n' +
		'.sg-tk-num span { display: inline-block; width: 1ch; text-align: center; }\n';

	Macro.add('sg-ticker', {
		handler: function () {
			if (tickerCollect) {
				tickerCollect.line = blockArgs(this, [], ['screen', 'height', 'size', 'font', 'speed', 'pause', 'hold', 'change', 'mode', 'order'], []);
			}
		}
	});

	Macro.add('sg-cycle', {
		handler: function () {
			if (tickerCollect) {
				tickerCollect.cycle = blockArgs(this, [], ['var', 'spin', 'gap', 'from', 'to', 'rate', 'sound', 'volume', 'font'], []);
			}
		}
	});

	Macro.add('sg-cycle-at', {
		handler: function () {
			if (tickerCollect) {
				var a = blockArgs(this, ['progress', 'value'], [], []);

				tickerCollect.rows.push({progress: Number(a.progress) || 0, value: String(a.value === undefined ? '' : a.value)});
			}
		}
	});

	Macro.add('sg-news', {
		tags: ['sg-text'],
		handler: function () {
			if (!tickerCollect) {
				return;
			}

			var a = blockArgs(this, ['name'], ['priority', 'minutes', 'times', 'color', 'effect'], ['general', 'bold', 'italic']);

			a.name = String(a.name === undefined ? '' : a.name);
			a.expr = this.payload[0].contents.trim();
			a.text = this.payload[1] ? this.payload[1].contents.trim() : '';
			a.priority = Number(a.priority) || 0;
			a.minutes = Number(a.minutes) || 0;
			a.times = Number(a.times) || 0;
			a.index = tickerCollect.news.length;
			tickerCollect.news.push(a);
		}
	});

	function ticker() {
		if (tickerTable !== null) {
			return tickerTable;
		}

		var t = {line: null, cycle: null, rows: [], news: []};

		tickerCollect = t;
		Story.filter(function (p) {
			return p.tags.indexOf('sg-ticker') !== -1;
		}).forEach(function (p) {
			try {
				new Wikifier(document.createDocumentFragment(), p.text);
			} catch (e) {
				console.error('СИГНАЛЫ: строка событий', e);
			}
		});
		tickerCollect = null;
		if (!t.line) {
			tickerTable = false;
			return false;
		}

		var a = t.line;
		var number = function (value, fallback) {
			var n = Number(value);

			return value === undefined || isNaN(n) ? fallback : n;
		};

		t.line = {
			screen: String(a.screen || ''),
			height: number(a.height, 48),
			size: number(a.size, 22),
			font: String(a.font || ''),
			speed: Math.max(1, number(a.speed, 60)),
			pause: number(a.pause, 2),
			hold: number(a.hold, 8),
			change: number(a.change, 1.5),
			mode: a.mode === 'scroll' ? 'scroll' : 'fade',
			order: String(a.order || 'new,general,seen').split(',')
		};
		if (t.cycle) {
			t.cycle.name = String(t.cycle['var'] || '').replace(/^\$/, '');
			t.cycle.spin = number(t.cycle.spin, 10);
			t.cycle.gap = Math.max(0, number(t.cycle.gap, 0.5));
			// rate — запись сборок до сессии 15: одна скорость в начале на все цифры.
			var firstRate = number(t.cycle.rate, 20);

			t.cycle.from = digitRates(t.cycle.from, firstRate);
			t.cycle.to = digitRates(t.cycle.to, t.cycle.rate === undefined ? 2 : Math.max(1, Math.round(firstRate / 15)));
			t.cycle.volume = number(t.cycle.volume, 100);
			// Сессия 26: цифры цикла — шрифтом табло (DSEG7), 'none' — как у строки.
			t.cycle.font = t.cycle.font === undefined ? timerDefaults.font : String(t.cycle.font);
			if (!preview && t.cycle.sound) {
				signalFor(String(t.cycle.sound));
			}
			t.rows.sort(function (x, y) {
				return x.progress - y.progress;
			});
		}
		tickerTable = t;
		return t;
	}

	// Скорости пяти цифр слева направо: «20,20,20,20,20», смен в секунду.
	function digitRates(list, fallback) {
		var words = String(list === undefined ? '' : list).split(',');
		var rates = [];

		for (var i = 0; i < 5; i++) {
			var rate = Number(words[i]);

			rates.push(words[i] !== undefined && words[i] !== '' && rate > 0 ? rate : Math.max(0.1, fallback));
		}
		return rates;
	}

	function padCycle(value, length) {
		return String(value).padStart(length, '0');
	}

	// Цикл — строка таблицы с наибольшим прогрессом, не больше текущего.
	function cycleTarget(t) {
		if (!t.cycle || !t.cycle.name) {
			return null;
		}

		var progress = Number(State.variables[t.cycle.name]) || 0;
		var value = '00000';

		t.rows.forEach(function (row) {
			if (row.progress <= progress) {
				value = row.value;
			}
		});
		return padCycle(value, 5);
	}

	function showCycle(value) {
		if (!tickerNum) {
			return;
		}
		tickerNum.textContent = '';
		String(value).split('').forEach(function (digit) {
			var cell = document.createElement('span');

			cell.textContent = digit;
			tickerNum.appendChild(cell);
		});
	}

	// Меняются только разряды, начиная с первого изменившегося слева. Самая
	// правая цифра останавливается через spin секунд, каждая следующая левее —
	// ещё через gap секунд. Скорость цифры идёт от from к to за всё её время.
	function startSpin(from, to, t) {
		var length = Math.max(from.length, to.length);
		var a = padCycle(from, length);
		var b = padCycle(to, length);
		var first = 0;
		var cells = [];
		var duration = Math.max(0, t.cycle.spin) * 1000;
		var gap = t.cycle.gap * 1000;

		while (first < length && a.charAt(first) === b.charAt(first)) {
			first++;
		}
		for (var i = first; i < length; i++) {
			var slot = i - length + 5;

			cells.push({
				index: i,
				stop: duration + (length - 1 - i) * gap,
				from: t.cycle.from[slot],
				to: t.cycle.to[slot],
				next: 0
			});
		}
		tickerSpin = {to: b, digits: a.split(''), cells: cells, start: performance.now()};
		showCycle(a);
	}

	function spinFrame(now) {
		var spin = tickerSpin;

		if (!spin) {
			return;
		}

		var elapsed = now - spin.start;
		var left = 0;
		var changed = false;

		spin.cells.forEach(function (cell) {
			if (cell.done) {
				return;
			}
			if (elapsed >= cell.stop) {
				cell.done = true;
				spin.digits[cell.index] = spin.to.charAt(cell.index);
				changed = true;
				return;
			}
			left++;
			if (now < cell.next) {
				return;
			}

			var digit = Math.floor(Math.random() * 9);

			spin.digits[cell.index] = String(digit >= Number(spin.digits[cell.index]) ? digit + 1 : digit);
			cell.next = now + 1000 / (cell.from + (cell.to - cell.from) * (elapsed / cell.stop));
			changed = true;
		});
		if (changed) {
			showCycle(spin.digits.join(''));
		}
		if (left === 0) {
			tickerSpin = null;
			showCycle(spin.to);
			varObject('sgTicker').seen = spin.to;
			saveVars();
		}
	}

	function newsTrue(n) {
		if (n.expr === '') {
			return true;
		}
		try {
			return !!Scripting.evalTwineScript(n.expr);
		} catch (e) {
			if (!n.failed) {
				n.failed = true;
				console.error('СИГНАЛЫ: условие сообщения «' + n.name + '»', e);
			}
			return false;
		}
	}

	// Какие сообщения можно показывать: из общих — только включившееся последним
	// (новое общее сменяет старое).
	function tickerRefresh(t, marks, now) {
		var live = {};
		var fresh = [];
		var general = null;

		t.news.forEach(function (n) {
			var m = marks[n.name];

			if (!m || (n.minutes > 0 && now >= m.at + n.minutes * 60000)) {
				return;
			}
			live[n.name] = true;
			if (n.times > 0 && m.shown >= n.times) {
				return;
			}
			if (n.general && (!general || m.at >= marks[general.name].at)) {
				general = n;
			}
			fresh.push(n);
		});
		tk.live = live;
		tk.general = general;
		tk.active = fresh.filter(function (n) {
			return !n.general || n === general;
		});
	}

	function tickerCheck() {
		if (restoring || !State.passage || (!preview && !started) || (Engine.isIdle && !Engine.isIdle())) {
			return;
		}

		var t = ticker();

		if (!t) {
			return;
		}

		var store = varObject('sgTicker');
		var marks = store.msgs || (store.msgs = {});
		var now = Date.now();
		var changed = false;

		t.news.forEach(function (n) {
			var on = newsTrue(n);

			if (on && !marks[n.name]) {
				marks[n.name] = {at: now, shown: 0};
				changed = true;
			} else if (!on && marks[n.name]) {
				delete marks[n.name];
				delete tk.round[n.name];
				changed = true;
			}
		});
		tickerRefresh(t, marks, now);

		var target = cycleTarget(t);

		if (target !== null) {
			if (store.cycle === undefined) {
				store.cycle = target;
				store.seen = target;
				changed = true;
			} else if (store.cycle !== target) {
				store.cycle = target;
				changed = true;
			}
			if (tickerStrip && tickerStrip.isConnected) {
				if (store.seen !== target && (!tickerSpin || tickerSpin.to !== target)) {
					startSpin(tickerSpin ? tickerNum.textContent : store.seen, target, t);
					// Звук — когда игроки видят счётчик (ответ 7б, сессия 15).
					if (!preview && t.cycle.sound) {
						var audio = signalFor(String(t.cycle.sound));

						audio.volume = Math.max(0, Math.min(1, t.cycle.volume / 100));
						audio.currentTime = 0;
						audio.play().catch(function () {});
					}
				} else if (store.seen === target && !tickerSpin && tickerNum.textContent !== target) {
					showCycle(target);
				}
			}
		}
		if (changed) {
			saveVars();
		}
	}

	function tickerFont(font) {
		return !font ? '' : /[\/\\]/.test(font) ? timerFont(font) : '"' + font + '", monospace';
	}

	function buildTicker(t) {
		var strip = document.createElement('div');

		strip.id = 'sg-ticker';
		strip.style.fontSize = t.line.size + 'px';
		strip.style.fontFamily = tickerFont(t.line.font);
		tickerLine = document.createElement('div');
		tickerLine.className = 'sg-tk-box sg-tk-line';
		tickerLine.style.height = t.line.height + 'px';
		strip.appendChild(tickerLine);
		if (t.cycle) {
			var cycle = document.createElement('div');

			cycle.className = 'sg-tk-box sg-tk-cycle';
			cycle.style.height = t.line.height + 'px';
			cycle.textContent = 'Цикл';
			tickerNum = document.createElement('span');
			tickerNum.className = 'sg-tk-num';
			tickerNum.style.fontFamily = timerFont(t.cycle.font);
			cycle.appendChild(tickerNum);
			strip.appendChild(cycle);
		}
		tickerStrip = strip;
	}

	function tickerClear() {
		tk.phase = 'idle';
		tk.cur = null;
		tk.old = null;
		tickerSpin = null;
		if (tickerLine) {
			tickerLine.textContent = '';
		}
	}

	function placeTicker() {
		var t = ticker();

		if (!t) {
			return;
		}

		var root = document.documentElement;
		var passages = document.getElementById('passages');

		if (State.passage !== t.line.screen) {
			if (tickerStrip && tickerStrip.parentNode) {
				tickerStrip.parentNode.removeChild(tickerStrip);
			}
			tickerClear();
			root.style.removeProperty('--sg-place-shift');
			return;
		}
		if (!tickerStrip) {
			buildTicker(t);
		}

		var fresh = !tickerStrip.isConnected && tk.phase === 'idle';

		passages.insertBefore(tickerStrip, passages.firstChild);
		root.style.setProperty('--sg-place-shift', t.line.height + 12 + 'px');

		if (fresh && t.cycle) {
			var store = varObject('sgTicker');

			showCycle(store.seen !== undefined ? store.seen : cycleTarget(t));
		}
	}

	function msgPlace(item, x, opacity) {
		item.el.style.transform = 'translate(' + x + 'px, -50%)';
		item.el.style.opacity = opacity;
	}

	function buildMsg(n) {
		var el = document.createElement('span');
		var inner = document.createElement('span');

		el.className = 'sg-tk-msg';
		if (n.color) {
			inner.style.color = String(n.color);
		}
		if (n.bold) {
			inner.style.fontWeight = 'bold';
		}
		if (n.italic) {
			inner.style.fontStyle = 'italic';
		}
		$(inner).wiki(n.text);
		if (n.effect === 'blink') {
			inner.className = 'sg-blink';
		} else if (n.effect === 'glitch') {
			inner.className = 'glitchy';
			inner.setAttribute('data-text', inner.textContent);
		}
		el.appendChild(inner);
		tickerLine.appendChild(el);
		return {news: n, el: el, width: el.getBoundingClientRect().width, x: 0};
	}

	function tickerPick(t) {
		if (!tk.active.length) {
			return null;
		}

		var marks = varObject('sgTicker').msgs || {};
		var rank = function (n) {
			var name = !(marks[n.name] && marks[n.name].shown) ? 'new' : n.general ? 'general' : 'seen';

			return t.line.order.indexOf(name);
		};
		var list = tk.active.slice().sort(function (x, y) {
			return rank(x) - rank(y) || y.priority - x.priority || x.index - y.index;
		});

		for (var i = 0; i < list.length; i++) {
			if (!tk.round[list[i].name]) {
				return list[i];
			}
		}
		tk.round = {};
		return list[0];
	}

	function countShow(t, n) {
		var marks = varObject('sgTicker').msgs || {};

		tk.round[n.name] = 1;
		if (marks[n.name]) {
			marks[n.name].shown = (marks[n.name].shown || 0) + 1;
			tickerRefresh(t, marks, Date.now());
			saveVars();
		}
	}

	function tickerEnter(t, n, now) {
		tk.cur = buildMsg(n);
		countShow(t, n);
		tk.phase = 'in';
		tk.at = now;
		msgPlace(tk.cur, t.line.mode === 'scroll' ? tickerLine.clientWidth : 0, t.line.mode === 'scroll' ? 1 : 0);
	}

	function tickerDrop(item) {
		if (item && item.el.parentNode) {
			item.el.parentNode.removeChild(item.el);
		}
	}

	// Текущее сообщение отстояло или его пора убрать: следующее — через смену.
	function tickerNext(t, now) {
		var n = tickerPick(t);

		if (n && tk.cur && n === tk.cur.news && tk.cur.x === 0) {
			countShow(t, n);
			tickerDrop(tk.cur);
			tk.cur = buildMsg(n);
			msgPlace(tk.cur, 0, 1);
			tk.phase = 'hold';
			tk.at = now;
			return;
		}
		if (t.line.mode === 'scroll' && n) {
			tk.old = tk.cur;
			tickerEnter(t, n, now);
			return;
		}
		tk.phase = 'out';
		tk.at = now;
	}

	function tickerFrame(now) {
		requestAnimationFrame(tickerFrame);

		var t = tickerTable;

		if (!t || !tickerStrip || !tickerStrip.isConnected) {
			return;
		}
		spinFrame(now);

		var line = t.line;
		var width = tickerLine.clientWidth - 20;
		var half = (line.change * 1000) / 2 || 1;
		var full = line.change * 1000 || 1;
		var cur = tk.cur;

		if (tk.phase === 'idle') {
			var n = tickerPick(t);

			if (n) {
				tickerEnter(t, n, now);
			}
			return;
		}
		if (cur && (tk.phase === 'hold' || tk.phase === 'run')) {
			var gone = !tk.live[cur.news.name] || (cur.news.general && tk.general && tk.general !== cur.news);

			if (gone) {
				tickerNext(t, now);
				return;
			}
		}
		if (tk.phase === 'in') {
			var enter = (now - tk.at) / (line.mode === 'scroll' ? full : half);

			if (enter >= 1) {
				tickerDrop(tk.old);
				tk.old = null;
				msgPlace(cur, 0, 1);
				tk.phase = 'hold';
				tk.at = now;
			} else if (line.mode === 'scroll') {
				msgPlace(cur, (1 - enter) * tickerLine.clientWidth, 1);
				if (tk.old) {
					msgPlace(tk.old, tk.old.x - enter * tickerLine.clientWidth, 1);
				}
			} else {
				msgPlace(cur, 0, enter);
			}
		} else if (tk.phase === 'hold') {
			var over = cur.width > width;

			if (now - tk.at >= (over ? line.pause : line.hold) * 1000) {
				if (over) {
					tk.phase = 'run';
					tk.at = now;
				} else {
					tickerNext(t, now);
				}
			}
		} else if (tk.phase === 'run') {
			cur.x = -((now - tk.at) / 1000) * line.speed;
			if (cur.x <= -(cur.width + 10)) {
				tickerDrop(cur);
				tk.cur = null;
				tk.phase = 'idle';
			} else {
				msgPlace(cur, cur.x, 1);
			}
		} else if (tk.phase === 'out') {
			var leave = (now - tk.at) / half;

			if (leave >= 1 || !cur) {
				tickerDrop(cur);
				tk.cur = null;
				tk.phase = 'idle';
			} else {
				msgPlace(cur, cur.x, 1 - leave);
			}
		}
	}

	setup.signaly.tickerCheck = tickerCheck;
	// Предпросмотр окна «Строка событий»: показать смену цикла.
	setup.signaly.cycleDemo = function () {
		var t = ticker();

		if (!t || !t.cycle || !tickerNum) {
			return;
		}

		var to = cycleTarget(t);
		var list = t.rows.map(function (row) {
			return padCycle(row.value, 5);
		});
		var at = list.indexOf(to);
		var other = list[at - 1] || list[at + 1];

		startSpin(other && other !== to ? other : padCycle((Number(to) + 25) % 100000, 5), to, t);
	};
	$(document).on(':passagedisplay', placeTicker);
	$(document).on(':passageend', function () {
		setTimeout(tickerCheck, 0);
	});
	setInterval(tickerCheck, 250);
	requestAnimationFrame(tickerFrame);

	/* ----- Первое посещение (шаг 4.5): элементы экрана возникают постепенно, из
	   белого шума, сквозь помехи или через глитч. Способы — переменные
	   --sg-first-<id> блока оформления, на экране — тег sg-first-<id>. Только при
	   самом первом заходе; после сбоя экран не показывается так заново. */

	var fvPrefix = 'sg-first-';
	var fvNow = null;
	var fvRestored = false;
	// Нельзя переносить или накрывать обёрткой: видео сбросится, фиксированное
	// место собьётся из-за фильтра на родителе.
	var fvKeep = '.sg-place, .sg-alarm, .sg-chain, .sg-camera, video, iframe, [style*="position: fixed"]';
	var fvOwn = fvKeep + ', img, canvas, svg, input, textarea, select, .sg-timer';

	function fvParse(value) {
		var w = String(value || '').trim().split(/\s+/);

		function part(i) {
			return w[i] && w[i] !== '-' ? w[i] : w[0];
		}

		if (w.length < 7) {
			return null;
		}
		return {
			mode: w[0],
			time: Math.max(0.001, Number(w[1]) || 0) * 1000,
			step: Math.max(0, Number(w[2]) || 0) * 1000,
			delay: Math.max(0, Number(w[3]) || 0) * 1000,
			power: Math.max(0, Number(w[4]) || 0),
			color: w[5],
			skip: w[6] === '1',
			parts: {text: part(7), links: part(8), media: part(9), fields: part(10)},
			// Шаг 5.4: громкость и файл (имя закодировано: в нём бывают пробелы).
			volume: w[11] === undefined ? 100 : Number(w[11]),
			sound: w[12] ? decodeURIComponent(w[12]) : ''
		};
	}

	function fvWay(tags) {
		var tag = tags.filter(function (name) {
			return name.indexOf(fvPrefix) === 0;
		})[0];

		return tag ? fvParse(rootStyle.getPropertyValue('--' + tag)) : null;
	}

	function fvKind(el) {
		function has(selector) {
			return el.matches(selector) || !!el.querySelector(selector);
		}

		if (has('img, video, canvas, iframe, svg, .sg-chain')) {
			return 'media';
		}
		if (has('input, textarea, select, .sg-timer')) {
			return 'fields';
		}
		return has('a, button') ? 'links' : 'text';
	}

	function fvItem(el, kind, wrap) {
		var look = getComputedStyle(el);

		return {
			el: el,
			kind: kind,
			wrap: !!wrap,
			style: el.getAttribute('style'),
			inline: look.display === 'inline',
			fixed: look.position === 'fixed',
			staticBox: look.position === 'static',
			bare:
				look.display === 'block' &&
				/^(text|links)$/.test(kind) &&
				look.backgroundColor === 'rgba(0, 0, 0, 0)' &&
				parseFloat(look.borderTopWidth) === 0,
			next: 0
		};
	}

	// Элементы экрана по порядку сверху вниз. Текст одной строки — один элемент,
	// ссылки, кнопки, картинки, поля и блоки — отдельные.
	function fvScan(box, items) {
		var run = [];

		function flush() {
			var visible = run.some(function (node) {
				return /\S/.test(node.textContent);
			});

			if (visible) {
				var wrap = document.createElement('span');

				wrap.className = 'sg-fv';
				run[0].parentNode.insertBefore(wrap, run[0]);
				run.forEach(function (node) {
					wrap.appendChild(node);
				});
				items.push(fvItem(wrap, 'text', true));
			}
			run = [];
		}

		Array.prototype.slice.call(box.childNodes).forEach(function (node) {
			if (node.nodeType === 3) {
				run.push(node);
				return;
			}
			if (node.nodeType !== 1) {
				return;
			}
			if (/^(BR|STYLE|SCRIPT)$/.test(node.tagName) || node.matches('.sg-alarm')) {
				flush();
				return;
			}

			var display = getComputedStyle(node).display;

			if (display === 'none') {
				return;
			}
			if (node.matches(fvOwn)) {
				flush();
				if (node.getClientRects().length) {
					items.push(fvItem(node, fvKind(node)));
				}
			} else if (node.querySelector(fvKeep) || node.matches('.sg-art-list, .sg-art-section, .sg-art-grid, .sg-list-grid')) {
				flush();
				fvScan(node, items);
			} else if (display !== 'inline' || node.matches('a, button') || node.querySelector('a, button')) {
				flush();
				if (node.getClientRects().length && /\S/.test(node.textContent + (node.querySelector('img, svg, canvas') ? 'x' : ''))) {
					items.push(fvItem(node, fvKind(node)));
				}
			} else {
				run.push(node);
			}
		});
		flush();
	}

	function fvRestore(item) {
		if (item.style === null) {
			item.el.removeAttribute('style');
		} else {
			item.el.setAttribute('style', item.style);
		}
	}

	function fvRelease(item) {
		fvRestore(item);
		if (item.wrap && item.el.parentNode) {
			while (item.el.firstChild) {
				item.el.parentNode.insertBefore(item.el.firstChild, item.el);
			}
			item.el.parentNode.removeChild(item.el);
		}
	}

	function fvEnd() {
		if (!fvNow) {
			return;
		}
		fvNow.items.forEach(fvRelease);
		[fvNow.canvas, fvNow.svg].forEach(function (el) {
			if (el.parentNode) {
				el.parentNode.removeChild(el);
			}
		});
		fvNow = null;
	}

	function fvRgb(color) {
		var hex = String(color).replace('#', '');

		return [0, 2, 4].map(function (i) {
			var n = parseInt(hex.substr(i, 2), 16);

			return isNaN(n) ? 255 : n;
		});
	}

	// Узор шума: level — плотность, от 1 (редкие точки) до 8 (сплошной).
	function fvTile(level) {
		var key = level + '-' + Math.floor(Math.random() * 3);

		if (fvNow.tiles[key]) {
			return fvNow.tiles[key];
		}

		var size = 128;
		var tile = document.createElement('canvas');
		var rgb = fvRgb(fvNow.way.color);

		tile.width = size;
		tile.height = size;

		var tileCtx = tile.getContext('2d');
		var image = tileCtx.createImageData(size, size);

		for (var i = 0; i < image.data.length; i += 4) {
			var bright = 0.3 + Math.random() * 0.7;

			image.data[i] = rgb[0] * bright;
			image.data[i + 1] = rgb[1] * bright;
			image.data[i + 2] = rgb[2] * bright;
			image.data[i + 3] = Math.random() < level / 8 ? 255 : 0;
		}
		tileCtx.putImageData(image, 0, 0);
		fvNow.tiles[key] = fvNow.ctx.createPattern(tile, 'repeat');
		return fvNow.tiles[key];
	}

	function fvRects(item) {
		var box = fvNow.box;
		var source = item.el;

		// Блок без своего фона и рамки: шум — по тексту, а не во всю ширину строки.
		if (item.bare) {
			source = document.createRange();
			source.selectNodeContents(item.el);
		}
		return Array.prototype.slice.call(source.getClientRects()).map(function (r) {
			if (item.fixed || !box) {
				return r;
			}

			var top = Math.max(r.top, box.top);
			var bottom = Math.min(r.bottom, box.bottom);

			return {left: r.left, top: top, width: r.width, height: bottom - top};
		}).filter(function (r) {
			return r.width > 0 && r.height > 0;
		});
	}

	function fvNoise(item, level) {
		var ctx = fvNow.ctx;
		var rects = fvRects(item);
		var density = Math.ceil(level * 8);

		if (!rects.length || density < 1) {
			return;
		}
		ctx.save();
		ctx.beginPath();
		rects.forEach(function (r) {
			ctx.rect(r.left, r.top, r.width, r.height);
		});
		ctx.clip();
		ctx.imageSmoothingEnabled = false;
		ctx.translate(Math.floor(Math.random() * 128), Math.floor(Math.random() * 128));
		ctx.scale(2, 2);
		ctx.fillStyle = fvTile(density);
		ctx.fillRect(-128, -128, fvNow.canvas.width, fvNow.canvas.height);
		ctx.restore();
	}

	function fvBands(item, level) {
		var ctx = fvNow.ctx;
		var rgb = fvRgb(fvNow.way.color);

		fvRects(item).forEach(function (r) {
			var count = 1 + Math.floor(Math.random() * 3);

			for (var i = 0; i < count; i++) {
				ctx.fillStyle = 'rgba(' + rgb.join(',') + ',' + level * 0.6 + ')';
				ctx.fillRect(r.left, r.top + Math.random() * r.height, r.width, 1 + Math.random() * 2);
			}
		});
	}

	function fvMove(item, dx) {
		if (item.inline) {
			if (item.staticBox) {
				item.el.style.position = 'relative';
			}
			item.el.style.left = dx + 'px';
		} else {
			item.el.style.translate = dx + 'px 0';
		}
	}

	function fvFilter(item) {
		var ns = 'http://www.w3.org/2000/svg';
		var filter = document.createElementNS(ns, 'filter');
		var noise = document.createElementNS(ns, 'feTurbulence');
		var map = document.createElementNS(ns, 'feDisplacementMap');
		var id = 'sg-fv-f' + fvNow.filters++;

		filter.setAttribute('id', id);
		filter.setAttribute('x', '-30%');
		filter.setAttribute('y', '-10%');
		filter.setAttribute('width', '160%');
		filter.setAttribute('height', '120%');
		filter.setAttribute('color-interpolation-filters', 'sRGB');
		noise.setAttribute('type', 'fractalNoise');
		noise.setAttribute('baseFrequency', '0.003 0.25');
		noise.setAttribute('numOctaves', '2');
		noise.setAttribute('result', 'n');
		map.setAttribute('in', 'SourceGraphic');
		map.setAttribute('in2', 'n');
		map.setAttribute('xChannelSelector', 'R');
		map.setAttribute('yChannelSelector', 'A');
		filter.appendChild(noise);
		filter.appendChild(map);
		fvNow.svg.appendChild(filter);
		item.noise = noise;
		item.map = map;
		item.el.style.filter = 'url(#' + id + ')';
	}

	function fvPaint(item, t, now) {
		var way = fvNow.way;
		var left = 1 - t;
		var power = way.power / 100;
		var s = item.el.style;

		s.pointerEvents = '';
		if (item.mode === 'fade') {
			s.opacity = t;
		} else if (item.mode === 'noise') {
			s.opacity = Math.min(1, t * 1.5);
			fvNoise(item, power * left);
		} else if (item.mode === 'wave') {
			if (!item.map) {
				fvFilter(item);
			}
			if (now >= item.next) {
				item.next = now + 50;
				item.noise.setAttribute('seed', Math.floor(Math.random() * 1000));
				item.map.setAttribute('scale', way.power * 1.6 * left * left);
				s.opacity = Math.random() < 0.3 * left ? 0.3 : Math.min(1, 0.3 + t * 2);
			}
			fvBands(item, power * left);
		} else {
			if (now >= item.next) {
				var shift = Math.round((way.power / 4) * left);
				var edge = Math.max(1, shift / 2);

				item.next = now + 60;
				fvMove(item, Math.round((Math.random() * 2 - 1) * shift));
				s.filter =
					'drop-shadow(' + edge + 'px 0 0 ' + fvNow.shadow1 + ') drop-shadow(' + -edge + 'px 0 0 ' + fvNow.shadow2 + ')';
				s.clipPath = '';
				if (Math.random() < left * 0.7) {
					var top = Math.random() * 60;

					s.clipPath = 'inset(' + top + '% 0 ' + Math.random() * (80 - top) + '% 0)';
				}
				s.opacity = Math.random() < left * 0.25 ? 0.25 : 1;
			}
		}
	}

	function fvFrame(now) {
		if (!fvNow) {
			return;
		}

		var run = fvNow;
		var alive = false;
		var boxEl = document.getElementById('passages');

		run.box = boxEl ? boxEl.getBoundingClientRect() : null;
		run.ctx.clearRect(0, 0, run.canvas.width, run.canvas.height);
		// Шаг 5.4 (ответ 1А): один раз, с начала эффекта и до конца файла. Уход с
		// экрана и щелчок показывают всё сразу, но звук не обрывают.
		if (!run.sounded && now - run.start >= run.way.delay) {
			run.sounded = true;
			signalPlay(run.way.sound, run.way.volume);
		}
		run.items.forEach(function (item) {
			var t = (now - run.start - item.at) / run.way.time;

			if (item.over) {
				return;
			}
			if (t >= 1) {
				item.over = true;
				fvRestore(item);
				return;
			}
			alive = true;
			if (t >= 0) {
				fvPaint(item, t, now);
			}
		});
		if (alive) {
			requestAnimationFrame(fvFrame);
		} else {
			fvEnd();
		}
	}

	function fvStart(way) {
		fvEnd();

		var found = [];
		var items = [];
		var at = way.delay;

		$('#passages').children().not('#sg-ticker').each(function () {
			fvScan(this, found);
		});
		found.forEach(function (item) {
			item.mode = way.parts[item.kind];
			if (item.mode === 'now') {
				fvRelease(item);
				return;
			}
			item.at = at;
			at += way.step;
			item.el.style.opacity = '0';
			item.el.style.pointerEvents = 'none';
			items.push(item);
		});
		if (!items.length) {
			return;
		}

		var canvas = document.createElement('canvas');
		var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');

		canvas.id = 'sg-fv-canvas';
		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;
		canvas.style.cssText = 'position: fixed; left: 0; top: 0; z-index: 1001; pointer-events: none;';
		svg.setAttribute('width', '0');
		svg.setAttribute('height', '0');
		svg.style.position = 'absolute';
		document.body.appendChild(svg);
		document.body.appendChild(canvas);
		fvNow = {
			way: way,
			items: items,
			canvas: canvas,
			svg: svg,
			ctx: canvas.getContext('2d'),
			tiles: {},
			filters: 0,
			box: null,
			shadow1: rootStyle.getPropertyValue('--sg-fvs-1').trim() || '#0000ff',
			shadow2: rootStyle.getPropertyValue('--sg-fvs-2').trim() || '#ff0000',
			start: performance.now()
		};
		requestAnimationFrame(fvFrame);
	}

	document.addEventListener('click', function () {
		if (fvNow && fvNow.way.skip) {
			fvEnd();
		}
	}, true);

	$(document).on(':passageinit', fvEnd);
	$(document).on(':passagestart', function () {
		fvRestored = restoring;
	});
	// После обработчика окна KR2: он перекладывает элементы экрана в свои зоны.
	$(document).one(':passageinit', function () {
		$(document).on(':passageend', function (ev) {
			var way = preview || fvRestored ? null : fvWay(ev.passage.tags);

			if (way && setup.visits(ev.passage.title) === 1) {
				fvStart(way);
			}
		});
	});
	// Предпросмотр программы: показать появление на открытом экране.
	setup.signaly.firstDemo = function (value) {
		var way = value ? fvParse(value) : fvWay(Story.get(State.passage).tags);

		if (way) {
			fvStart(way);
		}
	};

	if (preview) {
		// Всегда с выбранного экрана, а не с того, что был в прошлый раз.
		State.reset();
		if (preview === 'start') {
			LoadScreen.lock();
			showStartScreen(function () {});
		}
		return;
	}

	/* ----- Сеть с телефонами игроков (сессия 31): модуль signaly-app, только в игре ----- */

	// Огонёк в углу — только если сеть есть в истории (или терминал уже подключали).
	window.SG_TERM_NET_QUIET = !Story.filter(function (p) {
		return /<<sg-net[\s>]|setup\.phone\(/.test(p.text);
	}).length;
	// QR «СЕТЬ» камерой ноутбука (сессия 32): в Chrome для Windows нет BarcodeDetector — своя jsQR (Apache-2.0).
