:: INPUTTEST {"position":"850,250","size":"100,100"}
Ввод пароля без звёздочек
Молекулярный синтезатор активирован.

<<textbox "$inputCode" $inputCode>>
<<button "Подтвердить">>
<<script>>
    var code = State.variables.inputCode;
    console.log("Введённый код: " + code);

    if (code === "11111") {
        Engine.play("gotoPSG");
    } else if (code === "22222") {
        Dialog.create("Инфо из пассажа");
        Dialog.wikiPassage("showPSGinfo");
        Dialog.open();
    } else if (code === "33333") {
        Dialog.create("Предустановленное инфо");
        Dialog.wiki("33333");
        Dialog.open();
       } else {
        Dialog.create("Ошибка");
        Dialog.wiki("Неверный код: " + (code || "пусто"));
        Dialog.open();
    }
<</script>>
<</button>>

[[Назад|Start]]


:: PASSWORDTEST {"position":"425,375","size":"100,100"}
Ввод пароля<br>
Молекулярный синтезатор активирован.

<input type="password" id="passwordInput" value="">

<<script>>
    // Синхронизация значения поля с $inputCode
    $(document).one(':passagedisplay', function() {
        var inputField = document.getElementById('passwordInput');
        if (inputField) {
            console.log("Поле найдено:", inputField);
            // Обновляем $inputCode при вводе
            inputField.addEventListener('input', function() {
                State.variables.inputCode = inputField.value;
            });
            // Устанавливаем фокус на поле
            inputField.focus();
        } else {
            console.log("Поле ввода не найдено.");
        }
    });
<</script>>

<<button "Подтвердить">>
    <<script>>
        var code = State.variables.inputCode;
        console.log("Введённый код: " + code);

        if (code === "11111") {
            Engine.play("gotoPSG");
        } else if (code === "22222") {
            Dialog.create("Инфо из пассажа");
            Dialog.wikiPassage("showPSGinfo");
            Dialog.open();
        } else if (code === "33333") {
            Dialog.create("Предустановленное инфо");
            Dialog.wiki("33333");
            Dialog.open();
        } else {
            Dialog.create("Ошибка");
            Dialog.wiki("Неверный код");
            Dialog.open();
        }

        // Очистка поля после ввода
        var inputField = document.getElementById('passwordInput');
        if (inputField) {
            inputField.value = "";
            State.variables.inputCode = "";
        }
    <</script>>
<</button>>

[[Назад|Start]]


